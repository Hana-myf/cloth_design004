,EAAA,EAAA;AAAA,QAAA,KAAA,EAAA;AAAA,OAAA,CADA,CAEA;;AACA,WAAA,UAAA,GAAA,EAAA;AACA,WAAA,UAAA,GAAA,EAAA;AACA,WAAA,QAAA,GAAA,EAAA;AACA,WAAA,YAAA,GAAA,EAAA;AACA,KA/JA;;AAgKA,UAAA,cAAA,GAAA;AACA,UAAA;AACA,YAAA,SAAA,GAAA,IAAA;AACA,YAAA,OAAA,GAAA,IAAA;;AACA,YAAA,KAAA,UAAA,IAAA,KAAA,UAAA,CAAA,MAAA,KAAA,CAAA,EAAA;AACA,gBAAA,CAAA,SAAA,EAAA,OAAA,IAAA,KAAA,UAAA,CAAA,GAAA,CAAA,IAAA,IAAA,IAAA,CAAA,WAAA,EAAA,CAAA;AACA,UAAA,SAAA,GAAA,GAAA,SAAA,CAAA,KAAA,CAAA,GAAA,EAAA,CAAA,CAAA,WAAA;AACA,UAAA,OAAA,GAAA,GAAA,OAAA,CAAA,KAAA,CAAA,GAAA,EAAA,CAAA,CAAA,WAAA;AACA;;AACA,cAAA,MAAA,GAAA;AACA,UAAA,OAAA,EAAA,KAAA,WADA;AAEA,UAAA,IAAA,EAAA,KAAA,QAFA;AAGA,UAAA,SAAA,EAAA,SAHA;AAIA,UAAA,OAAA,EAAA,OAJA;AAKA,aAAA,KAAA;AALA,SAAA;AAOA,cAAA,QAAA,GAAA,MAAA,KAAA,MAAA,CAAA,IAAA,CAAA,aAAA,EAAA,MAAA,CAAA;AACA,cAAA;AAAA,UAAA;AAAA,YAAA,QAAA;AACA,aAAA,SAAA,GAAA,IAAA,CAAA,IAAA;AACA,aAAA,UAAA,GAAA,IAAA,CAAA,KAAA;AACA,OAnBA,CAmBA,OAAA,KAAA,EAAA;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,WAAA,EAAA,KAAA;AACA;AACA,KAvLA;;AAwLA;AACA,IAAA,GAAA,GAAA;AACA,WAAA,kBAAA,GAAA,IAAA;AACA,WAAA,WAAA,GAAA,KAAA,CAFA,CAEA;;AACA,WAAA,aAAA,GAHA,CAGA;AACA;;AACA,UAAA,KAAA,QAAA,CAAA,MAAA,GAAA,CAAA,EAAA;AACA,aAAA,IAAA,CAAA,KAAA,GAAA,KAAA,QAAA,CAAA,CAAA,EAAA,EAAA;AACA;AACA,KAjMA;;AAkMA,IAAA,YAAA,GAAA;AACA,WAAA,WAAA,GAAA,CAAA;AACA,WAAA,cAAA;AACA,KArMA;;AAsMA,IAAA,iBAAA,GAAA;AACA,WAAA,UAAA,GAAA,EAAA;AACA,WAAA,YAAA;AACA,KAzMA;;AA0MA,IAAA,gBAAA,CAAA,GAAA,EAAA;AACA,WAAA,QAAA,GAAA,GAAA;AACA,WAAA,WAAA,GAAA,CAAA;AACA,WAAA,cAAA;AACA,KA9MA;;AA+MA,IAAA,mBAAA,CAAA,GAAA,EAAA;AACA,WAAA,WAAA,GAAA,GAAA;AACA,WAAA,cAAA;AACA,KAlNA;;AAmNA,IAAA,UAAA,CAAA,GAAA,EAAA;AACA,WAAA,kBAAA,GAAA,IAAA;AACA,WAAA,WAAA,GAAA,IAAA,CAFA,CAEA;AACA;;AACA,WAAA,IAAA,GAAA,EAAA,GAAA;AAAA,OAAA,CAJA,CAKA;;AACA,WAAA,UAAA,GAAA,EAAA;AACA,WAAA,UAAA,GAAA,EAAA;AACA,WAAA,QAAA,GAAA,EAAA;AACA,WAAA,YAAA,GAAA,EAAA;AACA,KA7NA;;AA8NA,IAAA,YAAA,CAAA,GAAA,EAAA;AACA,WAAA,YAAA,GAAA,CAAA,GAAA,CAAA,CADA,CACA;;AACA,WAAA,WAAA;AACA;;AAjOA;AA9BA,CAAA","sourcesContent":["<template>\r\n  <el-row style=\"background-color: #FFFFFF;padding: 5px 0;border-radius: 5px;\">\r\n    <el-row style=\"padding: 10px;margin-left: 10px;\">\r\n      <el-row>\r\n         <el-select\r\n          @change=\"changeNewsTag\"\r\n          size=\"small\"\r\n          v-model=\"newsQueryDto.tagId\"\r\n          placeholder=\"资讯分类\"\r\n        >\r\n          <el-option\r\n            v-for=\"tag in tagsList\"\r\n            :key=\"tag.id\"\r\n            :label=\"tag.name\"\r\n            :value=\"tag.id\"\r\n          >\r\n          </el-option>\r\n        </el-select>\r\n        <el-date-picker\r\n          size=\"small\"\r\n          style=\"margin-left: 5px;width: 220px;\"\r\n          v-model=\"searchTime\"\r\n          type=\"daterange\"\r\n          range-separator=\"至\"\r\n          start-placeholder=\"发布开始\"\r\n          end-placeholder=\"发布结束\"\r\n        >\r\n        </el-date-picker>\r\n        <el-input\r\n          size=\"small\"\r\n          style=\"width: 188px;margin-left: 5px;margin-right: 6px;\"\r\n          v-model=\"newsQueryDto.name\"\r\n          placeholder=\"资讯标题\"\r\n          clearable\r\n          @clear=\"handleFilterClear\"\r\n        >\r\n          <el-button\r\n            slot=\"append\"\r\n            @click=\"handleFilter\"\r\n            icon=\"el-icon-search\"\r\n          ></el-button>\r\n        </el-input>\r\n        <span style=\"float: right;\">\r\n          <el-button\r\n            size=\"small\"\r\n            style=\"background-color: rgb(96, 98, 102);color: rgb(247,248,249);border: none;\"\r\n            class=\"customer\"\r\n            type=\"info\"\r\n            @click=\"add()\"\r\n            ><i class=\"el-icon-plus\"></i>新增资讯</el-button\r\n          >\r\n        </span>\r\n      </el-row>\r\n    </el-row>\r\n    <el-row style=\"margin: 0 20px;border-top: 1px solid rgb(245,245,245);\">\r\n      <el-table\r\n        row-key=\"id\"\r\n        @selection-change=\"handleSelectionChange\"\r\n        :data=\"tableData\"\r\n        style=\"width: 100%\"\r\n      >\r\n        <el-table-column prop=\"cover\" width=\"80\" label=\"首图\">\r\n          <template slot-scope=\"scope\">\r\n            <img\r\n              :src=\"scope.row.cover\"\r\n              style=\"width: 48px;height: 34px;border-radius: 5px;\"\r\n            />\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"tagName\" width=\"138\" label=\"所属分类\">\r\n          <template slot-scope=\"scope\">\r\n            <span\r\n              ><i class=\"el-icon-discount\" style=\"margin-right: 3px;\"></i>\r\n              {{ scope.row.tagName }}\r\n            </span>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"isTop\" width=\"128\" label=\"是否推荐\">\r\n          <template slot-scope=\"scope\">\r\n            <i\r\n              v-if=\"!scope.row.isTop\"\r\n              style=\"margin-right: 5px;\"\r\n              class=\"el-icon-warning\"\r\n            ></i>\r\n            <i\r\n              v-else\r\n              style=\"margin-right: 5px;color: rgb(253, 199, 50);\"\r\n              class=\"el-icon-success\"\r\n            ></i>\r\n            <el-tooltip\r\n              v-if=\"!scope.row.isTop\"\r\n              class=\"item\"\r\n              effect=\"dark\"\r\n              content=\"未推荐资讯，不做推荐展示\"\r\n              placement=\"bottom-end\"\r\n            >\r\n              <span\r\n                style=\"cursor: pointer;;text-decoration: underline;text-decoration-style: dashed;\"\r\n                >未推荐</span\r\n              >\r\n            </el-tooltip>\r\n            <span v-else>已推荐</span>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column\r\n          prop=\"createTime\"\r\n          width=\"168\"\r\n          label=\"发布时间\"\r\n        ></el-table-column>\r\n        <el-table-column prop=\"name\" label=\"标题\"></el-table-column>\r\n        <el-table-column label=\"操作\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            <span class=\"text-button\" @click=\"handleEdit(scope.row)\">编辑</span>\r\n            <span class=\"text-button\" @click=\"handleDelete(scope.row)\"\r\n              >删除</span\r\n            >\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n      <el-pagination\r\n        style=\"margin: 20px 0;\"\r\n        @size-change=\"handleSizeChange\"\r\n        @current-change=\"handleCurrentChange\"\r\n        :current-page=\"currentPage\"\r\n        :page-sizes=\"[10, 20]\"\r\n        :page-size=\"pageSize\"\r\n        layout=\"total, sizes, prev, pager, next, jumper\"\r\n        :total=\"totalItems\"\r\n      ></el-pagination>\r\n    </el-row>\r\n    <el-dialog\r\n      :show-close=\"false\"\r\n      :visible.sync=\"dialogUserOperaion\"\r\n      width=\"50%\"\r\n    >\r\n      <div slot=\"title\">\r\n        <p class=\"dialog-title\">{{ !isOperation ? \"新增资讯\" : \"修改资讯\" }}</p>\r\n      </div>\r\n      <div style=\"padding:0 20px;\">\r\n        <!-- 封面 -->\r\n        <el-row style=\"margin-top: 10px;\">\r\n          <p>*封面 <span style=\"color:red\" v-if=\"coverError\">{{ coverError }}</span></p>\r\n          <el-upload\r\n            class=\"avatar-uploader\"\r\n            action=\"/api/personal-heath/v1.0/file/upload\"\r\n            :show-file-list=\"false\"\r\n            :on-success=\"handleAvatarSuccess\"\r\n            :on-error=\"handleAvatarError\"\r\n          >\r\n            <img\r\n              v-if=\"data.cover\"\r\n              :src=\"data.cover\"\r\n              style=\"height: 120px;width: 188px;\"\r\n            />\r\n            <i v-else class=\"el-icon-plus avatar-uploader-icon\"></i>\r\n          </el-upload>\r\n        </el-row>\r\n        <!-- 标题 -->\r\n        <el-row>\r\n          <p>*标题 <span style=\"color:red\" v-if=\"titleError\">{{ titleError }}</span></p>\r\n          <input\r\n            style=\"font-size: 32px;line-height: 45px;\"\r\n            class=\"dialog-input\"\r\n            v-model=\"data.name\"\r\n            placeholder=\"标题\"\r\n          />\r\n        </el-row>\r\n        <!-- 标签 -->\r\n        <el-row style=\"margin: 12px 0;\">\r\n          <el-row>\r\n            <span class=\"dialog-hover\">所属分类 <span style=\"color:red\" v-if=\"tagError\">{{ tagError }}</span></span>\r\n          </el-row>\r\n          <el-radio-group style=\"margin-top: 10px;\" v-model=\"data.tagId\">\r\n            <el-radio\r\n              :key=\"index\"\r\n              :label=\"tag.id\"\r\n              v-for=\"(tag, index) in tagsList\"\r\n              >{{ tag.name }}</el-radio\r\n            >\r\n          </el-radio-group>\r\n        </el-row>\r\n        <!-- 推荐 -->\r\n        <el-row style=\"margin: 12px 0;\">\r\n          <el-row>\r\n            <span class=\"dialog-hover\">是否推荐</span>\r\n          </el-row>\r\n          <el-switch\r\n            style=\"user-select: none;padding: 0 6px;\"\r\n            v-model=\"data.isTop\"\r\n            active-color=\"#13ce66\"\r\n            inactive-color=\"rgb(226, 226, 226)\"\r\n          >\r\n          </el-switch>\r\n        </el-row>\r\n        <el-row>\r\n          <p>*正文描述 <span style=\"color:red\" v-if=\"contentError\">{{ contentError }}</span></p>\r\n          <Editor\r\n            height=\"calc(100vh - 500px)\"\r\n            :receiveContent=\"data.content\"\r\n            @on-receive=\"onReceiveContent\"\r\n          />\r\n        </el-row>\r\n      </div>\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button\r\n          size=\"small\"\r\n          v-if=\"!isOperation\"\r\n          style=\"background-color: rgb(96, 98, 102);color: rgb(247,248,249);border: none;\"\r\n          class=\"customer\"\r\n          type=\"info\"\r\n          @click=\"addOperation()\"\r\n          >新增</el-button\r\n        >\r\n        <el-button\r\n          size=\"small\"\r\n          v-else\r\n          style=\"background-color: rgb(96, 98, 102);color: rgb(247,248,249);border: none;\"\r\n          class=\"customer\"\r\n          type=\"info\"\r\n          @click=\"updateOperation()\"\r\n          >修改</el-button\r\n        >\r\n        <el-button\r\n          class=\"customer\"\r\n          size=\"small\"\r\n          style=\"background-color: rgb(241, 241, 241);border: none;\"\r\n          @click=\"dialogUserOperaion = false\"\r\n          >取消</el-button\r\n        >\r\n      </span>\r\n    </el-dialog>\r\n  </el-row>\r\n</template>\r\n\r\n<script>\r\nimport Editor from \"@/components/Editor\";\r\nexport default {\r\n  components: { Editor },\r\n  data() {\r\n    return {\r\n      userPwd: \"\",\r\n      data: { cover: \"\", isTop: false }, // 初始化默认值\r\n      filterText: \"\",\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n      totalItems: 0,\r\n      dialogUserOperaion: false,\r\n      isOperation: false, // false=新增，true=修改\r\n      tableData: [],\r\n      searchTime: [],\r\n      selectedRows: [],\r\n      status: null,\r\n      newsQueryDto: {},\r\n      messsageContent: \"\",\r\n      tagsList: [],\r\n      // 表单验证错误提示\r\n      coverError: \"\",\r\n      titleError: \"\",\r\n      tagError: \"\",\r\n      contentError: \"\"\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchFreshData();\r\n    this.loadAllTags();\r\n  },\r\n  methods: {\r\n    changeNewsTag(tagId) {\r\n      this.newsQueryDto.tagId = tagId;\r\n      this.fetchFreshData();\r\n    },\r\n    onReceiveContent(html) {\r\n      this.data.content = html;\r\n    },\r\n    loadAllTags() {\r\n      this.$axios.post(`/tags/query`, {}).then(response => {\r\n        const { data } = response;\r\n        if (data.code === 200) {\r\n          this.tagsList = data.data;\r\n          this.tagsList.unshift({ name: \"全部\", id: null });\r\n        }\r\n      });\r\n    },\r\n    handleAvatarSuccess(res, file) {\r\n      this.coverError = \"\"; // 清空错误提示\r\n      if (res.code !== 200) {\r\n        this.$message.error(`资讯封面上传异常`);\r\n        return;\r\n      }\r\n      this.data.cover = res.data;\r\n      this.$message.success(`资讯封面上传成功`);\r\n    },\r\n    handleAvatarError() {\r\n      this.coverError = \"封面上传失败，请重新上传\";\r\n    },\r\n    handleSelectionChange(selection) {\r\n      this.selectedRows = selection;\r\n    },\r\n    async batchDelete() {\r\n      if (!this.selectedRows.length) {\r\n        this.$message(`未选中任何数据`);\r\n        return;\r\n      }\r\n      const confirmed = await this.$swalConfirm({\r\n        title: \"删除资讯数据\",\r\n        text: `删除后不可恢复，是否继续？`,\r\n        icon: \"warning\"\r\n      });\r\n      if (confirmed) {\r\n        try {\r\n          let ids = this.selectedRows.map(entity => entity.id);\r\n          const response = await this.$axios.post(`/news/batchDelete`, ids);\r\n          if (response.data.code === 200) {\r\n            this.$swal.fire({\r\n              title: \"删除提示\",\r\n              text: response.data.msg,\r\n              icon: \"success\",\r\n              showConfirmButton: false,\r\n              timer: 2000\r\n            });\r\n            this.fetchFreshData();\r\n            return;\r\n          }\r\n        } catch (e) {\r\n          this.$swal.fire({\r\n            title: \"错误提示\",\r\n            text: \"删除失败\",\r\n            icon: \"error\",\r\n            showConfirmButton: false,\r\n            timer: 2000\r\n          });\r\n          console.error(`资讯信息删除异常：`, e);\r\n        }\r\n      }\r\n    },\r\n    resetQueryCondition() {\r\n      this.newsQueryDto = {};\r\n      this.searchTime = [];\r\n      this.fetchFreshData();\r\n    },\r\n    async updateOperation() {\r\n      // 验证表单\r\n      if (!this.validateForm()) return;\r\n\r\n      try {\r\n        const response = await this.$axios.put(\"/news/update\", this.data);\r\n        this.$swal.fire({\r\n          title: \"资讯信息修改\",\r\n          text: response.data.msg,\r\n          icon: response.data.code === 200 ? \"success\" : \"error\",\r\n          showConfirmButton: false,\r\n          timer: 1000\r\n        });\r\n        if (response.data.code === 200) {\r\n          this.closeDialog();\r\n          this.fetchFreshData();\r\n          this.clearFormData();\r\n        }\r\n      } catch (error) {\r\n        console.error(\"提交表单时出错:\", error);\r\n        this.$message.error(\"提交失败，请稍后再试！\");\r\n      }\r\n    },\r\n    async addOperation() {\r\n      // 验证表单必填项\r\n      if (!this.validateForm()) return;\r\n\r\n      try {\r\n        const response = await this.$axios.post(\"/news/save\", this.data);\r\n        this.$message[response.data.code === 200 ? \"success\" : \"error\"](\r\n          response.data.msg\r\n        );\r\n        if (response.data.code === 200) {\r\n          this.closeDialog();\r\n          this.fetchFreshData();\r\n          this.clearFormData();\r\n        }\r\n      } catch (error) {\r\n        console.error(\"提交表单时出错:\", error);\r\n        this.$message.error(\"提交失败，请稍后再试！\");\r\n      }\r\n    },\r\n    // 表单验证方法\r\n    validateForm() {\r\n      let isValid = true;\r\n      // 验证封面\r\n      if (!this.data.cover) {\r\n        this.coverError = \"请上传封面图片\";\r\n        isValid = false;\r\n      } else {\r\n        this.coverError = \"\";\r\n      }\r\n      // 验证标题\r\n      if (!this.data.name || this.data.name.trim() === \"\") {\r\n        this.titleError = \"请输入资讯标题\";\r\n        isValid = false;\r\n      } else {\r\n        this.titleError = \"\";\r\n      }\r\n      // 验证分类\r\n      if (this.data.tagId === undefined || this.data.tagId === null) {\r\n        this.tagError = \"请选择所属分类\";\r\n        isValid = false;\r\n      } else {\r\n        this.tagError = \"\";\r\n      }\r\n      // 验证正文\r\n      if (!this.data.content || this.data.content.trim() === \"\") {\r\n        this.contentError = \"请输入资讯正文\";\r\n        isValid = false;\r\n      } else {\r\n        this.contentError = \"\";\r\n      }\r\n      return isValid;\r\n    },\r\n    closeDialog() {\r\n      this.dialogUserOperaion = false;\r\n    },\r\n    clearFormData() {\r\n      this.data = { cover: \"\", isTop: false };\r\n      // 清空错误提示\r\n      this.coverError = \"\";\r\n      this.titleError = \"\";\r\n      this.tagError = \"\";\r\n      this.contentError = \"\";\r\n    },\r\n    async fetchFreshData() {\r\n      try {\r\n        let startTime = null;\r\n        let endTime = null;\r\n        if (this.searchTime && this.searchTime.length === 2) {\r\n          const [startDate, endDate] = this.searchTime.map(date => date.toISOString());\r\n          startTime = `${startDate.split(\"T\")[0]}T00:00:00`;\r\n          endTime = `${endDate.split(\"T\")[0]}T23:59:59`;\r\n        }\r\n        const params = {\r\n          current: this.currentPage,\r\n          size: this.pageSize,\r\n          startTime: startTime,\r\n          endTime: endTime,\r\n          ...this.newsQueryDto\r\n        };\r\n        const response = await this.$axios.post(\"/news/query\", params);\r\n        const { data } = response;\r\n        this.tableData = data.data;\r\n        this.totalItems = data.total;\r\n      } catch (error) {\r\n        console.error(\"查询资讯信息异常:\", error);\r\n      }\r\n    },\r\n    // 新增按钮点击事件（关键修复）\r\n    add() {\r\n      this.dialogUserOperaion = true;\r\n      this.isOperation = false; // 强制设为新增模式\r\n      this.clearFormData(); // 清空表单数据\r\n      // 默认选中第一个可用分类（排除\"全部\"）\r\n      if (this.tagsList.length > 1) {\r\n        this.data.tagId = this.tagsList[1].id;\r\n      }\r\n    },\r\n    handleFilter() {\r\n      this.currentPage = 1;\r\n      this.fetchFreshData();\r\n    },\r\n    handleFilterClear() {\r\n      this.filterText = \"\";\r\n      this.handleFilter();\r\n    },\r\n    handleSizeChange(val) {\r\n      this.pageSize = val;\r\n      this.currentPage = 1;\r\n      this.fetchFreshData();\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.currentPage = val;\r\n      this.fetchFreshData();\r\n    },\r\n    handleEdit(row) {\r\n      this.dialogUserOperaion = true;\r\n      this.isOperation = true; // 设为修改模式\r\n      // 深拷贝行数据，避免直接修改表格数据\r\n      this.data = { ...row };\r\n      // 清空错误提示\r\n      this.coverError = \"\";\r\n      this.titleError = \"\";\r\n      this.tagError = \"\";\r\n      this.contentError = \"\";\r\n    },\r\n    handleDelete(row) {\r\n      this.selectedRows = [row]; // 单次删除选中当前行\r\n      this.batchDelete();\r\n    }\r\n  }\r\n};\r\n</script>\r\n<style scoped lang=\"scss\">\r\n.tag-tip {\r\n  display: inline-block;\r\n  padding: 5px 10px;\r\n  border-radius: 5px;\r\n  background-color: rgb(245, 245, 245);\r\n  color: rgb(104, 118, 130);\r\n}\r\n\r\n.input-def {\r\n  height: 40px;\r\n  line-height: 40px;\r\n  outline: none;\r\n  border: none;\r\n  font-size: 20px;\r\n  color: rgb(102, 102, 102);\r\n  font-weight: 900;\r\n  width: 100%;\r\n}\r\n\r\n.dialog-footer {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.customer {\r\n  margin: 0 8px;\r\n}\r\n\r\n.text-button {\r\n  margin: 0 5px;\r\n  color: #409eff;\r\n  cursor: pointer;\r\n}\r\n\r\n.text-button:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.dialog-input {\r\n  width: 100%;\r\n  padding: 8px 0;\r\n  border: none;\r\n  border-bottom: 1px solid #eaeaea;\r\n  outline: none;\r\n  transition: border-color 0.3s;\r\n}\r\n\r\n.dialog-input:focus {\r\n  border-bottom-color: #409eff;\r\n}\r\n</style>"],"sourceRoot":"src/views/admin"}]}