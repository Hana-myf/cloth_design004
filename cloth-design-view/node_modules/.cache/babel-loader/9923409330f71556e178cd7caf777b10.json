AA;AACA;AACA,WAAA,SAAA,GAAA,EAAA;AACA,WAAA,YAAA,GAAA,EAAA;AACA,WAAA,YAAA,GAAA,EAAA;AACA,WAAA,OAAA,GAAA,EAAA;AACA,WAAA,WAAA,GAAA,KAAA;AACA,WAAA,UAAA,GAAA,KAAA,WAAA;AACA,WAAA,SAAA,GAAA,IAAA;;AAEA,UAAA;AACA;AACA,cAAA,WAAA,GAAA;AACA,UAAA,KAAA,EAAA,gCADA;AAEA,UAAA,MAAA,EAAA,KAAA,MAAA,CAAA,IAAA,EAFA;AAGA,UAAA,KAAA,EAAA,KAAA,QAAA,CAAA,IAAA,EAHA;AAIA,UAAA,IAAA,EAAA,GAJA;AAKA,UAAA,cAAA,EAAA;AALA,SAAA,CAFA,CAUA;;AACA,cAAA,OAAA,GAAA;AACA,0BAAA,kBADA;AAEA,8BAAA;AAFA,SAAA,CAXA,CAgBA;;AACA,YAAA,KAAA,SAAA,CAAA,IAAA,EAAA,EAAA;AACA;AACA,UAAA,OAAA,CAAA,eAAA,CAAA,GAAA,KAAA,SAAA,CAAA,UAAA,CAAA,SAAA,IACA,KAAA,SADA,GAEA,UAAA,KAAA,SAAA,EAFA;AAGA,SALA,MAKA;AACA,eAAA,OAAA,GAAA,uCAAA;AACA,SAxBA,CA0BA;;;AACA,cAAA,UAAA,GAAA,IAAA,eAAA,EAAA;AACA,cAAA,SAAA,GAAA,UAAA,CAAA,MAAA,UAAA,CAAA,KAAA,EAAA,EAAA,KAAA,CAAA,CA5BA,CA8BA;;AACA,cAAA,QAAA,GAAA,MAAA,KAAA,CAAA,KAAA,WAAA,EAAA;AACA,UAAA,MAAA,EAAA,MADA;AAEA,UAAA,OAAA,EAAA,OAFA;AAGA,UAAA,IAAA,EAAA,IAAA,CAAA,SAAA,CAAA,WAAA,CAHA;AAIA,UAAA,MAAA,EAAA,UAAA,CAAA,MAJA;AAKA,UAAA,WAAA,EAAA,SALA,CAKA;;AALA,SAAA,CAAA;AAQA,QAAA,YAAA,CAAA,SAAA,CAAA,CAvCA,CAyCA;;AACA,cAAA,YAAA,GAAA,MAAA,QAAA,CAAA,IAAA,EAAA;AACA,YAAA,YAAA;;AAEA,YAAA;AACA,UAAA,YAAA,GAAA,IAAA,CAAA,KAAA,CAAA,YAAA,CAAA;AACA,SAFA,CAEA,OAAA,CAAA,EAAA;AACA,gBAAA,IAAA,KAAA,CAAA,aAAA,YAAA,CAAA,SAAA,CAAA,CAAA,EAAA,GAAA,CAAA,EAAA,CAAA;AACA,SAjDA,CAmDA;;;AACA,YAAA,YAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,cAAA,YAAA,CAAA,IAAA,IAAA,YAAA,CAAA,IAAA,CAAA,MAAA,GAAA,CAAA,IAAA,YAAA,CAAA,IAAA,CAAA,CAAA,EAAA,GAAA,EAAA;AACA,iBAAA,SAAA,GAAA,YAAA,CAAA,IAAA,CAAA,CAAA,EAAA,GAAA;AACA,WAFA,MAEA;AACA,kBAAA,IAAA,KAAA,CAAA,cAAA,CAAA;AACA;AACA,SANA,MAMA,IAAA,YAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA;AACA,cAAA,YAAA,CAAA,GAAA,CAAA,QAAA,CAAA,QAAA,KAAA,YAAA,CAAA,GAAA,CAAA,QAAA,CAAA,IAAA,CAAA,EAAA;AACA,iBAAA,OAAA,GAAA,iCAAA;AACA;;AACA,gBAAA,IAAA,KAAA,CAAA,SAAA,YAAA,CAAA,GAAA,EAAA,CAAA;AACA,SANA,MAMA;AACA,gBAAA,IAAA,KAAA,CAAA,SAAA,YAAA,CAAA,GAAA,IAAA,MAAA,EAAA,CAAA;AACA;AAEA,OApEA,CAoEA,OAAA,KAAA,EAAA;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,OAAA,EAAA,KAAA,EADA,CAGA;;AACA,YAAA,KAAA,CAAA,IAAA,KAAA,YAAA,EAAA;AACA,eAAA,YAAA,GAAA,MAAA;AACA,eAAA,YAAA,GAAA,kBAAA;AACA,SAHA,MAGA,IAAA,KAAA,CAAA,OAAA,CAAA,QAAA,CAAA,iBAAA,CAAA,EAAA;AACA,eAAA,YAAA,GAAA,YAAA;AACA,eAAA,YAAA,GAAA,sBAAA;AACA,SAHA,MAGA;AACA,eAAA,YAAA,GAAA,QAAA;AACA,eAAA,YAAA,GAAA,KAAA,CAAA,OAAA;AACA;AACA,OAlFA,SAkFA;AACA,aAAA,SAAA,GAAA,KAAA;AACA;AACA;;AAtGA;AAjCA,CAAA","sourcesContent":["<template>\r\n  <div class=\"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex flex-col\">\r\n    <!-- 顶部导航 -->\r\n    <header class=\"bg-white shadow-md py-4 px-6\">\r\n      <div class=\"container mx-auto\">\r\n        <h1 class=\"text-2xl font-bold text-gray-800\">图片风格转换工具</h1>\r\n        <p class=\"text-gray-600 mt-1\">通过文字描述修改您的图片</p>\r\n      </div>\r\n    </header>\r\n\r\n    <!-- 主要内容区 -->\r\n    <main class=\"flex-grow container mx-auto px-4 py-8\">\r\n      <div class=\"max-w-4xl mx-auto\">\r\n        <!-- 登录状态提示 -->\r\n        <div v-if=\"!isAuthenticated\" class=\"bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6\">\r\n          <div class=\"flex items-start\">\r\n            <i class=\"fa fa-info-circle mt-1 mr-3 text-yellow-500\"></i>\r\n            <p class=\"text-sm text-yellow-700\">检测到未登录状态，尝试使用默认认证信息...</p>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 输入表单 -->\r\n        <div class=\"bg-white rounded-xl shadow-lg p-6 mb-8 transform transition-all hover:shadow-xl\">\r\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">输入参数</h2>\r\n          \r\n          <div class=\"space-y-4\">\r\n            <!-- 图片URL输入 -->\r\n            <div>\r\n              <label for=\"imageUrl\" class=\"block text-sm font-medium text-gray-700 mb-1\">图片URL</label>\r\n              <input\r\n                type=\"url\"\r\n                id=\"imageUrl\"\r\n                v-model=\"imageUrl\"\r\n                class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors\"\r\n                placeholder=\"https://example.com/image.jpg\"\r\n                required\r\n              >\r\n              <p class=\"text-xs text-gray-500 mt-1\">支持jpeg、png格式的可访问URL</p>\r\n            </div>\r\n\r\n            <!-- 提示词输入 -->\r\n            <div>\r\n              <label for=\"prompt\" class=\"block text-sm font-medium text-gray-700 mb-1\">描述文字</label>\r\n              <textarea\r\n                id=\"prompt\"\r\n                v-model=\"prompt\"\r\n                class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors\"\r\n                rows=\"3\"\r\n                placeholder=\"例如：改成爱心形状的泡泡\"\r\n                required\r\n              ></textarea>\r\n            </div>\r\n\r\n            <!-- 认证Token输入（可选，用于测试） -->\r\n            <div>\r\n              <label for=\"authToken\" class=\"block text-sm font-medium text-gray-700 mb-1\">认证Token（可选）</label>\r\n              <input\r\n                type=\"text\"\r\n                id=\"authToken\"\r\n                v-model=\"authToken\"\r\n                class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors\"\r\n                placeholder=\"输入认证Token（如Bearer Token）\"\r\n              >\r\n            </div>\r\n\r\n            <!-- 生成按钮 -->\r\n            <button\r\n              @click=\"generateImage\"\r\n              :disabled=\"isLoading || !isFormValid\"\r\n              class=\"w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors disabled:bg-gray-400 disabled:cursor-not-allowed flex items-center justify-center gap-2\"\r\n            >\r\n              <span>生成图片</span>\r\n              <i v-if=\"isLoading\" class=\"fa fa-spinner fa-spin\"></i>\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 结果展示 -->\r\n        <div v-if=\"resultUrl\" class=\"bg-white rounded-xl shadow-lg p-6 transform transition-all hover:shadow-xl\">\r\n          <h2 class=\"text-xl font-semibold text-gray-800 mb-4\">生成结果</h2>\r\n          <div class=\"flex flex-col items-center\">\r\n            <div class=\"relative w-full max-w-2xl aspect-video bg-gray-100 rounded-lg overflow-hidden mb-4\">\r\n              <img\r\n                :src=\"resultUrl\"\r\n                :alt=\"prompt\"\r\n                class=\"w-full h-full object-contain\"\r\n                @load=\"imageLoaded = true\"\r\n              >\r\n              <div v-if=\"!imageLoaded\" class=\"absolute inset-0 flex items-center justify-center\">\r\n                <i class=\"fa fa-image text-gray-300 text-5xl\"></i>\r\n              </div>\r\n            </div>\r\n            <a\r\n              :href=\"resultUrl\"\r\n              target=\"_blank\"\r\n              class=\"inline-flex items-center text-blue-600 hover:text-blue-800 font-medium\"\r\n            >\r\n              <span>查看原图</span>\r\n              <i class=\"fa fa-external-link ml-1\"></i>\r\n            </a>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 错误提示 -->\r\n        <div v-if=\"errorMessage\" class=\"bg-red-50 border border-red-200 rounded-lg p-4 text-red-700\">\r\n          <div class=\"flex items-start\">\r\n            <i class=\"fa fa-exclamation-circle mt-1 mr-3 text-red-500\"></i>\r\n            <div>\r\n              <p>{{ errorMessage }}</p>\r\n              <p v-if=\"errorDetails\" class=\"text-xs mt-2 bg-red-100 p-2 rounded\">{{ errorDetails }}</p>\r\n              <p v-if=\"requestUrl\" class=\"text-xs mt-2 bg-red-100 p-2 rounded\">请求地址: {{ requestUrl }}</p>\r\n              <p v-if=\"authTip\" class=\"text-xs mt-2 bg-red-100 p-2 rounded\">{{ authTip }}</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </main>\r\n\r\n    <!-- 页脚 -->\r\n    <footer class=\"bg-white py-4 px-6 border-t\">\r\n      <div class=\"container mx-auto text-center text-gray-600 text-sm\">\r\n        <p>图片生成工具 &copy; {{ new Date().getFullYear() }}</p>\r\n      </div>\r\n    </footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      // 表单数据\r\n      imageUrl: '',\r\n      prompt: '',\r\n      authToken: '', // 用于输入认证Token\r\n      \r\n      // 状态管理\r\n      isLoading: false,\r\n      resultUrl: '',\r\n      errorMessage: '',\r\n      errorDetails: '',\r\n      imageLoaded: false,\r\n      requestUrl: '',\r\n      authTip: '', // 认证相关提示\r\n      \r\n      // 后端接口完整地址\r\n      apiEndpoint: 'http://localhost:21090/api/personal-heath/v1.0/api/proxy/generate-image'\r\n    };\r\n  },\r\n  computed: {\r\n    // 表单验证\r\n    isFormValid() {\r\n      return this.imageUrl.trim() !== '' && \r\n             this.prompt.trim() !== '' &&\r\n             this.isValidImageUrl(this.imageUrl);\r\n    },\r\n    // 检查是否有认证信息\r\n    isAuthenticated() {\r\n      return !!this.authToken.trim();\r\n    }\r\n  },\r\n  methods: {\r\n    // 验证图片URL格式\r\n    isValidImageUrl(url) {\r\n      const regex = /^(https?:\\/\\/).*\\.(jpeg|jpg|png)$/i;\r\n      return regex.test(url);\r\n    },\r\n    \r\n    async generateImage() {\r\n      // 重置状态\r\n      this.resultUrl = '';\r\n      this.errorMessage = '';\r\n      this.errorDetails = '';\r\n      this.authTip = '';\r\n      this.imageLoaded = false;\r\n      this.requestUrl = this.apiEndpoint;\r\n      this.isLoading = true;\r\n\r\n      try {\r\n        // 构建请求参数\r\n        const requestData = {\r\n          model: 'doubao-seededit-3-0-i2i-250628',\r\n          prompt: this.prompt.trim(),\r\n          image: this.imageUrl.trim(),\r\n          seed: 123,\r\n          guidance_scale: 5.5\r\n        };\r\n\r\n        // 构建请求头（包含认证信息）\r\n        const headers = {\r\n          'Content-Type': 'application/json',\r\n          'X-Requested-With': 'XMLHttpRequest'\r\n        };\r\n\r\n        // 如果有认证Token，添加到请求头\r\n        if (this.authToken.trim()) {\r\n          // 自动补充Bearer前缀（如果用户没输入）\r\n          headers['Authorization'] = this.authToken.startsWith('Bearer ') \r\n            ? this.authToken \r\n            : `Bearer ${this.authToken}`;\r\n        } else {\r\n          this.authTip = '未提供认证Token，可能导致请求失败。请输入有效的登录Token后重试。';\r\n        }\r\n\r\n        // 设置请求超时\r\n        const controller = new AbortController();\r\n        const timeoutId = setTimeout(() => controller.abort(), 30000);\r\n\r\n        // 发送请求\r\n        const response = await fetch(this.apiEndpoint, {\r\n          method: 'POST',\r\n          headers: headers,\r\n          body: JSON.stringify(requestData),\r\n          signal: controller.signal,\r\n          credentials: 'include' // 允许携带Cookie（如果后端用Session认证）\r\n        });\r\n\r\n        clearTimeout(timeoutId);\r\n\r\n        // 读取响应内容\r\n        const responseText = await response.text();\r\n        let responseData;\r\n\r\n        try {\r\n          responseData = JSON.parse(responseText);\r\n        } catch (e) {\r\n          throw new Error(`后端返回无效格式: ${responseText.substring(0, 200)}`);\r\n        }\r\n\r\n        // 处理后端响应\r\n        if (responseData.code === 200) {\r\n          if (responseData.data && responseData.data.length > 0 && responseData.data[0].url) {\r\n            this.resultUrl = responseData.data[0].url;\r\n          } else {\r\n            throw new Error('后端未返回有效图片URL');\r\n          }\r\n        } else if (responseData.code === 400) {\r\n          // 专门处理身份认证异常\r\n          if (responseData.msg.includes('身份认证异常') || responseData.msg.includes('登录')) {\r\n            this.authTip = '请先登录系统获取有效Token，或联系管理员开放接口访问权限。';\r\n          }\r\n          throw new Error(`请求错误: ${responseData.msg}`);\r\n        } else {\r\n          throw new Error(`请求失败: ${responseData.msg || '未知错误'}`);\r\n        }\r\n\r\n      } catch (error) {\r\n        console.error('生成失败:', error);\r\n        \r\n        // 错误分类处理\r\n        if (error.name === 'AbortError') {\r\n          this.errorMessage = '请求超时';\r\n          this.errorDetails = '服务器响应时间超过30秒，请重试';\r\n        } else if (error.message.includes('Failed to fetch')) {\r\n          this.errorMessage = '无法连接到后端服务器';\r\n          this.errorDetails = '请检查后端服务是否已启动，或网络是否正常';\r\n        } else {\r\n          this.errorMessage = '生成图片失败';\r\n          this.errorDetails = error.message;\r\n        }\r\n      } finally {\r\n        this.isLoading = false;\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n"],"sourceRoot":"src/views/user"}]}