AAA,cAAA,EAAA,aANA;AAOA,UAAA,IAAA,EAAA,UAPA;AAQA,UAAA,SAAA,EAAA;AARA,SAAA,CAJA,CAeA;;AACA,cAAA,QAAA,GAAA,MAAA,KAAA,CAAA,IAAA,CACA,KAAA,WAAA,CAAA,MADA,EAEA,WAFA,EAGA;AACA,UAAA,OAAA,EAAA;AACA,4BAAA,kBADA;AAEA,6BAAA,UAAA,KAAA,WAAA,CAAA,MAAA,EAFA;AAEA;AACA,2BAAA,IAAA,IAAA,GAAA,OAAA,GAAA,QAAA,EAHA,CAGA;;AAHA;AADA,SAHA,CAAA,CAhBA,CA4BA;;AACA,YAAA,QAAA,CAAA,IAAA,IAAA,QAAA,CAAA,IAAA,CAAA,IAAA,IAAA,QAAA,CAAA,IAAA,CAAA,IAAA,CAAA,MAAA,GAAA,CAAA,EAAA;AACA,gBAAA,QAAA,GAAA,QAAA,CAAA,IAAA,CAAA,IAAA,CAAA,CAAA,EAAA,GAAA;AACA,eAAA,KAAA,CAAA,iBAAA,EAAA;AACA,YAAA,IAAA,EAAA,GADA;AAEA,YAAA,IAAA,EAAA;AAAA,cAAA,QAAA,EAAA;AAAA,aAFA;AAGA,YAAA,GAAA,EAAA;AAHA,WAAA;AAKA,SAPA,MAOA;AACA,gBAAA,IAAA,KAAA,CAAA,YAAA,CAAA;AACA;AAEA,OAxCA,CAwCA,OAAA,KAAA,EAAA;AACA;AACA,YAAA,QAAA,GAAA,UAAA;;AACA,YAAA,KAAA,CAAA,QAAA,EAAA;AAAA;;AACA;AACA,UAAA,QAAA,GAAA,SAAA,yBAAA,KAAA,CAAA,QAAA,CAAA,IAAA,8EAAA,GAAA,KAAA,KAAA,CAAA,QAAA,CAAA,UAAA,EAAA;AACA,SAHA,MAGA,IAAA,KAAA,CAAA,OAAA,EAAA;AACA,UAAA,QAAA,GAAA,KAAA,CAAA,OAAA;AACA;;AACA,aAAA,KAAA,CAAA,eAAA,EAAA;AACA,UAAA,IAAA,EAAA,GADA;AAEA,UAAA,GAAA,EAAA;AAFA,SAAA;AAIA,OArDA,SAqDA;AACA,aAAA,SAAA,GAAA,KAAA;AACA;AACA;;AA5DA;AA3BA,CAAA","sourcesContent":["<template>\r\n  <!-- 该组件无需UI，仅作为逻辑封装，通过props接收参数，事件返回结果 -->\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'DirectModelCall',\r\n  props: {\r\n    // 接收生成图片所需的参数\r\n    generateParams: {\r\n      type: Object,\r\n      required: true,\r\n      default: () => ({\r\n        prompt: '',\r\n        image: '',\r\n        model: 'doubao-seededit-3-0-i2i-250628',\r\n        seed: 123,\r\n        guidanceScale: 5.5\r\n      })\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      // 模型接口配置（注意：生产环境不建议在此硬编码密钥）\r\n      modelConfig: {\r\n        apiUrl: 'https://ark.cn-beijing.volces.com/api/v3/images/generations', // 火山引擎图片生成接口\r\n        apiKey: 'f2390958-8c5a-424a-9021-651e920c2bc4', \r\n        model: 'doubao-seededit-3-0-i2i-250628'\r\n      },\r\n      isLoading: false\r\n    };\r\n  },\r\n  methods: {\r\n    // 核心方法：直接调用模型接口生成图片\r\n    async callModel() {\r\n      this.isLoading = true;\r\n      try {\r\n        const { prompt, image, model, seed, guidanceScale } = this.generateParams;\r\n        \r\n        // 1. 构建请求参数（按第三方API要求格式）\r\n        const requestData = {\r\n          model: model,\r\n          prompt: prompt,\r\n          image: image, // 图片URL（需为公网可访问地址）\r\n          response_format: 'url',\r\n          seed: seed,\r\n          guidance_scale: guidanceScale,\r\n          size: 'adaptive',\r\n          watermark: true\r\n        };\r\n\r\n        // 2. 调用第三方API（直接前端请求）\r\n        const response = await axios.post(\r\n          this.modelConfig.apiUrl,\r\n          requestData,\r\n          {\r\n            headers: {\r\n              'Content-Type': 'application/json',\r\n              'Authorization': `Bearer ${this.modelConfig.apiKey}`, // 按第三方要求传递密钥\r\n              'X-Timestamp': new Date().getTime().toString() // 部分API需要时间戳\r\n            }\r\n          }\r\n        );\r\n\r\n        // 3. 处理成功响应（根据第三方返回格式调整）\r\n        if (response.data && response.data.data && response.data.data.length > 0) {\r\n          const imageUrl = response.data.data[0].url;\r\n          this.$emit('generateSuccess', {\r\n            code: 200,\r\n            data: { imageUrl: imageUrl },\r\n            msg: '生成成功'\r\n          });\r\n        } else {\r\n          throw new Error('模型返回数据格式异常');\r\n        }\r\n\r\n      } catch (error) {\r\n        // 4. 处理错误（网络错误、API错误等）\r\n        let errorMsg = '生成失败，请重试';\r\n        if (error.response) {\r\n          // 第三方API返回的错误（如密钥无效、参数错误）\r\n          errorMsg = `API错误：${error.response.data?.msg || error.response.statusText}`;\r\n        } else if (error.message) {\r\n          errorMsg = error.message;\r\n        }\r\n        this.$emit('generateError', {\r\n          code: 500,\r\n          msg: errorMsg\r\n        });\r\n      } finally {\r\n        this.isLoading = false;\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>"],"sourceRoot":"src/components"}]}