AA;AALa,CAAf","sourcesContent":["// 存储用户信息、登录状态、用户ID等\r\nconst state = {\r\n  userInfo: null, // 完整用户信息（包含id、角色等）\r\n  token: ''       // 登录令牌\r\n};\r\n\r\nconst mutations = {\r\n  // 保存用户信息（登录时调用）\r\n  SAVE_USER_INFO(state, data) {\r\n    state.userInfo = data; // data需包含id、role等字段\r\n    state.token = data.token;\r\n  },\r\n  // 清除用户信息（登出时调用）\r\n  CLEAR_USER_INFO(state) {\r\n    state.userInfo = null;\r\n    state.token = '';\r\n  }\r\n};\r\n\r\nconst actions = {\r\n  // 登录成功后保存用户信息\r\n  login({ commit }, userData) {\r\n    commit('SAVE_USER_INFO', userData);\r\n  },\r\n  // 登出\r\n  logout({ commit }) {\r\n    commit('CLEAR_USER_INFO');\r\n  }\r\n};\r\n\r\nconst getters = {\r\n  // 获取用户ID\r\n  userId: (state) => state.userInfo?.id || null,\r\n  // 判断是否登录\r\n  isLoggedIn: (state) => !!state.token,\r\n  // 获取用户角色\r\n  userRole: (state) => state.userInfo?.role || null\r\n};\r\n\r\nexport default {\r\n  namespaced: true, // 开启命名空间，避免模块间命名冲突\r\n  state,\r\n  mutations,\r\n  actions,\r\n  getters\r\n};"]}]}