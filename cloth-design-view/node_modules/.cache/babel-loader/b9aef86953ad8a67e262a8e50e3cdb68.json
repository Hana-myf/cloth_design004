{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js!D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js??ref--0-0!D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\views\\admin\\FabricManage.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\views\\admin\\FabricManage.vue","mtime":1753951514271},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":1759332253502},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":1759332273371}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["FabricManage.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA2NA,eAAA;AACA,EAAA,IAAA,GAAA;AACA,WAAA;AACA;AACA,MAAA,SAAA,EAAA,EAFA;AAGA,MAAA,UAAA,EAAA,CAHA;AAIA,MAAA,WAAA,EAAA,CAJA;AAKA,MAAA,QAAA,EAAA,EALA;AAOA;AACA,MAAA,cAAA,EAAA;AACA,QAAA,IAAA,EAAA,EADA;AAEA,QAAA,IAAA,EAAA;AAFA,OARA;AAaA;AACA,MAAA,WAAA,EAAA,CAAA,GAAA,EAAA,IAAA,EAAA,IAAA,EAAA,IAAA,EAAA,IAAA,EAAA,IAAA,CAdA;AAgBA;AACA,MAAA,aAAA,EAAA,KAjBA;AAkBA,MAAA,MAAA,EAAA,KAlBA;AAoBA;AACA,MAAA,QAAA,EAAA;AACA,QAAA,EAAA,EAAA,IADA;AAEA,QAAA,IAAA,EAAA,EAFA;AAGA,QAAA,IAAA,EAAA,EAHA;AAIA,QAAA,QAAA,EAAA,EAJA;AAKA,QAAA,WAAA,EAAA;AALA,OArBA;AA6BA;AACA,MAAA,UAAA,EAAA,EA9BA;AA+BA,MAAA,SAAA,EAAA,EA/BA;AAgCA,MAAA,SAAA,EAAA,EAhCA;AAkCA;AACA,MAAA,YAAA,EAAA;AAnCA,KAAA;AAqCA,GAvCA;;AAwCA,EAAA,OAAA,GAAA;AACA,SAAA,eAAA;AACA,GA1CA;;AA2CA,EAAA,OAAA,EAAA;AACA;AACA,UAAA,eAAA,GAAA;AACA,UAAA;AACA,cAAA,MAAA,GAAA;AACA,UAAA,OAAA,EAAA,KAAA,WADA;AAEA,UAAA,IAAA,EAAA,KAAA,QAFA;AAGA,UAAA,IAAA,EAAA,KAAA,cAAA,CAAA,IAHA;AAIA,UAAA,IAAA,EAAA,KAAA,cAAA,CAAA;AAJA,SAAA;AAMA,cAAA,QAAA,GAAA,MAAA,KAAA,MAAA,CAAA,IAAA,CAAA,eAAA,EAAA,MAAA,CAAA;;AACA,YAAA,QAAA,CAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,eAAA,SAAA,GAAA,QAAA,CAAA,IAAA,CAAA,IAAA,CAAA,UAAA;AACA,eAAA,UAAA,GAAA,QAAA,CAAA,IAAA,CAAA,IAAA,CAAA,UAAA;AACA;AACA,OAZA,CAYA,OAAA,KAAA,EAAA;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,WAAA,EAAA,KAAA;AACA,aAAA,QAAA,CAAA,KAAA,CAAA,UAAA;AACA;AACA,KAnBA;;AAqBA;AACA,IAAA,GAAA,GAAA;AACA,WAAA,MAAA,GAAA,KAAA;AACA,WAAA,QAAA,GAAA;AACA,QAAA,EAAA,EAAA,IADA;AAEA,QAAA,IAAA,EAAA,EAFA;AAGA,QAAA,IAAA,EAAA,EAHA;AAIA,QAAA,QAAA,EAAA,EAJA;AAKA,QAAA,WAAA,EAAA;AALA,OAAA;AAOA,WAAA,eAAA;AACA,WAAA,aAAA,GAAA,IAAA;AACA,KAjCA;;AAmCA;AACA,IAAA,UAAA,CAAA,GAAA,EAAA;AACA,WAAA,MAAA,GAAA,IAAA;AACA,WAAA,QAAA,GAAA,EAAA,GAAA;AAAA,OAAA;AACA,WAAA,eAAA;AACA,WAAA,aAAA,GAAA,IAAA;AACA,KAzCA;;AA2CA;AACA,UAAA,YAAA,CAAA,GAAA,EAAA;AACA,YAAA,SAAA,GAAA,MAAA,KAAA,YAAA,CAAA;AACA,QAAA,KAAA,EAAA,MADA;AAEA,QAAA,IAAA,EAAA,WAAA,GAAA,CAAA,IAAA,KAFA;AAGA,QAAA,IAAA,EAAA;AAHA,OAAA,CAAA;;AAKA,UAAA,SAAA,EAAA;AACA,YAAA;AACA,gBAAA,QAAA,GAAA,MAAA,KAAA,MAAA,CAAA,IAAA,CAAA,kBAAA,GAAA,CAAA,EAAA,EAAA,CAAA;;AACA,cAAA,QAAA,CAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,iBAAA,QAAA,CAAA,OAAA,CAAA,MAAA;AACA,iBAAA,eAAA;AACA,WAHA,MAGA;AACA,iBAAA,QAAA,CAAA,KAAA,CAAA,MAAA;AACA;AACA,SARA,CAQA,OAAA,KAAA,EAAA;AACA,UAAA,OAAA,CAAA,KAAA,CAAA,SAAA,EAAA,KAAA;AACA,eAAA,QAAA,CAAA,KAAA,CAAA,UAAA;AACA;AACA;AACA,KAhEA;;AAkEA;AACA,UAAA,UAAA,GAAA;AACA,UAAA,CAAA,KAAA,YAAA,EAAA,EAAA;;AAEA,UAAA;AACA,YAAA,QAAA;;AACA,YAAA,KAAA,MAAA,EAAA;AACA;AACA,UAAA,QAAA,GAAA,MAAA,KAAA,MAAA,CAAA,IAAA,CAAA,gBAAA,EAAA,KAAA,QAAA,CAAA;AACA,SAHA,MAGA;AACA;AACA,UAAA,QAAA,GAAA,MAAA,KAAA,MAAA,CAAA,IAAA,CAAA,cAAA,EAAA,KAAA,QAAA,CAAA;AACA;;AAEA,YAAA,QAAA,CAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,eAAA,QAAA,CAAA,OAAA,CAAA,KAAA,MAAA,GAAA,MAAA,GAAA,MAAA;AACA,eAAA,aAAA,GAAA,KAAA;AACA,eAAA,eAAA;AACA,SAJA,MAIA;AACA,eAAA,QAAA,CAAA,KAAA,CAAA,QAAA,CAAA,IAAA,CAAA,GAAA,KAAA,KAAA,MAAA,GAAA,MAAA,GAAA,MAAA,CAAA;AACA;AACA,OAjBA,CAiBA,OAAA,KAAA,EAAA;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,WAAA,EAAA,KAAA;AACA,aAAA,QAAA,CAAA,KAAA,CAAA,UAAA;AACA;AACA,KA3FA;;AA6FA;AACA,IAAA,YAAA,GAAA;AACA,UAAA,OAAA,GAAA,IAAA;AACA,WAAA,eAAA,GAFA,CAIA;;AACA,UAAA,CAAA,KAAA,QAAA,CAAA,QAAA,EAAA;AACA,aAAA,UAAA,GAAA,SAAA;AACA,QAAA,OAAA,GAAA,KAAA;AACA,OARA,CAUA;;;AACA,UAAA,CAAA,KAAA,QAAA,CAAA,IAAA,IAAA,KAAA,QAAA,CAAA,IAAA,CAAA,IAAA,OAAA,EAAA,EAAA;AACA,aAAA,SAAA,GAAA,SAAA;AACA,QAAA,OAAA,GAAA,KAAA;AACA,OAdA,CAgBA;;;AACA,UAAA,CAAA,KAAA,QAAA,CAAA,IAAA,EAAA;AACA,aAAA,SAAA,GAAA,SAAA;AACA,QAAA,OAAA,GAAA,KAAA;AACA;;AAEA,aAAA,OAAA;AACA,KArHA;;AAuHA;AACA,IAAA,eAAA,GAAA;AACA,WAAA,UAAA,GAAA,EAAA;AACA,WAAA,SAAA,GAAA,EAAA;AACA,WAAA,SAAA,GAAA,EAAA;AACA,KA5HA;;AA8HA;AACA,IAAA,wBAAA,CAAA,GAAA,EAAA;AACA,UAAA,GAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,aAAA,QAAA,CAAA,QAAA,GAAA,GAAA,CAAA,IAAA;AACA,aAAA,UAAA,GAAA,EAAA;AACA,aAAA,QAAA,CAAA,OAAA,CAAA,QAAA;AACA,OAJA,MAIA;AACA,aAAA,UAAA,GAAA,YAAA;AACA;AACA,KAvIA;;AAyIA;AACA,IAAA,sBAAA,GAAA;AACA,WAAA,UAAA,GAAA,YAAA;AACA,KA5IA;;AA8IA;AACA,IAAA,iBAAA,CAAA,IAAA,EAAA;AACA,YAAA,OAAA,GAAA,IAAA,CAAA,IAAA,CAAA,UAAA,CAAA,QAAA,CAAA;AACA,YAAA,MAAA,GAAA,IAAA,CAAA,IAAA,GAAA,IAAA,GAAA,IAAA,GAAA,CAAA;;AAEA,UAAA,CAAA,OAAA,EAAA;AACA,aAAA,QAAA,CAAA,KAAA,CAAA,UAAA;AACA,eAAA,KAAA;AACA;;AACA,UAAA,CAAA,MAAA,EAAA;AACA,aAAA,QAAA,CAAA,KAAA,CAAA,aAAA;AACA,eAAA,KAAA;AACA;;AACA,aAAA,IAAA;AACA,KA5JA;;AA8JA;AACA,IAAA,YAAA,GAAA;AACA,WAAA,WAAA,GAAA,CAAA;AACA,WAAA,eAAA;AACA,KAlKA;;AAmKA,IAAA,iBAAA,GAAA;AACA,WAAA,cAAA,GAAA;AAAA,QAAA,IAAA,EAAA,EAAA;AAAA,QAAA,IAAA,EAAA;AAAA,OAAA;AACA,WAAA,eAAA;AACA,KAtKA;;AAuKA,IAAA,gBAAA,GAAA;AACA,WAAA,eAAA;AACA,KAzKA;;AA2KA,IAAA,gBAAA,CAAA,GAAA,EAAA;AACA,WAAA,QAAA,GAAA,GAAA;AACA,WAAA,WAAA,GAAA,CAAA,CAFA,CAEA;;AACA,WAAA,eAAA;AACA,KA/KA;;AAgLA,IAAA,mBAAA,CAAA,GAAA,EAAA;AACA;AACA,WAAA,WAAA,GAAA,IAAA,CAAA,GAAA,CAAA,GAAA,EAAA,CAAA,CAAA;AACA,WAAA,eAAA;AACA,KApLA;;AAqLA;AACA,IAAA,qBAAA,CAAA,SAAA,EAAA;AACA,WAAA,YAAA,GAAA,SAAA;AACA;;AAxLA;AA3CA,CAAA","sourcesContent":["<template>\r\n  <el-row style=\"background-color: #FFFFFF;padding: 5px 0;border-radius: 5px;\">\r\n    <!-- 筛选区域 -->\r\n    <el-row style=\"padding: 10px;margin-left: 10px;\">\r\n      <el-row>\r\n        <!-- 面料类型筛选 -->\r\n        <el-select\r\n          @change=\"handleTypeChange\"\r\n          size=\"small\"\r\n          v-model=\"fabricQueryDto.type\"\r\n          placeholder=\"面料类型\"\r\n        >\r\n          <el-option\r\n            v-for=\"type in fabricTypes\"\r\n            :key=\"type\"\r\n            :label=\"type\"\r\n            :value=\"type\"\r\n          >\r\n          </el-option>\r\n        </el-select>\r\n        \r\n        <!-- 名称搜索 -->\r\n        <el-input\r\n          size=\"small\"\r\n          style=\"width: 188px;margin-left: 5px;margin-right: 6px;\"\r\n          v-model=\"fabricQueryDto.name\"\r\n          placeholder=\"面料名称\"\r\n          clearable\r\n          @clear=\"handleFilterClear\"\r\n        >\r\n          <el-button\r\n            slot=\"append\"\r\n            @click=\"handleFilter\"\r\n            icon=\"el-icon-search\"\r\n          ></el-button>\r\n        </el-input>\r\n        \r\n        <!-- 新增按钮 -->\r\n        <span style=\"float: right;\">\r\n          <el-button\r\n            size=\"small\"\r\n            style=\"background-color: rgb(96, 98, 102);color: rgb(247,248,249);border: none;\"\r\n            class=\"customer\"\r\n            type=\"info\"\r\n            @click=\"add\"\r\n            ><i class=\"el-icon-plus\"></i>新增面料</el-button\r\n          >\r\n        </span>\r\n      </el-row>\r\n    </el-row>\r\n\r\n    <!-- 列表区域 -->\r\n    <el-row style=\"margin: 0 20px;border-top: 1px solid rgb(245,245,245);\">\r\n      <el-table\r\n        row-key=\"id\"\r\n        @selection-change=\"handleSelectionChange\"\r\n        :data=\"tableData\"\r\n        style=\"width: 100%\"\r\n      >\r\n        <!-- 面料图片 -->\r\n        <el-table-column prop=\"imageUrl\" width=\"100\" label=\"面料图片\">\r\n          <template slot-scope=\"scope\">\r\n            <img\r\n              :src=\"scope.row.imageUrl\"\r\n              style=\"width: 60px;height: 40px;border-radius: 5px;object-fit: cover;\"\r\n            />\r\n          </template>\r\n        </el-table-column>\r\n        \r\n        <!-- 面料名称 -->\r\n        <el-table-column prop=\"name\" label=\"面料名称\" width=\"180\"></el-table-column>\r\n        \r\n        <!-- 面料类型 -->\r\n        <el-table-column prop=\"type\" label=\"面料类型\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            <span class=\"type-tag\">{{ scope.row.type }}</span>\r\n          </template>\r\n        </el-table-column>\r\n        \r\n        <!-- 创建时间 -->\r\n        <el-table-column prop=\"createTime\" label=\"创建时间\" width=\"160\"></el-table-column>\r\n        \r\n        <!-- 描述 -->\r\n        <el-table-column prop=\"description\" label=\"描述\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tooltip :content=\"scope.row.description\" placement=\"top\">\r\n              <div class=\"description-text\">{{ scope.row.description }}</div>\r\n            </el-tooltip>\r\n          </template>\r\n        </el-table-column>\r\n        \r\n        <!-- 操作按钮 -->\r\n        <el-table-column label=\"操作\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            <span class=\"text-button\" @click=\"handleEdit(scope.row)\">编辑</span>\r\n            <span class=\"text-button\" @click=\"handleDelete(scope.row)\"\r\n              >删除</span\r\n            >\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <!-- 分页控件 -->\r\n      <el-pagination\r\n        style=\"margin: 20px 0;\"\r\n        @size-change=\"handleSizeChange\"\r\n        @current-change=\"handleCurrentChange\"\r\n        :current-page=\"currentPage\"\r\n        :page-sizes=\"[10, 20]\"\r\n        :page-size=\"pageSize\"\r\n        layout=\"total, sizes, prev, pager, next, jumper\"\r\n        :total=\"totalItems\"\r\n      ></el-pagination>\r\n    </el-row>\r\n\r\n    <!-- 新增/编辑弹窗 -->\r\n    <el-dialog\r\n      :show-close=\"false\"\r\n      :visible.sync=\"dialogVisible\"\r\n      width=\"50%\"\r\n    >\r\n      <div slot=\"title\">\r\n        <p class=\"dialog-title\">{{ !isEdit ? \"新增面料\" : \"修改面料\" }}</p>\r\n      </div>\r\n      \r\n      <div style=\"padding:0 20px;\">\r\n        <!-- 面料图片上传 -->\r\n        <el-row style=\"margin-top: 10px;\">\r\n          <p>*面料图片 <span style=\"color:red\" v-if=\"imageError\">{{ imageError }}</span></p>\r\n          <el-upload\r\n  class=\"avatar-uploader\"\r\n  action=\"/api/personal-heath/v1.0/file/upload\"\r\n  :show-file-list=\"false\"\r\n  :on-success=\"handleImageUploadSuccess\"\r\n  :on-error=\"handleImageUploadError\"\r\n  :before-upload=\"beforeImageUpload\"\r\n >\r\n            <img\r\n              v-if=\"formData.imageUrl\"\r\n              :src=\"formData.imageUrl\"\r\n              style=\"height: 180px;width: 240px;object-fit: cover;border-radius: 4px;\"\r\n            />\r\n            <div v-else class=\"upload-placeholder\">\r\n              <i class=\"el-icon-plus avatar-uploader-icon\"></i>\r\n              <p>点击上传面料图片</p>\r\n            </div>\r\n          </el-upload>\r\n        </el-row>\r\n        \r\n        <!-- 面料名称 -->\r\n        <el-row style=\"margin-top: 20px;\">\r\n          <p>*面料名称 <span style=\"color:red\" v-if=\"nameError\">{{ nameError }}</span></p>\r\n          <el-input\r\n            v-model=\"formData.name\"\r\n            placeholder=\"请输入面料名称\"\r\n            clearable\r\n          ></el-input>\r\n        </el-row>\r\n        \r\n        <!-- 面料类型 -->\r\n        <el-row style=\"margin-top: 20px;\">\r\n          <p>*面料类型 <span style=\"color:red\" v-if=\"typeError\">{{ typeError }}</span></p>\r\n          <el-select\r\n            v-model=\"formData.type\"\r\n            placeholder=\"请选择面料类型\"\r\n          >\r\n            <el-option\r\n              v-for=\"type in fabricTypes\"\r\n              :key=\"type\"\r\n              :label=\"type\"\r\n              :value=\"type\"\r\n            ></el-option>\r\n          </el-select>\r\n        </el-row>\r\n        \r\n        <!-- 面料描述 -->\r\n        <el-row style=\"margin-top: 20px;\">\r\n          <p>面料描述 <span style=\"color:#999\">(选填)</span></p>\r\n          <el-input\r\n            v-model=\"formData.description\"\r\n            placeholder=\"请输入面料描述信息\"\r\n            type=\"textarea\"\r\n            :rows=\"4\"\r\n          ></el-input>\r\n        </el-row>\r\n      </div>\r\n      \r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button\r\n          size=\"small\"\r\n          v-if=\"!isEdit\"\r\n          style=\"background-color: rgb(96, 98, 102);color: rgb(247,248,249);border: none;\"\r\n          class=\"customer\"\r\n          type=\"info\"\r\n          @click=\"submitForm\"\r\n          >保存</el-button\r\n        >\r\n        <el-button\r\n          size=\"small\"\r\n          v-else\r\n          style=\"background-color: rgb(96, 98, 102);color: rgb(247,248,249);border: none;\"\r\n          class=\"customer\"\r\n          type=\"info\"\r\n          @click=\"submitForm\"\r\n          >更新</el-button\r\n        >\r\n        <el-button\r\n          class=\"customer\"\r\n          size=\"small\"\r\n          style=\"background-color: rgb(241, 241, 241);border: none;\"\r\n          @click=\"dialogVisible = false\"\r\n          >取消</el-button\r\n        >\r\n      </span>\r\n    </el-dialog>\r\n  </el-row>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      // 表格数据\r\n      tableData: [],\r\n      totalItems: 0,\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n      \r\n      // 查询条件\r\n      fabricQueryDto: {\r\n        name: '',\r\n        type: ''\r\n      },\r\n      \r\n      // 面料类型列表（可从接口加载）\r\n      fabricTypes: ['棉', '羊毛', '丝绸', '亚麻', '化纤', '混纺'],\r\n      \r\n      // 弹窗状态\r\n      dialogVisible: false,\r\n      isEdit: false,\r\n      \r\n      // 表单数据\r\n      formData: {\r\n        id: null,\r\n        name: '',\r\n        type: '',\r\n        imageUrl: '',\r\n        description: ''\r\n      },\r\n      \r\n      // 表单验证错误\r\n      imageError: '',\r\n      nameError: '',\r\n      typeError: '',\r\n      \r\n      // 选中的行\r\n      selectedRows: []\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchFabricList();\r\n  },\r\n  methods: {\r\n    // 获取面料列表\r\n    async fetchFabricList() {\r\n      try {\r\n        const params = {\r\n          current: this.currentPage,\r\n          size: this.pageSize,\r\n          name: this.fabricQueryDto.name,\r\n          type: this.fabricQueryDto.type\r\n        };\r\n        const response = await this.$axios.post('/fabric/query', params);\r\n        if (response.data.code === 200) {\r\n          this.tableData = response.data.data.fabricList;\r\n          this.totalItems = response.data.data.totalCount;\r\n        }\r\n      } catch (error) {\r\n        console.error('获取面料列表失败:', error);\r\n        this.$message.error('加载面料数据失败');\r\n      }\r\n    },\r\n    \r\n    // 新增按钮点击\r\n    add() {\r\n      this.isEdit = false;\r\n      this.formData = {\r\n        id: null,\r\n        name: '',\r\n        type: '',\r\n        imageUrl: '',\r\n        description: ''\r\n      };\r\n      this.clearFormErrors();\r\n      this.dialogVisible = true;\r\n    },\r\n    \r\n    // 编辑按钮点击\r\n    handleEdit(row) {\r\n      this.isEdit = true;\r\n      this.formData = { ...row };\r\n      this.clearFormErrors();\r\n      this.dialogVisible = true;\r\n    },\r\n    \r\n    // 删除按钮点击\r\n    async handleDelete(row) {\r\n      const confirmed = await this.$swalConfirm({\r\n        title: '确认删除',\r\n        text: `确定要删除面料\"${row.name}\"吗？`,\r\n        icon: 'warning'\r\n      });\r\n      if (confirmed) {\r\n        try {\r\n          const response = await this.$axios.post(`/fabric/delete/${row.id}`);\r\n          if (response.data.code === 200) {\r\n            this.$message.success('删除成功');\r\n            this.fetchFabricList();\r\n          } else {\r\n            this.$message.error('删除失败');\r\n          }\r\n        } catch (error) {\r\n          console.error('删除面料失败:', error);\r\n          this.$message.error('删除失败，请重试');\r\n        }\r\n      }\r\n    },\r\n    \r\n    // 表单提交\r\n    async submitForm() {\r\n      if (!this.validateForm()) return;\r\n      \r\n      try {\r\n        let response;\r\n        if (this.isEdit) {\r\n          // 修改操作\r\n          response = await this.$axios.post('/fabric/update', this.formData);\r\n        } else {\r\n          // 新增操作\r\n          response = await this.$axios.post('/fabric/save', this.formData);\r\n        }\r\n        \r\n        if (response.data.code === 200) {\r\n          this.$message.success(this.isEdit ? '更新成功' : '新增成功');\r\n          this.dialogVisible = false;\r\n          this.fetchFabricList();\r\n        } else {\r\n          this.$message.error(response.data.msg || (this.isEdit ? '更新失败' : '新增失败'));\r\n        }\r\n      } catch (error) {\r\n        console.error('提交面料数据失败:', error);\r\n        this.$message.error('操作失败，请重试');\r\n      }\r\n    },\r\n    \r\n    // 表单验证\r\n    validateForm() {\r\n      let isValid = true;\r\n      this.clearFormErrors();\r\n      \r\n      // 验证图片\r\n      if (!this.formData.imageUrl) {\r\n        this.imageError = '请上传面料图片';\r\n        isValid = false;\r\n      }\r\n      \r\n      // 验证名称\r\n      if (!this.formData.name || this.formData.name.trim() === '') {\r\n        this.nameError = '请输入面料名称';\r\n        isValid = false;\r\n      }\r\n      \r\n      // 验证类型\r\n      if (!this.formData.type) {\r\n        this.typeError = '请选择面料类型';\r\n        isValid = false;\r\n      }\r\n      \r\n      return isValid;\r\n    },\r\n    \r\n    // 清空表单错误\r\n    clearFormErrors() {\r\n      this.imageError = '';\r\n      this.nameError = '';\r\n      this.typeError = '';\r\n    },\r\n    \r\n    // 图片上传成功\r\n    handleImageUploadSuccess(res) {\r\n      if (res.code === 200) {\r\n        this.formData.imageUrl = res.data;\r\n        this.imageError = '';\r\n        this.$message.success('图片上传成功');\r\n      } else {\r\n        this.imageError = '图片上传失败，请重试';\r\n      }\r\n    },\r\n    \r\n    // 图片上传失败\r\n    handleImageUploadError() {\r\n      this.imageError = '图片上传失败，请重试';\r\n    },\r\n    \r\n    // 上传前校验\r\n    beforeImageUpload(file) {\r\n      const isImage = file.type.startsWith('image/');\r\n      const isLt2M = file.size / 1024 / 1024 < 2;\r\n      \r\n      if (!isImage) {\r\n        this.$message.error('只能上传图片文件');\r\n        return false;\r\n      }\r\n      if (!isLt2M) {\r\n        this.$message.error('图片大小不能超过2MB');\r\n        return false;\r\n      }\r\n      return true;\r\n    },\r\n    \r\n    // 筛选相关方法\r\n    handleFilter() {\r\n      this.currentPage = 1;\r\n      this.fetchFabricList();\r\n    },\r\n    handleFilterClear() {\r\n      this.fabricQueryDto = { name: '', type: '' };\r\n      this.fetchFabricList();\r\n    },\r\n    handleTypeChange() {\r\n      this.fetchFabricList();\r\n    },\r\n    \r\n    handleSizeChange(val) {\r\n  this.pageSize = val;\r\n  this.currentPage = 1; // 切换每页条数时，重置为第一页\r\n  this.fetchFabricList();\r\n  },\r\n  handleCurrentChange(val) {\r\n  // 确保页码不小于1\r\n  this.currentPage = Math.max(val, 1); \r\n  this.fetchFabricList();\r\n  },\r\n    // 选择行变化\r\n    handleSelectionChange(selection) {\r\n      this.selectedRows = selection;\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n/* 类型标签样式 */\r\n.type-tag {\r\n  display: inline-block;\r\n  padding: 2px 8px;\r\n  border-radius: 4px;\r\n  background-color: #f0f7ff;\r\n  color: #1890ff;\r\n  font-size: 12px;\r\n}\r\n\r\n/* 描述文本样式 */\r\n.description-text {\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  max-width: 300px;\r\n}\r\n\r\n/* 上传占位样式 */\r\n.upload-placeholder {\r\n  width: 240px;\r\n  height: 180px;\r\n  border: 1px dashed #ddd;\r\n  border-radius: 4px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #999;\r\n}\r\n\r\n.avatar-uploader-icon {\r\n  font-size: 28px;\r\n  color: #8c939d;\r\n}\r\n\r\n.upload-placeholder p {\r\n  margin-top: 10px;\r\n  font-size: 14px;\r\n}\r\n\r\n/* 复用资讯管理的样式 */\r\n.dialog-footer {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.customer {\r\n  margin: 0 8px;\r\n}\r\n\r\n.text-button {\r\n  margin: 0 5px;\r\n  color: #409eff;\r\n  cursor: pointer;\r\n}\r\n\r\n.text-button:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.dialog-title {\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #333;\r\n}\r\n</style>"],"sourceRoot":"src/views/admin"}]}