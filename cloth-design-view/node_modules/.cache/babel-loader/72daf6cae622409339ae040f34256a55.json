AAA,IAAA,CAZA,CAcA;;AACA,YAAA,UAAA,GAAA,KAAA,QAAA,CAAA,IAAA,CAAA;AACA,QAAA,OAAA,EAAA,EADA;AAEA,QAAA,MAAA,EAAA,KAFA;AAGA,QAAA,MAAA,EAAA;AAHA,OAAA,IAIA,CAJA;;AAMA,UAAA;AACA;AACA,cAAA,QAAA,GAAA,MAAA,KAAA,CAAA,KAAA,MAAA,EAAA;AACA,UAAA,MAAA,EAAA,MADA;AAEA,UAAA,OAAA,EAAA;AACA,4BAAA,kBADA;AAEA,6BAAA,UAAA,KAAA,MAAA;AAFA,WAFA;AAMA,UAAA,IAAA,EAAA,IAAA,CAAA,SAAA,CAAA;AACA,YAAA,MAAA,EAAA,KAAA,OADA;AAEA,YAAA,OAAA,EAAA,KAAA,MAFA;AAGA,YAAA,MAAA,EAAA,IAHA;AAGA;AACA,YAAA,iBAAA,EAAA,IAJA;AAKA,YAAA,mBAAA,EAAA,CACA;AACA,cAAA,IAAA,EAAA,MADA;AAEA,cAAA,OAAA,EAAA,WAFA;AAGA,cAAA,YAAA,EAAA;AAHA,aADA;AALA,WAAA;AANA,SAAA,CAAA;AAqBA,YAAA,CAAA,QAAA,CAAA,EAAA,EAAA,MAAA,IAAA,KAAA,CAAA,SAAA,QAAA,CAAA,MAAA,EAAA,CAAA;AAEA,cAAA,MAAA,GAAA,QAAA,CAAA,IAAA,CAAA,SAAA,EAAA;AACA,cAAA,OAAA,GAAA,IAAA,WAAA,EAAA;AACA,YAAA,SAAA,GAAA,EAAA;AACA,YAAA,YAAA,GAAA,IAAA,CA5BA,CA8BA;;AACA,eAAA,IAAA,EAAA;AACA,gBAAA;AAAA,YAAA,IAAA;AAAA,YAAA;AAAA,cAAA,MAAA,MAAA,CAAA,IAAA,EAAA;AACA,cAAA,IAAA,EAAA;AAEA,gBAAA,KAAA,GAAA,OAAA,CAAA,MAAA,CAAA,KAAA,EAAA;AAAA,YAAA,MAAA,EAAA;AAAA,WAAA,CAAA;AACA,gBAAA,KAAA,GAAA,KAAA,CAAA,KAAA,CAAA,IAAA,EAAA,MAAA,CAAA,IAAA,IAAA,IAAA,CAAA,IAAA,EAAA,CAAA;;AAEA,eAAA,MAAA,IAAA,IAAA,KAAA,EAAA;AACA,gBAAA,IAAA,CAAA,UAAA,CAAA,QAAA,CAAA,EAAA;AACA,cAAA,YAAA,GAAA,IAAA,CAAA,OAAA,CAAA,QAAA,EAAA,EAAA,EAAA,IAAA,EAAA;AACA;AACA;;AAEA,gBAAA,IAAA,CAAA,UAAA,CAAA,OAAA,KAAA,YAAA,KAAA,4BAAA,EAAA;AACA,oBAAA,OAAA,GAAA,IAAA,CAAA,OAAA,CAAA,OAAA,EAAA,EAAA,EAAA,IAAA,EAAA;;AACA,kBAAA,OAAA,EAAA;AACA,oBAAA;AACA,wBAAA,IAAA,GAAA,IAAA,CAAA,KAAA,CAAA,OAAA,CAAA;;AACA,sBAAA,IAAA,CAAA,OAAA,EAAA;AACA,oBAAA,SAAA,IAAA,IAAA,CAAA,OAAA;AACA,yBAAA,QAAA,CAAA,UAAA,EAAA,OAAA,GAAA,SAAA;AACA,yBAAA,cAAA;AACA;AACA,iBAPA,CAOA,OAAA,CAAA,EAAA;AACA,kBAAA,OAAA,CAAA,IAAA,CAAA,SAAA,EAAA,CAAA;AACA;AACA;AACA;AACA;AACA;;AAEA,aAAA,SAAA,GAAA,KAAA;AAEA,OAhEA,CAgEA,OAAA,KAAA,EAAA;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,YAAA,EAAA,KAAA;AACA,aAAA,QAAA,CAAA,UAAA,EAAA,OAAA,GAAA,aAAA,KAAA,CAAA,OAAA,EAAA;AACA,aAAA,SAAA,GAAA,KAAA;AACA;AACA,KA3FA;;AA6FA,IAAA,cAAA,GAAA;AACA,YAAA,SAAA,GAAA,KAAA,GAAA,CAAA,aAAA,CAAA,gBAAA,CAAA;AACA,UAAA,SAAA,EAAA,SAAA,CAAA,SAAA,GAAA,SAAA,CAAA,YAAA;AACA,KAhGA;;AAkGA,IAAA,gBAAA,GAAA;AACA,UAAA,OAAA,CAAA,aAAA,CAAA,EAAA;AACA,aAAA,QAAA,GAAA,EAAA,CADA,CAEA;;AACA,aAAA,QAAA,CAAA,IAAA,CAAA;AACA,UAAA,OAAA,EAAA,wBADA;AAEA,UAAA,MAAA,EAAA,KAFA;AAGA,UAAA,MAAA,EAAA;AAHA,SAAA;AAKA;AACA;;AA5GA;AAvBA,CAAA","sourcesContent":["<template>\r\n  <div class=\"collocation-assistant\">\r\n    <div class=\"chat-header\">\r\n      <h3>搭配助手</h3>\r\n      <div class=\"header-buttons\">\r\n        <button @click=\"clearChatHistory\" class=\"clear-btn\">清空记录</button>\r\n        <button @click=\"isMinimized = !isMinimized\" class=\"minimize-btn\">\r\n          {{ isMinimized ? '展开' : '收起' }}\r\n        </button>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-if=\"!isMinimized\" class=\"chat-messages\">\r\n      <div v-for=\"(msg, index) in messages\" :key=\"index\" class=\"message-item\">\r\n        <div :class=\"['message-bubble', msg.isUser ? 'user' : 'ai']\">\r\n          <img :src=\"msg.avatar\" class=\"avatar\" alt=\"头像\">\r\n          <div class=\"content\">\r\n            <p class=\"sender\">{{ msg.isUser ? '我' : '搭配助手' }}</p>\r\n            <div class=\"text\">{{ msg.content }}</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div v-if=\"isLoading\" class=\"loading\">正在思考搭配方案...</div>\r\n    </div>\r\n\r\n    <div v-if=\"!isMinimized\" class=\"chat-input\">\r\n      <input \r\n        type=\"text\" \r\n        v-model=\"userInput\" \r\n        @keyup.enter=\"sendMessage\" \r\n        placeholder=\"输入搭配需求...按回车发送\"\r\n        :disabled=\"isLoading\"\r\n      >\r\n      <button @click=\"sendMessage\" :disabled=\"isLoading || !userInput.trim()\">发送</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'CollocationAssistant',\r\n  data() {\r\n    return {\r\n      messages: [],\r\n      userInput: '',\r\n      isLoading: false,\r\n      isMinimized: false,\r\n      // 搭配助手专属配置（使用指定robotid）\r\n      apiKey: 'pat_sk8iOnz5qzT9cU18pxYZSWboH3f6oynlyQctR1ObYP9vV9lDTUYsw4lPtQjxjzfe',\r\n      robotId: '7533187838620631066', // 搭配助手robotid\r\n      userId: 'user_' + Math.random().toString(36).substr(2, 9),\r\n      apiUrl: 'https://api.coze.cn/v3/chat'\r\n    };\r\n  },\r\n  mounted() {\r\n    // 初始化欢迎消息\r\n    this.messages.push({\r\n      content: '你好！我可以帮你搭配服装配饰，有什么需求吗？',\r\n      isUser: false,\r\n      avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/chatsdk-logo.png'\r\n    });\r\n  },\r\n  methods: {\r\n    async sendMessage() {\r\n      if (!this.userInput.trim() || this.isLoading) return;\r\n\r\n      // 添加用户消息\r\n      this.messages.push({\r\n        content: this.userInput,\r\n        isUser: true,\r\n        avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/coze-logo.png'\r\n      });\r\n\r\n      const userMessage = this.userInput;\r\n      this.userInput = '';\r\n      this.isLoading = true;\r\n\r\n      // 添加AI消息占位\r\n      const aiMsgIndex = this.messages.push({\r\n        content: '',\r\n        isUser: false,\r\n        avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/chatsdk-logo.png'\r\n      }) - 1;\r\n\r\n      try {\r\n        // 调用Coze API（与CozeChat逻辑一致）\r\n        const response = await fetch(this.apiUrl, {\r\n          method: 'POST',\r\n          headers: {\r\n            'Content-Type': 'application/json',\r\n            'Authorization': `Bearer ${this.apiKey}`\r\n          },\r\n          body: JSON.stringify({\r\n            bot_id: this.robotId,\r\n            user_id: this.userId,\r\n            stream: true, // 保持流式响应\r\n            auto_save_history: true,\r\n            additional_messages: [\r\n              {\r\n                role: \"user\",\r\n                content: userMessage,\r\n                content_type: \"text\"\r\n              }\r\n            ]\r\n          })\r\n        });\r\n\r\n        if (!response.ok) throw new Error(`请求失败: ${response.status}`);\r\n\r\n        const reader = response.body.getReader();\r\n        const decoder = new TextDecoder();\r\n        let fullReply = '';\r\n        let currentEvent = null;\r\n\r\n        // 处理流式响应（与CozeChat完全一致）\r\n        while (true) {\r\n          const { done, value } = await reader.read();\r\n          if (done) break;\r\n\r\n          const chunk = decoder.decode(value, { stream: true });\r\n          const lines = chunk.split('\\n').filter(line => line.trim());\r\n\r\n          for (const line of lines) {\r\n            if (line.startsWith('event:')) {\r\n              currentEvent = line.replace('event:', '').trim();\r\n              continue;\r\n            }\r\n\r\n            if (line.startsWith('data:') && currentEvent === 'conversation.message.delta') {\r\n              const dataStr = line.replace('data:', '').trim();\r\n              if (dataStr) {\r\n                try {\r\n                  const data = JSON.parse(dataStr);\r\n                  if (data.content) {\r\n                    fullReply += data.content;\r\n                    this.messages[aiMsgIndex].content = fullReply;\r\n                    this.scrollToBottom();\r\n                  }\r\n                } catch (e) {\r\n                  console.warn('解析片段失败:', e);\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n\r\n        this.isLoading = false;\r\n\r\n      } catch (error) {\r\n        console.error('搭配助手API错误:', error);\r\n        this.messages[aiMsgIndex].content = `获取搭配建议失败: ${error.message}`;\r\n        this.isLoading = false;\r\n      }\r\n    },\r\n\r\n    scrollToBottom() {\r\n      const container = this.$el.querySelector('.chat-messages');\r\n      if (container) container.scrollTop = container.scrollHeight;\r\n    },\r\n\r\n    clearChatHistory() {\r\n      if (confirm('确定要清空聊天记录吗？')) {\r\n        this.messages = [];\r\n        // 重新添加欢迎消息\r\n        this.messages.push({\r\n          content: '你好！我可以帮你搭配服装配饰，有什么需求吗？',\r\n          isUser: false,\r\n          avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/chatsdk-logo.png'\r\n        });\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.collocation-assistant {\r\n  height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n}\r\n\r\n.chat-header {\r\n  padding: 10px 16px;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  background: #f5f5f5;\r\n  border-bottom: 1px solid #eee;\r\n}\r\n\r\n.chat-header h3 {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  color: #333;\r\n}\r\n\r\n.header-buttons {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n\r\n.clear-btn, .minimize-btn {\r\n  padding: 4px 8px;\r\n  font-size: 12px;\r\n  border: none;\r\n  border-radius: 3px;\r\n  background: #e0e0e0;\r\n  cursor: pointer;\r\n}\r\n\r\n.chat-messages {\r\n  flex: 1;\r\n  padding: 12px;\r\n  overflow-y: auto;\r\n  background: #fff;\r\n}\r\n\r\n.message-item {\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.message-bubble {\r\n  display: flex;\r\n  max-width: 80%;\r\n}\r\n\r\n.message-bubble.user {\r\n  margin-left: auto;\r\n}\r\n\r\n.avatar {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 50%;\r\n  margin-right: 8px;\r\n}\r\n\r\n.message-bubble.user .avatar {\r\n  margin-right: 0;\r\n  margin-left: 8px;\r\n}\r\n\r\n.content {\r\n  padding: 8px 12px;\r\n  border-radius: 16px;\r\n  background: #f0f0f0;\r\n}\r\n\r\n.message-bubble.user .content {\r\n  background: #1890ff;\r\n  color: white;\r\n}\r\n\r\n.sender {\r\n  margin: 0 0 4px;\r\n  font-size: 12px;\r\n  opacity: 0.8;\r\n}\r\n\r\n.text {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.loading {\r\n  text-align: center;\r\n  padding: 10px;\r\n  color: #666;\r\n  font-size: 12px;\r\n}\r\n\r\n.chat-input {\r\n  display: flex;\r\n  gap: 8px;\r\n  padding: 12px;\r\n  border-top: 1px solid #eee;\r\n}\r\n\r\n.chat-input input {\r\n  flex: 1;\r\n  padding: 8px 12px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 4px;\r\n  outline: none;\r\n}\r\n\r\n.chat-input button {\r\n  padding: 8px 16px;\r\n  background: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.chat-input button:disabled {\r\n  background: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n</style>\r\n"],"sourceRoot":"src/components"}]}