{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js!D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js??ref--1-0!D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\views\\login\\Login.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\views\\login\\Login.vue","mtime":1753783291996},{"path":"D:\\web\\cloth_design\\cloth-design-view\\babel.config.js","mtime":1757507572271},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":456789000000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["ADMIN_ROLE","USER_ROLE","DELAY_TIME","request","setToken","md5","Logo","mapActions","name","components","data","act","pwd","colorLogo","methods","toDoRegister","$router","push","login","$swal","fire","title","text","icon","showConfirmButton","timer","hashedPwd","paramDTO","userAccount","userPwd","post","code","msg","loginToStore","id","role","token","setTimeout","navigateToRole","error","console","$message","warn"],"sources":["src/views/login/Login.vue"],"sourcesContent":["<template>\n    <div class=\"login-container\">\n        <div class=\"login-panel\">\n            <div class=\"logo\">\n                <Logo :bag=\"colorLogo\"/>\n            </div>\n            <div class=\"text\">\n                <input v-model=\"act\" class=\"act\" placeholder=\"输入账号\" />\n            </div>\n            <div class=\"text\">\n                <input v-model=\"pwd\" class=\"pwd\" type=\"password\" placeholder=\"输入密码\" />\n            </div>\n            <div>\n                <span class=\"login-btn\" @click=\"login\">立即登录</span>\n            </div>\n            <div class=\"tip\">\n                <p>没有账号？<span class=\"no-act\" @click=\"toDoRegister\">点此注册</span></p>\n            </div>\n        </div>\n    </div>\n</template>\n\n<script>\nconst ADMIN_ROLE = 1;\nconst USER_ROLE = 2;\nconst DELAY_TIME = 1300;\nimport request from \"@/utils/request.js\";\nimport { setToken } from \"@/utils/storage.js\";\nimport md5 from 'js-md5';\nimport Logo from '@/components/Logo.vue';\nimport { mapActions } from 'vuex';\nexport default {\n    name: \"Login\",\n    components: { Logo },\n    data() {\n        return {\n            act: '',\n            pwd: '',\n            colorLogo: 'rgb(38,38,38)',\n        }\n    },\n    methods: {\n        // 跳转注册页面\n        toDoRegister(){\n            this.$router.push('/register');\n        },\n        async login() {\n            if (!this.act || !this.pwd) {\n                this.$swal.fire({\n                    title: '填写校验',\n                    text: '账号或密码不能为空',\n                    icon: 'error',\n                    showConfirmButton: false,\n                    timer: DELAY_TIME,\n                });\n                return;\n            }\n            const hashedPwd = md5(md5(this.pwd));\n            const paramDTO = { userAccount: this.act, userPwd: hashedPwd };\n            try {\n        const { data } = await request.post(`user/login`, paramDTO);\n        if (data.code !== 200) {\n          // 登录失败处理\n          this.$swal.fire({\n            title: '登录失败',\n            text: data.msg,\n            icon: 'error',\n            showConfirmButton: false,\n            timer: DELAY_TIME,\n          });\n          return; // 登录失败时才需要 return\n        }\n        \n        // 登录成功：保存用户信息到 Vuex\n        this.loginToStore({\n          id: data.data.id,\n          role: data.data.role,\n          token: data.data.token\n        });\n        \n        // 保存 token 到本地存储\n        setToken(data.data.token);\n        \n        // 登录成功提示\n        this.$swal.fire({\n          title: '登录成功',\n          text: '即将进入系统...',\n          icon: 'success',\n          showConfirmButton: false,\n          timer: DELAY_TIME,\n        });\n        \n        // 根据角色跳转\n        setTimeout(() => {\n          const { role } = data.data;\n          this.navigateToRole(role);\n        }, DELAY_TIME);\n        \n      } catch (error) {\n        console.error('登录请求错误:', error);\n        this.$message.error('登录请求出错，请重试！');\n      }\n    },\n    \n    // 映射 Vuex 的 action 到 methods\n    ...mapActions('user', {\n      loginToStore: 'login' // 将 user/login action 映射为 this.loginToStore\n    }),\n        navigateToRole(role) {\n            switch (role) {\n                case ADMIN_ROLE:\n                    this.$router.push('/admin');\n                    break;\n                case USER_ROLE:\n                    this.$router.push('/user');\n                    break;\n                default:\n                    console.warn('未知的角色类型:', role);\n                    break;\n            }\n        },\n    }\n};\n</script>\n\n<style lang=\"scss\" scoped>\n* {\n    user-select: none;\n}\n.login-container {\n    width: 100%;\n    min-height: 100vh;\n    background-color: rgb(255, 255, 255);\n    display: flex;\n    /* 启用Flexbox布局 */\n    justify-content: center;\n    /* 水平居中 */\n    align-items: center;\n    /* 垂直居中 */\n    flex-direction: column;\n    /* 如果需要垂直居中，确保子元素也是这样排列 */\n\n    .login-panel {\n        width: 313px;\n        height: auto;\n        padding: 40px 30px 16px 30px;\n        border-radius: 3px;\n         box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1), 0 1px 3px rgba(0, 0, 0, 0.06);\n\n        .logo {\n            margin: 10px 0 30px 0;\n        }\n\n        .act,\n        .pwd {\n            margin: 8px 0;\n            height: 43px;\n            line-height: 43px;\n            width: 100%;\n            padding: 0 8px;\n            box-sizing: border-box;\n            border: 1px solid #c8d4e7;\n            border-radius: 3px;\n            padding: 0 15px;\n            margin-top: 13px;\n        }\n\n        .act:focus,\n        .pwd:focus {\n            outline: none;\n            border: 1px solid rgb(0, 185, 107);\n            transition: 1.2s;\n        }\n\n        .role {\n            display: inline-block;\n            color: rgb(30, 102, 147);\n            font-size: 14px;\n            padding-right: 10px;\n        }\n    }\n\n    .login-btn {\n        display: inline-block;\n        text-align: center;\n        border-radius: 3px;\n        margin-top: 20px;\n        height: 43px;\n        line-height: 43px;\n        width: 100%;\n        background-color: rgb(0, 185, 107);\n        font-size: 14px !important;\n        border: none;\n        color: white;\n        padding: 0 !important;\n        cursor: pointer;\n        user-select: none;\n    }\n\n    .login-btn:hover {\n        background-color: #5782c6;\n    }\n\n    .tip {\n        margin: 20px 0;\n\n        p {\n            padding: 3px 0;\n            margin: 0;\n            font-size: 14px;\n            color: #647897;\n\n            i{\n                margin-right: 3px;\n            }\n\n            span {\n                color: #3b3c3e;\n                border-radius: 2px;\n                margin: 0 6px;\n            }\n            .no-act:hover{\n                color: #3e77c2;\n                cursor: pointer;\n            }\n\n        }\n    }\n\n}\n</style>\n"],"mappings":";AAuBA,MAAAA,UAAA;AACA,MAAAC,SAAA;AACA,MAAAC,UAAA;AACA,OAAAC,OAAA;AACA,SAAAC,QAAA;AACA,OAAAC,GAAA;AACA,OAAAC,IAAA;AACA,SAAAC,UAAA;AACA;EACAC,IAAA;EACAC,UAAA;IAAAH;EAAA;EACAI,KAAA;IACA;MACAC,GAAA;MACAC,GAAA;MACAC,SAAA;IACA;EACA;EACAC,OAAA;IACA;IACAC,aAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;IACA,MAAAC,MAAA;MACA,UAAAP,GAAA,UAAAC,GAAA;QACA,KAAAO,KAAA,CAAAC,IAAA;UACAC,KAAA;UACAC,IAA