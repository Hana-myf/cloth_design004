{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js!D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js??ref--0-0!D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ImageEditor.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ImageEditor.vue","mtime":1757575332018},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":315532800000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["ImageEditor.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA2DA,OAAA,KAAA,MAAA,OAAA,C,CACA;AACA;;AAEA,eAAA;AACA,EAAA,IAAA,EAAA,aADA;AAEA,EAAA,KAAA,EAAA;AACA,IAAA,WAAA,EAAA;AACA,MAAA,IAAA,EAAA,QADA;AAEA,MAAA,QAAA,EAAA;AAFA;AADA,GAFA;;AAQA,EAAA,IAAA,GAAA;AACA,WAAA;AACA,MAAA,WAAA,EAAA,KADA;AAEA,MAAA,eAAA,EAAA,IAFA;AAGA,MAAA,SAAA,EAAA,EAHA;AAIA,MAAA,cAAA,EAAA,IAJA;AAKA,MAAA,SAAA,EAAA,KALA;AAMA;AACA,MAAA,WAAA,EAAA,kCAPA;AAQA;AACA;AAEA;AACA,MAAA,YAAA,EAAA;AACA,QAAA,MAAA,EAAA,6BADA;AAEA,QAAA,MAAA,EAAA,sEAFA;AAGA,QAAA,KAAA,EAAA,qBAHA;AAIA,QAAA,MAAA,EAAA,UAAA,IAAA,CAAA,MAAA,GAAA,QAAA,CAAA,EAAA,EAAA,MAAA,CAAA,CAAA,EAAA,CAAA,CAJA;AAKA,QAAA,eAAA,EAAA;AALA;AAZA,KAAA;AAoBA,GA7BA;;AA8BA;AACA;AACA,EAAA,OAAA,EAAA;AACA;AACA;AAEA;AACA,UAAA,iBAAA,CAAA,CAAA,EAAA;AACA,YAAA,IAAA,GAAA,CAAA,CAAA,MAAA,CAAA,KAAA,CAAA,CAAA,CAAA;AACA,UAAA,CAAA,IAAA,IAAA,KAAA,SAAA,EAAA,OAFA,CAIA;;AACA,YAAA,OAAA,GAAA,IAAA,IAAA,GAAA,IAAA,CALA,CAKA;;AACA,UAAA,IAAA,CAAA,IAAA,GAAA,OAAA,EAAA;AACA,aAAA,QAAA,CAAA,KAAA,CAAA,cAAA;AACA;AACA;;AACA,YAAA,UAAA,GAAA,CAAA,YAAA,EAAA,WAAA,EAAA,YAAA,CAAA;;AACA,UAAA,CAAA,UAAA,CAAA,QAAA,CAAA,IAAA,CAAA,IAAA,CAAA,EAAA;AACA,aAAA,QAAA,CAAA,KAAA,CAAA,wBAAA;AACA;AACA;;AAEA,WAAA,SAAA,GAAA,IAAA;AACA,WAAA,cAAA,GAAA,IAAA,CAjBA,CAiBA;;AAEA,YAAA,QAAA,GAAA,IAAA,QAAA,EAAA;AACA,MAAA,QAAA,CAAA,MAAA,CAAA,OAAA,EAAA,IAAA;;AAEA,UAAA;AACA,QAAA,OAAA,CAAA,GAAA,CAAA,kBAAA;AACA,cAAA,QAAA,GAAA,MAAA,KAAA,CAAA,sCAAA,KAAA,WAAA,EAAA,EAAA;AACA,UAAA,MAAA,EAAA,MADA;AAEA,UAAA,IAAA,EAAA;AAFA,SAAA,CAAA;AAKA,cAAA,MAAA,GAAA,MAAA,QAAA,CAAA,IAAA,EAAA;;AAEA,YAAA,MAAA,CAAA,OAAA,EAAA;AACA,eAAA,eAAA,GAAA,MAAA,CAAA,IAAA,CAAA,GAAA;AACA,UAAA,OAAA,CAAA,GAAA,CAAA,gBAAA,EAAA,KAAA,eAAA;AACA,eAAA,QAAA,CAAA,OAAA,CAAA,gBAAA;AACA,SAJA,MAIA;AAAA;;AACA;AACA,gBAAA,IAAA,KAAA,CAAA,kBAAA,MAAA,CAAA,KAAA,gEAAA,OAAA,KAAA,gBAAA,CAAA;AACA;AACA,OAjBA,CAiBA,OAAA,KAAA,EAAA;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,WAAA,EAAA,KAAA,EADA,CAEA;;AACA,aAAA,eAAA,GAAA,KAAA,YAAA,CAAA,eAAA;AACA,aAAA,QAAA,CAAA,KAAA,CAAA,mBAAA,KAAA,CAAA,OAAA,EAAA;AACA,OAtBA,SAsBA;AACA,aAAA,SAAA,GAAA,KAAA;AACA;AACA,KApDA;;AAsDA;AACA,UAAA,SAAA,GAAA;AACA,UAAA,CAAA,KAAA,eAAA,IAAA,CAAA,KAAA,SAAA,CAAA,IAAA,EAAA,IAAA,KAAA,SAAA,EAAA;AAEA,WAAA,SAAA,GAAA,IAAA;AACA,WAAA,cAAA,GAAA,IAAA;;AAEA,UAAA;AACA;AACA,cAAA,QAAA,GAAA,MAAA,KAAA,CACA,KAAA,YAAA,CAAA,MADA,EAEA;AACA,UAAA,MAAA,EAAA,MADA;AAEA,UAAA,OAAA,EAAA;AACA,4BAAA,kBADA;AAEA,6BAAA,UAAA,KAAA,YAAA,CAAA,MAAA;AAFA,WAFA;AAMA,UAAA,IAAA,EAAA,IAAA,CAAA,SAAA,CAAA;AACA,YAAA,MAAA,EAAA,KAAA,YAAA,CAAA,KADA;AAEA,YAAA,OAAA,EAAA,KAAA,YAAA,CAAA,MAFA;AAGA,YAAA,MAAA,EAAA,IAHA;AAGA;AACA,YAAA,iBAAA,EAAA,IAJA;AAKA,YAAA,mBAAA,EAAA,CACA;AACA,cAAA,IAAA,EAAA,MADA;AAEA,cAAA,OAAA,EAAA,QAAA,KAAA,SAAA,YAAA,KAAA,eAAA,EAFA;AAGA,cAAA,YAAA,EAAA;AAHA,aADA;AALA,WAAA;AANA,SAFA,CAAA;;AAwBA,YAAA,CAAA,QAAA,CAAA,EAAA,EAAA;AACA,gBAAA,IAAA,KAAA,CAAA,YAAA,QAAA,CAAA,MAAA,IAAA,QAAA,CAAA,UAAA,EAAA,CAAA;AACA,SA5BA,CA8BA;;;AACA,cAAA,MAAA,GAAA,QAAA,CAAA,IAAA,CAAA,SAAA,EAAA;AACA,cAAA,OAAA,GAAA,IAAA,WAAA,EAAA;AACA,YAAA,SAAA,GAAA,EAAA;AACA,YAAA,YAAA,GAAA,IAAA;;AAEA,eAAA,IAAA,EAAA;AACA,gBAAA;AAAA,YAAA,IAAA;AAAA,YAAA;AAAA,cAAA,MAAA,MAAA,CAAA,IAAA,EAAA;AACA,cAAA,IAAA,EAAA;AAEA,gBAAA,KAAA,GAAA,OAAA,CAAA,MAAA,CAAA,KAAA,EAAA;AAAA,YAAA,MAAA,EAAA;AAAA,WAAA,CAAA;AACA,gBAAA,KAAA,GAAA,KAAA,CAAA,KAAA,CAAA,IAAA,EAAA,MAAA,CAAA,IAAA,IAAA,IAAA,CAAA,IAAA,EAAA,CAAA;;AAEA,eAAA,MAAA,IAAA,IAAA,KAAA,EAAA;AACA,gBAAA,IAAA,CAAA,UAAA,CAAA,QAAA,CAAA,EAAA;AACA,cAAA,YAAA,GAAA,IAAA,CAAA,OAAA,CAAA,QAAA,EAAA,EAAA,EAAA,IAAA,EAAA;AACA;AACA,aAJA,CAMA;;;AACA,gBAAA,IAAA,CAAA,UAAA,CAAA,OAAA,KAAA,YAAA,KAAA,4BAAA,EAAA;AACA,oBAAA,OAAA,GAAA,IAAA,CAAA,OAAA,CAAA,OAAA,EAAA,EAAA,EAAA,IAAA,EAAA;;AACA,kBAAA,OAAA,EAAA;AACA,oBAAA;AACA,wBAAA,IAAA,GAAA,IAAA,CAAA,KAAA,CAAA,OAAA,CAAA,CADA,CAEA;;AACA,sBAAA,IAAA,CAAA,OAAA,EAAA;AACA,oBAAA,SAAA,IAAA,IAAA,CAAA,OAAA;AACA;AACA,iBANA,CAMA,OAAA,CAAA,EAAA;AACA,kBAAA,OAAA,CAAA,IAAA,CAAA,aAAA,EAAA,CAAA;AACA;AACA;AACA;AACA;AACA,SAjEA,CAmEA;AACA;;;AACA,QAAA,OAAA,CAAA,GAAA,CAAA,WAAA,EAAA,SAAA;AACA,cAAA,aAAA,GAAA,SAAA,CAAA,KAAA,CAAA,qCAAA,CAAA;;AAEA,YAAA,CAAA,aAAA,EAAA;AACA,gBAAA,IAAA,KAAA,CAAA,sBAAA,CAAA;AACA;;AAEA,aAAA,cAAA,GAAA,aAAA,CAAA,CAAA,CAAA;AACA,aAAA,QAAA,CAAA,OAAA,CAAA,SAAA;AAEA,OA/EA,CA+EA,OAAA,KAAA,EAAA;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,SAAA,EAAA,KAAA;AACA,aAAA,QAAA,CAAA,KAAA,CAAA,QAAA,KAAA,CAAA,OAAA,IAAA,MAAA,EAAA;AACA,OAlFA,SAkFA;AACA,aAAA,SAAA,GAAA,KAAA;AACA;AACA,KAlJA;;AAoJA;AACA,IAAA,eAAA,GAAA;AACA,UAAA,CAAA,KAAA,cAAA,EAAA;AACA,WAAA,WAAA,CAAA,KAAA,cAAA,EAAA,QAAA,IAAA,IAAA,GAAA,OAAA,EAAA,EAAA;AACA,WAAA,QAAA,CAAA,OAAA,CAAA,SAAA;AACA,KAzJA;;AA2JA,IAAA,WAAA,GAAA;AACA,WAAA,eAAA,GAAA,IAAA;AACA,WAAA,SAAA,GAAA,EAAA;AACA,WAAA,cAAA,GAAA,IAAA;AACA,WAAA,QAAA,CAAA,IAAA,CAAA,SAAA;AACA;;AAhKA;AAhCA,CAAA","sourcesContent":["<template>\r\n  <div class=\"image-editor\">\r\n    <!-- 组件头部：展开/收起+标题 -->\r\n    <div class=\"editor-header\">\r\n      <h3>图像编辑助手</h3>\r\n      <div class=\"header-buttons\">\r\n        <button @click=\"clearEditor\" class=\"clear-btn\">清空编辑</button>\r\n        <button @click=\"isMinimized = !isMinimized\" class=\"minimize-btn\">\r\n          {{ isMinimized ? '展开' : '收起' }}\r\n        </button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 编辑内容区（收起时隐藏） -->\r\n    <div v-if=\"!isMinimized\" class=\"editor-content\">\r\n      <!-- 1. 图片上传区 (已修改) -->\r\n      <div class=\"upload-area\">\r\n        <!-- disabled 条件已简化 -->\r\n        <label class=\"upload-btn\" :disabled=\"isEditing\">\r\n          <input type=\"file\" accept=\"image/jpeg,image/png,image/webp\" @change=\"handleImageUpload\" hidden>\r\n          上传图片（支持JPG/PNG/WEBP，最大5MB）\r\n        </label>\r\n        <!-- 提示文本已修改 -->\r\n        <p class=\"tip\" v-if=\"currentImageUrl\">已上传图片，可输入编辑需求</p>\r\n      </div>\r\n\r\n      <!-- 2. 图片预览区 -->\r\n      <div class=\"preview-area\" v-if=\"currentImageUrl\">\r\n        <img :src=\"currentImageUrl\" alt=\"预览图\" class=\"preview-img\">\r\n      </div>\r\n\r\n      <!-- 3. 编辑需求输入区 -->\r\n      <div class=\"input-area\">\r\n        <input\r\n          type=\"text\"\r\n          v-model=\"editInput\"\r\n          @keyup.enter=\"startEdit\"\r\n          placeholder=\"输入编辑需求（如：改成浅粉色、换成牛仔面料）\"\r\n          :disabled=\"isEditing || !currentImageUrl\"\r\n        >\r\n        <button @click=\"startEdit\" :disabled=\"isEditing || !currentImageUrl || !editInput.trim()\">\r\n          {{ isEditing ? '编辑中...' : '开始编辑' }}\r\n        </button>\r\n      </div>\r\n\r\n      <!-- 4. 编辑结果区 -->\r\n      <div class=\"result-area\" v-if=\"editedImageUrl\">\r\n        <h4>编辑结果：</h4>\r\n        <img :src=\"editedImageUrl\" alt=\"编辑后图片\" class=\"result-img\">\r\n        <button @click=\"saveEditedImage\" class=\"save-btn\">保存到成果库</button>\r\n      </div>\r\n\r\n      <!-- 加载状态 -->\r\n      <div v-if=\"isEditing\" class=\"loading\">正在处理中...</div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n// 不再需要TOS的工具函数\r\n// import { loadTosSdk, uploadImageToTos } from '@/utils/tosUpload.js';\r\n\r\nexport default {\r\n  name: 'ImageEditor',\r\n  props: {\r\n    onSaveImage: {\r\n      type: Function,\r\n      required: true\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      isMinimized: false,\r\n      currentImageUrl: null,\r\n      editInput: '',\r\n      editedImageUrl: null,\r\n      isEditing: false,\r\n      // 【修改】添加ImgBB的API Key\r\n      imgbbApiKey: 'ddfd3ce61ba74d50a1d1167d498e4c0f',\r\n      // 【移除】不再需要tosLoaded状态\r\n      // tosLoaded: false,\r\n      \r\n      // 图像编辑智能体配置（不变）\r\n      editorConfig: {\r\n        apiUrl: 'https://api.coze.cn/v3/chat',\r\n        apiKey: 'pat_mY0OSWqTlyfxYW4cV8fu7vGY6jXupqFhQJ2FvyZfasve8SgKMGmFoFoS5Rshonq5',\r\n        botId: '7533205966545272882',\r\n        userId: 'user_' + Math.random().toString(36).substr(2, 9),\r\n        defaultImageUrl: 'https://ark-project.tos-cn-beijing.volces.com/doc_image/seededit_i2i.jpeg'\r\n      }\r\n    };\r\n  },\r\n  // 【移除】不再需要mounted生命周期和initTos方法\r\n  // mounted() { ... }\r\n  methods: {\r\n    // 【移除】不再需要initTos方法\r\n    // async initTos() { ... }\r\n\r\n    // 【核心修改】重写图片上传方法，使用ImgBB\r\n    async handleImageUpload(e) {\r\n      const file = e.target.files[0];\r\n      if (!file || this.isEditing) return;\r\n\r\n      // 前端校验（保留，这是一个好习惯）\r\n      const maxSize = 5 * 1024 * 1024; // 5MB\r\n      if (file.size > maxSize) {\r\n        this.$message.error(`图片过大，最大支持5MB`);\r\n        return;\r\n      }\r\n      const validTypes = ['image/jpeg', 'image/png', 'image/webp'];\r\n      if (!validTypes.includes(file.type)) {\r\n        this.$message.error(`格式不支持，仅允许：JPG、PNG、WEBP`);\r\n        return;\r\n      }\r\n\r\n      this.isEditing = true;\r\n      this.editedImageUrl = null; // 清除上一次的编辑结果\r\n\r\n      const formData = new FormData();\r\n      formData.append('image', file);\r\n\r\n      try {\r\n        console.log('正在上传图片到 ImgBB...');\r\n        const response = await fetch(`https://api.imgbb.com/1/upload?key=${this.imgbbApiKey}`, {\r\n          method: 'POST',\r\n          body: formData,\r\n        });\r\n\r\n        const result = await response.json();\r\n\r\n        if (result.success) {\r\n          this.currentImageUrl = result.data.url;\r\n          console.log('✅ 图片上传成功, URL:', this.currentImageUrl);\r\n          this.$message.success('图片上传成功，可输入编辑需求');\r\n        } else {\r\n          // 如果ImgBB返回错误，则抛出错误\r\n          throw new Error(result.error?.message || 'ImgBB API 返回错误');\r\n        }\r\n      } catch (error) {\r\n        console.error('❌ 图片上传失败：', error);\r\n        // 上传失败时，回退到默认图，并给出提示\r\n        this.currentImageUrl = this.editorConfig.defaultImageUrl;\r\n        this.$message.error(`图片上传失败，已使用默认示例图：${error.message}`);\r\n      } finally {\r\n        this.isEditing = false;\r\n      }\r\n    },\r\n\r\n    // 【无需修改】调用智能体的方法保持不变\r\n    async startEdit() {\r\n  if (!this.currentImageUrl || !this.editInput.trim() || this.isEditing) return;\r\n\r\n  this.isEditing = true;\r\n  this.editedImageUrl = null;\r\n\r\n  try {\r\n    // 【核心修改】使用 fetch 并将 stream 设置为 true\r\n    const response = await fetch(\r\n      this.editorConfig.apiUrl,\r\n      {\r\n        method: 'POST',\r\n        headers: {\r\n          'Content-Type': 'application/json',\r\n          'Authorization': `Bearer ${this.editorConfig.apiKey}`\r\n        },\r\n        body: JSON.stringify({\r\n          bot_id: this.editorConfig.botId,\r\n          user_id: this.editorConfig.userId,\r\n          stream: true, // <--- 关键！改为流式请求\r\n          auto_save_history: true,\r\n          additional_messages: [\r\n            {\r\n              role: \"user\",\r\n              content: `编辑需求：${this.editInput}，参考图片URL：${this.currentImageUrl}`,\r\n              content_type: \"text\"\r\n            }\r\n          ]\r\n        })\r\n      }\r\n    );\r\n\r\n    if (!response.ok) {\r\n      throw new Error(`API请求失败: ${response.status} ${response.statusText}`);\r\n    }\r\n\r\n    // 【核心修改】像“搭配助手”一样，处理流式响应\r\n    const reader = response.body.getReader();\r\n    const decoder = new TextDecoder();\r\n    let fullReply = '';\r\n    let currentEvent = null;\r\n\r\n    while (true) {\r\n      const { done, value } = await reader.read();\r\n      if (done) break;\r\n\r\n      const chunk = decoder.decode(value, { stream: true });\r\n      const lines = chunk.split('\\n').filter(line => line.trim());\r\n\r\n      for (const line of lines) {\r\n        if (line.startsWith('event:')) {\r\n          currentEvent = line.replace('event:', '').trim();\r\n          continue;\r\n        }\r\n        \r\n        // 我们只关心 message.delta 事件，它包含返回的内容\r\n        if (line.startsWith('data:') && currentEvent === 'conversation.message.delta') {\r\n          const dataStr = line.replace('data:', '').trim();\r\n          if (dataStr) {\r\n            try {\r\n              const data = JSON.parse(dataStr);\r\n              // 将所有返回的片段拼接成一个完整的字符串\r\n              if (data.content) {\r\n                fullReply += data.content;\r\n              }\r\n            } catch (e) {\r\n              console.warn('解析流式数据片段失败:', e);\r\n            }\r\n          }\r\n        }\r\n      }\r\n    }\r\n\r\n    // 流式响应结束后，fullReply 包含了完整的AI返回内容\r\n    // 现在，我们可以像之前一样，从这个完整内容中提取图片URL\r\n    console.log('AI完整返回内容:', fullReply);\r\n    const imageUrlMatch = fullReply.match(/https?:\\/\\/\\S+\\.(jpg|png|jpeg|webp)/);\r\n    \r\n    if (!imageUrlMatch) {\r\n      throw new Error('智能体返回的内容中不包含有效的图片URL');\r\n    }\r\n\r\n    this.editedImageUrl = imageUrlMatch[0];\r\n    this.$message.success('图片编辑完成！');\r\n\r\n  } catch (error) {\r\n    console.error('图像编辑失败：', error);\r\n    this.$message.error(`编辑失败：${error.message || '未知错误'}`);\r\n  } finally {\r\n    this.isEditing = false;\r\n  }\r\n},\r\n\r\n    // 【无需修改】保存和清空方法保持不变\r\n    saveEditedImage() {\r\n      if (!this.editedImageUrl) return;\r\n      this.onSaveImage(this.editedImageUrl, `编辑结果_${new Date().getTime()}`);\r\n      this.$message.success('已保存到成果库');\r\n    },\r\n\r\n    clearEditor() {\r\n      this.currentImageUrl = null;\r\n      this.editInput = '';\r\n      this.editedImageUrl = null;\r\n      this.$message.info('已清空编辑内容');\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 样式完全不变，此处省略 */\r\n.image-editor {\r\n  border-radius: 4px;\r\n  border: 1px solid #eee;\r\n  overflow: hidden;\r\n  margin-bottom: 16px;\r\n}\r\n.editor-header {\r\n  padding: 10px 16px;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  background: #f5f5f5;\r\n  border-bottom: 1px solid #eee;\r\n}\r\n.editor-header h3 { margin: 0; font-size: 14px; color: #333; }\r\n.header-buttons { display: flex; gap: 8px; }\r\n.clear-btn, .minimize-btn { padding: 4px 8px; font-size: 12px; border: none; border-radius: 3px; background: #e0e0e0; cursor: pointer; }\r\n.editor-content { padding: 16px; background: #fff; }\r\n.upload-area { margin-bottom: 16px; }\r\n.upload-btn { display: inline-block; padding: 8px 16px; background: #1890ff; color: white; border-radius: 4px; cursor: pointer; }\r\n.upload-btn:disabled { background: #ccc; cursor: not-allowed; }\r\n.tip { margin: 8px 0 0; font-size: 12px; color: #666; }\r\n.preview-area { margin-bottom: 16px; text-align: center; }\r\n.preview-img { max-width: 100%; max-height: 300px; border-radius: 4px; border: 1px solid #eee; }\r\n.input-area { display: flex; gap: 8px; margin-bottom: 16px; }\r\n.input-area input { flex: 1; padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px; outline: none; }\r\n.input-area button { padding: 8px 16px; background: #1890ff; color: white; border: none; border-radius: 4px; cursor: pointer; }\r\n.input-area button:disabled { background: #ccc; cursor: not-allowed; }\r\n.result-area { margin-top: 16px; padding-top: 16px; border-top: 1px dashed #eee; text-align: center; }\r\n.result-img { max-width: 100%; max-height: 400px; border-radius: 4px; border: 1px solid #eee; margin: 8px 0; }\r\n.save-btn { margin-top: 8px; padding: 6px 12px; background: #52c41a; color: white; border: none; border-radius: 4px; cursor: pointer; }\r\n.loading { text-align: center; padding: 10px; color: #666; font-size: 12px; }\r\n</style>\r\n"],"sourceRoot":"src/components"}]}