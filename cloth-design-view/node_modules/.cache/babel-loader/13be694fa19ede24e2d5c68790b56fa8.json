EAAAA,SAAS,GAAG,IAAIU,MAAM,CAACC,GAAX,CAAe;AACzBT,IAAAA,WAAW,EAAED,UAAU,CAACC,WADC;AAEzBC,IAAAA,eAAe,EAAEF,UAAU,CAACE,eAFH;AAGzBC,IAAAA,MAAM,EAAEH,UAAU,CAACG,MAHM;AAIzBkB,IAAAA,KAAK,EAAE;AAJkB,GAAf,CAAZ;AAMD,CARD,C,CAUA;;;AACA,OAAO,MAAMC,gBAAgB,GAAG,MAAOC,IAAP,IAAgB;AAC9C,MAAI,CAACA,IAAD,IAAS,CAACxB,SAAd,EAAyB,MAAM,IAAImB,KAAJ,CAAU,iBAAV,CAAN,CADqB,CAG9C;;AACA,QAAMM,OAAO,GAAG,IAAI,IAAJ,GAAW,IAA3B,CAJ8C,CAIb;;AACjC,MAAID,IAAI,CAACE,IAAL,GAAYD,OAAhB,EAAyB,MAAM,IAAIN,KAAJ,CAAW,WAAUM,OAAO,GAAG,IAAV,GAAiB,IAAK,IAA3C,CAAN;AAEzB,QAAME,UAAU,GAAG,CAAC,YAAD,EAAe,WAAf,EAA4B,YAA5B,CAAnB;AACA,MAAI,CAACA,UAAU,CAACC,QAAX,CAAoBJ,IAAI,CAACK,IAAzB,CAAL,EAAqC,MAAM,IAAIV,KAAJ,CAAU,sBAAV,CAAN,CARS,CAU9C;;AACA,QAAMW,IAAI,GAAG,IAAIC,IAAJ,EAAb;AACA,QAAMC,IAAI,GAAGF,IAAI,CAACG,WAAL,EAAb;AACA,QAAMC,KAAK,GAAGC,MAAM,CAACL,IAAI,CAACM,QAAL,KAAkB,CAAnB,CAAN,CAA4BC,QAA5B,CAAqC,CAArC,EAAwC,GAAxC,CAAd;AACA,QAAMC,GAAG,GAAGH,MAAM,CAACL,IAAI,CAACS,OAAL,EAAD,CAAN,CAAuBF,QAAvB,CAAgC,CAAhC,EAAmC,GAAnC,CAAZ;AACA,QAAMG,QAAQ,GAAI,iBAAgBR,IAAK,IAAGE,KAAM,IAAGI,GAAI,IAAGP,IAAI,CAACU,GAAL,EAAW,IAAGjB,IAAI,CAACkB,IAAL,CAAUC,OAAV,CAAkB,YAAlB,EAAgC,EAAhC,CAAoC,EAA5G,CAf8C,CAiB9C;;AACA,QAAM3C,SAAS,CAAC4C,SAAV,CAAoB;AACxBC,IAAAA,MAAM,EAAE5C,UAAU,CAACI,MADK;AAExByC,IAAAA,GAAG,EAAEN,QAFmB;AAGxBO,IAAAA,IAAI,EAAEvB,IAHkB;AAIxBwB,IAAAA,WAAW,EAAExB,IAAI,CAACK,IAJM;AAKxBoB,IAAAA,GAAG,EAAE,aALmB,CAKL;;AALK,GAApB,CAAN,CAlB8C,CA0B9C;;AACA,SAAQ,WAAUhD,UAAU,CAACI,MAAO,IAAGJ,UAAU,CAACG,MAAO,8BAA6BoC,QAAS,EAA/F;AACD,CA5BM,C,CA8BP;;AACA,OAAO,MAAMU,YAAY,GAAG,MAAMjD,UAA3B","sourcesContent":["// src/utils/tosUpload.js\r\nlet tosClient = null;\r\nconst TOS_CONFIG = {\r\n  accessKeyId: 'AKLTNGVhOWRjNTVjM2JlNGRlYmFjNGFkNTZiNDU3Y2Q2YjE',\r\n  secretAccessKey: 'TXpNeE4yWm1aR05tTUdZeE5EWXhZemt3TjJRelpqVXpZVFE1WmpRNVkySQ==',\r\n  region: 'cn-beijing', // 替换为你的存储桶地域\r\n  bucket: 'cloth-design01'\r\n};\r\n\r\n// 加载TOS SDK\r\nexport const loadTosSdk = () => {\r\n  return new Promise((resolve, reject) => {\r\n    if (window.TOS) {\r\n      initTosClient();\r\n      resolve(true);\r\n      return;\r\n    }\r\n\r\n    const script = document.createElement('script');\r\n    script.src = 'https://cdn.jsdelivr.net/npm/volcengine-tos-js-sdk@2.6.0/dist/tos-js-sdk.min.js';\r\n    script.onload = () => {\r\n      initTosClient();\r\n      resolve(true);\r\n    };\r\n    script.onerror = () => reject(new Error('TOS SDK加载失败'));\r\n    document.head.appendChild(script);\r\n  });\r\n};\r\n\r\n// 初始化TOS客户端\r\nconst initTosClient = () => {\r\n  if (tosClient) return;\r\n  tosClient = new window.TOS({\r\n    accessKeyId: TOS_CONFIG.accessKeyId,\r\n    secretAccessKey: TOS_CONFIG.secretAccessKey,\r\n    region: TOS_CONFIG.region,\r\n    debug: false\r\n  });\r\n};\r\n\r\n// 上传图片到TOS并返回公网URL\r\nexport const uploadImageToTos = async (file) => {\r\n  if (!file || !tosClient) throw new Error('TOS客户端未初始化或文件为空');\r\n\r\n  // 图片校验\r\n  const maxSize = 5 * 1024 * 1024; // 5MB\r\n  if (file.size > maxSize) throw new Error(`图片大小不能超过${maxSize / 1024 / 1024}MB`);\r\n  \r\n  const validTypes = ['image/jpeg', 'image/png', 'image/webp'];\r\n  if (!validTypes.includes(file.type)) throw new Error('请上传JPG、PNG或WEBP格式的图片');\r\n\r\n  // 生成文件名（按日期分类）\r\n  const date = new Date();\r\n  const year = date.getFullYear();\r\n  const month = String(date.getMonth() + 1).padStart(2, '0');\r\n  const day = String(date.getDate()).padStart(2, '0');\r\n  const fileName = `design-images/${year}/${month}/${day}/${Date.now()}-${file.name.replace(/[^\\w\\.\\-]/g, '')}`;\r\n\r\n  // 上传文件\r\n  await tosClient.putObject({\r\n    Bucket: TOS_CONFIG.bucket,\r\n    Key: fileName,\r\n    Body: file,\r\n    ContentType: file.type,\r\n    ACL: 'public-read' // 公共读权限，确保AI可访问\r\n  });\r\n\r\n  // 返回公网URL\r\n  return `https://${TOS_CONFIG.bucket}.${TOS_CONFIG.region}.tos-cn-beijing.volces.com/${fileName}`;\r\n};\r\n\r\n// 获取TOS配置（供组件使用）\r\nexport const getTosConfig = () => TOS_CONFIG;"]}]}