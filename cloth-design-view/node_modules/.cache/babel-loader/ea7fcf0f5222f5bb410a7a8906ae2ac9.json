AA,cAAA,GAAA;AACA,WAAA,OAAA,GAAA,IAAA;;AACA,UAAA;AACA,YAAA,QAAA;;AACA,gBAAA,KAAA,SAAA;AACA,eAAA,MAAA;AACA,iBAAA,KAAA,GAAA,CAAA,OAAA,EAAA,OAAA,EAAA,MAAA,EAAA,MAAA,EAAA,UAAA,EAAA,YAAA,CAAA;AACA,iBAAA,MAAA,GAAA,CAAA,CAAA,EAAA,CAAA,EAAA,CAAA,EAAA,CAAA,EAAA,CAAA,EAAA,CAAA,CAAA;AACA;;AACA,eAAA,MAAA;AACA;AACA,iBAAA,KAAA,GAAA,CAAA,KAAA,EAAA,MAAA,CAAA;AACA,iBAAA,MAAA,GAAA,CAAA,CAAA,EAAA,EAAA,CAAA;AACA;AATA;;AAWA,aAAA,SAAA;AACA,OAdA,CAcA,OAAA,KAAA,EAAA;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,KAAA,KAAA,SAAA,QAAA,EAAA,KAAA;AACA,OAhBA,SAgBA;AACA,aAAA,OAAA,GAAA,KAAA;AACA;AACA,KAtBA;;AAuBA,IAAA,SAAA,GAAA;AACA,UAAA,CAAA,KAAA,KAAA,CAAA,KAAA,EAAA;AAEA,WAAA,KAAA,GAAA,OAAA,CAAA,IAAA,CAAA,KAAA,KAAA,CAAA,KAAA,CAAA;AACA,YAAA,MAAA,GAAA;AACA,QAAA,KAAA,EAAA;AACA,UAAA,IAAA,EAAA,KAAA,GADA;AAEA,UAAA,IAAA,EAAA,QAFA;AAGA,UAAA,KAAA,EAAA,KAAA;AAHA,SADA;AAMA,QAAA,OAAA,EAAA;AACA,UAAA,OAAA,EAAA,MADA;AAEA,UAAA,SAAA,EAAA;AAFA,SANA;AAUA,QAAA,MAAA,EAAA,CACA;AACA,UAAA,IAAA,EAAA,KAAA,GADA;AAEA,UAAA,IAAA,EAAA,KAFA;AAGA,UAAA,MAAA,EAAA,KAHA;AAIA,UAAA,IAAA,EAAA,KAAA,KAAA,CAAA,GAAA,CAAA,CAAA,IAAA,EAAA,KAAA,MAAA;AACA,YAAA,IAAA,EAAA,IADA;AAEA,YAAA,KAAA,EAAA,KAAA,MAAA,CAAA,KAAA;AAFA,WAAA,CAAA,CAJA;AAQA,UAAA,SAAA,EAAA;AACA;AACA,YAAA,KAAA,EAAA,MAAA,IAAA;AACA,oBAAA,SAAA,GAAA,CACA,SADA,EACA;AACA,uBAFA,EAEA;AACA,uBAHA,EAGA;AACA,uBAJA,EAIA;AACA,uBALA,EAKA;AACA,uBANA,EAMA,SANA,EAMA,SANA,EAMA,SANA,CAAA;AAQA,qBAAA,SAAA,CAAA,MAAA,CAAA,SAAA,GAAA,IAAA,SAAA,CAAA,MAAA,CAAA;AACA;AAZA,WARA;AAsBA,UAAA,KAAA,EAAA;AAAA,YAAA,IAAA,EAAA;AAAA;AAtBA,SADA;AAVA,OAAA;AAqCA,WAAA,KAAA,CAAA,SAAA,CAAA,MAAA;AACA,MAAA,MAAA,CAAA,gBAAA,CAAA,QAAA,EAAA,KAAA,YAAA;AACA,KAlEA;;AAmEA,IAAA,YAAA,GAAA;AACA,WAAA,KAAA,EAAA,MAAA;AACA;;AArEA,GAxBA;;AA+FA,EAAA,aAAA,GAAA;AACA,IAAA,MAAA,CAAA,mBAAA,CAAA,QAAA,EAAA,KAAA,YAAA;AACA,SAAA,KAAA,EAAA,OAAA;AACA;;AAlGA,CAAA","sourcesContent":["<!-- <template>\r\n  <div class=\"line-main\" :style=\"{ backgroundColor: bag }\">\r\n    <div ref=\"chart\" :style=\"{ width: width, height: height }\"></div>\r\n    <div>\r\n      <span class=\"tag\" :style=\"{ color: fontColor }\">\r\n        <i class=\"el-icon-pie-chart\"></i>\r\n        {{ tag }}</span>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport * as echarts from 'echarts'\r\nexport default {\r\n  name: 'PieChart',\r\n  props: {\r\n    types: {\r\n      type: Array,\r\n      default: []\r\n    },\r\n    values: {\r\n      type: Array,\r\n      default: []\r\n    },\r\n    width: {\r\n      type: String,\r\n      default: '100%'\r\n    },\r\n    tag: {\r\n      type: String,\r\n      default: '饼状图'\r\n    },\r\n    height: {\r\n      type: String,\r\n      default: '243px'\r\n    },\r\n    bag: {\r\n      type: String,\r\n      default: '#fff'\r\n    },\r\n    fontColor:{\r\n      type: String,\r\n      default: '#333'\r\n    },\r\n  },\r\n  data() {\r\n    return {\r\n      chart: null,\r\n    }\r\n  },\r\n  watch: {\r\n    types(v1, v2) {\r\n      this.initChart();\r\n    }\r\n  },\r\n  mounted() {\r\n    this.initChart();\r\n  },\r\n  methods: {\r\n    initChart() {\r\n      this.chart = echarts.init(this.$refs.chart)\r\n      let option = {\r\n        title: {\r\n          text: '',\r\n          subtext: '',\r\n          left: 'center'\r\n        },\r\n        tooltip: {\r\n          trigger: 'item'\r\n        },\r\n        legend: {\r\n          orient: 'vertical',\r\n          left: 'left',\r\n          show: false,\r\n        },\r\n        series: [\r\n          {\r\n            name: '',\r\n            type: 'pie',\r\n            radius: '70%',\r\n            avoidLabelOverlap: false,\r\n            label: {\r\n              show: false,\r\n              position: 'center'\r\n            },\r\n            emphasis: {\r\n              label: {\r\n                show: false,\r\n                fontSize: '24',\r\n                fontWeight: '600'\r\n              }\r\n            },\r\n            labelLine: {\r\n              show: true\r\n            },\r\n            label: {\r\n              show: true,\r\n              position: 'outer',\r\n              formatter: '{d}%'\r\n            },\r\n            data: this.values.map((value, index) => ({\r\n              name: this.types[index],\r\n              value: value,\r\n            })),\r\n            itemStyle: {\r\n              color: function (params) {\r\n                const colorList = [\r\n                  '#525288', \r\n                  '#f0a1a8', \r\n                  '#541e24',\r\n                  '#ADD8E6', \r\n                  '#87CEEB',\r\n                  '#6495ED',\r\n                  '#4682B4', \r\n                ];\r\n                return colorList[params.dataIndex % colorList.length];\r\n              }\r\n            }\r\n          }\r\n        ]\r\n      }\r\n      this.chart.setOption(option)\r\n    }\r\n  },\r\n  beforeDestroy() {\r\n    if (this.chart) {\r\n      this.chart.dispose()\r\n    }\r\n  }\r\n}  \r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n.line-main {\r\n  padding-top: 40px;\r\n  margin-bottom: 5px;\r\n  border-radius: 3px;\r\n  background-color: #000000;\r\n\r\n  .tag {\r\n    font-size: 14px;\r\n    text-align: center;\r\n    padding: 15px 6px;\r\n    display: block;\r\n  }\r\n\r\n}\r\n</style> -->\r\n<template>\r\n  <div class=\"pie-main\" :style=\"{ backgroundColor: bag }\">\r\n    <div ref=\"chart\" :style=\"{ width: width, height: height }\"></div>\r\n    <div>\r\n      <span class=\"tag\" :style=\"{ color: fontColor }\">\r\n        <i class=\"el-icon-pie-chart\"></i>\r\n        {{ tag }}\r\n      </span>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport * as echarts from 'echarts';\r\nimport request from '@/utils/request';\r\n\r\nexport default {\r\n  name: 'PieChart',\r\n  props: {\r\n    width: { type: String, default: '100%' },\r\n    height: { type: String, default: '243px' },\r\n    bag: { type: String, default: '#fff' },\r\n    fontColor: { type: String, default: '#333' },\r\n    tag: { type: String, required: true },\r\n    chartType: {\r\n      type: String,\r\n      default: 'tenant'\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      chart: null,\r\n      types: [],\r\n      values: [],\r\n      loading: false\r\n    }\r\n  },\r\n  mounted() {\r\n    this.fetchChartData();\r\n  },\r\n  methods: {\r\n    async fetchChartData() {\r\n      this.loading = true;\r\n      try {\r\n        let response;\r\n        switch (this.chartType) {\r\n          case 'dept':\r\n              this.types = ['沈阳互联网', '北方实验室', '河北至臻', '河北卓越','沈阳凯捷有限公司','沈阳健康执行有限公司'];\r\n              this.values = [4, 4, 4, 5, 2, 2];\r\n            break;\r\n          case 'user':\r\n            // 使用模拟数据 - 管理员和普通用户\r\n            this.types = ['管理员', '普通用户'];\r\n            this.values = [4, 11];\r\n            break;\r\n        }\r\n        this.initChart();\r\n      } catch (error) {\r\n        console.error(`获取${this.chartType}图表数据失败`, error);\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n    initChart() {\r\n      if (!this.$refs.chart) return;\r\n      \r\n      this.chart = echarts.init(this.$refs.chart);\r\n      const option = {\r\n        title: {\r\n          text: this.tag,\r\n          left: 'center',\r\n          color: this.fontColor\r\n        },\r\n        tooltip: {\r\n          trigger: 'item',\r\n          formatter: '{a} <br/>{b}: {c} ({d}%)'\r\n        },\r\n        series: [\r\n          {\r\n            name: this.tag,\r\n            type: 'pie',\r\n            radius: '60%',\r\n            data: this.types.map((type, index) => ({\r\n              name: type,\r\n              value: this.values[index]\r\n            })),\r\n            itemStyle: {\r\n              // 柔和的非荧光颜色方案（蓝绿色调+浅灰）\r\n              color: (params) => {\r\n                const colorList = [\r\n                  '#94C6E8',  // 浅天蓝色\r\n                  '#D8CCC5',  // 浅灰褐色\r\n                  '#B3C6E8',  // 淡薰衣草蓝\r\n                  '#A9B3D5',  // 浅灰蓝色\r\n                  '#D5B3C6' ,  // 浅粉紫色\r\n                  '#D5C6A9' ,'#B3A9D5' ,'#E8A9C6' ,'#A9D5D5'\r\n                ];\r\n                return colorList[params.dataIndex+1 % colorList.length];\r\n              }\r\n            },\r\n            label: { show: true }\r\n          }\r\n        ]\r\n      };\r\n      this.chart.setOption(option);\r\n      window.addEventListener('resize', this.handleResize);\r\n    },\r\n    handleResize() {\r\n      this.chart?.resize();\r\n    }\r\n  },\r\n  beforeDestroy() {\r\n    window.removeEventListener('resize', this.handleResize);\r\n    this.chart?.dispose();\r\n  }\r\n}\r\n</script>"],"sourceRoot":"src/components"}]}