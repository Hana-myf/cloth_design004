{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js!D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js??ref--0-0!D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\components\\LevelMenu.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\components\\LevelMenu.vue","mtime":1753937778307},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":315532800000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":315532800000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["LevelMenu.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAyEA,SAAA,UAAA,QAAA,oBAAA;AACA,OAAA,IAAA,MAAA,uBAAA;AACA,eAAA;AACA,EAAA,IAAA,EAAA,UADA;AAEA,EAAA,UAAA,EAAA;AACA,IAAA;AADA,GAFA;;AAKA,EAAA,IAAA,GAAA;AACA,WAAA;AACA,MAAA,aAAA,EAAA,CADA;AAEA,MAAA,WAAA,EAAA,UAFA;AAGA,MAAA,SAAA,EAAA,QAHA;AAIA,MAAA,OAAA,EAAA,MAJA;AAKA,MAAA,WAAA,EAAA,cALA;AAMA,MAAA,UAAA,EAAA,EANA;AAOA,MAAA,SAAA,EAAA;AAPA,KAAA;AASA,GAfA;;AAgBA,EAAA,KAAA,EAAA;AACA;AACA,IAAA,KAAA,EAAA;AACA,MAAA,IAAA,EAAA,KADA;AAEA,MAAA,QAAA,EAAA;AAFA,KAFA;AAMA;AACA,IAAA,QAAA,EAAA;AACA,MAAA,IAAA,EAAA,MADA;AAEA,MAAA,QAAA,EAAA;AAFA;AAPA,GAhBA;;AA4BA,EAAA,OAAA,GAAA;AACA,SAAA,QAAA,CAAA,KAAA,WAAA;AACA,SAAA,YAAA;AACA,GA/BA;;AAgCA,EAAA,OAAA,EAAA;AACA;AACA,IAAA,MAAA,GAAA;AACA;AACA,UAAA,KAAA,MAAA,CAAA,IAAA,KAAA,gBAAA,EAAA;AACA,QAAA,cAAA,CAAA,OAAA,CAAA,SAAA,EAAA,KAAA,UAAA;AACA;AACA,OALA,CAMA;;;AACA,MAAA,cAAA,CAAA,OAAA,CAAA,SAAA,EAAA,KAAA,UAAA;AACA,WAAA,KAAA,CAAA,eAAA,EAAA,eAAA;AACA,KAXA;;AAYA;AACA,IAAA,eAAA,GAAA;AACA,WAAA,KAAA,CAAA,eAAA,EAAA,QAAA;AACA,KAfA;;AAgBA;AACA,IAAA,QAAA,GAAA;AACA,WAAA,KAAA,CAAA,eAAA,EAAA,UAAA;AACA,KAnBA;;AAoBA;AACA,IAAA,QAAA,GAAA;AACA,WAAA,KAAA,CAAA,eAAA,EAAA,UAAA;AACA,KAvBA;;AAwBA;AACA,IAAA,UAAA,GAAA;AACA,WAAA,KAAA,CAAA,eAAA,EAAA,YAAA;AACA,KA3BA;;AA4BA;AACA,IAAA,gBAAA,GAAA;AACA,WAAA,KAAA,CAAA,eAAA,EAAA,kBAAA;AACA,KA/BA;;AAgCA;AACA,IAAA,QAAA,GAAA;AACA,WAAA,KAAA,CAAA,eAAA,EAAA,UAAA;AACA,KAnCA;;AAoCA,UAAA,YAAA,GAAA;AACA,YAAA,QAAA,GAAA,cAAA,CAAA,OAAA,CAAA,UAAA,CAAA;AACA,YAAA,cAAA,GAAA,IAAA,CAAA,KAAA,CAAA,QAAA,CAAA;AACA,YAAA,eAAA,GAAA;AAAA,QAAA,MAAA,EAAA,cAAA,CAAA,EAAA;AAAA,QAAA,MAAA,EAAA;AAAA,OAAA;AACA,YAAA,QAAA,GAAA,MAAA,KAAA,MAAA,CAAA,IAAA,CAAA,gBAAA,EAAA,eAAA,CAAA;AACA,YAAA;AAAA,QAAA;AAAA,UAAA,QAAA;;AACA,UAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,aAAA,SAAA,GAAA,IAAA,CAAA,IAAA,CAAA,MAAA;AACA;AACA,KA7CA;;AA8CA;AACA,IAAA,QAAA,CAAA,IAAA,EAAA;AACA,UAAA,KAAA,MAAA,CAAA,IAAA,KAAA,IAAA,EAAA;AACA,aAAA,OAAA,CAAA,IAAA,CAAA,IAAA;AACA;AACA,KAnDA;;AAoDA;AACA,IAAA,SAAA,CAAA,IAAA,EAAA,KAAA,EAAA;AACA,WAAA,aAAA,GAAA,KAAA;AACA,WAAA,QAAA,CAAA,IAAA;AACA,KAxDA;;AAyDA;AACA,IAAA,aAAA,GAAA;AACA,WAAA,aAAA,GAAA,IAAA;AACA,WAAA,QAAA,CAAA,KAAA,WAAA;AACA,KA7DA;;AA8DA;AACA,UAAA,GAAA,GAAA;AACA,YAAA,SAAA,GAAA,MAAA,KAAA,YAAA,CAAA;AACA,QAAA,KAAA,EAAA,QADA;AAEA,QAAA,IAAA,EAAA,mBAFA;AAGA,QAAA,IAAA,EAAA;AAHA,OAAA,CAAA;;AAKA,UAAA,SAAA,EAAA;AACA,aAAA,KAAA,CAAA,IAAA,CAAA;AACA,UAAA,KAAA,EAAA,MADA;AAEA,UAAA,IAAA,EAAA,WAFA;AAGA,UAAA,IAAA,EAAA,SAHA;AAGA;AACA,UAAA,iBAAA,EAAA,KAJA;AAIA;AACA,UAAA,KAAA,EAAA,IALA,CAKA;;AALA,SAAA;AAOA,QAAA,UAAA,CAAA,MAAA;AACA,UAAA,UAAA;AACA,eAAA,OAAA,CAAA,IAAA,CAAA,YAAA;AACA,SAHA,EAGA,IAHA,CAAA;AAIA,OAZA,MAYA;AACA,QAAA,OAAA,CAAA,GAAA,CAAA,WAAA;AACA;AACA;;AApFA;AAhCA,CAAA","sourcesContent":["<template>\r\n    <div>\r\n        <ul class=\"nav\">\r\n            <li>\r\n                <Logo />\r\n            </li>\r\n            <!-- 功能菜单 -->\r\n            <li v-if=\"!item.isHidden\" \r\n                :style=\"{\r\n                    fontSize: selectedIndex === index ? '18px' : '14px',\r\n                    color: selectedIndex === index ? '#1c1c1c' : 'rgb(102 102 102)'\r\n                }\" \r\n                class=\"funItem\" \r\n                v-for=\"(item, index) in menus\" \r\n                :key=\"index\" \r\n                @click=\"menuClick(`${item.path}`, index)\">\r\n                <span>\r\n                    <i :class=\"item.icon\"></i>\r\n                    <span>&nbsp; {{ item.name }}</span>\r\n                </span>\r\n            </li>\r\n            <!-- 搜索框 -->\r\n            <li class=\"search-item\">\r\n                <el-row>\r\n                    <el-col :span=\"14\">\r\n                        <input class=\"search-input\" placeholder=\"搜索...\" @keyup.enter=\"search\" v-model=\"filterText\" />\r\n                    </el-col>\r\n                    <el-col :span=\"4\">\r\n                        <span @click=\"search\" class=\"search-btn\">\r\n                            搜索\r\n                        </span>\r\n                    </el-col>\r\n                </el-row>\r\n            </li>\r\n            <!-- 指标记录 -->\r\n            <li class=\"health-record-item\">\r\n                <span @click=\"healthDataRecord\" class=\"health-record-text\">\r\n                    <i class=\"el-icon-edit-outline\"></i>\r\n                    指标记录\r\n                </span>\r\n            </li>\r\n            <!-- 消息中心 -->\r\n            <li class=\"message-item\">\r\n                <el-badge style=\"margin-left: 5px;font-size: 16px;\" v-if=\"noReadMsg !== 0\" :value=\"noReadMsg\">\r\n                    <span class=\"message-span\" @click=\"messageCenter\">\r\n                        <i class=\"el-icon-bell\"></i>\r\n                    </span>\r\n                </el-badge>\r\n                <span style=\"margin-left: 5px;font-size: 16px;\" v-else class=\"message-span\" @click=\"messageCenter\">\r\n                    <i class=\"el-icon-bell\"></i>\r\n                </span>\r\n            </li>\r\n            <!-- 用户信息 -->\r\n            <li class=\"user-item\">\r\n                <span class=\"user-block\">\r\n                    <el-dropdown class=\"user-dropdown\">\r\n                        <span class=\"el-dropdown-link\" style=\"display: flex; align-items: center;\">\r\n                            <el-avatar :size=\"35\" :src=\"userInfo.url\" style=\"margin-top: 0;\"></el-avatar>\r\n                            <span class=\"userName\" style=\"margin-left: 5px;font-size: 16px;\">{{ userInfo.name }}</span>\r\n                            <i class=\"el-icon-arrow-down el-icon--right\" style=\"margin-left: 5px;\"></i>\r\n                        </span>\r\n                        <el-dropdown-menu slot=\"dropdown\">\r\n                            <el-dropdown-item icon=\"el-icon-user\" @click.native=\"userCenterPanel\">个人中心</el-dropdown-item>\r\n                            <el-dropdown-item icon=\"el-icon-warning-outline\" @click.native=\"resetPwd\">修改密码</el-dropdown-item>\r\n                            <el-dropdown-item icon=\"el-icon-back\" @click.native=\"loginOut\">退出登录</el-dropdown-item>\r\n                        </el-dropdown-menu>\r\n                    </el-dropdown>\r\n                </span>\r\n            </li>\r\n        </ul>\r\n    </div>\r\n</template>\r\n<script>\r\nimport { clearToken } from \"@/utils/storage.js\";\r\nimport Logo from '@/components/Logo.vue';\r\nexport default {\r\n    name: \"UserMenu\",\r\n    components: {\r\n        Logo\r\n    },\r\n    data() {\r\n        return {\r\n            selectedIndex: 0,\r\n            messagePath: '/message',\r\n            loginPath: '/login',\r\n            sysName: '纤云速织',\r\n            defaultPath: '/news-record',\r\n            filterText: '',\r\n            noReadMsg: 0,\r\n        }\r\n    },\r\n    props: {\r\n        // 路由菜单数据\r\n        menus: {\r\n            type: Array,\r\n            required: true\r\n        },\r\n        // 用户信息数据\r\n        userInfo: {\r\n            type: Object,\r\n            required: true\r\n        }\r\n    },\r\n    mounted() {\r\n        this.pathToDo(this.defaultPath);\r\n        this.loadMsgCount();\r\n    },\r\n    methods: {\r\n        // 搜索关键词，返回父组件处理\r\n        search() {\r\n            // 如果当前是搜索页面了，更新关键词即可\r\n            if (this.$route.path === '/search-detail') {\r\n                sessionStorage.setItem('keyWord', this.filterText);\r\n                return;\r\n            }\r\n            // 将关键词存起来\r\n            sessionStorage.setItem('keyWord', this.filterText);\r\n            this.$emit('eventListener', 'search-detail');\r\n        },\r\n        // 个人中心，传回父组件处理\r\n        userCenterPanel() {\r\n            this.$emit('eventListener', 'center');\r\n        },\r\n        // 重置密码，传回父组件处理\r\n        resetPwd() {\r\n            this.$emit('eventListener', 'resetPwd');\r\n        },\r\n        // 退出登录，传回父组件处理\r\n        loginOut() {\r\n            this.$emit('eventListener', 'loginOut');\r\n        },\r\n        // 记录饮食，传回父组件处理\r\n        dietRecord() {\r\n            this.$emit('eventListener', 'dietRecord');\r\n        },\r\n        // 记录个人健康指标，传回父组件处理\r\n        healthDataRecord() {\r\n            this.$emit('eventListener', 'healthDataRecord');\r\n        },\r\n        // 退出登录，传回父组件处理\r\n        loginOut() {\r\n            this.$emit('eventListener', 'loginOut');\r\n        },\r\n        async loadMsgCount() {\r\n            const userInfo = sessionStorage.getItem('userInfo');\r\n            const userInfoEntity = JSON.parse(userInfo);\r\n            const messageQueryDto = { userId: userInfoEntity.id, isRead: false }\r\n            const response = await this.$axios.post(`/message/query`, messageQueryDto);\r\n            const { data } = response;\r\n            if(data.code === 200){\r\n                this.noReadMsg = data.data.length;\r\n            }\r\n        },\r\n        // 不是存量路由，则跳转\r\n        pathToDo(path) {\r\n            if (this.$route.path !== path) {\r\n                this.$router.push(path);\r\n            }\r\n        },\r\n        //路由跳转\r\n        menuClick(path, index) {\r\n            this.selectedIndex = index;\r\n            this.pathToDo(path);\r\n        },\r\n        // 消息中心\r\n        messageCenter() {\r\n            this.selectedIndex = null;\r\n            this.pathToDo(this.messagePath);\r\n        },\r\n        // 退出登录\r\n        async out() {\r\n            const confirmed = await this.$swalConfirm({\r\n                title: '是否退出登录',\r\n                text: `退出后将重新登录，才能使用系统功能`,\r\n                icon: 'warning',\r\n            });\r\n            if (confirmed) {\r\n                this.$swal.fire({\r\n                    title: '退出登录',\r\n                    text: '您已成功退出登录。',\r\n                    icon: 'success', // 使用'success'图标表示操作成功\r\n                    showConfirmButton: false, // 隐藏确认按钮，使得弹窗只展示信息后自动关闭\r\n                    timer: 1300, // 自动关闭弹窗的延迟时间，这里是2秒\r\n                });\r\n                setTimeout(() => {\r\n                    clearToken();\r\n                    this.$router.push('/loginPath');\r\n                }, 1300)\r\n            } else {\r\n                console.log('用户取消了退出操作');\r\n            }\r\n        },\r\n    }\r\n}\r\n</script>\r\n<style scoped lang=\"scss\">\r\n.nav {\r\n    padding: 12px 20px; /* 调整整体内边距，避免右侧内容溢出 */\r\n    height: 70px;\r\n    line-height: 70px;\r\n    list-style: none;\r\n    border-bottom: 1px solid #f1f1f1;\r\n    margin: 0;\r\n    display: flex; /* 使用flex布局更易控制间距 */\r\n    align-items: center;\r\n    justify-content: flex-start;\r\n\r\n    li {\r\n        float: left;\r\n        height: 70px;\r\n        line-height: 70px;\r\n        font-weight: 400;\r\n        padding: 0 15px; /* 统一基础间距 */\r\n        user-select: none;\r\n        color: rgb(102, 102, 102);\r\n        font-size: 14px;\r\n        transition: all 0.5s;\r\n\r\n        i {\r\n            color: rgb(102, 102, 102);\r\n        }\r\n    }\r\n}\r\n\r\n/* 搜索框容器样式 - 作为按钮定位的父容器 */\r\n.search-item {\r\n    margin-left: 3px;\r\n    padding: 0 10px;\r\n    min-width: 300px;\r\n    position: relative; /* 关键：让按钮基于此容器定位 */\r\n}\r\n\r\n/* 搜索输入框样式 - 预留按钮空间 */\r\n.search-input {\r\n    outline: none;\r\n    width: 100%;\r\n    font-size: 14px;\r\n    height: 35px;\r\n    line-height: 35px;\r\n    /* 右侧预留按钮+边距空间（按钮宽约60px+左右边距10px=70px） */\r\n    padding: 0 70px 0 15px; \r\n    border-radius: 5px;\r\n    transition: all 0.3s;\r\n    border: 1px solid #ccc;\r\n    box-sizing: border-box; /* 确保padding不撑开输入框 */\r\n}\r\n\r\n/* 搜索按钮样式 - 内嵌在输入框内右侧 */\r\n.search-btn {\r\n    /* 绝对定位实现内嵌效果 */\r\n    position: absolute;\r\n    right: 15px; /* 距离容器右侧的间距（与输入框左侧padding呼应） */\r\n    top: 50%;\r\n    transform: translateY(-50%); /* 垂直居中对齐 */\r\n    \r\n    /* 按钮尺寸小于搜索框 */\r\n    height: 28px; /* 比输入框矮7px */\r\n    line-height: 28px; /* 文字垂直居中 */\r\n    min-width: 50px; /* 按钮最小宽度，小于输入框宽度 */\r\n    width: auto; /* 取消100%宽度，按内容自适应 */\r\n    \r\n    background-color: #000;\r\n    color: #f1f1f1;\r\n    border-radius: 3px; /* 圆角比输入框小，更精致 */\r\n    padding: 0 12px; /* 水平内边距 */\r\n    text-align: center;\r\n    cursor: pointer;\r\n    font-size: 13px; /* 字体稍小，适配按钮尺寸 */\r\n    border: none; /* 去掉默认边框 */\r\n    box-shadow: 0 1px 2px rgba(0,0,0,0.1); /* 轻微阴影，突出按钮 */\r\n}\r\n\r\n/* 交互效果优化 */\r\n.search-btn:hover {\r\n    background-color: #333; /* 悬停时加深颜色 */\r\n}\r\n\r\n.search-input:focus {\r\n    border-color: #666; /* 输入框聚焦时边框变色 */\r\n    box-shadow: 0 0 0 2px rgba(0,0,0,0.05); /* 轻微聚焦效果 */\r\n}\r\n\r\n/* 指标记录样式 */\r\n.health-record-item {\r\n    padding: 0 15px;\r\n    margin-left: 10px; /* 与搜索框保持距离 */\r\n}\r\n\r\n.health-record-text {\r\n    cursor: pointer;\r\n    padding: 5px 8px;\r\n    border-radius: 4px;\r\n    transition: background-color 0.2s;\r\n\r\n    &:hover {\r\n        background-color: #f5f5f5;\r\n    }\r\n}\r\n\r\n/* 消息中心样式 */\r\n.message-item {\r\n    padding: 0 15px;\r\n    margin-left: 5px;\r\n}\r\n\r\n.message-span {\r\n    padding: 5px;\r\n    border-radius: 5px;\r\n    cursor: pointer;\r\n\r\n    &:hover {\r\n        background-color: rgb(240, 240, 240);\r\n    }\r\n\r\n    i {\r\n        font-size: 16px;\r\n    }\r\n}\r\n\r\n/* 用户信息样式 */\r\n.user-item {\r\n    padding: 0 20px;\r\n    margin-left: 10px;\r\n    position: relative;\r\n}\r\n\r\n.user-block {\r\n    .userName {\r\n        display: inline-block;\r\n        vertical-align: middle;\r\n        font-size: 14px;\r\n        cursor: pointer;\r\n        user-select: none;\r\n    }\r\n}\r\n\r\n/* 修复搜索框聚焦样式拼写错误 */\r\n.search-input:focus {\r\n    border: 1px solid rgb(188, 229, 247);\r\n    outline: none;\r\n}\r\n</style>"],"sourceRoot":"src/components"}]}