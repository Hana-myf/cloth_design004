{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js!D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js??ref--0-0!D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\DetailOptimization.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\DetailOptimization.vue","mtime":1757574555581},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":315532800000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["DetailOptimization.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAyHA,OAAA,KAAA,MAAA,OAAA,C,CACA;;AACA,OAAA,aAAA,MAAA,gCAAA;AACA,OAAA,aAAA,MAAA,gCAAA;AACA,OAAA,cAAA,MAAA,iCAAA;AACA,OAAA,oBAAA,MAAA,uCAAA;AAEA,eAAA;AACA,EAAA,UAAA,EAAA;AACA,IAAA,aADA;AAEA,IAAA,aAFA;AAGA,IAAA,cAHA;AAIA,IAAA;AAJA,GADA;;AAOA,EAAA,IAAA,GAAA;AACA,WAAA;AACA,MAAA,WAAA,EAAA,EADA;AAEA,MAAA,SAAA,EAAA,EAFA;AAGA,MAAA,WAAA,EAAA,EAHA;AAIA,MAAA,SAAA,EAAA,KAJA;AAKA,MAAA,aAAA,EAAA,IALA;AAMA,MAAA,aAAA,EAAA,IANA;AAOA;AACA,MAAA,uBAAA,EAAA,IARA;AAQA;AACA,MAAA,aAAA,EAAA,EATA;AASA;AACA;AACA,MAAA,WAAA,EAAA,kCAXA;AAYA;AACA,MAAA,aAAA,EAAA;AACA;AACA,QAAA,MAAA,EAAA,0EAFA;AAGA,QAAA,MAAA,EAAA,sCAHA;AAIA,QAAA,OAAA,EAAA,gCAJA;AAKA;AACA,QAAA,eAAA,EAAA;AANA;AAbA,KAAA;AAsBA,GA9BA;;AA+BA,EAAA,QAAA,EAAA;AACA,IAAA,cAAA,GAAA;AACA;AACA,aAAA,CAAA,KAAA,SAAA,KACA,KAAA,SAAA,CAAA,IAAA,OAAA,EAAA,IACA,KAAA,aAAA,KAAA,IADA,IAEA,KAAA,aAAA,KAAA,IAFA,IAGA,KAAA,uBAAA,KAAA,IAHA,IAIA,KAAA,aAAA,CAAA,IAAA,OAAA,EALA,CAAA;AAOA;;AAVA,GA/BA;AA2CA,EAAA,OAAA,EAAA;AACA;AACA,IAAA,iBAAA,CAAA,SAAA,EAAA;AACA,WAAA,SAAA,GAAA,KAAA,SAAA,CAAA,KAAA,SAAA,SAAA,CAAA,IAAA,EAAA;AACA,WAAA,QAAA,CAAA,OAAA,CAAA,QAAA,SAAA,CAAA,KAAA,MAAA;AACA,KALA;;AAMA;AACA,IAAA,cAAA,CAAA,MAAA,EAAA;AACA,WAAA,aAAA,GAAA,MAAA;AACA,WAAA,QAAA,CAAA,OAAA,CAAA,SAAA,MAAA,CAAA,IAAA,EAAA;AACA,KAVA;;AAWA;AACA,IAAA,eAAA,CAAA,MAAA,EAAA;AACA,WAAA,aAAA,GAAA,MAAA,CAAA,KAAA,CAAA,CAAA,EAAA,CAAA,CAAA;AACA,WAAA,QAAA,CAAA,OAAA,CAAA,SAAA;AACA,KAfA;;AAiBA;AACA;AACA;AACA,UAAA,iBAAA,CAAA,IAAA,EAAA;AACA,YAAA,SAAA,GAAA,IAAA,CAAA,GAAA;AACA,UAAA,CAAA,SAAA,IAAA,KAAA,SAAA,EAAA;AAEA,WAAA,SAAA,GAAA,IAAA;AACA,WAAA,QAAA,CAAA,IAAA,CAAA,WAAA;AACA,YAAA,QAAA,GAAA,IAAA,QAAA,EAAA;AACA,MAAA,QAAA,CAAA,MAAA,CAAA,OAAA,EAAA,SAAA;;AAEA,UAAA;AACA,cAAA,QAAA,GAAA,MAAA,KAAA,CAAA,sCAAA,KAAA,WAAA,EAAA,EAAA;AACA,UAAA,MAAA,EAAA,MADA;AAEA,UAAA,IAAA,EAAA;AAFA,SAAA,CAAA;AAIA,cAAA,MAAA,GAAA,MAAA,QAAA,CAAA,IAAA,EAAA;;AAEA,YAAA,MAAA,CAAA,OAAA,EAAA;AACA,eAAA,uBAAA,GAAA,MAAA,CAAA,IAAA,CAAA,GAAA,CADA,CACA;;AACA,eAAA,aAAA,GAAA,EAAA,CAFA,CAEA;;AACA,eAAA,QAAA,CAAA,OAAA,CAAA,SAAA;AACA,SAJA,MAIA;AAAA;;AACA,gBAAA,IAAA,KAAA,CAAA,kBAAA,MAAA,CAAA,KAAA,gEAAA,OAAA,KAAA,gBAAA,CAAA;AACA;AACA,OAdA,CAcA,OAAA,KAAA,EAAA;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,SAAA,EAAA,KAAA;AACA,aAAA,QAAA,CAAA,KAAA,CAAA,QAAA,KAAA,CAAA,OAAA,IAAA,MAAA,EAAA;AACA,OAjBA,SAiBA;AACA,aAAA,SAAA,GAAA,KAAA;AACA;AACA,KAjDA;;AAmDA;AACA;AACA;AACA,IAAA,WAAA,GAAA;AACA,UAAA,CAAA,KAAA,cAAA,EAAA,OADA,CAGA;;AACA,YAAA,aAAA,GAAA,KAAA,aAAA,CAAA,IAAA,MAAA,KAAA,uBAAA;AAEA,YAAA,WAAA,GAAA;AACA,QAAA,IAAA,EAAA,MADA;AAEA,QAAA,IAAA,EAAA,KAAA,SAFA;AAGA,QAAA,MAAA,EAAA,KAAA,aAHA;AAIA,QAAA,MAAA,EAAA,KAAA,aAJA;AAKA,QAAA,QAAA,EAAA;AALA,OAAA;AAOA,WAAA,WAAA,CAAA,IAAA,CAAA,WAAA,EAbA,CAeA;;AACA,WAAA,kBAAA,CAAA,aAAA,EAhBA,CAkBA;;AACA,WAAA,SAAA,GAAA,EAAA;AACA,WAAA,aAAA,GAAA,IAAA;AACA,WAAA,aAAA,GAAA,IAAA;AACA,WAAA,uBAAA,GAAA,IAAA;AACA,WAAA,aAAA,GAAA,EAAA;AACA,KA9EA;;AAgFA;AACA;AACA;AACA;AACA,UAAA,kBAAA,CAAA,QAAA,EAAA;AACA,WAAA,SAAA,GAAA,IAAA,CADA,CAGA;;AACA,UAAA,UAAA,GAAA,KAAA,SAAA,CAAA,IAAA,EAAA;AACA,UAAA,KAAA,aAAA,EAAA,UAAA,IAAA,OAAA,KAAA,aAAA,CAAA,IAAA,MAAA;;AACA,UAAA,KAAA,aAAA,EAAA;AACA,cAAA,YAAA,GAAA,KAAA,aAAA,CAAA,GAAA,CAAA,CAAA,IAAA,CAAA,CAAA,GAAA,EAAA,IAAA,CAAA,GAAA,CAAA;AACA,QAAA,UAAA,IAAA,SAAA,YAAA,GAAA;AACA;;AACA,UAAA,CAAA,UAAA,EAAA,UAAA,GAAA,mBAAA;AAEA,YAAA,gBAAA,GAAA,QAAA,IAAA,KAAA,aAAA,CAAA,eAAA,CAZA,CAcA;AACA;;AACA,YAAA,uBAAA,GAAA;AACA,QAAA,MAAA,EAAA,UADA;AAEA,QAAA,QAAA,EAAA;AAFA,OAAA;;AAKA,UAAA;AAAA;;AACA;AACA,cAAA,QAAA,GAAA,MAAA,KAAA,CAAA,IAAA,CACA,uBADA,EACA;AACA,QAAA,uBAFA,CAGA;AAHA,SAAA,CAFA,CAQA;;AACA,cAAA,gBAAA,GAAA,QAAA,CAAA,IAAA;;AAEA,YAAA,gBAAA,CAAA,KAAA,EAAA;AACA,gBAAA,IAAA,KAAA,CAAA,cAAA,gBAAA,CAAA,KAAA,CAAA,OAAA,EAAA,CAAA;AACA;;AAEA,cAAA,MAAA,4BAAA,gBAAA,CAAA,OAAA,0DAAA,sBAAA,CAAA,CAAA;AACA,cAAA,cAAA,GAAA,MAAA,aAAA,MAAA,0CAAA,MAAA,CAAA,OAAA,oDAAA,gBAAA,OAAA;;AAEA,YAAA,CAAA,cAAA,EAAA;AACA,gBAAA,IAAA,KAAA,CAAA,kBAAA,CAAA;AACA;;AAEA,cAAA,QAAA,GAAA,cAAA,CAAA,KAAA,CAAA,aAAA,CAAA;;AACA,YAAA,CAAA,QAAA,IAAA,CAAA,QAAA,CAAA,CAAA,CAAA,EAAA;AACA,gBAAA,IAAA,KAAA,CAAA,sBAAA,CAAA;AACA;;AACA,cAAA,iBAAA,GAAA,QAAA,CAAA,CAAA,CAAA,CA1BA,CA4BA;;AACA,aAAA,WAAA,CAAA,IAAA,CAAA;AACA,UAAA,IAAA,EAAA,IADA;AAEA,UAAA,IAAA,EAAA,eAFA;AAGA,UAAA,QAAA,EAAA,iBAHA;AAIA,UAAA,KAAA,EAAA;AAJA,SAAA;AAOA,OApCA,CAoCA,OAAA,KAAA,EAAA;AAAA;;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,UAAA,EAAA,KAAA;AACA,cAAA,SAAA,GAAA,UAAA,oBAAA,KAAA,CAAA,QAAA,4FAAA,IAAA,8EAAA,KAAA,KAAA,KAAA,CAAA,OAAA,IAAA,QAAA,EAAA;AACA,aAAA,WAAA,CAAA,IAAA,CAAA;AAAA,UAAA,IAAA,EAAA,IAAA;AAAA,UAAA,IAAA,EAAA;AAAA,SAAA;AACA,aAAA,QAAA,CAAA,KAAA,CAAA,SAAA;AACA,OAzCA,SAyCA;AACA,aAAA,SAAA,GAAA,KAAA;AACA;AACA,KArJA;;AAuJA;AACA,IAAA,aAAA,CAAA,QAAA,EAAA,KAAA,EAAA;AACA,UAAA,KAAA,WAAA,CAAA,MAAA,IAAA,CAAA,EAAA,KAAA,WAAA,CAAA,KAAA;AACA,WAAA,WAAA,CAAA,IAAA,CAAA;AACA,QAAA,QAAA,EAAA,QADA;AAEA,QAAA,SAAA,EAAA,KAAA,IAAA,QAAA,IAAA,IAAA,GAAA,OAAA,EAAA;AAFA,OAAA;AAIA,WAAA,QAAA,CAAA,OAAA,CAAA,SAAA;AACA;;AA/JA;AA3CA,CAAA","sourcesContent":["<template>\r\n  <div class=\"detail-optimization\">\r\n    <!-- 页面标题 -->\r\n    <div class=\"page-header\">\r\n      <h1>细节优化工具</h1>\r\n      <p>上传图片/输入公网链接 → 选择素材 → 生成方案</p>\r\n    </div>\r\n\r\n    <!-- 主布局：左（工具）- 中（交互）- 右（成果） -->\r\n    <div class=\"main-layout\">\r\n      <!-- 左侧工具区 -->\r\n      <div class=\"tools-area\">\r\n        <div class=\"tools-title\">设计工具</div>\r\n        <fabric-library \r\n          @select=\"onFabricSelect\" \r\n          class=\"tool-component fabric-component\"\r\n        ></fabric-library>\r\n        <color-extractor \r\n          @apply-colors=\"onColorsApplied\"\r\n          class=\"tool-component color-component\"\r\n        ></color-extractor>\r\n        <CollocationAssistant\r\n          class=\"tool-component assistant-component\"\r\n          @select-recommend=\"onRecommendSelect\"\r\n        ></CollocationAssistant>\r\n      </div>\r\n\r\n      <!-- 中间交互区 -->\r\n      <div class=\"interaction-area\">\r\n        <div class=\"interaction-title\">AI设计对话</div>\r\n        <div class=\"chat-content\">\r\n          <div class=\"system-message\">\r\n            请上传参考图片、输入公网链接或描述，我会生成设计方案\r\n          </div>\r\n          <!-- 聊天记录渲染（保持不变） -->\r\n          <div v-for=\"(msg, index) in chatRecords\" :key=\"index\" class=\"chat-bubble\">\r\n            <div class=\"bubble-avatar\">{{ msg.role === 'user' ? '我' : 'AI' }}</div>\r\n            <div class=\"bubble-content\">\r\n              <template v-if=\"msg.role === 'user'\">\r\n                <div v-if=\"msg.fabric\" class=\"selected-fabric-tag\">已选择面料：{{ msg.fabric.name }}</div>\r\n                <div v-if=\"msg.colors\" class=\"selected-colors\">\r\n                  <span class=\"tag\">已选择色彩：</span>\r\n                  <div class=\"color-swatch-container\">\r\n                    <div v-for=\"(color, cIndex) in msg.colors\" :key=\"cIndex\" class=\"color-swatch\" :style=\"{ backgroundColor: color.hex }\" :title=\"color.hex\"></div>\r\n                  </div>\r\n                </div>\r\n                <p v-if=\"msg.text\">{{ msg.text }}</p>\r\n                <div v-if=\"msg.imageUrl\" class=\"user-image\">\r\n                  <img :src=\"msg.imageUrl\" alt=\"用户参考图片\">\r\n                </div>\r\n              </template>\r\n              <template v-if=\"msg.role === 'ai'\">\r\n                <p v-if=\"msg.text\">{{ msg.text }}</p>\r\n                <div v-if=\"msg.imageUrl\" class=\"ai-image\">\r\n                  <img :src=\"msg.imageUrl\" alt=\"AI生成方案\" @click=\"saveToGallery(msg.imageUrl, msg.title)\">\r\n                  <div class=\"image-action\">点击保存到右侧成果库</div>\r\n                </div>\r\n              </template>\r\n            </div>\r\n          </div>\r\n          <div v-if=\"isLoading\" class=\"loading\">\r\n            <div class=\"custom-spinner\"></div>\r\n            <p>方案生成中...</p>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 输入区 -->\r\n        <div class=\"input-area\">\r\n          <div class=\"input-controls\">\r\n            <!-- 【新增】公网URL输入框 -->\r\n            <el-input \r\n              v-model=\"imageUrlInput\" \r\n              placeholder=\"在此粘贴公共图片URL\" \r\n              class=\"url-input\"\r\n              clearable\r\n            ></el-input>\r\n            \r\n            <el-upload\r\n              class=\"image-uploader\"\r\n              action=\"\"\r\n              :auto-upload=\"false\"\r\n              :on-change=\"handleImageUpload\"\r\n              :show-file-list=\"false\"\r\n              accept=\"image/jpeg,image/png,image/webp\"\r\n              :disabled=\"isLoading\"\r\n            >\r\n              <el-button type=\"primary\" icon=\"el-icon-upload\" :disabled=\"!!imageUrlInput\">上传本地图片</el-button>\r\n            </el-upload>\r\n          </div>\r\n          \r\n          <div class=\"main-input-row\">\r\n            <el-input \r\n              v-model=\"userInput\" \r\n              placeholder=\"输入设计需求，例如：改成赛博朋克风格...\" \r\n              class=\"text-input\"\r\n              @keyup.enter.native=\"sendMessage\"\r\n            ></el-input>\r\n            <el-button \r\n              type=\"primary\" \r\n              @click=\"sendMessage\"\r\n              class=\"send-btn\"\r\n              :disabled=\"!canSendMessage\"\r\n            >\r\n              发送\r\n            </el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 右侧成果区 -->\r\n      <div class=\"gallery-area\">\r\n        <div class=\"gallery-title\">我的成果库</div>\r\n        <image-save-list \r\n          :saved-images=\"savedImages\"\r\n        ></image-save-list>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n// 引入其他组件（保持不变）\r\nimport FabricLibrary from '@/components/FabricLibrary.vue';\r\nimport ImageSaveList from '@/components/ImageSaveList.vue';\r\nimport ColorExtractor from '@/components/ColorExtractor.vue';\r\nimport CollocationAssistant from '@/components/CollocationAssistant.vue';\r\n\r\nexport default {\r\n  components: {\r\n    FabricLibrary,\r\n    ImageSaveList,\r\n    ColorExtractor,\r\n    CollocationAssistant\r\n  },\r\n  data() {\r\n    return {\r\n      chatRecords: [],\r\n      userInput: '',\r\n      savedImages: [],\r\n      isLoading: false,\r\n      currentFabric: null,\r\n      currentColors: null,\r\n      // 状态管理\r\n      currentUploadedImageUrl: null, // 存储由上传功能生成的URL\r\n      imageUrlInput: '', // 【新增】绑定公网URL输入框\r\n      // ImgBB的API Key (用于上传功能)\r\n      imgbbApiKey: 'ddfd3ce61ba74d50a1d1167d498e4c0f',\r\n      // 大模型配置\r\n      aiModelConfig: {\r\n        // 【重要】更换为更稳定的代理，并修复了之前的404问题\r\n        apiUrl: \"https://proxy.cors.sh/https://ark.volcengine.com/api/v3/chat/completions\",\r\n        apiKey: \"f2390958-8c5a-424a-9021-651e920c2bc4\",\r\n        modelId: \"doubao-seededit-3-0-i2i-250628\",\r\n        // 默认图，当用户未提供任何图片时使用\r\n        defaultImageUrl: \"https://ark-project.tos-cn-beijing.volces.com/doc_image/seededit_i2i.jpeg\"\r\n      }\r\n    };\r\n  },\r\n  computed: {\r\n    canSendMessage() {\r\n      // 只要有任何输入，或选择了素材，就可以发送\r\n      return !this.isLoading && (\r\n             this.userInput.trim() !== '' || \r\n             this.currentFabric !== null || \r\n             this.currentColors !== null ||\r\n             this.currentUploadedImageUrl !== null ||\r\n             this.imageUrlInput.trim() !== ''\r\n      );\r\n    }\r\n  },\r\n  methods: {\r\n    // 推荐搭配选择\r\n    onRecommendSelect(recommend) {\r\n      this.userInput = `按【${recommend.style}】风格设计：${recommend.desc}`;\r\n      this.$message.success(`已为你填充${recommend.style}搭配需求`);\r\n    },\r\n    // 面料选择\r\n    onFabricSelect(fabric) {\r\n      this.currentFabric = fabric;\r\n      this.$message.success(`已选择面料：${fabric.name}`);\r\n    },\r\n    // 色彩选择\r\n    onColorsApplied(colors) {\r\n      this.currentColors = colors.slice(0, 4);\r\n      this.$message.success('已选择色彩方案');\r\n    },\r\n\r\n    /**\r\n     * 【保留】处理本地图片上传，使用 ImgBB 转换为公网 URL\r\n     */\r\n    async handleImageUpload(file) {\r\n      const imageFile = file.raw;\r\n      if (!imageFile || this.isLoading) return;\r\n      \r\n      this.isLoading = true;\r\n      this.$message.info('正在上传图片...');\r\n      const formData = new FormData();\r\n      formData.append('image', imageFile);\r\n\r\n      try {\r\n        const response = await fetch(`https://api.imgbb.com/1/upload?key=${this.imgbbApiKey}`, {\r\n          method: 'POST',\r\n          body: formData,\r\n        });\r\n        const result = await response.json();\r\n\r\n        if (result.success) {\r\n          this.currentUploadedImageUrl = result.data.url; // 存储上传后的URL\r\n          this.imageUrlInput = ''; // 清空URL输入框，以上传的为准\r\n          this.$message.success('图片上传成功！');\r\n        } else {\r\n          throw new Error(result.error?.message || 'ImgBB API 返回错误');\r\n        }\r\n      } catch (error) {\r\n        console.error('图片上传失败：', error);\r\n        this.$message.error(`上传失败：${error.message || '未知错误'}`);\r\n      } finally {\r\n        this.isLoading = false;\r\n      }\r\n    },\r\n\r\n    /**\r\n     * 发送消息，触发AI生成\r\n     */\r\n    sendMessage() {\r\n      if (!this.canSendMessage) return;\r\n      \r\n      // 决定最终使用的图片URL：优先使用输入框的，其次是上传的\r\n      const finalImageUrl = this.imageUrlInput.trim() || this.currentUploadedImageUrl;\r\n      \r\n      const userMessage = {\r\n        role: 'user',\r\n        text: this.userInput,\r\n        fabric: this.currentFabric,\r\n        colors: this.currentColors,\r\n        imageUrl: finalImageUrl\r\n      };\r\n      this.chatRecords.push(userMessage);\r\n\r\n      // 调用AI生成，并传递最终确认的图片URL\r\n      this.generateAIResponse(finalImageUrl);\r\n      \r\n      // 清空输入状态\r\n      this.userInput = '';\r\n      this.currentFabric = null;\r\n      this.currentColors = null;\r\n      this.currentUploadedImageUrl = null;\r\n      this.imageUrlInput = '';\r\n    },\r\n\r\n    /**\r\n     * 【已重写】调用火山引擎大模型API\r\n     * @param {string | null} imageUrl 最终确认要使用的公网图片URL\r\n     */\r\n     async generateAIResponse(imageUrl) {\r\n      this.isLoading = true;\r\n\r\n      // 1. 组合完整的用户指令 (逻辑不变)\r\n      let fullPrompt = this.userInput.trim();\r\n      if (this.currentFabric) fullPrompt += ` 使用【${this.currentFabric.name}】面料。`;\r\n      if (this.currentColors) {\r\n        const colorHexList = this.currentColors.map(c => c.hex).join('、');\r\n        fullPrompt += ` 搭配颜色：${colorHexList}。`;\r\n      }\r\n      if (!fullPrompt) fullPrompt = \"根据我提供的图片和素材进行优化设计\";\r\n      \r\n      const finalApiImageUrl = imageUrl || this.aiModelConfig.defaultImageUrl;\r\n\r\n      // 2. 【核心修改】构建发送给我们自己后端代理的数据\r\n      // 我们不再构建复杂的火山引擎请求体，只把需要的数据发给后端\r\n      const requestDataToOurBackend = {\r\n        prompt: fullPrompt,\r\n        imageUrl: finalApiImageUrl\r\n      };\r\n\r\n      try {\r\n        // 3. 【核心修改】请求我们自己的后端接口，例如 '/api/proxy-volcengine'\r\n        const response = await axios.post(\r\n          '/api/proxy-volcengine', // 请求我们自己！\r\n          requestDataToOurBackend\r\n          // 注意：这里不再需要 API Key，它将被安全地配置在后端\r\n        );\r\n\r\n        // 4. 解析从我们后端代理转发回来的、火山引擎的真实数据\r\n        const volcResponseData = response.data;\r\n\r\n        if (volcResponseData.error) {\r\n           throw new Error(`火山引擎API错误: ${volcResponseData.error.message}`);\r\n        }\r\n        \r\n        const choice = volcResponseData.choices?.[0];\r\n        const messageContent = choice?.message?.content;\r\n\r\n        if (!messageContent) {\r\n          throw new Error('火山引擎未返回有效的设计方案内容');\r\n        }\r\n\r\n        const urlMatch = messageContent.match(/\\(([^)]+)\\)/);\r\n        if (!urlMatch || !urlMatch[1]) {\r\n           throw new Error('无法从火山引擎返回内容中解析出图片URL');\r\n        }\r\n        const generatedImageUrl = urlMatch[1];\r\n        \r\n        // 5. 将成功的结果展示在聊天记录中 (逻辑不变)\r\n        this.chatRecords.push({\r\n          role: 'ai',\r\n          text: '已根据您的需求生成新方案：',\r\n          imageUrl: generatedImageUrl,\r\n          title: `AI设计方案`\r\n        });\r\n\r\n      } catch (error) {\r\n        console.error('大模型调用失败：', error);\r\n        const errorText = `❌ 生成失败：${error.response?.data?.error || error.message || '未知网络错误'}`;\r\n        this.chatRecords.push({ role: 'ai', text: errorText });\r\n        this.$message.error(errorText);\r\n      } finally {\r\n        this.isLoading = false;\r\n      }\r\n    },\r\n\r\n    // 保存到成果库（保持不变）\r\n    saveToGallery(imageUrl, title) {\r\n      if (this.savedImages.length >= 4) this.savedImages.shift();\r\n      this.savedImages.push({\r\n        imageUrl: imageUrl,\r\n        imageName: title || `设计方案_${new Date().getTime()}`\r\n      });\r\n      this.$message.success('已保存到成果库');\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 为了新加的输入框，微调一下样式 */\r\n.input-area {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  padding: 10px;\r\n  border-top: 1px solid #e0e0e0;\r\n}\r\n.input-controls {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n}\r\n.url-input {\r\n  flex-grow: 1;\r\n}\r\n.main-input-row {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n.text-input {\r\n  flex-grow: 1;\r\n}\r\n/* 其他样式保持不变 */\r\n.detail-optimization {\r\n  padding: 20px;\r\n  background-color: #f4f6f8;\r\n  height: 100vh;\r\n  box-sizing: border-box;\r\n}\r\n.page-header {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n}\r\n.page-header h1 {\r\n  font-size: 28px;\r\n  color: #333;\r\n}\r\n.page-header p {\r\n  color: #888;\r\n}\r\n.main-layout {\r\n  display: grid;\r\n  grid-template-columns: 280px 1fr 300px;\r\n  gap: 20px;\r\n  height: calc(100vh - 120px);\r\n}\r\n.tools-area, .interaction-area, .gallery-area {\r\n  background-color: #fff;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.05);\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n.tools-title, .interaction-title, .gallery-title {\r\n  padding: 15px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  border-bottom: 1px solid #eee;\r\n}\r\n.tool-component {\r\n  margin: 10px;\r\n}\r\n.interaction-area {\r\n  height: 100%;\r\n}\r\n.chat-content {\r\n  flex-grow: 1;\r\n  overflow-y: auto;\r\n  padding: 15px;\r\n}\r\n.system-message {\r\n  text-align: center;\r\n  color: #aaa;\r\n  font-size: 12px;\r\n  margin-bottom: 15px;\r\n}\r\n.chat-bubble {\r\n  display: flex;\r\n  margin-bottom: 15px;\r\n  max-width: 90%;\r\n}\r\n.chat-bubble .bubble-avatar {\r\n  width: 36px;\r\n  height: 36px;\r\n  border-radius: 50%;\r\n  background-color: #007bff;\r\n  color: white;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-weight: bold;\r\n  margin-right: 10px;\r\n  flex-shrink: 0;\r\n}\r\n.chat-bubble .bubble-content {\r\n  background-color: #f0f0f0;\r\n  border-radius: 12px;\r\n  padding: 10px 15px;\r\n  word-break: break-word;\r\n}\r\n.chat-bubble .user-image, .chat-bubble .ai-image {\r\n  margin-top: 8px;\r\n}\r\n.chat-bubble .user-image img, .chat-bubble .ai-image img {\r\n  max-width: 200px;\r\n  max-height: 200px;\r\n  border-radius: 6px;\r\n}\r\n.ai-image img {\r\n  cursor: pointer;\r\n}\r\n.image-action {\r\n  font-size: 12px;\r\n  color: #888;\r\n  margin-top: 4px;\r\n}\r\n.loading {\r\n  text-align: center;\r\n  color: #888;\r\n}\r\n.custom-spinner {\r\n  margin: 10px auto;\r\n  width: 30px;\r\n  height: 30px;\r\n  border: 3px solid #f3f3f3;\r\n  border-top: 3px solid #007bff;\r\n  border-radius: 50%;\r\n  animation: spin 1s linear infinite;\r\n}\r\n@keyframes spin {\r\n  0% { transform: rotate(0deg); }\r\n  100% { transform: rotate(360deg); }\r\n}\r\n.selected-fabric-tag, .selected-colors {\r\n  background-color: #e9f5ff;\r\n  border: 1px solid #d0ebff;\r\n  border-radius: 4px;\r\n  padding: 5px 8px;\r\n  margin-bottom: 5px;\r\n  font-size: 13px;\r\n}\r\n.color-swatch-container {\r\n  display: flex;\r\n  gap: 5px;\r\n  margin-top: 5px;\r\n}\r\n.color-swatch {\r\n  width: 20px;\r\n  height: 20px;\r\n  border-radius: 4px;\r\n  border: 1px solid #ccc;\r\n}\r\n</style>\r\n"],"sourceRoot":"src/views/user"}]}