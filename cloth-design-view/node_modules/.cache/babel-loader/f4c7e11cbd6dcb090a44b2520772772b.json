IAAA,CAAA,IAAA,CAAA,EAAA;AACA,gBAAA,KAAA,GAAA,IAAA,CAAA,KAAA,CAAA,GAAA,CAAA;AACA,iBAAA,KAAA,CAAA,CAAA,CAAA;AACA;;AACA,eAAA,IAAA;AACA,OARA,MAQA,IAAA,WAAA,KAAA,CAAA,EAAA;AACA;AACA,eAAA,IAAA;AACA,OAdA,CAeA;;;AACA,aAAA,IAAA;AACA,KA9BA;;AA+BA,IAAA,oBAAA,GAAA;AACA,YAAA,OAAA,GAAA;AACA,QAAA,OAAA,EAAA,KAAA;AADA,OAAA;AAGA,WAAA,MAAA,CACA,IADA,CACA,8BADA,EACA,OADA,EAEA,IAFA,CAEA,QAAA,IAAA;AACA,cAAA;AAAA,UAAA;AAAA,YAAA,QAAA;;AACA,YAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,eAAA,OAAA,CAAA;AACA,YAAA,QAAA,EAAA,IADA;AAEA,YAAA,KAAA,EAAA,MAFA;AAGA,YAAA,OAAA,EAAA,IAHA;AAIA,YAAA,IAAA,EAAA;AAJA,WAAA;AAMA,eAAA,sBAAA,GAAA,KAAA;AACA,eAAA,cAAA,GAAA,EAAA;AACA;AACA,OAdA;AAeA,KAlDA;;AAmDA,IAAA,cAAA,GAAA;AACA,WAAA,sBAAA,GAAA,IAAA;AACA,KArDA;;AAsDA,IAAA,kBAAA,GAAA;AACA,WAAA,MAAA,CAAA,GAAA,CAAA,gBAAA,EAAA,IAAA,CAAA,QAAA,IAAA;AACA,cAAA;AAAA,UAAA;AAAA,YAAA,QAAA;;AACA,YAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,eAAA,eAAA,GAAA,IAAA,CAAA,IAAA;AACA;AACA,OALA;AAMA,KA7DA;;AA8DA;AACA,UAAA,WAAA,GAAA;AACA,UAAA,CAAA,KAAA,YAAA,CAAA,MAAA,EAAA;AACA,aAAA,QAAA,CAAA,SAAA;AACA;AACA;;AACA,YAAA,SAAA,GAAA,MAAA,KAAA,YAAA,CAAA;AACA,QAAA,KAAA,EAAA,QADA;AAEA,QAAA,IAAA,EAAA,eAFA;AAGA,QAAA,IAAA,EAAA;AAHA,OAAA,CAAA;;AAKA,UAAA,SAAA,EAAA;AACA,YAAA;AACA,cAAA,GAAA,GAAA,KAAA,YAAA,CAAA,GAAA,CAAA,MAAA,IAAA,MAAA,CAAA,EAAA,CAAA;AACA,gBAAA,QAAA,GAAA,MAAA,KAAA,MAAA,CAAA,IAAA,CAAA,sBAAA,EAAA,GAAA,CAAA;;AACA,cAAA,QAAA,CAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,iBAAA,KAAA,CAAA,IAAA,CAAA;AACA,cAAA,KAAA,EAAA,MADA;AAEA,cAAA,IAAA,EAAA,QAAA,CAAA,IAAA,CAAA,GAFA;AAGA,cAAA,IAAA,EAAA,SAHA;AAIA,cAAA,iBAAA,EAAA,KAJA;AAKA,cAAA,KAAA,EAAA;AALA,aAAA;AAOA,iBAAA,cAAA;AACA;AACA;AACA,SAdA,CAcA,OAAA,CAAA,EAAA;AACA,UAAA,OAAA,CAAA,KAAA,CAAA,WAAA,EAAA,CAAA;AACA;AACA;AACA,KA5FA;;AA6FA,IAAA,mBAAA,GAAA;AACA,WAAA,eAAA,GAAA,EAAA;AACA,WAAA,UAAA,GAAA,EAAA;AACA,WAAA,cAAA;AACA,KAjGA;;AAkGA,UAAA,cAAA,GAAA;AACA,UAAA;AACA,YAAA,SAAA,GAAA,IAAA;AACA,YAAA,OAAA,GAAA,IAAA;;AACA,YAAA,KAAA,UAAA,IAAA,IAAA,IAAA,KAAA,UAAA,CAAA,MAAA,KAAA,CAAA,EAAA;AACA,gBAAA,CAAA,SAAA,EAAA,OAAA,IAAA,MAAA,OAAA,CAAA,GAAA,CACA,KAAA,UAAA,CAAA,GAAA,CAAA,IAAA,IAAA,IAAA,CAAA,WAAA,EAAA,CADA,CAAA;AAGA,UAAA,SAAA,GAAA,GAAA,SAAA,CAAA,KAAA,CAAA,GAAA,EAAA,CAAA,CAAA,WAAA;AACA,UAAA,OAAA,GAAA,GAAA,OAAA,CAAA,KAAA,CAAA,GAAA,EAAA,CAAA,CAAA,WAAA;AACA,SATA,CAUA;;;AACA,cAAA,MAAA,GAAA;AACA,UAAA,OAAA,EAAA,KAAA,WADA;AAEA,UAAA,IAAA,EAAA,KAAA,QAFA;AAGA,UAAA,SAAA,EAAA,SAHA;AAIA,UAAA,OAAA,EAAA,OAJA;AAKA,aAAA,KAAA;AALA,SAAA;AAOA,cAAA,QAAA,GAAA,MAAA,KAAA,MAAA,CAAA,IAAA,CAAA,gBAAA,EAAA,MAAA,CAAA;AACA,cAAA;AAAA,UAAA;AAAA,YAAA,QAAA,CAnBA,CAoBA;;AACA,aAAA,SAAA,GAAA,IAAA,CAAA,IAAA,CAAA,MAAA,CACA,CAAA,IAAA,CAAA,CAAA,WAAA,KAAA,CAAA,IAAA,CAAA,CAAA,WAAA,KAAA,CADA,CAAA;AAGA,aAAA,UAAA,GAAA,IAAA,CAAA,KAAA;AACA,OAzBA,CAyBA,OAAA,KAAA,EAAA;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,WAAA,EAAA,KAAA;AACA;AACA,KA/HA;;AAgIA,IAAA,GAAA,GAAA;AACA,WAAA,kBAAA,GAAA,IAAA;AACA,KAlIA;;AAmIA,IAAA,YAAA,GAAA;AACA,WAAA,WAAA,GAAA,CAAA;AACA,WAAA,cAAA;AACA,KAtIA;;AAuIA,IAAA,iBAAA,GAAA;AACA,WAAA,UAAA,GAAA,EAAA;AACA,WAAA,YAAA;AACA,KA1IA;;AA2IA,IAAA,gBAAA,CAAA,GAAA,EAAA;AACA,WAAA,QAAA,GAAA,GAAA;AACA,WAAA,WAAA,GAAA,CAAA;AACA,WAAA,cAAA;AACA,KA/IA;;AAgJA,IAAA,mBAAA,CAAA,GAAA,EAAA;AACA,WAAA,WAAA,GAAA,GAAA;AACA,WAAA,cAAA;AACA,KAnJA;;AAoJA,IAAA,UAAA,CAAA,GAAA,EAAA;AACA,WAAA,kBAAA,GAAA,IAAA;AACA,WAAA,WAAA,GAAA,IAAA;AACA,WAAA,IAAA,GAAA,EAAA,GAAA;AAAA,OAAA;AACA,KAxJA;;AAyJA,IAAA,YAAA,CAAA,GAAA,EAAA;AACA,WAAA,YAAA,CAAA,IAAA,CAAA,GAAA;AACA,WAAA,WAAA;AACA;;AA5JA;AAtBA,CAAA","sourcesContent":["<template>\r\n  <el-row style=\"background-color: #FFFFFF;padding: 10px 0;border-radius: 5px;\">\r\n    <el-row style=\"padding: 10px;margin-left: 5px;\">\r\n      <el-row>\r\n        <el-date-picker\r\n          size=\"small\"\r\n          style=\"margin-left: 10px;width: 220px;\"\r\n          v-model=\"searchTime\"\r\n          type=\"daterange\"\r\n          range-separator=\"至\"\r\n          start-placeholder=\"消息开始\"\r\n          end-placeholder=\"消息结束\"\r\n        >\r\n        </el-date-picker>\r\n        <el-input\r\n          size=\"small\"\r\n          style=\"width: 188px;margin-left: 5px;margin-right: 6px;\"\r\n          v-model=\"messageQueryDto.content\"\r\n          placeholder=\"消息内容\"\r\n          clearable\r\n          @clear=\"handleFilterClear\"\r\n        >\r\n          <el-button\r\n            slot=\"append\"\r\n            @click=\"handleFilter\"\r\n            icon=\"el-icon-search\"\r\n          ></el-button>\r\n        </el-input>\r\n        <span style=\"float: right;\">\r\n          <el-button\r\n            size=\"small\"\r\n            style=\"background-color: rgb(96, 98, 102);color: rgb(247,248,249);border: none;\"\r\n            class=\"customer\"\r\n            type=\"info\"\r\n            @click=\"allMessagePush\"\r\n            ><i class=\"el-icon-plus\"></i>定向推送</el-button\r\n          >\r\n        </span>\r\n      </el-row>\r\n    </el-row>\r\n    <el-row style=\"margin: 0 20px;border-top: 1px solid rgb(245,245,245);\">\r\n      <el-table :data=\"tableData\" style=\"width: 100%\">\r\n        <el-table-column prop=\"name\" width=\"98\" label=\"读取状态\">\r\n          <template slot-scope=\"scope\">\r\n            <span>{{ scope.row.isRead ? \"已读\" : \"未读\" }}</span>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"messageType\" width=\"148\" label=\"消息类型\">\r\n          <template slot-scope=\"scope\">\r\n            <span v-if=\"scope.row.messageType === 1\">评论回复</span>\r\n            <span v-else-if=\"scope.row.messageType === 2\">评论点赞</span>\r\n            <span v-else-if=\"scope.row.messageType === 3\">指标提醒</span>\r\n            <span v-else>系统通知</span>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column\r\n          prop=\"receiverName\"\r\n          width=\"108\"\r\n          label=\"接收者\"\r\n        ></el-table-column>\r\n        <!-- <el-table-column prop=\"content\" label=\"消息体\">\r\n          <template slot-scope=\"scope\">\r\n            <div>{{ parseText(scope.row.content) }}</div>\r\n          </template>\r\n        </el-table-column> -->\r\n        <el-table-column prop=\"content\" label=\"消息体\">\r\n  <template slot-scope=\"scope\">\r\n    <div>{{ parseText(scope.row.content, scope.row.messageType) }}</div>\r\n  </template>\r\n</el-table-column>\r\n        <el-table-column\r\n          prop=\"createTime\"\r\n          width=\"168\"\r\n          label=\"发送时间\"\r\n        ></el-table-column>\r\n        <el-table-column label=\"操作\" width=\"88\">\r\n          <template slot-scope=\"scope\">\r\n            <span class=\"text-button\" @click=\"handleDelete(scope.row)\"\r\n              >删除</span\r\n            >\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n      <el-pagination\r\n        style=\"margin: 20px 0;\"\r\n        @size-change=\"handleSizeChange\"\r\n        @current-change=\"handleCurrentChange\"\r\n        :current-page=\"currentPage\"\r\n        :page-sizes=\"[10, 20]\"\r\n        :page-size=\"pageSize\"\r\n        layout=\"total, sizes, prev, pager, next, jumper\"\r\n        :total=\"totalItems\"\r\n      ></el-pagination>\r\n    </el-row>\r\n    <!-- 全站消息推送 -->\r\n    <el-dialog\r\n      :show-title=\"false\"\r\n      :show-close=\"false\"\r\n      :visible.sync=\"dialogMessageOperation\"\r\n      width=\"24%\"\r\n    >\r\n      <p style=\"padding: 20px 0  0 20px;\">消息推送</p>\r\n      <div style=\"padding:0 20px;\">\r\n        <el-row>\r\n          <span class=\"dialog-hover\">消息内容</span>\r\n          <el-input\r\n            type=\"textarea\"\r\n            :autosize=\"{ minRows: 2, maxRows: 4 }\"\r\n            placeholder=\"消息内容\"\r\n            v-model=\"messageContent\"\r\n          >\r\n          </el-input>\r\n        </el-row>\r\n      </div>\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button\r\n          size=\"small\"\r\n          style=\"background-color: rgb(43, 121, 203);border: none;\"\r\n          class=\"customer\"\r\n          type=\"info\"\r\n          @click=\"messagePushOperation\"\r\n          >确定推送</el-button\r\n        >\r\n        <el-button\r\n          class=\"customer\"\r\n          size=\"small\"\r\n          style=\"background-color: rgb(241, 241, 241);border: none;\"\r\n          @click=\"dialogMessageOperation = false\"\r\n          >取消</el-button\r\n        >\r\n      </span>\r\n    </el-dialog>\r\n  </el-row>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      data: {},\r\n      filterText: \"\",\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n      totalItems: 0,\r\n      tableData: [],\r\n      searchTime: [],\r\n      selectedRows: [],\r\n      messageQueryDto: {}, // 搜索条件\r\n      messsageContent: \"\",\r\n      messageTypeList: [],\r\n      dialogMessageOperation: false, // 开关变量，控制消息的对话框显示与否\r\n      messageContent: \"\"\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchFreshData();\r\n    this.loadAllMessageType();\r\n  },\r\n  methods: {\r\n    // parseText(text) {\r\n    //   // 使用正则表达式判断文本是否符合由分号分隔且至少有三项的结构\r\n    //   const pattern = /^([^;]+;){2}[^;]+$/;\r\n    //   if (pattern.test(text)) {\r\n    //     // 使用分号分割文本\r\n    //     const parts = text.split(\";\");\r\n    //     // 返回第三项内容\r\n    //     return parts[2];\r\n    //   }\r\n    //   // 若不满足条件则返回原文本\r\n    //   return text;\r\n    // },\r\n    parseText(text, messageType) {\r\n      console.log(`解析消息内容 - 类型: ${messageType}, 原始内容: ${text}`);\r\n  // 指标提醒(3)和系统通知(4)采用不同的解析方式\r\n  if (messageType === 3) {\r\n    // 指标提醒沿用原有解析逻辑\r\n    const pattern = /^([^;]+;){2}[^;]+$/;\r\n    if (pattern.test(text)) {\r\n      const parts = text.split(\";\");\r\n      return parts[2];\r\n    }\r\n    return text;\r\n  } else if (messageType === 4) {\r\n    // 系统通知直接返回原始内容\r\n    return text;\r\n  }\r\n  // 其他类型消息默认返回原始内容\r\n  return text;\r\n},\r\n    messagePushOperation() {\r\n      const message = {\r\n        content: this.messageContent\r\n      };\r\n      this.$axios\r\n        .post(\"/message/systemInfoUsersSave\", message)\r\n        .then(response => {\r\n          const { data } = response;\r\n          if (data.code === 200) {\r\n            this.$notify({\r\n              duration: 2000,\r\n              title: \"推送操作\",\r\n              message: \"成功\",\r\n              type: \"success\"\r\n            });\r\n            this.dialogMessageOperation = false;\r\n            this.messageContent = \"\";\r\n          }\r\n        });\r\n    },\r\n    allMessagePush() {\r\n      this.dialogMessageOperation = true;\r\n    },\r\n    loadAllMessageType() {\r\n      this.$axios.get(\"/message/types\").then(response => {\r\n        const { data } = response;\r\n        if (data.code === 200) {\r\n          this.messageTypeList = data.data;\r\n        }\r\n      });\r\n    },\r\n    // 批量删除数据\r\n    async batchDelete() {\r\n      if (!this.selectedRows.length) {\r\n        this.$message(`未选中任何数据`);\r\n        return;\r\n      }\r\n      const confirmed = await this.$swalConfirm({\r\n        title: \"删除消息数据\",\r\n        text: `删除后不可恢复，是否继续？`,\r\n        icon: \"warning\"\r\n      });\r\n      if (confirmed) {\r\n        try {\r\n          let ids = this.selectedRows.map(entity => entity.id);\r\n          const response = await this.$axios.post(`/message/batchDelete`, ids);\r\n          if (response.data.code === 200) {\r\n            this.$swal.fire({\r\n              title: \"删除提示\",\r\n              text: response.data.msg,\r\n              icon: \"success\",\r\n              showConfirmButton: false,\r\n              timer: 2000\r\n            });\r\n            this.fetchFreshData();\r\n            return;\r\n          }\r\n        } catch (e) {\r\n          console.error(`消息信息删除异常：`, e);\r\n        }\r\n      }\r\n    },\r\n    resetQueryCondition() {\r\n      this.messageQueryDto = {};\r\n      this.searchTime = [];\r\n      this.fetchFreshData();\r\n    },\r\n    async fetchFreshData() {\r\n      try {\r\n        let startTime = null;\r\n        let endTime = null;\r\n        if (this.searchTime != null && this.searchTime.length === 2) {\r\n          const [startDate, endDate] = await Promise.all(\r\n            this.searchTime.map(date => date.toISOString())\r\n          );\r\n          startTime = `${startDate.split(\"T\")[0]}T00:00:00`;\r\n          endTime = `${endDate.split(\"T\")[0]}T23:59:59`;\r\n        }\r\n        // 请求参数\r\n        const params = {\r\n          current: this.currentPage,\r\n          size: this.pageSize,\r\n          startTime: startTime,\r\n          endTime: endTime,\r\n          ...this.messageQueryDto\r\n        };\r\n        const response = await this.$axios.post(\"/message/query\", params);\r\n        const { data } = response;\r\n        // this.tableData = data.data;\r\n           this.tableData = data.data.filter(\r\n      (m) => m.messageType === 3 || m.messageType === 4\r\n    );\r\n        this.totalItems = data.total;\r\n      } catch (error) {\r\n        console.error(\"查询消息信息异常:\", error);\r\n      }\r\n    },\r\n    add() {\r\n      this.dialogUserOperaion = true;\r\n    },\r\n    handleFilter() {\r\n      this.currentPage = 1;\r\n      this.fetchFreshData();\r\n    },\r\n    handleFilterClear() {\r\n      this.filterText = \"\";\r\n      this.handleFilter();\r\n    },\r\n    handleSizeChange(val) {\r\n      this.pageSize = val;\r\n      this.currentPage = 1;\r\n      this.fetchFreshData();\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.currentPage = val;\r\n      this.fetchFreshData();\r\n    },\r\n    handleEdit(row) {\r\n      this.dialogUserOperaion = true;\r\n      this.isOperation = true;\r\n      this.data = { ...row };\r\n    },\r\n    handleDelete(row) {\r\n      this.selectedRows.push(row);\r\n      this.batchDelete();\r\n    }\r\n  }\r\n};\r\n</script>\r\n<style scoped lang=\"scss\"></style>"],"sourceRoot":"src/views/admin"}]}