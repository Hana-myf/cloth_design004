,SAAA,GAAA;AACA,YAAA,GAAA,GAAA;AAAA,QAAA,SAAA,EAAA,KAAA,QAAA,CAAA;AAAA,OAAA;AACA,WAAA,MAAA,CAAA,IAAA,CAAA,cAAA,EAAA,GAAA,EAAA,IAAA,CAAA,QAAA,IAAA;AACA,cAAA;AAAA,UAAA;AAAA,YAAA,QAAA;;AACA,YAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,eAAA,SAAA,GAAA,IAAA,CAAA,IAAA;AACA;AACA,OALA;AAMA,KA3BA;;AA4BA,IAAA,cAAA,GAAA;AACA,YAAA,gBAAA,GAAA;AACA,QAAA,MAAA,EAAA,KAAA,QAAA,CAAA;AADA,OAAA;AAGA,MAAA,OAAA,CAAA,GAAA,CAAA,WAAA,IAAA,CAAA,SAAA,CAAA,gBAAA,CAAA;AACA,WAAA,MAAA,CACA,IADA,CACA,sBADA,EACA,gBADA,EAEA,IAFA,CAEA,QAAA,IAAA;AACA,cAAA;AAAA,UAAA;AAAA,YAAA,QAAA;;AACA,YAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,eAAA,QAAA,GAAA,IAAA,CAAA,IAAA,CAAA,MAAA,KAAA,CAAA;AACA;AACA,OAPA;AAQA,KAzCA;;AA0CA;AACA,IAAA,iBAAA,GAAA;AACA,WAAA,MAAA,CACA,IADA,CACA,sBADA,EACA;AAAA,QAAA,MAAA,EAAA,KAAA,QAAA,CAAA;AAAA,OADA,EAEA,IAFA,CAEA,QAAA,IAAA;AACA,cAAA;AAAA,UAAA;AAAA,YAAA,QAAA;;AACA,YAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,eAAA,QAAA,CAAA,OAAA,CAAA,CAAA,KAAA,QAAA,GAAA,MAAA,GAAA,QAAA;AACA,eAAA,QAAA,GAAA,CAAA,KAAA,QAAA;AACA;AACA,OARA;AASA,KArDA;;AAsDA,IAAA,aAAA,CAAA,IAAA,EAAA;AACA,WAAA,QAAA,GAAA,IAAA;AACA,WAAA,cAAA;AACA,KAzDA;;AA0DA;AACA,IAAA,SAAA,CAAA,IAAA,EAAA;AACA,aAAA,OAAA,CAAA,IAAA,CAAA;AACA,KA7DA;;AA8DA,IAAA,cAAA,GAAA;AACA,YAAA,OAAA,GAAA,cAAA,CAAA,OAAA,CAAA,UAAA,CAAA;AACA,WAAA,QAAA,GAAA,IAAA,CAAA,KAAA,CAAA,OAAA,CAAA;AACA,WAAA,cAAA;AACA,KAlEA;;AAmEA;AACA,IAAA,cAAA,GAAA;AACA,WAAA,MAAA,CAAA,GAAA,CAAA,wBAAA,CAAA,EAAA,EAAA,IAAA,CAAA,QAAA,IAAA;AACA,cAAA;AAAA,UAAA;AAAA,YAAA,QAAA;;AACA,YAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,eAAA,WAAA,GAAA,IAAA,CAAA,IAAA;AACA;AACA,OALA;AAMA;;AA3EA;AAlBA,CAAA","sourcesContent":["<template>\r\n  <el-row>\r\n    <el-col :span=\"18\">\r\n      <div style=\"padding-right: 50px;box-sizing: border-box;\">\r\n        <div>\r\n          <h1>{{ newsInfo.name }}</h1>\r\n          <div\r\n            style=\"font-size: 12px;background-color: rgb(250, 250, 250);padding: 16px 6px;border-radius: 5px;\"\r\n          >\r\n            <span class=\"news-tags\">{{ newsInfo.tagName }}</span>\r\n            <span style=\"margin-left: 10px;\">{{\r\n              parseTime(newsInfo.createTime)\r\n            }}</span>\r\n            <el-button\r\n              style=\"margin-left: 20px;\"\r\n              @click=\"saveNewsOperation\"\r\n              class=\"customer\"\r\n              size=\"mini\"\r\n              >{{ !saveFlag ? \"立即收藏\" : \"取消收藏\" }}</el-button\r\n            >\r\n          </div>\r\n          <div v-html=\"newsInfo.content\"></div>\r\n        </div>\r\n        <div>\r\n          <Evaluations :contentId=\"newsInfo.id\" contentType=\"NEWS\" />\r\n        </div>\r\n      </div>\r\n    </el-col>\r\n    <el-col :span=\"6\">\r\n      <div v-if=\"scoreList.length === 0\">\r\n        <h3 style=\"padding: 10px 30px;\">立即评分</h3>\r\n        <div\r\n          style=\"background-color: rgb(248,249,250);margin-inline: 30px;padding: 20px;border-radius: 4px;\"\r\n        >\r\n          <el-rate\r\n            style=\"margin-left: 25px;\"\r\n            v-model=\"score\"\r\n            @change=\"scoreChange\"\r\n          ></el-rate>\r\n        </div>\r\n      </div>\r\n      <div v-else>\r\n        <h3 style=\"padding: 10px 30px;\">我的评分</h3>\r\n        <div\r\n          style=\"background-color: rgb(248,249,250);margin-inline: 30px;padding: 20px;border-radius: 4px;\"\r\n        >\r\n          <el-rate\r\n            style=\"margin-left: 25px;\"\r\n            v-model=\"scoreList[0].total\"\r\n            disabled\r\n            show-score\r\n            text-color=\"#ff9900\"\r\n            score-template=\"{value}\"\r\n          >\r\n          </el-rate>\r\n        </div>\r\n      </div>\r\n      <h3 style=\"padding: 10px 30px;\">资讯推荐</h3>\r\n      <el-col\r\n        @click.native=\"newsItemClick(news)\"\r\n        :span=\"24\"\r\n        :key=\"index\"\r\n        v-for=\"(news, index) in newsTopList\"\r\n      >\r\n        <div style=\"padding: 8px 30px;box-sizing: border-box;\">\r\n          <img\r\n            :src=\"news.cover\"\r\n            :alt=\"news.name\"\r\n            style=\"width: 100%;height: 148px;border-radius: 5px;\"\r\n          />\r\n          <div class=\"news-title\">{{ news.name }}</div>\r\n          <div style=\"font-size: 12px;\">\r\n            <span class=\"news-tags\">{{ news.tagName }}</span>\r\n            <span style=\"margin-left: 10px;\">{{\r\n              parseTime(news.createTime)\r\n            }}</span>\r\n          </div>\r\n        </div>\r\n      </el-col>\r\n    </el-col>\r\n  </el-row>\r\n</template>\r\n<script>\r\nimport { timeAgo } from \"@/utils/data\";\r\nimport Evaluations from \"@/components/Evaluations.vue\";\r\nexport default {\r\n  components: { Evaluations },\r\n  name: \"NewsDetail\",\r\n  data() {\r\n    return {\r\n      newsInfo: {},\r\n      newsTopList: [],\r\n      saveFlag: false,\r\n      newsSaveList: [],\r\n      scoreList: [],\r\n      score: 0\r\n    };\r\n  },\r\n  created() {\r\n    this.getStorageInfo();\r\n    this.loadAllTopNews();\r\n    this.loadScore();\r\n  },\r\n  methods: {\r\n    scoreChange() {\r\n      const dto = {\r\n        total: this.score,\r\n        articleId: this.newsInfo.id\r\n      };\r\n      this.$axios.post(\"/score/save\", dto).then(response => {\r\n        const { data } = response;\r\n        if (data.code === 200) {\r\n          this.$notify({\r\n            duration: 1000,\r\n            title: \"评分\",\r\n            message: \"评分成功\",\r\n            type: \"success\"\r\n          });\r\n          this.loadScore();\r\n        }\r\n      });\r\n    },\r\n    loadScore() {\r\n      const dto = { articleId: this.newsInfo.id };\r\n      this.$axios.post(\"/score/query\", dto).then(response => {\r\n        const { data } = response;\r\n        if (data.code === 200) {\r\n          this.scoreList = data.data;\r\n        }\r\n      });\r\n    },\r\n    loadSaveStatus() {\r\n      const newsSaveQueryDto = {\r\n        newsId: this.newsInfo.id\r\n      };\r\n      console.log(\"查询的参数：\" + JSON.stringify(newsSaveQueryDto));\r\n      this.$axios\r\n        .post(\"/news-save/queryUser\", newsSaveQueryDto)\r\n        .then(response => {\r\n          const { data } = response;\r\n          if (data.code === 200) {\r\n            this.saveFlag = data.data.length !== 0;\r\n          }\r\n        });\r\n    },\r\n    // 收藏或取消收藏操作\r\n    saveNewsOperation() {\r\n      this.$axios\r\n        .post(\"/news-save/operation\", { newsId: this.newsInfo.id })\r\n        .then(response => {\r\n          const { data } = response;\r\n          if (data.code === 200) {\r\n            this.$message.success(!this.saveFlag ? \"收藏成功\" : \"取消收藏成功\");\r\n            this.saveFlag = !this.saveFlag;\r\n          }\r\n        });\r\n    },\r\n    newsItemClick(news) {\r\n      this.newsInfo = news;\r\n      this.loadSaveStatus();\r\n    },\r\n    // 转换时间\r\n    parseTime(time) {\r\n      return timeAgo(time);\r\n    },\r\n    getStorageInfo() {\r\n      const newInfo = sessionStorage.getItem(\"newsInfo\");\r\n      this.newsInfo = JSON.parse(newInfo);\r\n      this.loadSaveStatus();\r\n    },\r\n    // 查询推荐资讯\r\n    loadAllTopNews() {\r\n      this.$axios.get(`/news/queryRecommend/${3}`).then(response => {\r\n        const { data } = response;\r\n        if (data.code === 200) {\r\n          this.newsTopList = data.data;\r\n        }\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n.news-tags {\r\n  display: inline-block;\r\n  padding: 4px 10px;\r\n  background-color: rgb(226, 242, 249);\r\n  color: #1d3cc4;\r\n  border-radius: 3px;\r\n}\r\n.news-title {\r\n  margin-block: 10px;\r\n  font-weight: 600;\r\n}\r\n</style>\r\n"],"sourceRoot":"src/views/user"}]}