 <p class=\"subtitle\">Intelligent Pattern Making System</p>\n      </div>\n      \n      <!-- 功能卡片区：一排展示 -->\n      <div class=\"card-container\">\n        <!-- 蛋糕裙 -->\n        <div class=\"custom-card pink-theme\" @click=\"$router.push('/womenswear/cake-skirt')\">\n          <div class=\"icon-box\">\n            <img src=\"https://pic1.imgdb.cn/item/69c2a0732cb231a0e876d983.png\" alt=\"蛋糕裙\" class=\"card-icon\">\n          </div>\n          <div class=\"text-info\">\n            <span class=\"en-tag\">Tiered Skirt</span>\n            <h3 class=\"card-title\">蛋糕裙制版</h3>\n          </div>\n        </div>\n\n        <!-- 太阳裙 -->\n        <div class=\"custom-card orange-theme\" @click=\"$router.push('/womenswear/sun-skirt')\">\n          <div class=\"icon-box\">\n            <img src=\"https://pic1.imgdb.cn/item/69c2be142cb231a0e87755c7.png\" alt=\"太阳裙\" class=\"card-icon\">\n          </div>\n          <div class=\"text-info\">\n            <span class=\"en-tag\">Sun Skirt</span>\n            <h3 class=\"card-title\">太阳裙制版</h3>\n          </div>\n        </div>\n\n        <!-- 敬请期待 -->\n        <div class=\"custom-card disabled-theme\" @click=\"showComingSoon\">\n          <div class=\"icon-box\">\n            <!-- 这里可以放一个默认的等待图标或之前的SVG -->\n            <svg width=\"80\" height=\"100\" viewBox=\"0 0 150 200\">\n              <rect x=\"35\" y=\"60\" width=\"80\" height=\"120\" rx=\"10\" fill=\"none\" stroke=\"#ccc\" stroke-width=\"2\" stroke-dasharray=\"5\"/>\n              <circle cx=\"75\" cy=\"35\" r=\"15\" fill=\"none\" stroke=\"#ccc\" stroke-width=\"2\"/>\n            </svg>\n          </div>\n          <div class=\"text-info\">\n            <span class=\"en-tag\">More Coming</span>\n            <h3 class=\"card-title\">敬请期待</h3>\n          </div>\n        </div>\n      </div>\n\n      <!-- 底部流程图 -->\n      <div class=\"workflow-section\">\n        <h2 class=\"workflow-title\">制版工艺流程</h2>\n        <div class=\"workflow-steps\">\n          <div class=\"step\">\n            <div class=\"step-num\">01</div>\n            <div class=\"step-text\">测量人体数据</div>\n          </div>\n          <div class=\"arrow\">➔</div>\n          <div class=\"step\">\n            <div class=\"step-num\">02</div>\n            <div class=\"step-text\">输入关键尺寸</div>\n          </div>\n          <div class=\"arrow\">➔</div>\n          <div class=\"step\">\n            <div class=\"step-num\">03</div>\n            <div class=\"step-text\">实时计算裁片</div>\n          </div>\n          <div class=\"arrow\">➔</div>\n          <div class=\"step\">\n            <div class=\"step-num\">04</div>\n            <div class=\"step-text\">导出PDF图纸</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"WomenswearMain\",\n  methods: {\n    showComingSoon() {\n      this.$message.info('更多高级裙装版型正在开发中...');\n    }\n  }\n};\n</script>\n\n<style scoped lang=\"scss\">\n.womenswear-main {\n  min-height: 100vh;\n  background: linear-gradient(135deg, #fffaf0 0%, #fff5f5 100%);\n  padding: 40px 20px;\n  font-family: \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n\n  .header-section {\n    text-align: center;\n    margin-bottom: 60px;\n    .title {\n      font-size: 36px;\n      color: #2c3e50;\n      letter-spacing: 2px;\n      margin-bottom: 8px;\n    }\n    .subtitle {\n      color: #95a5a6;\n      font-size: 14px;\n      text-transform: uppercase;\n      letter-spacing: 4px;\n    }\n  }\n\n  .card-container {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 30px;\n    margin-bottom: 80px;\n    flex-wrap: nowrap; \n\n    .custom-card {\n      width: 280px;\n      height: 380px;\n      background: rgba(255, 255, 255, 0.85);\n      backdrop-filter: blur(10px);\n      border-radius: 24px;\n      border: 1px solid rgba(255, 255, 255, 0.8);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);\n      box-shadow: 0 10px 25px rgba(0,0,0,0.05);\n\n      &:hover {\n        transform: translateY(-12px);\n        box-shadow: 0 20px 40px rgba(0,0,0,0.1);\n      }\n\n      .icon-box {\n        margin-bottom: 25px;\n        transition: transform 0.4s;\n        height: 160px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        \n        .card-icon {\n          max-width: 150px;\n          max-height: 150px;\n          object-fit: contain;\n        }\n      }\n\n      .text-info {\n        text-align: center;\n        .en-tag {\n          font-size: 12px;\n          color: #bdc3c7;\n          text-transform: uppercase;\n          letter-spacing: 1px;\n        }\n        .card-title {\n          font-size: 20px;\n          color: #34495e;\n          margin-top: 5px;\n          font-weight: 600;\n        }\n      }\n\n      &.pink-theme:hover {\n        border-color: #ffb6c1;\n        background: #fffafa;\n        .card-title { color: #ff69b4; }\n      }\n\n      &.orange-theme:hover {\n        border-color: #ffd700;\n        background: #fffef0;\n        .card-title { color: #ff8c00; }\n      }\n\n      &.disabled-theme {\n        opacity: 0.6;\n        cursor: not-allowed;\n        background: rgba(245, 245, 245, 0.5);\n      }\n    }\n  }\n\n  .workflow-section {\n    max-width: 900px;\n    margin: 0 auto;\n    background: rgba(255, 255, 255, 0.6);\n    border-radius: 30px;\n    padding: 35px;\n    border: 1px dashed #e4e7ed;\n    box-shadow: inset 0 2px 10px rgba(0,0,0,0.02);\n\n    .workflow-title {\n      text-align: center;\n      font-size: 18px;\n      color: #909399;\n      margin-bottom: 35px;\n      font-weight: normal;\n    }\n\n    .workflow-steps {\n      display: flex;\n      justify-content: space-around;\n      align-items: center;\n\n      .step {\n        text-align: center;\n        flex: 1;\n        .step-num {\n          font-size: 28px;\n          font-weight: bold;\n          color: #f2f2f2;\n          margin-bottom: 5px;\n          font-family: Georgia, serif;\n          text-shadow: 1px 1px 0 #dcdfe6;\n        }\n        .step-text {\n          font-size: 15px;\n          color: #5e6d82;\n        }\n      }\n\n      .arrow {\n        color: #dcdfe6;\n        font-size: 20px;\n        padding: 0 10px;\n      }\n    }\n  }\n}\n\n@media (max-width: 1000px) {\n  .card-container {\n    flex-wrap: wrap;\n    gap: 20px;\n  }\n}\n</style>"],"sourceRoot":"src/views/drafts"}]}