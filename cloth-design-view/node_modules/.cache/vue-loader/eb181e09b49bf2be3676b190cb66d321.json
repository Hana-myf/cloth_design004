{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\views\\admin\\FabricManage.vue?vue&type=style&index=0&id=3d034038&scoped=true&lang=scss&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\views\\admin\\FabricManage.vue","mtime":1753951514271},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\css-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\postcss-loader\\src\\index.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\sass-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["FabricManage.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAocA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA","file":"FabricManage.vue","sourceRoot":"src/views/admin","sourcesContent":["<template>\r\n  <el-row style=\"background-color: #FFFFFF;padding: 5px 0;border-radius: 5px;\">\r\n    <!-- 筛选区域 -->\r\n    <el-row style=\"padding: 10px;margin-left: 10px;\">\r\n      <el-row>\r\n        <!-- 面料类型筛选 -->\r\n        <el-select\r\n          @change=\"handleTypeChange\"\r\n          size=\"small\"\r\n          v-model=\"fabricQueryDto.type\"\r\n          placeholder=\"面料类型\"\r\n        >\r\n          <el-option\r\n            v-for=\"type in fabricTypes\"\r\n            :key=\"type\"\r\n            :label=\"type\"\r\n            :value=\"type\"\r\n          >\r\n          </el-option>\r\n        </el-select>\r\n        \r\n        <!-- 名称搜索 -->\r\n        <el-input\r\n          size=\"small\"\r\n          style=\"width: 188px;margin-left: 5px;margin-right: 6px;\"\r\n          v-model=\"fabricQueryDto.name\"\r\n          placeholder=\"面料名称\"\r\n          clearable\r\n          @clear=\"handleFilterClear\"\r\n        >\r\n          <el-button\r\n            slot=\"append\"\r\n            @click=\"handleFilter\"\r\n            icon=\"el-icon-search\"\r\n          ></el-button>\r\n        </el-input>\r\n        \r\n        <!-- 新增按钮 -->\r\n        <span style=\"float: right;\">\r\n          <el-button\r\n            size=\"small\"\r\n            style=\"background-color: rgb(96, 98, 102);color: rgb(247,248,249);border: none;\"\r\n            class=\"customer\"\r\n            type=\"info\"\r\n            @click=\"add\"\r\n            ><i class=\"el-icon-plus\"></i>新增面料</el-button\r\n          >\r\n        </span>\r\n      </el-row>\r\n    </el-row>\r\n\r\n    <!-- 列表区域 -->\r\n    <el-row style=\"margin: 0 20px;border-top: 1px solid rgb(245,245,245);\">\r\n      <el-table\r\n        row-key=\"id\"\r\n        @selection-change=\"handleSelectionChange\"\r\n        :data=\"tableData\"\r\n        style=\"width: 100%\"\r\n      >\r\n        <!-- 面料图片 -->\r\n        <el-table-column prop=\"imageUrl\" width=\"100\" label=\"面料图片\">\r\n          <template slot-scope=\"scope\">\r\n            <img\r\n              :src=\"scope.row.imageUrl\"\r\n              style=\"width: 60px;height: 40px;border-radius: 5px;object-fit: cover;\"\r\n            />\r\n          </template>\r\n        </el-table-column>\r\n        \r\n        <!-- 面料名称 -->\r\n        <el-table-column prop=\"name\" label=\"面料名称\" width=\"180\"></el-table-column>\r\n        \r\n        <!-- 面料类型 -->\r\n        <el-table-column prop=\"type\" label=\"面料类型\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            <span class=\"type-tag\">{{ scope.row.type }}</span>\r\n          </template>\r\n        </el-table-column>\r\n        \r\n        <!-- 创建时间 -->\r\n        <el-table-column prop=\"createTime\" label=\"创建时间\" width=\"160\"></el-table-column>\r\n        \r\n        <!-- 描述 -->\r\n        <el-table-column prop=\"description\" label=\"描述\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tooltip :content=\"scope.row.description\" placement=\"top\">\r\n              <div class=\"description-text\">{{ scope.row.description }}</div>\r\n            </el-tooltip>\r\n          </template>\r\n        </el-table-column>\r\n        \r\n        <!-- 操作按钮 -->\r\n        <el-table-column label=\"操作\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            <span class=\"text-button\" @click=\"handleEdit(scope.row)\">编辑</span>\r\n            <span class=\"text-button\" @click=\"handleDelete(scope.row)\"\r\n              >删除</span\r\n            >\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <!-- 分页控件 -->\r\n      <el-pagination\r\n        style=\"margin: 20px 0;\"\r\n        @size-change=\"handleSizeChange\"\r\n        @current-change=\"handleCurrentChange\"\r\n        :current-page=\"currentPage\"\r\n        :page-sizes=\"[10, 20]\"\r\n        :page-size=\"pageSize\"\r\n        layout=\"total, sizes, prev, pager, next, jumper\"\r\n        :total=\"totalItems\"\r\n      ></el-pagination>\r\n    </el-row>\r\n\r\n    <!-- 新增/编辑弹窗 -->\r\n    <el-dialog\r\n      :show-close=\"false\"\r\n      :visible.sync=\"dialogVisible\"\r\n      width=\"50%\"\r\n    >\r\n      <div slot=\"title\">\r\n        <p class=\"dialog-title\">{{ !isEdit ? \"新增面料\" : \"修改面料\" }}</p>\r\n      </div>\r\n      \r\n      <div style=\"padding:0 20px;\">\r\n        <!-- 面料图片上传 -->\r\n        <el-row style=\"margin-top: 10px;\">\r\n          <p>*面料图片 <span style=\"color:red\" v-if=\"imageError\">{{ imageError }}</span></p>\r\n          <el-upload\r\n  class=\"avatar-uploader\"\r\n  action=\"/api/personal-heath/v1.0/file/upload\"\r\n  :show-file-list=\"false\"\r\n  :on-success=\"handleImageUploadSuccess\"\r\n  :on-error=\"handleImageUploadError\"\r\n  :before-upload=\"beforeImageUpload\"\r\n >\r\n            <img\r\n              v-if=\"formData.imageUrl\"\r\n              :src=\"formData.imageUrl\"\r\n              style=\"height: 180px;width: 240px;object-fit: cover;border-radius: 4px;\"\r\n            />\r\n            <div v-else class=\"upload-placeholder\">\r\n              <i class=\"el-icon-plus avatar-uploader-icon\"></i>\r\n              <p>点击上传面料图片</p>\r\n            </div>\r\n          </el-upload>\r\n        </el-row>\r\n        \r\n        <!-- 面料名称 -->\r\n        <el-row style=\"margin-top: 20px;\">\r\n          <p>*面料名称 <span style=\"color:red\" v-if=\"nameError\">{{ nameError }}</span></p>\r\n          <el-input\r\n            v-model=\"formData.name\"\r\n            placeholder=\"请输入面料名称\"\r\n            clearable\r\n          ></el-input>\r\n        </el-row>\r\n        \r\n        <!-- 面料类型 -->\r\n        <el-row style=\"margin-top: 20px;\">\r\n          <p>*面料类型 <span style=\"color:red\" v-if=\"typeError\">{{ typeError }}</span></p>\r\n          <el-select\r\n            v-model=\"formData.type\"\r\n            placeholder=\"请选择面料类型\"\r\n          >\r\n            <el-option\r\n              v-for=\"type in fabricTypes\"\r\n              :key=\"type\"\r\n              :label=\"type\"\r\n              :value=\"type\"\r\n            ></el-option>\r\n          </el-select>\r\n        </el-row>\r\n        \r\n        <!-- 面料描述 -->\r\n        <el-row style=\"margin-top: 20px;\">\r\n          <p>面料描述 <span style=\"color:#999\">(选填)</span></p>\r\n          <el-input\r\n            v-model=\"formData.description\"\r\n            placeholder=\"请输入面料描述信息\"\r\n            type=\"textarea\"\r\n            :rows=\"4\"\r\n          ></el-input>\r\n        </el-row>\r\n      </div>\r\n      \r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button\r\n          size=\"small\"\r\n          v-if=\"!isEdit\"\r\n          style=\"background-color: rgb(96, 98, 102);color: rgb(247,248,249);border: none;\"\r\n          class=\"customer\"\r\n          type=\"info\"\r\n          @click=\"submitForm\"\r\n          >保存</el-button\r\n        >\r\n        <el-button\r\n          size=\"small\"\r\n          v-else\r\n          style=\"background-color: rgb(96, 98, 102);color: rgb(247,248,249);border: none;\"\r\n          class=\"customer\"\r\n          type=\"info\"\r\n          @click=\"submitForm\"\r\n          >更新</el-button\r\n        >\r\n        <el-button\r\n          class=\"customer\"\r\n          size=\"small\"\r\n          style=\"background-color: rgb(241, 241, 241);border: none;\"\r\n          @click=\"dialogVisible = false\"\r\n          >取消</el-button\r\n        >\r\n      </span>\r\n    </el-dialog>\r\n  </el-row>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      // 表格数据\r\n      tableData: [],\r\n      totalItems: 0,\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n      \r\n      // 查询条件\r\n      fabricQueryDto: {\r\n        name: '',\r\n        type: ''\r\n      },\r\n      \r\n      // 面料类型列表（可从接口加载）\r\n      fabricTypes: ['棉', '羊毛', '丝绸', '亚麻', '化纤', '混纺'],\r\n      \r\n      // 弹窗状态\r\n      dialogVisible: false,\r\n      isEdit: false,\r\n      \r\n      // 表单数据\r\n      formData: {\r\n        id: null,\r\n        name: '',\r\n        type: '',\r\n        imageUrl: '',\r\n        description: ''\r\n      },\r\n      \r\n      // 表单验证错误\r\n      imageError: '',\r\n      nameError: '',\r\n      typeError: '',\r\n      \r\n      // 选中的行\r\n      selectedRows: []\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchFabricList();\r\n  },\r\n  methods: {\r\n    // 获取面料列表\r\n    async fetchFabricList() {\r\n      try {\r\n        const params = {\r\n          current: this.currentPage,\r\n          size: this.pageSize,\r\n          name: this.fabricQueryDto.name,\r\n          type: this.fabricQueryDto.type\r\n        };\r\n        const response = await this.$axios.post('/fabric/query', params);\r\n        if (response.data.code === 200) {\r\n          this.tableData = response.data.data.fabricList;\r\n          this.totalItems = response.data.data.totalCount;\r\n        }\r\n      } catch (error) {\r\n        console.error('获取面料列表失败:', error);\r\n        this.$message.error('加载面料数据失败');\r\n      }\r\n    },\r\n    \r\n    // 新增按钮点击\r\n    add() {\r\n      this.isEdit = false;\r\n      this.formData = {\r\n        id: null,\r\n        name: '',\r\n        type: '',\r\n        imageUrl: '',\r\n        description: ''\r\n      };\r\n      this.clearFormErrors();\r\n      this.dialogVisible = true;\r\n    },\r\n    \r\n    // 编辑按钮点击\r\n    handleEdit(row) {\r\n      this.isEdit = true;\r\n      this.formData = { ...row };\r\n      this.clearFormErrors();\r\n      this.dialogVisible = true;\r\n    },\r\n    \r\n    // 删除按钮点击\r\n    async handleDelete(row) {\r\n      const confirmed = await this.$swalConfirm({\r\n        title: '确认删除',\r\n        text: `确定要删除面料\"${row.name}\"吗？`,\r\n        icon: 'warning'\r\n      });\r\n      if (confirmed) {\r\n        try {\r\n          const response = await this.$axios.post(`/fabric/delete/${row.id}`);\r\n          if (response.data.code === 200) {\r\n            this.$message.success('删除成功');\r\n            this.fetchFabricList();\r\n          } else {\r\n            this.$message.error('删除失败');\r\n          }\r\n        } catch (error) {\r\n          console.error('删除面料失败:', error);\r\n          this.$message.error('删除失败，请重试');\r\n        }\r\n      }\r\n    },\r\n    \r\n    // 表单提交\r\n    async submitForm() {\r\n      if (!this.validateForm()) return;\r\n      \r\n      try {\r\n        let response;\r\n        if (this.isEdit) {\r\n          // 修改操作\r\n          response = await this.$axios.post('/fabric/update', this.formData);\r\n        } else {\r\n          // 新增操作\r\n          response = await this.$axios.post('/fabric/save', this.formData);\r\n        }\r\n        \r\n        if (response.data.code === 200) {\r\n          this.$message.success(this.isEdit ? '更新成功' : '新增成功');\r\n          this.dialogVisible = false;\r\n          this.fetchFabricList();\r\n        } else {\r\n          this.$message.error(response.data.msg || (this.isEdit ? '更新失败' : '新增失败'));\r\n        }\r\n      } catch (error) {\r\n        console.error('提交面料数据失败:', error);\r\n        this.$message.error('操作失败，请重试');\r\n      }\r\n    },\r\n    \r\n    // 表单验证\r\n    validateForm() {\r\n      let isValid = true;\r\n      this.clearFormErrors();\r\n      \r\n      // 验证图片\r\n      if (!this.formData.imageUrl) {\r\n        this.imageError = '请上传面料图片';\r\n        isValid = false;\r\n      }\r\n      \r\n      // 验证名称\r\n      if (!this.formData.name || this.formData.name.trim() === '') {\r\n        this.nameError = '请输入面料名称';\r\n        isValid = false;\r\n      }\r\n      \r\n      // 验证类型\r\n      if (!this.formData.type) {\r\n        this.typeError = '请选择面料类型';\r\n        isValid = false;\r\n      }\r\n      \r\n      return isValid;\r\n    },\r\n    \r\n    // 清空表单错误\r\n    clearFormErrors() {\r\n      this.imageError = '';\r\n      this.nameError = '';\r\n      this.typeError = '';\r\n    },\r\n    \r\n    // 图片上传成功\r\n    handleImageUploadSuccess(res) {\r\n      if (res.code === 200) {\r\n        this.formData.imageUrl = res.data;\r\n        this.imageError = '';\r\n        this.$message.success('图片上传成功');\r\n      } else {\r\n        this.imageError = '图片上传失败，请重试';\r\n      }\r\n    },\r\n    \r\n    // 图片上传失败\r\n    handleImageUploadError() {\r\n      this.imageError = '图片上传失败，请重试';\r\n    },\r\n    \r\n    // 上传前校验\r\n    beforeImageUpload(file) {\r\n      const isImage = file.type.startsWith('image/');\r\n      const isLt2M = file.size / 1024 / 1024 < 2;\r\n      \r\n      if (!isImage) {\r\n        this.$message.error('只能上传图片文件');\r\n        return false;\r\n      }\r\n      if (!isLt2M) {\r\n        this.$message.error('图片大小不能超过2MB');\r\n        return false;\r\n      }\r\n      return true;\r\n    },\r\n    \r\n    // 筛选相关方法\r\n    handleFilter() {\r\n      this.currentPage = 1;\r\n      this.fetchFabricList();\r\n    },\r\n    handleFilterClear() {\r\n      this.fabricQueryDto = { name: '', type: '' };\r\n      this.fetchFabricList();\r\n    },\r\n    handleTypeChange() {\r\n      this.fetchFabricList();\r\n    },\r\n    \r\n    handleSizeChange(val) {\r\n  this.pageSize = val;\r\n  this.currentPage = 1; // 切换每页条数时，重置为第一页\r\n  this.fetchFabricList();\r\n  },\r\n  handleCurrentChange(val) {\r\n  // 确保页码不小于1\r\n  this.currentPage = Math.max(val, 1); \r\n  this.fetchFabricList();\r\n  },\r\n    // 选择行变化\r\n    handleSelectionChange(selection) {\r\n      this.selectedRows = selection;\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n/* 类型标签样式 */\r\n.type-tag {\r\n  display: inline-block;\r\n  padding: 2px 8px;\r\n  border-radius: 4px;\r\n  background-color: #f0f7ff;\r\n  color: #1890ff;\r\n  font-size: 12px;\r\n}\r\n\r\n/* 描述文本样式 */\r\n.description-text {\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  max-width: 300px;\r\n}\r\n\r\n/* 上传占位样式 */\r\n.upload-placeholder {\r\n  width: 240px;\r\n  height: 180px;\r\n  border: 1px dashed #ddd;\r\n  border-radius: 4px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #999;\r\n}\r\n\r\n.avatar-uploader-icon {\r\n  font-size: 28px;\r\n  color: #8c939d;\r\n}\r\n\r\n.upload-placeholder p {\r\n  margin-top: 10px;\r\n  font-size: 14px;\r\n}\r\n\r\n/* 复用资讯管理的样式 */\r\n.dialog-footer {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.customer {\r\n  margin: 0 8px;\r\n}\r\n\r\n.text-button {\r\n  margin: 0 5px;\r\n  color: #409eff;\r\n  cursor: pointer;\r\n}\r\n\r\n.text-button:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.dialog-title {\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #333;\r\n}\r\n</style>"]}]}