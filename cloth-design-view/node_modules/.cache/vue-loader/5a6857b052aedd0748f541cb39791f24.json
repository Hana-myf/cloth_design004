px;\r\n  word-break: break-word;\r\n}\r\n/* AI消息气泡 */\r\n.message-bubble.ai .content {\r\n  background-color: #fff8e8; /* 暖色调AI气泡 */\r\n  border: 1px solid #f0e8d0;\r\n  padding: 12px 15px; /* 稍微增大内边距 */\r\n  overflow: hidden; /* 防止图片超出气泡范围 */\r\n}\r\n/* 用户消息气泡 */\r\n.message-bubble.user .content {\r\n  background-color: #f8fff0; /* 清新暖色调用户气泡 */\r\n  border: 1px solid #e0f0d8;\r\n  padding: 12px 15px; /* 稍微增大内边距 */\r\n  overflow: hidden; /* 防止图片超出气泡范围 */\r\n}\r\n\r\n/* 聊天图片样式优化 */\r\n.chat-image {\r\n  /* 限制最大宽度为对话框的80%，避免超出容器 */\r\n  max-width: 80%;\r\n  /* 限制最大高度，避免图片过长 */\r\n  max-height: 200px;\r\n  /* 保持图片比例，避免变形 */\r\n  object-fit: contain;\r\n  /* 增加边框圆角和间距，提升美观度 */\r\n  border-radius: 8px;\r\n  margin: 5px 0;\r\n  /* 避免图片被挤压时出现滚动条 */\r\n  display: block;\r\n  border: 1px solid #f0e8d0; /* 暖色调图片边框 */\r\n}\r\n.sender {\r\n  font-size: 12px;\r\n  margin: 0 0 5px 0;\r\n  color: #8a7d5e; /* 暖色调文字 */\r\n}\r\n\r\n.message-bubble.user .sender {\r\n  color: #7d8a5e; /* 用户消息暖色调文字 */\r\n  text-align: right;\r\n}\r\n\r\n.text {\r\n  margin: 0;\r\n  line-height: 1.5;\r\n  color: #5a523e; /* 暖色调正文 */\r\n}\r\n\r\n.loading {\r\n  text-align: center;\r\n  padding: 10px;\r\n  color: #8a7d5e; /* 暖色调加载文字 */\r\n  font-size: 14px;\r\n  background-color: #fff8e8;\r\n  border-radius: 8px;\r\n  border: 1px dashed #f0e8d0;\r\n}\r\n\r\n/* 聊天输入区域（暖色调替换原蓝色） */\r\n.chat-input {\r\n  display: flex;\r\n  padding: 10px;\r\n  border-top: 1px solid #f0e8d0; /* 暖色调分割线 */\r\n  background-color: #fffdf8; /* 暖色调背景 */\r\n}\r\n\r\n.chat-input input {\r\n  flex: 1;\r\n  padding: 10px 15px;\r\n  border: 1px solid #f0e8d0; /* 暖色调输入框边框 */\r\n  border-radius: 20px;\r\n  outline: none;\r\n  font-size: 14px;\r\n  background-color: #fff;\r\n}\r\n.chat-input input:focus {\r\n  border-color: #f0c880; /* 聚焦暖色调边框 */\r\n}\r\n\r\n/* 发送按钮（暖色调替换原蓝色） */\r\n.chat-input button {\r\n  margin-left: 10px;\r\n  padding: 0 18px;\r\n  background-color: #f5dca8; /* 暖色调按钮 */\r\n  color: #8a7d5e; /* 暖色调文字 */\r\n  border: 1px solid #f0c880; /* 暖色调边框 */\r\n  border-radius: 20px;\r\n  cursor: pointer;\r\n}\r\n.chat-input button:hover {\r\n  background-color: #f0c880; /* hover暖色调 */\r\n}\r\n.chat-input button:disabled {\r\n  background-color: #e8e4d8;\r\n  border-color: #e0d8c0;\r\n  color: #a09880;\r\n  cursor: not-allowed;\r\n}\r\n\r\n/* 文件上传按钮样式（暖色调） */\r\n.file-upload-input {\r\n  display: none; /* 隐藏原生文件选择框 */\r\n}\r\n\r\n.file-upload-btn {\r\n  margin-right: 10px;\r\n  padding: 8px;\r\n  color: #8a7d5e; /* 暖色调图标 */\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background-color: #fff8e8;\r\n  border: 1px solid #f0e8d0;\r\n  border-radius: 50%;\r\n}\r\n\r\n.file-upload-btn:hover {\r\n  color: #7a6d4e; /* hover暖色调 */\r\n  background-color: #f5dca8;\r\n  border-color: #f0c880;\r\n}\r\n\r\n::v-deep .chat-image {\r\n  max-width: 80% !important; /* 限制最大宽度为对话框80% */\r\n  max-height: 200px !important; /* 限制最大高度200px */\r\n  object-fit: contain !important; /* 保持比例，不拉伸 */\r\n  border-radius: 8px;\r\n  margin: 5px auto !important; /* 居中显示 */\r\n  display: block !important;\r\n  border: 1px solid #f0e8d0 !important;\r\n}\r\n\r\n/* 确保消息气泡不会被图片撑大 */\r\n::v-deep .message-bubble .content {\r\n  max-width: 100%;\r\n  overflow: hidden;\r\n}\r\n\r\n/* 限制消息容器宽度，避免图片溢出 */\r\n::v-deep .message-item {\r\n  max-width: 100%;\r\n  overflow: hidden;\r\n}\r\n\r\n/* 响应式调整：屏幕宽度小于1240px时自动纵向排列 */\r\n@media (max-width: 1240px) {\r\n  .chat-layout {\r\n    flex-direction: column;\r\n  }\r\n}\r\n</style>"]}]}