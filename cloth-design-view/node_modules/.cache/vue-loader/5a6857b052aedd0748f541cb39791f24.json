{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\components\\CozeChat.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\components\\CozeChat.vue","mtime":1767439783053},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":1759332253502},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":1759332273371}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["CozeChat.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA0EA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"CozeChat.vue","sourceRoot":"src/components","sourcesContent":["<template>\r\n  <div class=\"chat-layout\">\r\n    <!-- 左侧：智能体对话框 -->\r\n    <div class=\"chat-container\">\r\n    <div class=\"chat-header\">\r\n     <h3>AI 助手</h3>\r\n     <div class=\"header-buttons\">\r\n      <!-- 清空按钮 -->\r\n      <!-- <button @click=\"clearChatHistory\" class=\"clear-btn\">\r\n        清空记录\r\n      </button> -->\r\n      <!-- 最小化按钮 -->\r\n      <button @click=\"isMinimized =!isMinimized\" class=\"minimize-btn\">\r\n        {{ isMinimized? '展开' : '收起' }}\r\n      </button>\r\n     </div>\r\n    </div>\r\n\r\n      <div v-if=\"!isMinimized\" class=\"chat-messages\">\r\n        <div v-for=\"(msg, index) in messages\" :key=\"index\" class=\"message-item\">\r\n          <div :class=\"['message-bubble', msg.isUser? 'user' : 'ai']\">\r\n            <img :src=\"msg.avatar\" class=\"avatar\" alt=\"头像\">\r\n            <div class=\"content\">\r\n              <p class=\"sender\">{{ msg.isUser? '我' : 'AI 助手' }}</p>\r\n              <div class=\"text\" v-html=\"parseContent(msg.content)\"></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div v-if=\"isLoading\" class=\"loading\">AI 正在思考...</div>\r\n      </div>\r\n\r\n      <div v-if=\"!isMinimized\" class=\"chat-input\">\r\n        <label class=\"file-upload-btn\" for=\"file-upload\">\r\n          <i class=\"el-icon-picture\"></i> <!-- 假设使用Element UI图标，也可替换为文字 -->\r\n        </label>\r\n        <input \r\n          type=\"file\" \r\n          id=\"file-upload\" \r\n          class=\"file-upload-input\"\r\n          accept=\"image/*\" \r\n          @change=\"handleFileUpload\"\r\n          :disabled=\"isLoading\"\r\n        >\r\n        <input \r\n          type=\"text\" \r\n          v-model=\"userInput\" \r\n          @keyup.enter=\"sendMessage\" \r\n          placeholder=\"输入消息...按回车发送\"\r\n          :disabled=\"isLoading\"\r\n        >\r\n        <button @click=\"sendMessage\" :disabled=\"isLoading\">发送</button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 右侧：图片预览框（与左侧等高并排） -->\r\n    <div class=\"image-container\">\r\n      <div class=\"image-header\">\r\n        <h3>图片预览</h3>\r\n      </div>\r\n      <ImageViewer \r\n       :aiReply=\"lastAiReply\" \r\n       :currentUserId=\"realCurrentUserId\" \r\n       class=\"image-viewer\"\r\n       @save-success=\"loadUserImages\" \r\n      />\r\n      <ImageSaveList \r\n        :savedImages=\"savedImages\" \r\n        class=\"save-list\"\r\n      />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport ImageViewer from './ImageViewer.vue';\r\nimport ImageSaveList from './ImageSaveList.vue';\r\nimport { mapGetters } from 'vuex';\r\nimport request from '@/utils/request';\r\nexport default {\r\n  name: 'CozeChat',\r\n  components: {\r\n    ImageViewer,\r\n    ImageSaveList\r\n  },\r\n  // 新增：计算属性获取正确的用户ID（解决初始化拿不到store的问题）\r\n  computed: {\r\n    realCurrentUserId() {\r\n      return this.$store.state.user.userInfo?.id || 23; // 兜底默认23，避免空值\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      messages: [],\r\n      userInput: '',\r\n      isLoading: false,\r\n      isMinimized: false,\r\n      apiKey: 'pat_l71GjeLrzmzEzh0d8R5saRWgJFrlhAL79YJbt1KJPLDSmHt2OuXaxom7A92dKjqG',\r\n      robotId: '7475343940674371584',\r\n      userId: 'user_' + Math.random().toString(36).substr(2, 9),\r\n      apiUrl: 'https://api.coze.cn/v3/chat',\r\n      lastAiReply: '',\r\n      savedImages: [], // 存储后端返回的用户图片列表\r\n      // 注释掉原错误赋值：避免初始化时拿不到store\r\n      // currentUserId: this.$store.state.user.userInfo?.id || '', \r\n      uploadUrl: '/file/upload',\r\n    };\r\n  },\r\n  mounted() {\r\n    // 初始化欢迎消息\r\n    this.messages.push({\r\n      content: '你好！我是AI助手，有什么可以帮你的吗？',\r\n      isUser: false,\r\n      avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/chatsdk-logo.png'\r\n    });\r\n    // 登录状态判断（只执行一次）\r\n    if (!this.realCurrentUserId) { // 修复：使用计算属性的用户ID\r\n      this.$router.push('/login'); // 未登录跳转\r\n    } else {\r\n      this.loadUserImages(); // 已登录才加载图片\r\n    }\r\n    console.log('Vuex用户信息:', this.$store.state.user.userInfo);\r\n    console.log('当前用户ID:', this.realCurrentUserId); // 修复：打印正确的用户ID\r\n  },\r\n  methods: {\r\n    // 调用后端接口，查询用户的图片列表\r\n    async loadUserImages() {\r\n      try {\r\n        const queryDto = {\r\n          userId: this.realCurrentUserId, // 修复：使用正确的用户ID\r\n          pageNum: 1,\r\n          pageSize: 4\r\n        };\r\n        console.log('前端查询参数：', queryDto);\r\n\r\n        const response = await request.post('/generatedImage/query', queryDto);\r\n        // 关键：打印完整响应，确认后端返回格式\r\n        console.log('后端响应完整数据：', response); \r\n        console.log('后端响应data字段：', response.data);\r\n\r\n        // 修正判断条件：根据后端实际返回的code判断（通常200代表成功）\r\n        if (response.data && response.data.code === 200) { \r\n          // 确认后端返回的图片数组在response.data.data中\r\n          console.log('后端返回的图片列表：', response.data.data);\r\n\r\n          // 按时间倒序（后端已按generate_time DESC排序，可省略）\r\n          const sortedImages = response.data.data.sort(\r\n            (a, b) => new Date(b.generateTime) - new Date(a.generateTime)\r\n          );\r\n          this.savedImages = sortedImages.slice(0, 4);\r\n          // 打印赋值后的savedImages，确认数据已接收\r\n          console.log('前端savedImages赋值后：', this.savedImages); \r\n        } else {\r\n          console.warn('后端返回非成功状态：', response.data);\r\n        }\r\n      } catch (error) {\r\n        console.error('加载失败：', error);\r\n      }\r\n    },\r\n    async handleFileUpload(e) {\r\n      const file = e.target.files[0];\r\n      if (!file) return;\r\n\r\n      // 清空文件选择框（允许重复选择同一文件）\r\n      e.target.value = '';\r\n\r\n      // 验证文件类型和大小\r\n      if (!file.type.startsWith('image/')) {\r\n        this.$message.error('请上传图片文件（jpg、png等）');\r\n        return;\r\n      }\r\n      if (file.size > 10 * 1024 * 1024) { // 10MB限制\r\n        this.$message.error('文件大小不能超过10MB');\r\n        return;\r\n      }\r\n\r\n      this.isLoading = true;\r\n      try {\r\n        // 构建FormData\r\n        const formData = new FormData();\r\n        formData.append('file', file);\r\n\r\n        // 调用后端上传接口\r\n        const response = await this.$axios.post(this.uploadUrl, formData, {\r\n          headers: { 'Content-Type': 'multipart/form-data' }\r\n        });\r\n\r\n        if (response.data.code === 200) {\r\n          const imageUrl = response.data.data; // 后端返回的图片URL\r\n          // 将图片添加到聊天记录\r\n          this.messages.push({\r\n            content: `<img src=\"${imageUrl}\" class=\"chat-image\" alt=\"上传的图片\">`,\r\n            isUser: true,\r\n            avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/coze-logo.png'\r\n          });\r\n          this.scrollToBottom();\r\n\r\n          // 自动发送图片给AI处理（如果需要）\r\n          this.sendMessageWithImage(imageUrl);\r\n        } else {\r\n          this.$message.error(response.data.msg || '上传失败');\r\n        }\r\n      } catch (error) {\r\n        console.error('文件上传失败:', error);\r\n        this.$message.error('上传失败，请重试');\r\n      } finally {\r\n        this.isLoading = false;\r\n      }\r\n    },\r\n    sendMessageWithImage(imageUrl) {\r\n      // 可以添加提示文本，例如\"请分析这张图片\"\r\n      const userMessage = `请分析这张图片: ${imageUrl}`;\r\n      \r\n      // 调用原有发送逻辑\r\n      this.userInput = userMessage;\r\n      this.sendMessage();\r\n    },\r\n    // 保存图片到后端（调用已有的save接口）\r\n    async saveImageToBackend(imageInfo) {\r\n      try {\r\n        const imageData = {\r\n          userId: this.realCurrentUserId, // 修复：使用正确的用户ID\r\n          imageName: imageInfo.name, // 图片名称\r\n          imageUrl: imageInfo.url,   // 图片URL\r\n          generateTime: new Date()   // 生成时间\r\n        };\r\n        await this.$http.post('/generatedImage/save', imageData);\r\n        // 保存成功后，重新加载列表（此时后端会返回最新的4张）\r\n        this.loadUserImages();\r\n      } catch (error) {\r\n        console.error('保存图片失败:', error);\r\n      }\r\n    },\r\n    parseContent(content) {\r\n      return content;\r\n    },\r\n    async sendMessage() {\r\n      // 原有发送消息逻辑不变...\r\n      if (!this.userInput.trim() || this.isLoading) return;\r\n\r\n      this.messages.push({\r\n        content: this.userInput,\r\n        isUser: true,\r\n        avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/coze-logo.png'\r\n      });\r\n\r\n      const userMessage = this.userInput;\r\n      this.userInput = '';\r\n      this.isLoading = true;\r\n\r\n      const aiMsgIndex = this.messages.push({\r\n        content: '',\r\n        isUser: false,\r\n        avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/chatsdk-logo.png'\r\n      }) - 1;\r\n\r\n      try {\r\n        const response = await fetch(this.apiUrl, {\r\n          method: 'POST',\r\n          headers: {\r\n            'Content-Type': 'application/json',\r\n            'Authorization': `Bearer ${this.apiKey}`\r\n          },\r\n          body: JSON.stringify({\r\n            bot_id: this.robotId,\r\n            user_id: this.userId,\r\n            stream: true,\r\n            auto_save_history: true,\r\n            additional_messages: [\r\n              {\r\n                role: \"user\",\r\n                content: userMessage,\r\n                content_type: \"text\"\r\n              }\r\n            ]\r\n          })\r\n        });\r\n\r\n        if (!response.ok) {\r\n          throw new Error(`请求失败: ${response.status}`);\r\n        }\r\n\r\n        const reader = response.body.getReader();\r\n        const decoder = new TextDecoder();\r\n        let fullReply = '';\r\n        let currentEvent = null;\r\n\r\n        while (true) {\r\n          const { done, value } = await reader.read();\r\n          if (done) break;\r\n\r\n          const chunk = decoder.decode(value, { stream: true });\r\n          const lines = chunk.split('\\n').filter(line => line.trim());\r\n\r\n          for (const line of lines) {\r\n            if (line.startsWith('event:')) {\r\n              currentEvent = line.replace('event:', '').trim();\r\n              continue;\r\n            }\r\n\r\n            if (line.startsWith('data:') && currentEvent === 'conversation.message.delta') {\r\n              const dataStr = line.replace('data:', '').trim();\r\n              if (dataStr) {\r\n                try {\r\n                  const data = JSON.parse(dataStr);\r\n                  if (data.content) {\r\n                    fullReply += data.content;\r\n                    this.messages[aiMsgIndex].content = fullReply;\r\n                    this.scrollToBottom();\r\n                  }\r\n                } catch (e) {\r\n                  console.warn('解析片段失败:', e);\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n\r\n        this.lastAiReply = fullReply;\r\n        console.log('AI回复已传递给ImageViewer:', this.lastAiReply); // 新增：验证回复传递\r\n        this.isLoading = false;\r\n\r\n      } catch (error) {\r\n        console.error('API调用错误:', error);\r\n        this.messages[aiMsgIndex].content = `出错了: ${error.message}`;\r\n        this.isLoading = false;\r\n      }\r\n    },\r\n    scrollToBottom() {\r\n      const container = this.$el.querySelector('.chat-messages');\r\n      if (container) {\r\n        container.scrollTop = container.scrollHeight;\r\n      }\r\n    }\r\n  },\r\n   clearChatHistory() {\r\n    // 确认弹窗，防止误操作\r\n    if (confirm('确定要清空所有聊天记录吗？')) {\r\n      this.messages = []; // 清空消息列表\r\n      // 可选项：重新添加初始欢迎消息\r\n      this.messages.push({\r\n        content: '你好！我是AI助手，有什么可以帮你的吗？',\r\n        isUser: false,\r\n        avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/chatsdk-logo.png'\r\n      });\r\n      this.scrollToBottom(); // 滚动到底部\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 横向布局容器 - 加背景图+暖色调基底 */\r\n.chat-layout {\r\n  display: flex;\r\n  gap: 20px; /* 两框之间的间距 */\r\n  padding: 20px;\r\n  max-width: 1400px; /* 限制最大宽度，避免过宽 */\r\n  margin: 0 auto; /* 居中显示 */\r\n  align-items: flex-start; /* 顶部对齐，而不是拉伸对齐 */\r\n  /* 背景图（替换成你的图片URL）+ 暖色调叠加 */\r\n  background: url(\"https://pic1.imgdb.cn/item/6958e1eeda3df73ea1bc5a2c.png\") center/cover no-repeat;\r\n  background-color: rgba(255, 255, 250, 0.95);\r\n  background-blend-mode: overlay;\r\n  min-height: calc(100vh - 100px);\r\n  border-radius: 16px;\r\n  box-shadow: 0 8px 24px rgba(240, 224, 180, 0.12);\r\n}\r\n\r\n/* 左侧聊天框样式 - 暖色调边框/背景 */\r\n.chat-container {\r\n  width: 600px;\r\n  border: 1px solid #f0e8d0; /* 暖色调边框 */\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 10px rgba(240, 224, 180, 0.15); /* 暖色调阴影 */\r\n  font-family: Arial, sans-serif;\r\n  display: flex;\r\n  flex-direction: column; /* 纵向布局，内容区自适应高度 */\r\n  max-height: 700px;\r\n  background-color: rgba(255, 255, 250, 0.98); /* 暖色调背景 */\r\n}\r\n\r\n/* 右侧图片预览框样式 - 同步暖色调 */\r\n.image-container {\r\n  width: 400px; /* 与聊天框等宽 */\r\n  border: 1px solid #f0e8d0; /* 暖色调边框 */\r\n  border-radius: 8px; /* 相同圆角 */\r\n  box-shadow: 0 2px 10px rgba(240, 224, 180, 0.15); /* 暖色调阴影 */\r\n  font-family: Arial, sans-serif;\r\n  display: flex;\r\n  flex-direction: column;\r\n  /* 新增：最大高度限制，超出则滚动 */\r\n  max-height: 650px;\r\n  background-color: rgba(255, 255, 250, 0.98); /* 暖色调背景 */\r\n  /* 移除了flex:1，不再强制拉伸高度 */\r\n}\r\n\r\n/* 图片框头部（暖色调替换原蓝色） */\r\n.image-header {\r\n  background-color: #fff8e8; /* 暖色调头部背景 */\r\n  color: #8a7d5e; /* 暖色调文字 */\r\n  padding: 12px 15px;\r\n  border-radius: 8px 8px 0 0;\r\n  border-bottom: 1px solid #f0e8d0;\r\n}\r\n\r\n.image-header h3 {\r\n  margin: 0;\r\n  font-size: 16px;\r\n}\r\n\r\n/* 图片预览工具的容器 */\r\n.image-viewer {\r\n  padding: 15px;\r\n  /* 让内容决