{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\Home.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\Home.vue","mtime":1774538335626},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":1759332253502},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":1759332273371}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Home.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAiGA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Home.vue","sourceRoot":"src/views/user","sourcesContent":["<template>\r\n  <div class=\"news-container\" @mousemove=\"handleMouseMove\">\r\n    <!-- 毛线光标（和登录页统一） -->\r\n    <div class=\"yarn-cursor\" :style=\"{ left: mouseX + 'px', top: mouseY + 'px' }\">\r\n      <div class=\"yarn-ball\">🧶</div>\r\n      <svg class=\"thread-tail\">\r\n        <path :d=\"threadPath\" stroke=\"#e2b86e\" stroke-width=\"1.5\" fill=\"none\" opacity=\"0.6\" stroke-dasharray=\"4,3\"/>\r\n      </svg>\r\n    </div>\r\n\r\n    <!-- 顶部 Banner + 推荐资讯 -->\r\n    <div class=\"news-top-wrapper\">\r\n      <el-row :gutter=\"20\">\r\n        <el-col :span=\"6\">\r\n          <div class=\"banner-card\">\r\n            <Banner :data=\"newsTopList\" @on-click=\"onBannerClick\" />\r\n          </div>\r\n        </el-col>\r\n\r\n        <el-col :span=\"18\">\r\n          <el-row :gutter=\"20\">\r\n            <el-col\r\n              @click.native=\"newsItemClick(news)\"\r\n              :span=\"6\"\r\n              :key=\"index\"\r\n              v-for=\"(news, index) in newsTopList\"\r\n            >\r\n              <div class=\"top-news-card\">\r\n                <div class=\"card-image\">\r\n                  <img :src=\"news.cover\" :alt=\"news.name\" />\r\n                  <div class=\"image-overlay\"></div>\r\n                </div>\r\n                <div class=\"card-content\">\r\n                  <h2 class=\"card-title\">{{ news.name }}</h2>\r\n                  <div class=\"card-info\">\r\n                    <span class=\"news-tag\">{{ news.tagName }}</span>\r\n                    <span class=\"time\">{{ parseTime(news.createTime) }}</span>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </el-col>\r\n          </el-row>\r\n        </el-col>\r\n      </el-row>\r\n    </div>\r\n\r\n    <!-- 标签栏 -->\r\n    <div class=\"tag-wrapper\">\r\n      <TagLine :dataList=\"tagsList\" @on-click=\"tagOnClick\" />\r\n    </div>\r\n\r\n    <!-- 资讯列表 -->\r\n    <div class=\"news-list-wrapper\">\r\n      <div v-if=\"newsList.length === 0\" class=\"empty-box\">\r\n        <el-empty description=\"暂无资讯\"></el-empty>\r\n      </div>\r\n\r\n      <el-row :gutter=\"20\">\r\n        <el-col\r\n          class=\"news-item-col\"\r\n          @click.native=\"newsItemClick(news)\"\r\n          :span=\"4\"\r\n          :key=\"index\"\r\n          v-for=\"(news, index) in newsList\"\r\n        >\r\n          <div class=\"news-card\">\r\n            <div class=\"news-image\">\r\n              <img :src=\"news.cover\" :alt=\"news.name\" />\r\n            </div>\r\n            <div class=\"news-content\">\r\n              <h3 class=\"news-title\">{{ news.name }}</h3>\r\n              <div class=\"news-bottom\">\r\n                <span class=\"news-tag\">{{ news.tagName }}</span>\r\n                <span class=\"time\">{{ parseTime(news.createTime) }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </el-col>\r\n      </el-row>\r\n\r\n      <!-- 分页 -->\r\n      <div class=\"pagination-box\">\r\n        <el-pagination\r\n          @size-change=\"handleSizeChange\"\r\n          @current-change=\"handleCurrentChange\"\r\n          :current-page=\"currentPage\"\r\n          :page-sizes=\"[12, 24, 36]\"\r\n          :page-size=\"pageSize\"\r\n          layout=\"total, sizes, prev, pager, next, jumper\"\r\n          :total=\"total\"\r\n        ></el-pagination>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport TagLine from \"@/components/TagLine\"\r\nimport Banner from \"@/components/Banner\"\r\nimport { timeAgo } from \"@/utils/data\"\r\n\r\nexport default {\r\n  components: { TagLine, Banner },\r\n  data() {\r\n    return {\r\n      tagsList: [],\r\n      newsList: [],\r\n      newsTopList: [],\r\n      newQueryDto: { tagId: null },\r\n      currentPage: 1,\r\n      pageSize: 12,\r\n      total: 0,\r\n      // 毛线光标\r\n      mouseX: 0,\r\n      mouseY: 0,\r\n      history: []\r\n    }\r\n  },\r\n  created() {\r\n    this.loadAllTags()\r\n    this.loadAllNews()\r\n    this.loadAllTopNews()\r\n  },\r\n  computed: {\r\n    threadPath() {\r\n      if (this.history.length < 2) return ''\r\n      return `M ${this.history.map(p => `${p.x - this.mouseX},${p.y - this.mouseY}`).join(' L ')}`\r\n    }\r\n  },\r\n  methods: {\r\n    // 毛线光标\r\n    handleMouseMove(e) {\r\n      this.mouseX = e.clientX\r\n      this.mouseY = e.clientY\r\n      this.history.push({ x: e.clientX, y: e.clientY })\r\n      if (this.history.length > 12) this.history.shift()\r\n    },\r\n    onBannerClick(banner) {\r\n      sessionStorage.setItem('newsInfo', JSON.stringify(banner))\r\n      this.$router.push('/news-detail')\r\n    },\r\n    newsItemClick(news) {\r\n      sessionStorage.setItem('newsInfo', JSON.stringify(news))\r\n      this.$router.push('/news-detail')\r\n    },\r\n    parseTime(time) {\r\n      return timeAgo(time)\r\n    },\r\n    tagOnClick(tags) {\r\n      this.newQueryDto.tagId = tags.id\r\n      this.currentPage = 1\r\n      this.loadAllNews()\r\n    },\r\n    loadAllTags() {\r\n      this.$axios.post('/tags/query', {}).then(res => {\r\n        if (res.data.code === 200) {\r\n          this.tagsList = res.data.data\r\n          this.tagsList.unshift({ name: '全部', id: null })\r\n        }\r\n      })\r\n    },\r\n    loadAllTopNews() {\r\n      this.$axios.get(`/news/queryRecommend/${4}`).then(res => {\r\n        if (res.data.code === 200) {\r\n          this.newsTopList = res.data.data\r\n        }\r\n      })\r\n    },\r\n    loadAllNews() {\r\n      this.$axios.post('/news/query', this.newQueryDto).then(res => {\r\n        if (res.data.code === 200) {\r\n          const allNews = res.data.data\r\n          this.total = allNews.length\r\n          const start = (this.currentPage - 1) * this.pageSize\r\n          const end = start + this.pageSize\r\n          this.newsList = allNews.slice(start, end)\r\n        }\r\n      })\r\n    },\r\n    handleSizeChange(val) {\r\n      this.pageSize = val\r\n      this.loadAllNews()\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.currentPage = val\r\n      this.loadAllNews()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n// 全局容器（统一登录页风格）\r\n.news-container {\r\n  width: 100%;\r\n  min-height: 100vh;\r\n  background: #fdfaf5;\r\n  padding: 30px 40px;\r\n  box-sizing: border-box;\r\n  font-family: \"PingFang SC\", \"Optima\", sans-serif;\r\n  cursor: none;\r\n}\r\n\r\n// 毛线光标（和登录页完全一致）\r\n.yarn-cursor {\r\n  position: fixed;\r\n  pointer-events: none;\r\n  z-index: 9999;\r\n  transform: translate(-50%, -50%);\r\n  .yarn-ball {\r\n    font-size: 32px;\r\n    filter: drop-shadow(0 5px 10px rgba(0,0,0,0.1));\r\n  }\r\n  .thread-tail {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    overflow: visible;\r\n    width: 1px;\r\n    height: 1px;\r\n  }\r\n}\r\n\r\n// 顶部区域\r\n.news-top-wrapper {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n// Banner 卡片\r\n.banner-card {\r\n  background: #fff;\r\n  border-radius: 16px;\r\n  overflow: hidden;\r\n  box-shadow: 0 8px 24px rgba(74, 58, 42, 0.08);\r\n}\r\n\r\n// 推荐资讯卡片\r\n.top-news-card {\r\n  background: #ffffff;\r\n  border-radius: 16px;\r\n  overflow: hidden;\r\n  box-shadow: 0 8px 24px rgba(74, 58, 42, 0.08);\r\n  transition: all 0.3s ease;\r\n  cursor: pointer;\r\n\r\n  &:hover {\r\n    transform: translateY(-4px);\r\n    box-shadow: 0 12px 32px rgba(74, 58, 42, 0.12);\r\n  }\r\n\r\n  .card-image {\r\n    position: relative;\r\n    width: 100%;\r\n    height: 160px;\r\n    overflow: hidden;\r\n\r\n    img {\r\n      width: 100%;\r\n      height: 100%;\r\n      object-fit: cover;\r\n      transition: 0.4s;\r\n    }\r\n\r\n    .image-overlay {\r\n      position: absolute;\r\n      top: 0;\r\n      left: 0;\r\n      width: 100%;\r\n      height: 100%;\r\n      background: linear-gradient(to top, rgba(0,0,0,0.2), transparent);\r\n    }\r\n  }\r\n\r\n  .card-content {\r\n    padding: 14px 16px;\r\n\r\n    .card-title {\r\n      font-size: 16px;\r\n      font-weight: 600;\r\n      color: #3d2f24;\r\n      margin: 0 0 8px 0;\r\n      overflow: hidden;\r\n      text-overflow: ellipsis;\r\n      white-space: nowrap;\r\n    }\r\n\r\n    .card-info {\r\n      display: flex;\r\n      justify-content: space-between;\r\n      align-items: center;\r\n      font-size: 12px;\r\n    }\r\n  }\r\n}\r\n\r\n// 标签栏\r\n.tag-wrapper {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n// 资讯列表容器\r\n.news-list-wrapper {\r\n  background: #fff;\r\n  border-radius: 20px;\r\n  padding: 30px;\r\n  box-shadow: 0 10px 30px rgba(74, 58, 42, 0.06);\r\n}\r\n\r\n// 空状态\r\n.empty-box {\r\n  padding: 60px 0;\r\n  text-align: center;\r\n}\r\n\r\n// 资讯卡片列\r\n.news-item-col {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n// 资讯卡片\r\n.news-card {\r\n  background: #fdfaf5;\r\n  border-radius: 16px;\r\n  overflow: hidden;\r\n  transition: all 0.3s ease;\r\n  cursor: pointer;\r\n  border: 1px solid rgba(226, 184, 110, 0.12);\r\n\r\n  &:hover {\r\n    transform: translateY(-4px);\r\n    box-shadow: 0 12px 24px rgba(74, 58, 42, 0.1);\r\n    border-color: rgba(226, 184, 110, 0.3);\r\n  }\r\n\r\n  .news-image {\r\n    width: 100%;\r\n    height: 130px;\r\n    overflow: hidden;\r\n\r\n    img {\r\n      width: 100%;\r\n      height: 100%;\r\n      object-fit: cover;\r\n      transition: 0.4s;\r\n    }\r\n  }\r\n\r\n  .news-content {\r\n    padding: 14px;\r\n\r\n    .news-title {\r\n      font-size: 15px;\r\n      font-weight: 600;\r\n      color: #3d2f24;\r\n      margin: 0 0 10px 0;\r\n      overflow: hidden;\r\n      text-overflow: ellipsis;\r\n      white-space: nowrap;\r\n    }\r\n\r\n    .news-bottom {\r\n      display: flex;\r\n      justify-content: space-between;\r\n      align-items: center;\r\n      font-size: 12px;\r\n    }\r\n  }\r\n}\r\n\r\n// ✅ 统一标签样式（修改后：缩小字号 + 禁止换行）\r\n.news-tag {\r\n  display: inline-block;\r\n  padding: 2px 6px;\r\n  background: #e2b86e;\r\n  color: #fff;\r\n  border-radius: 4px;\r\n  font-weight: 500;\r\n  font-size: 11px; /* 从12px缩小到11px */\r\n  white-space: nowrap; /* 强制不换行 */\r\n}\r\n\r\n// 时间样式\r\n.time {\r\n  color: #bca080;\r\n}\r\n\r\n// 分页\r\n.pagination-box {\r\n  margin-top: 30px;\r\n  text-align: center;\r\n\r\n  :deep(.el-pagination) {\r\n    color: #3d2f24;\r\n\r\n    button {\r\n      border-color: rgba(226, 184, 110, 0.3);\r\n      color: #3d2f24;\r\n\r\n      &:hover {\r\n        color: #e2b86e;\r\n        border-color: #e2b86e;\r\n        background: transparent;\r\n      }\r\n    }\r\n\r\n    .el-pager li.active {\r\n      background: #e2b86e;\r\n      color: #fff;\r\n      font-weight: bold;\r\n    }\r\n  }\r\n}\r\n</style>"]}]}