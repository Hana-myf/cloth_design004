{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ColorExtractor.vue?vue&type=style&index=0&id=589903b1&scoped=true&lang=css&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ColorExtractor.vue","mtime":1767451006046},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\css-loader\\dist\\cjs.js","mtime":1759332259160},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1759332273372},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\postcss-loader\\src\\index.js","mtime":1759332269050},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":1759332273371}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["ColorExtractor.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA8PA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"ColorExtractor.vue","sourceRoot":"src/components","sourcesContent":["<template>\r\n  <div class=\"color-extractor\">\r\n    <!-- 标题：手绘装饰点 -->\r\n    <h4 class=\"extractor-title\">\r\n      <span class=\"title-dot\"></span>色彩提取器\r\n    </h4>\r\n\r\n    <!-- 上传区域：暖色调按钮 -->\r\n    <div class=\"upload-area\">\r\n      <el-input\r\n        v-model=\"imageUrl\"\r\n        placeholder=\"粘贴公共图片URL\"\r\n        clearable\r\n        class=\"url-input\"\r\n        @clear=\"clearImageUrl\"\r\n      ></el-input>\r\n\r\n      <!-- 暖色调上传按钮（无蓝色） -->\r\n      <el-upload\r\n        class=\"image-uploader\"\r\n        action=\"\"\r\n        :auto-upload=\"false\"\r\n        :on-change=\"handleImageUpload\"\r\n        :show-file-list=\"false\"\r\n        accept=\"image/jpeg,image/png,image/webp\"\r\n        :disabled=\"isExtracting\"\r\n      >\r\n        <el-button class=\"upload-btn\">\r\n          <i class=\"el-icon-cloud-upload\"></i> 上传本地图片\r\n        </el-button>\r\n      </el-upload>\r\n\r\n      <!-- 暖色调提取按钮（无蓝色） -->\r\n      <el-button\r\n        class=\"extract-btn\"\r\n        @click=\"extractColors\"\r\n        :disabled=\"!imageUrl && !uploadedFile || isExtracting\"\r\n      >\r\n        <i class=\"el-icon-color\"></i> {{ isExtracting ? '提取中...' : '提取主色' }}\r\n      </el-button>\r\n    </div>\r\n\r\n    <!-- 手绘调色板：整齐排列 -->\r\n    <div class=\"palette-area\">\r\n      <h5 class=\"palette-title\">当前调色板</h5>\r\n      <div class=\"color-palette\" v-if=\"extractedColors.length > 0\">\r\n        <div\r\n          v-for=\"(color, index) in extractedColors\"\r\n          :key=\"index\"\r\n          class=\"color-swatch\"\r\n          :class=\"{ selected: selectedColorIndexes.includes(index) }\"\r\n          :style=\"{ backgroundColor: color.hex }\"\r\n          @click=\"toggleColorSelect(index)\"\r\n          title=\"点击选中/取消\"\r\n        >\r\n          <span class=\"color-hex\">{{ color.hex }}</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"empty-palette\" v-else>\r\n        <i class=\"el-icon-paintbrush\"></i>\r\n        <p>上传图片后自动生成调色板</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 图片预览：完整显示 -->\r\n    <div class=\"preview-area\" v-if=\"previewImageUrl\">\r\n      <p class=\"preview-label\">提取参考图</p>\r\n      <img :src=\"previewImageUrl\" alt=\"提取参考图\" class=\"preview-img\" />\r\n    </div>\r\n\r\n    <!-- 空状态提示 -->\r\n    <div class=\"global-empty-state\" v-if=\"!previewImageUrl && extractedColors.length === 0\">\r\n      <i class=\"el-icon-picture-outline\"></i>\r\n      <p>粘贴图片URL或上传本地图片，提取主色调</p>\r\n    </div>\r\n\r\n    <!-- 错误提示 -->\r\n    <div class=\"error-state\" v-if=\"extractError\">\r\n      <i class=\"el-icon-warning\"></i>\r\n      <p>{{ extractError }}</p>\r\n    </div>\r\n\r\n    <!-- 暖色调应用按钮（无蓝色） -->\r\n    <el-button\r\n      class=\"apply-btn\"\r\n      @click=\"applySelectedColors\"\r\n      :disabled=\"extractedColors.length === 0 || selectedColorIndexes.length === 0\"\r\n    >\r\n      应用选中的调色板\r\n    </el-button>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'ColorExtractor',\r\n  data() {\r\n    return {\r\n      imageUrl: '',\r\n      uploadedFile: null,\r\n      previewImageUrl: '',\r\n      extractedColors: [],\r\n      selectedColorIndexes: [],\r\n      isExtracting: false,\r\n      extractError: '',\r\n      imgbbApiKey: 'ddfd3ce61ba74d50a1d1167d498e4c0f',\r\n      maxColors: 8,\r\n    };\r\n  },\r\n  methods: {\r\n    clearImageUrl() {\r\n      this.imageUrl = '';\r\n      this.previewImageUrl = '';\r\n      this.extractedColors = [];\r\n      this.selectedColorIndexes = [];\r\n      this.extractError = '';\r\n    },\r\n\r\n    async handleImageUpload(file) {\r\n      const imageFile = file.raw;\r\n      if (!imageFile || this.isExtracting) return;\r\n\r\n      this.uploadedFile = imageFile;\r\n      this.isExtracting = true;\r\n      this.extractError = '';\r\n\r\n      try {\r\n        const formData = new FormData();\r\n        formData.append('image', imageFile);\r\n        const response = await fetch(`https://api.imgbb.com/1/upload?key=${this.imgbbApiKey}`, {\r\n          method: 'POST',\r\n          body: formData,\r\n        });\r\n        const result = await response.json();\r\n\r\n        if (result.success) {\r\n          this.previewImageUrl = result.data.url;\r\n          this.imageUrl = '';\r\n          this.$message.success('图片上传成功！');\r\n        } else {\r\n          throw new Error(result.error?.message || '图片上传失败');\r\n        }\r\n      } catch (error) {\r\n        this.extractError = `上传失败：${error.message}`;\r\n        this.$message.error(this.extractError);\r\n      } finally {\r\n        this.isExtracting = false;\r\n      }\r\n    },\r\n\r\n    async extractColors() {\r\n      if (this.isExtracting) return;\r\n      this.isExtracting = true;\r\n      this.extractError = '';\r\n      this.extractedColors = [];\r\n      this.selectedColorIndexes = [];\r\n\r\n      try {\r\n        const finalImageUrl = this.imageUrl.trim() || this.previewImageUrl;\r\n        if (!finalImageUrl) {\r\n          throw new Error('请先上传图片或输入图片URL');\r\n        }\r\n\r\n        const img = new Image();\r\n        img.crossOrigin = 'Anonymous';\r\n        img.onload = async () => {\r\n          try {\r\n            const canvas = document.createElement('canvas');\r\n            const ctx = canvas.getContext('2d');\r\n            const scale = 0.2;\r\n            canvas.width = img.width * scale;\r\n            canvas.height = img.height * scale;\r\n            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);\r\n\r\n            const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);\r\n            const pixels = imageData.data;\r\n            const colorMap = new Map();\r\n\r\n            for (let i = 0; i < pixels.length; i += 4) {\r\n              const r = pixels[i];\r\n              const g = pixels[i + 1];\r\n              const b = pixels[i + 2];\r\n              const a = pixels[i + 3];\r\n              if (a < 128) continue;\r\n\r\n              const hex = this.rgbToHex(r, g, b);\r\n              const count = colorMap.get(hex) || 0;\r\n              colorMap.set(hex, count + 1);\r\n            }\r\n\r\n            const sortedColors = Array.from(colorMap.entries())\r\n              .sort((a, b) => b[1] - a[1])\r\n              .slice(0, this.maxColors);\r\n\r\n            this.extractedColors = sortedColors.map(([hex]) => ({\r\n              hex,\r\n              name: this.getColorName(hex),\r\n            }));\r\n            this.selectedColorIndexes = [0, 1, 2, 3].filter(i => i < this.extractedColors.length);\r\n            this.$message.success(`成功生成${this.extractedColors.length}色调色板！`);\r\n          } catch (error) {\r\n            this.extractError = `提取失败：${error.message}`;\r\n            this.$message.error(this.extractError);\r\n          } finally {\r\n            this.isExtracting = false;\r\n          }\r\n        };\r\n\r\n        img.onerror = () => {\r\n          this.extractError = '图片加载失败，请检查URL是否有效';\r\n          this.$message.error(this.extractError);\r\n          this.isExtracting = false;\r\n        };\r\n\r\n        img.src = finalImageUrl;\r\n      } catch (error) {\r\n        this.extractError = error.message;\r\n        this.$message.error(this.extractError);\r\n        this.isExtracting = false;\r\n      }\r\n    },\r\n\r\n    rgbToHex(r, g, b) {\r\n      return `#${((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1)}`;\r\n    },\r\n\r\n    getColorName(hex) {\r\n      const colorNames = {\r\n        '#ffffff': '白色', '#000000': '黑色', '#ff0000': '红色', '#00ff00': '绿色', '#0000ff': '蓝色',\r\n        '#ffff00': '黄色', '#ff00ff': '洋红', '#00ffff': '青色', '#ffa500': '橙色', '#800080': '紫色',\r\n      };\r\n      return colorNames[hex.toLowerCase()] || `自定义色`;\r\n    },\r\n\r\n    toggleColorSelect(index) {\r\n      if (this.selectedColorIndexes.includes(index)) {\r\n        this.selectedColorIndexes = this.selectedColorIndexes.filter(i => i !== index);\r\n      } else {\r\n        this.selectedColorIndexes.push(index);\r\n      }\r\n    },\r\n\r\n    applySelectedColors() {\r\n      const selectedColors = this.selectedColorIndexes.map(i => this.extractedColors[i]);\r\n      this.$emit('apply-colors', selectedColors);\r\n      this.$message.success('调色板已应用！');\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 容器：手绘暖风格基底 */\r\n.color-extractor {\r\n  padding: 15px;\r\n  background-color: rgba(255, 255, 250, 0.98);\r\n  height: 100%;\r\n  box-sizing: border-box;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  overflow: hidden;\r\n}\r\n\r\n/* 标题：手绘装饰点 */\r\n.extractor-title {\r\n  margin: 0;\r\n  font-size: 16px;\r\n  color: #8a7d5e;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.title-dot {\r\n  display: inline-block;\r\n  width: 8px;\r\n  height: 16px;\r\n  background-color: #f0c880;\r\n  border-radius: 4px;\r\n}\r\n\r\n/* 上传区域：暖色调按钮+整齐布局 */\r\n.upload-area {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  align-items: center;\r\n}\r\n.url-input {\r\n  flex: 1;\r\n  min-width: 120px;\r\n  --el-input-border-color: #f0e8d0 !important;\r\n  --el-input-hover-border-color: #f0c880 !important;\r\n  --el-input-text-color: #8a7d5e !important;\r\n  --el-input-placeholder-color: #a09880 !important;\r\n  border-radius: 22px !important;\r\n}\r\n\r\n/* 所有按钮：强制暖色调（无蓝色） */\r\n.upload-btn, .extract-btn, .apply-btn {\r\n  --el-button-bg-color: #f5dca8 !important;\r\n  --el-button-border-color: #f0c880 !important;\r\n  --el-button-text-color: #8a7d5e !important;\r\n  --el-button-hover-bg-color: #f0c880 !important;\r\n  --el-button-hover-text-color: #7a6d4e !important;\r\n  --el-button-disabled-bg-color: #f9eeda !important;\r\n  --el-button-disabled-border-color: #f5dca8 !important;\r\n  --el-button-disabled-text-color: #a09880 !important;\r\n  border-radius: 22px !important;\r\n  padding: 8px 16px !important;\r\n}\r\n.apply-btn {\r\n  width: 100%;\r\n  margin-top: auto;\r\n}\r\n\r\n/* 手绘调色板：整齐排列 */\r\n.palette-area {\r\n  background-color: #fff8e8;\r\n  border: 1px solid #f0e8d0;\r\n  border-radius: 12px;\r\n  padding: 12px;\r\n  box-shadow: 0 3px 8px rgba(240, 224, 180, 0.12);\r\n}\r\n.palette-title {\r\n  margin: 0 0 12px;\r\n  font-size: 14px;\r\n  color: #8a7d5e;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n}\r\n.palette-title::before {\r\n  content: \"\";\r\n  width: 6px;\r\n  height: 12px;\r\n  background-color: #f0c880;\r\n  border-radius: 3px;\r\n}\r\n.color-palette {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 10px;\r\n}\r\n.color-swatch {\r\n  width: 100%;\r\n  height: 40px;\r\n  border-radius: 8px;\r\n  border: 2px solid #fff;\r\n  box-shadow: 0 2px 4px rgba(240, 200, 128, 0.2);\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  transition: transform 0.2s ease;\r\n}\r\n.color-swatch:hover {\r\n  transform: scale(1.05);\r\n}\r\n.color-swatch.selected {\r\n  box-shadow: 0 0 0 2px #f0c880;\r\n}\r\n.color-hex {\r\n  font-size: 10px;\r\n  color: #fff;\r\n  text-shadow: 0 0 2px rgba(0,0,0,0.5);\r\n  font-weight: bold;\r\n}\r\n.empty-palette {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 20px 0;\r\n  color: #8a7d5e;\r\n}\r\n.empty-palette i {\r\n  font-size: 36px;\r\n  color: #f0c880;\r\n  margin-bottom: 8px;\r\n}\r\n.empty-palette p {\r\n  margin: 0;\r\n  font-size: 13px;\r\n}\r\n\r\n/* 图片预览：完整显示 */\r\n.preview-area {\r\n  border: 1px solid #f0e8d0;\r\n  border-radius: 8px;\r\n  padding: 12px;\r\n  background-color: #fff8e8;\r\n}\r\n.preview-label {\r\n  margin: 0 0 8px;\r\n  font-size: 13px;\r\n  color: #8a7d5e;\r\n}\r\n.preview-img {\r\n  width: 100%;\r\n  max-height: 200px;\r\n  object-fit: contain;\r\n  border-radius: 4px;\r\n  border: 1px solid #f0e8d0;\r\n}\r\n\r\n/* 空状态/错误状态：手绘风格 */\r\n.global-empty-state, .error-state {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  background-color: #fff8e8;\r\n  border: 1px dashed #f0e8d0;\r\n}\r\n.global-empty-state i {\r\n  font-size: 48px;\r\n  color: #f0c880;\r\n  margin-bottom: 10px;\r\n}\r\n.error-state i {\r\n  font-size: 48px;\r\n  color: #e8a07e;\r\n  margin-bottom: 10px;\r\n}\r\n.global-empty-state p, .error-state p {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  color: #8a7d5e;\r\n}\r\n.error-state p {\r\n  color: #e8a07e;\r\n}\r\n</style>"]}]}