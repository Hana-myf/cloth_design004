{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ImageSaveList.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ImageSaveList.vue","mtime":1759332274469},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":1759332253502},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":1759332273371}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["ImageSaveList.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAmDA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"ImageSaveList.vue","sourceRoot":"src/components","sourcesContent":["<template>\r\n  <div class=\"image-save-list\">\r\n    <h4 class=\"list-title\">我的创作</h4>\r\n    <!-- 固定4个位置的网格 -->\r\n    <div class=\"image-grid\">\r\n      <!-- 循环4次，每次取对应索引的图片 -->\r\n      <div v-for=\"index in 4\" :key=\"index\" class=\"saved-image-item\">\r\n        <!-- 有图片时显示图片（添加@click事件） -->\r\n        <div \r\n          v-if=\"savedImages[index - 1]\" \r\n          class=\"image-wrapper\"\r\n          @click=\"handleImageClick(savedImages[index - 1])\"\r\n        >\r\n          <img \r\n            :src=\"savedImages[index - 1].imageUrl\" \r\n            alt=\"保存的图片\" \r\n            class=\"saved-image\"\r\n            @error=\"handleImageError(index - 1)\" \r\n          >\r\n          <!-- 显示图片名称 -->\r\n          <div class=\"image-name\">{{ savedImages[index - 1].imageName }}</div>\r\n        </div>\r\n        \r\n        <!-- 无图片时显示占位样式（修复v-else对应关系） -->\r\n        <div v-else class=\"image-placeholder\">\r\n          <span>+</span>\r\n          <p>暂无图片</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 图片放大预览弹窗（确保在根元素内） -->\r\n    <el-dialog\r\n      :visible.sync=\"previewVisible\"\r\n      :append-to-body=\"true\"\r\n      :close-on-click-modal=\"true\"\r\n      :show-close=\"true\"\r\n      class=\"image-preview-dialog\"\r\n      width=\"80%\"\r\n    >\r\n      <img \r\n        :src=\"currentImageUrl\" \r\n        alt=\"预览图片\" \r\n        class=\"preview-image\"\r\n        @error=\"handlePreviewImageError\"\r\n      >\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  props: {\r\n    savedImages: {\r\n      type: Array,\r\n      default: () => [] // 接收父组件传递的图片列表（最多4条，最新在前）\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      previewVisible: false, // 控制弹窗显示\r\n      currentImageUrl: '' // 当前预览的图片URL\r\n    }\r\n  },\r\n  methods: {\r\n    // 处理列表图片加载失败\r\n    handleImageError(index) {\r\n      this.$set(this.savedImages, index, {\r\n        ...this.savedImages[index],\r\n        imageUrl: require('@/assets/default-placeholder.png')\r\n      });\r\n    },\r\n    // 处理预览图片加载失败\r\n    handlePreviewImageError() {\r\n      this.currentImageUrl = require('@/assets/default-placeholder.png');\r\n    },\r\n    // 处理图片点击事件，显示放大预览\r\n    handleImageClick(image) {\r\n      this.currentImageUrl = image.imageUrl;\r\n      this.previewVisible = true;\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 原有样式保持不变 */\r\n.image-save-list {\r\n  padding: 16px;\r\n  border-top: 1px solid #eee;\r\n}\r\n\r\n.list-title {\r\n  margin: 0 0 16px;\r\n  font-size: 16px;\r\n  color: #333;\r\n}\r\n\r\n/* 固定4列网格 */\r\n.image-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr); /* 4个等宽列 */\r\n  gap: 12px;\r\n}\r\n\r\n.saved-image-item {\r\n  width: 100%;\r\n  height: 120px; /* 固定高度 */\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n  position: relative;\r\n}\r\n\r\n/* 有图片时的样式 */\r\n.image-wrapper {\r\n  width: 100%;\r\n  height: 100%;\r\n  cursor: pointer; /* 提示可点击 */\r\n}\r\n\r\n.saved-image {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover; /* 保持比例填充容器 */\r\n  transition: transform 0.2s;\r\n}\r\n\r\n.saved-image:hover {\r\n  transform: scale(1.05);\r\n}\r\n\r\n.image-name {\r\n  position: absolute;\r\n  bottom: 0;\r\n  left: 0;\r\n  right: 0;\r\n  padding: 4px 8px;\r\n  background: rgba(0, 0, 0, 0.5);\r\n  color: white;\r\n  font-size: 12px;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n/* 无图片时的占位样式 */\r\n.image-placeholder {\r\n  width: 100%;\r\n  height: 100%;\r\n  background: #f5f5f5;\r\n  border: 1px dashed #ddd;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #999;\r\n}\r\n\r\n.image-placeholder span {\r\n  font-size: 24px;\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.image-placeholder p {\r\n  font-size: 12px;\r\n  margin: 0;\r\n}\r\n\r\n/* 预览图片样式 */\r\n.preview-image {\r\n  width: 100%;\r\n  height: auto;\r\n  max-height: 80vh;\r\n  object-fit: contain;\r\n}\r\n\r\n.image-preview-dialog .el-dialog__body {\r\n  padding: 16px;\r\n  text-align: center;\r\n}\r\n</style>"]}]}