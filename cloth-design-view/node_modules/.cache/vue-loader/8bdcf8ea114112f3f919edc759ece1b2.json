{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\DetailOptimization.vue?vue&type=style&index=0&id=988021d0&scoped=true&lang=css&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\DetailOptimization.vue","mtime":1767452391426},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\css-loader\\dist\\cjs.js","mtime":1759332259160},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1759332273372},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\postcss-loader\\src\\index.js","mtime":1759332269050},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":1759332273371}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["DetailOptimization.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAmhBA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"DetailOptimization.vue","sourceRoot":"src/views/user","sourcesContent":["<template>\r\n  <div class=\"detail-optimization\">\r\n    <!-- 恢复页面标题（之前误删导致布局高度计算偏差） -->\r\n    <div class=\"page-header\">\r\n      <h1>细节优化工具</h1>\r\n    </div>\r\n\r\n    <!-- 主布局：左(自定义工具区)-中(对话区)-右(预览+成果库) -->\r\n    <div class=\"main-layout\">\r\n      <!-- 左侧：自定义工具区（彻底替换Tabs） -->\r\n      <div class=\"tools-area\">\r\n        <!-- 自定义标签栏 -->\r\n        <div class=\"custom-tab-header\">\r\n          <div \r\n            class=\"custom-tab-item\"\r\n            :class=\"{ active: activeToolTab === 'fabric' }\"\r\n            @click=\"activeToolTab = 'fabric'\"\r\n          >\r\n            面料库\r\n          </div>\r\n          <div \r\n            class=\"custom-tab-item\"\r\n            :class=\"{ active: activeToolTab === 'color' }\"\r\n            @click=\"activeToolTab = 'color'\"\r\n          >\r\n            色彩提取器\r\n          </div>\r\n          <div \r\n            class=\"custom-tab-item\"\r\n            :class=\"{ active: activeToolTab === 'assistant' }\"\r\n            @click=\"activeToolTab = 'assistant'\"\r\n          >\r\n            搭配助手\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 工具内容区 -->\r\n        <div class=\"custom-tab-content\">\r\n          <fabric-library \r\n            @select=\"onFabricSelect\" \r\n            v-if=\"activeToolTab === 'fabric'\"\r\n            class=\"tool-component\"\r\n          ></fabric-library>\r\n          <color-extractor \r\n            @apply-colors=\"onColorsApplied\"\r\n            v-if=\"activeToolTab === 'color'\"\r\n            class=\"tool-component\"\r\n          ></color-extractor>\r\n          <CollocationAssistant\r\n            v-if=\"activeToolTab === 'assistant'\"\r\n            class=\"tool-component\"\r\n            @select-recommend=\"onRecommendSelect\"\r\n          ></CollocationAssistant>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 中间：对话交互区（保留原有逻辑） -->\r\n      <div class=\"interaction-area\">\r\n        <div class=\"interaction-title\">AI设计对话</div>\r\n        <div class=\"chat-content\">\r\n          <div class=\"system-message\">\r\n            请上传参考图片、输入公网链接或描述，我会生成设计方案\r\n          </div>\r\n          <div v-for=\"(msg, index) in chatRecords\" :key=\"index\" class=\"chat-bubble\">\r\n            <div class=\"bubble-avatar\" :class=\"msg.role === 'user'? 'user-avatar' : 'ai-avatar'\">\r\n              {{ msg.role === 'user'? '我' : 'AI' }}\r\n            </div>\r\n            <div class=\"bubble-content\" :class=\"msg.role === 'user'? 'user-content' : 'ai-content'\">\r\n              <template v-if=\"msg.role === 'user'\">\r\n                <div v-if=\"msg.fabric\" class=\"selected-fabric-tag\">已选面料：{{ msg.fabric.name }}</div>\r\n                <div v-if=\"msg.colors\" class=\"selected-colors\">\r\n                  <span class=\"tag\">已选色彩：</span>\r\n                  <div class=\"color-swatch-container\">\r\n                    <div v-for=\"(color, cIndex) in msg.colors\" :key=\"cIndex\" class=\"color-swatch\" :style=\"{ backgroundColor: color.hex }\" :title=\"color.hex\"></div>\r\n                  </div>\r\n                </div>\r\n                <p v-if=\"msg.text\">{{ msg.text }}</p>\r\n                <div v-if=\"msg.imageUrl\" class=\"user-image\">\r\n                  <img :src=\"msg.imageUrl\" alt=\"用户参考图片\" @click=\"previewImage(msg.imageUrl)\">\r\n                  <div class=\"image-action\">右侧预览</div>\r\n                </div>\r\n              </template>\r\n              <template v-if=\"msg.role === 'ai'\">\r\n                <p v-if=\"msg.text\">{{ msg.text }}</p>\r\n                <div v-if=\"msg.imageUrl\" class=\"ai-image\">\r\n                  <img :src=\"msg.imageUrl\" alt=\"AI生成方案\" @click=\"previewImage(msg.imageUrl)\">\r\n                  <div class=\"image-action\">点击预览 | 右键保存到成果库</div>\r\n                </div>\r\n              </template>\r\n            </div>\r\n          </div>\r\n          <div v-if=\"isLoading\" class=\"loading\">\r\n            <div class=\"custom-spinner\"></div>\r\n            <p>方案生成中...</p>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"input-area\">\r\n          <div class=\"input-controls\">\r\n            <el-input \r\n              v-model=\"imageUrlInput\" \r\n              placeholder=\"粘贴公共图片URL\" \r\n              class=\"url-input\"\r\n              clearable\r\n            ></el-input>\r\n            \r\n            <el-upload\r\n              class=\"image-uploader\"\r\n              action=\"\"\r\n              :auto-upload=\"false\"\r\n              :on-change=\"handleImageUpload\"\r\n              :show-file-list=\"false\"\r\n              accept=\"image/jpeg,image/png,image/webp\"\r\n              :disabled=\"isLoading\"\r\n            >\r\n              <el-button type=\"primary\" icon=\"el-icon-upload\" :disabled=\"!!imageUrlInput\" class=\"upload-btn\">上传本地图片</el-button>\r\n            </el-upload>\r\n          </div>\r\n          \r\n          <div class=\"main-input-row\">\r\n            <el-input \r\n              v-model=\"userInput\" \r\n              placeholder=\"输入设计需求（例：改成赛博朋克风格）...\" \r\n              class=\"text-input\"\r\n              @keyup.enter.native=\"sendMessage\"\r\n            ></el-input>\r\n            <el-button \r\n              type=\"primary\" \r\n              @click=\"sendMessage\"\r\n              class=\"send-btn\"\r\n              :disabled=\"!canSendMessage\"\r\n            >\r\n              发送\r\n            </el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 右侧：预览区 + 成果库（统一样式） -->\r\n      <div class=\"gallery-area\">\r\n        <div class=\"gallery-title\">图片预览 & 成果库</div>\r\n        \r\n        <!-- 上半部分：高清预览区 -->\r\n        <div class=\"preview-section\">\r\n          <div class=\"img-placeholder-container\">\r\n            <img \r\n              :src=\"currentPreviewImage\" \r\n              alt=\"预览图片\"\r\n              class=\"preview-img\"\r\n              v-if=\"currentPreviewImage\"\r\n            >\r\n            <div class=\"img-placeholder\" v-else>\r\n              <div class=\"placeholder-content\">\r\n                <i class=\"el-icon-picture-outline\"></i>\r\n                <p>右侧预览</p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <!-- 预览区保存按钮 -->\r\n          <button \r\n            @click=\"saveCurrentPreviewImage\" \r\n            class=\"save-img-btn\"\r\n            v-if=\"currentPreviewImage\"\r\n          >\r\n            保存到成果库\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 下半部分：成果库列表 -->\r\n        <div class=\"list-section\">\r\n          <image-save-list \r\n            :saved-images=\"savedImages\"\r\n            class=\"save-list\"\r\n            @click-image=\"previewImage\"\r\n          ></image-save-list>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport request from '@/utils/request'; \r\nimport FabricLibrary from '@/components/FabricLibrary.vue';\r\nimport ImageSaveList from '@/components/ImageSaveList.vue';\r\nimport ColorExtractor from '@/components/ColorExtractor.vue';\r\nimport CollocationAssistant from '@/components/CollocationAssistant.vue';\r\n\r\nexport default {\r\n  components: {\r\n    FabricLibrary,\r\n    ImageSaveList,\r\n    ColorExtractor,\r\n    CollocationAssistant\r\n  },\r\n  mounted() {\r\n    // 登录状态判断\r\n    if (!this.currentUserId) {\r\n      this.$router.push('/login');\r\n    } else {\r\n      this.loadUserImages();\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      chatRecords: [],\r\n      userInput: '',\r\n      savedImages: [],\r\n      isLoading: false,\r\n      currentFabric: null,\r\n      currentColors: null,\r\n      currentUploadedImageUrl: null,\r\n      imageUrlInput: '',\r\n      imgbbApiKey: 'ddfd3ce61ba74d50a1d1167d498e4c0f',\r\n      cozeImageEditorConfig: {\r\n        apiKey: 'pat_l71GjeLrzmzEzh0d8R5saRWgJFrlhAL79YJbt1KJPLDSmHt2OuXaxom7A92dKjqG',\r\n        botId: '7533205966545272882',\r\n        userId: 'user_' + Math.random().toString(36).substr(2, 9),\r\n        defaultImageUrl: \"https://ark-project.tos-cn-beijing.volces.com/doc_image/seededit_i2i.jpeg\"\r\n      },\r\n      currentUserId: this.$store.state.user.userInfo?.id || '',\r\n      activeToolTab: 'fabric', // 保留原有激活状态逻辑\r\n      currentPreviewImage: '' // 当前预览的图片URL\r\n    };\r\n  },\r\n  computed: {\r\n    canSendMessage() {\r\n      return !this.isLoading && (\r\n             this.userInput.trim() !== '' || \r\n             this.currentFabric !== null || \r\n             this.currentColors !== null ||\r\n             this.currentUploadedImageUrl !== null ||\r\n             this.imageUrlInput.trim() !== ''\r\n      );\r\n    }\r\n  },\r\n  methods: {\r\n    // 预览图片方法\r\n    previewImage(imageUrl) {\r\n      this.currentPreviewImage = imageUrl;\r\n      // 滚动到右侧预览区\r\n      const galleryEl = this.$el.querySelector('.gallery-area');\r\n      if (galleryEl) galleryEl.scrollTop = 0;\r\n    },\r\n    // 保存当前预览的图片\r\n    saveCurrentPreviewImage() {\r\n      if (!this.currentPreviewImage) return;\r\n      const imageName = `设计方案_${new Date().getTime()}`;\r\n      this.saveImageToBackend({ \r\n        imageUrl: this.currentPreviewImage, \r\n        imageName \r\n      });\r\n    },\r\n\r\n    // 搭配助手选择推荐\r\n    onRecommendSelect(recommend) {\r\n      this.userInput = `按【${recommend.style}】风格设计：${recommend.desc}`;\r\n      this.$message.success(`已为你填充${recommend.style}搭配需求`);\r\n    },\r\n    // 选择面料\r\n    onFabricSelect(fabric) {\r\n      this.currentFabric = fabric;\r\n      this.$message.success(`已选择面料：${fabric.name}`);\r\n    },\r\n    // 应用提取的色彩\r\n    onColorsApplied(colors) {\r\n      this.currentColors = colors.slice(0, 4);\r\n      this.$message.success('已选择色彩方案');\r\n    },\r\n    // 上传本地图片\r\n    async handleImageUpload(file) {\r\n      const imageFile = file.raw;\r\n      if (!imageFile || this.isLoading) return;\r\n      this.isLoading = true;\r\n      const formData = new FormData();\r\n      formData.append('image', imageFile);\r\n      try {\r\n        const response = await fetch(`https://api.imgbb.com/1/upload?key=${this.imgbbApiKey}`, {\r\n          method: 'POST', body: formData,\r\n        });\r\n        const result = await response.json();\r\n        if (result.success) {\r\n          this.currentUploadedImageUrl = result.data.url;\r\n          this.imageUrlInput = '';\r\n          this.$message.success('图片上传成功！');\r\n        } else {\r\n          throw new Error(result.error?.message || 'ImgBB API 返回错误');\r\n        }\r\n      } catch (error) {\r\n        this.$message.error(`上传失败：${error.message || '未知错误'}`);\r\n      } finally {\r\n        this.isLoading = false;\r\n      }\r\n    },\r\n    // 发送设计需求\r\n    sendMessage() {\r\n      if (!this.canSendMessage) return;\r\n      const finalImageUrl = this.imageUrlInput.trim() || this.currentUploadedImageUrl;\r\n      const userMessage = {\r\n        role: 'user',\r\n        text: this.userInput,\r\n        fabric: this.currentFabric,\r\n        colors: this.currentColors,\r\n        imageUrl: finalImageUrl\r\n      };\r\n      this.chatRecords.push(userMessage);\r\n      this.generateAIResponse(finalImageUrl);\r\n      this.userInput = '';\r\n      this.currentFabric = null;\r\n      this.currentColors = null;\r\n      this.currentUploadedImageUrl = null;\r\n      this.imageUrlInput = '';\r\n    },\r\n    // 保存到成果库（兼容原有逻辑）\r\n    saveToGallery(imageUrl, title) {\r\n      this.previewImage(imageUrl);\r\n      const imageName = title || `设计方案_${new Date().getTime()}`; \r\n      this.saveImageToBackend({ imageUrl, imageName });\r\n    },\r\n    // 保存图片到后端\r\n    async saveImageToBackend(imageInfo) {\r\n      try {\r\n        const now = new Date();\r\n        const generateTimeFormatted = now.toISOString().slice(0, 19) + 'Z'; \r\n        const imageData = {\r\n          userId: this.currentUserId,\r\n          imageName: imageInfo.imageName,\r\n          imageUrl: imageInfo.imageUrl,\r\n          generateTime: generateTimeFormatted\r\n        };\r\n        const response = await request.post('/generatedImage/save', imageData);\r\n        if (response.data && response.data.code === 200) {\r\n          this.$message.success('图片已保存到成果库！');\r\n          this.loadUserImages(); // 重新加载成果库\r\n        } else {\r\n          this.$message.error(response.data.msg || '保存图片失败');\r\n        }\r\n      } catch (error) {\r\n        console.error('保存图片失败:', error);\r\n        this.$message.error('保存图片异常');\r\n      }\r\n    },\r\n    // 生成AI设计方案\r\n    async generateAIResponse(imageUrl) {\r\n      this.isLoading = true;\r\n      const aiMsgPlaceholder = {\r\n        role: 'ai',\r\n        text: '已接单，AI正在全力创作中，请耐心等待...',\r\n        imageUrl: '',\r\n        title: `AI设计方案`\r\n      };\r\n      this.chatRecords.push(aiMsgPlaceholder);\r\n      const feedbackMessageIndex = this.chatRecords.length - 1;\r\n\r\n      let fullPrompt = `编辑需求：${this.userInput.trim() || '请根据素材进行优化'}`;\r\n      if (this.currentFabric) fullPrompt += `，使用【${this.currentFabric.name}】面料`;\r\n      if (this.currentColors) {\r\n        const colorHexList = this.currentColors.map(c => c.hex).join('、');\r\n        fullPrompt += `，搭配颜色：${colorHexList}`;\r\n      }\r\n      const finalApiImageUrl = imageUrl || this.cozeImageEditorConfig.defaultImageUrl;\r\n      fullPrompt += `，参考图片URL：${finalApiImageUrl}`;\r\n\r\n      try {\r\n        const response = await fetch('/__coze_proxy_submit__', {\r\n          method: 'POST',\r\n          headers: {\r\n            'Content-Type': 'application/json',\r\n            'Authorization': `Bearer ${this.cozeImageEditorConfig.apiKey}`\r\n          },\r\n          body: JSON.stringify({\r\n            bot_id: this.cozeImageEditorConfig.botId,\r\n            user_id: this.cozeImageEditorConfig.userId,\r\n            stream: true,\r\n            auto_save_history: true,\r\n            additional_messages: [\r\n              {\r\n                role: \"user\",\r\n                content: fullPrompt,\r\n                content_type: \"text\"\r\n              }\r\n            ]\r\n          })\r\n        });\r\n\r\n        if (!response.ok) {\r\n          const errorText = await response.text();\r\n          throw new Error(`API 请求失败: ${response.status} ${response.statusText}`);\r\n        }\r\n\r\n        const reader = response.body.getReader();\r\n        const decoder = new TextDecoder();\r\n        let fullReplyContent = '';\r\n        let finalImageUrlFromAI = '';\r\n        let currentEvent = null;\r\n\r\n        while (true) {\r\n          const { done, value } = await reader.read();\r\n          if (done) break;\r\n\r\n          const chunk = decoder.decode(value, { stream: true });\r\n          const lines = chunk.split('\\n').filter(line => line.trim());\r\n\r\n          for (const line of lines) {\r\n            if (line.startsWith('event:')) {\r\n              currentEvent = line.replace('event:', '').trim();\r\n              continue;\r\n            }\r\n\r\n            if (line.startsWith('data:')) {\r\n              const dataStr = line.replace('data:', '').trim();\r\n              if (dataStr) {\r\n                try {\r\n                  const data = JSON.parse(dataStr);\r\n\r\n                  if (data.type === 'tool_response' && data.content) {\r\n                    try {\r\n                      const toolResponse = JSON.parse(data.content);\r\n                      if (toolResponse.msg === 'success' && typeof toolResponse.data === 'string' && toolResponse.data.startsWith('https://')) {\r\n                        finalImageUrlFromAI = toolResponse.data;\r\n                      }\r\n                    } catch (e) {\r\n                      console.warn(\"解析 tool_response 失败:\", e);\r\n                    }\r\n                  } else if (data.type === 'answer' && data.content) {\r\n                    fullReplyContent += data.content;\r\n                    this.$set(this.chatRecords[feedbackMessageIndex], 'text', `AI正在生成... ${fullReplyContent}`);\r\n                    const match = data.content.match(/\\[.*?\\]\\((https?:\\/\\/[^\\s)]+\\.(?:jpg|png|jpeg|gif|webp|bmp))\\)/);\r\n                    if (match && match[1]) {\r\n                      finalImageUrlFromAI = match[1];\r\n                    }\r\n                  }\r\n\r\n                } catch (e) {\r\n                  console.warn('解析流数据片段失败:', e);\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n        if (finalImageUrlFromAI) {\r\n          const displayText = fullReplyContent.replace(/\\[.*?\\]\\((https?:\\/\\/[^\\s)]+\\.(?:jpg|png|jpeg|gif|webp|bmp))\\)/g, '').trim();\r\n          this.$set(this.chatRecords[feedbackMessageIndex], 'text', displayText);\r\n          this.$set(this.chatRecords[feedbackMessageIndex], 'imageUrl', finalImageUrlFromAI);\r\n          this.lastAiReply = fullReplyContent;\r\n        } else {\r\n          if (fullReplyContent.trim()) {\r\n            this.$set(this.chatRecords[feedbackMessageIndex], 'text', fullReplyContent.trim());\r\n            this.lastAiReply = fullReplyContent;\r\n          } else {\r\n            throw new Error('AI 生成成功，但未找到图片 URL 或有效文本回复');\r\n          }\r\n        }\r\n\r\n      } catch (error) {\r\n        console.error('Coze任务失败：', error);\r\n        const errorMsg = error.message || '未知网络错误';\r\n        if (this.chatRecords[feedbackMessageIndex]) {\r\n            this.$set(this.chatRecords[feedbackMessageIndex], 'text', `❌ 生成失败：${errorMsg}`);\r\n            this.$set(this.chatRecords[feedbackMessageIndex], 'imageUrl', '');\r\n        }\r\n      } finally {\r\n        this.isLoading = false;\r\n        this.$nextTick(() => {\r\n            const container = this.$el.querySelector('.chat-content');\r\n            if (container) {\r\n                container.scrollTop = container.scrollHeight;\r\n            }\r\n        });\r\n      }\r\n    },\r\n    // 加载用户成果库图片\r\n    async loadUserImages() {\r\n      try {\r\n        const queryDto = {\r\n          userId: this.currentUserId,\r\n          pageNum: 1,\r\n          pageSize: 4\r\n        };\r\n        console.log('查询成果库参数：', queryDto); // 调试用\r\n        const response = await request.post('/generatedImage/query', queryDto);\r\n        console.log('成果库返回数据：', response.data); // 调试用\r\n        if (response.data && response.data.code === 200) { \r\n          this.savedImages = response.data.data.slice(0, 4);\r\n          console.log('渲染成果库数据：', this.savedImages); // 调试用\r\n        } else {\r\n          console.warn('后端返回非成功状态：', response.data);\r\n          this.$message.error(response.data.msg || '加载成果库失败');\r\n        }\r\n      } catch (error) {\r\n        console.error('加载成果库失败：', error);\r\n        this.$message.error('加载成果库异常');\r\n      }\r\n    },\r\n    // 轮询获取生成结果\r\n    async pollForResult(conversationId) {\r\n      const maxAttempts = 20;\r\n      const delay = 3000;\r\n      for (let i = 0; i < maxAttempts; i++) {\r\n        console.log(`第 ${i + 1} 次尝试取件...`);\r\n        try {\r\n          const retrieveResponse = await axios.get(\r\n            '/__coze_proxy_retrieve__',\r\n            {\r\n              params: {\r\n                conversation_id: conversationId,\r\n                bot_id: this.cozeImageEditorConfig.botId\r\n              },\r\n              headers: { 'Authorization': `Bearer ${this.cozeImageEditorConfig.apiKey}` }\r\n            }\r\n          );\r\n          const data = retrieveResponse.data?.data;\r\n          if (data?.status === 'completed') {\r\n            console.log('🎉 图片生成完成！', data);\r\n            return data;\r\n          } else if (data?.status === 'failed') {\r\n            throw new Error(`图片生成任务失败: ${data.last_error?.msg || '未知原因'}`);\r\n          }\r\n        } catch (error) {\r\n           throw new Error(`取件API请求失败: ${error.message}`);\r\n        }\r\n        await new Promise(resolve => setTimeout(resolve, delay));\r\n      }\r\n      throw new Error('图片生成超时，请稍后再试');\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 全局手绘风基底 */\r\n.detail-optimization {\r\n  padding: 20px;\r\n  background: url(\"https://pic1.imgdb.cn/item/6958e1eeda3df73ea1bc5a2c.png\") center/cover no-repeat;\r\n  background-color: rgba(255, 255, 250, 0.95);\r\n  background-blend-mode: overlay;\r\n  height: 100vh;\r\n  box-sizing: border-box;\r\n  font-family: \"Microsoft YaHei\", Arial, sans-serif;\r\n  overflow: hidden; /* 防止页面整体滚动 */\r\n}\r\n\r\n/* 页面标题 */\r\n.page-header {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n  color: #8a7d5e;\r\n}\r\n.page-header h1 {\r\n  font-size: 28px;\r\n  margin: 0 0 8px 0;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 10px;\r\n}\r\n.page-header h1::before {\r\n  content: \"\";\r\n  width: 12px;\r\n  height: 12px;\r\n  border-radius: 50%;\r\n  background-color: #f0c880;\r\n  box-shadow: 0 0 4px rgba(240, 200, 128, 0.5);\r\n}\r\n.page-header p {\r\n  color: #a09880;\r\n  margin: 0;\r\n}\r\n\r\n/* 主布局 - 核心修复：调整高度计算+最小高度 */\r\n.main-layout {\r\n  display: grid;\r\n  grid-template-columns: 280px 1fr 320px; \r\n  gap: 20px;\r\n  height: calc(100vh - 120px); /* 适配页面标题高度，预留足够空间 */\r\n  min-height: 600px; /* 小屏幕最小高度，防止布局坍塌 */\r\n}\r\n\r\n/* 左侧工具区 - 完全自定义，无ElementUI Tabs干扰 */\r\n.tools-area {\r\n  background-color: rgba(255, 255, 250, 0.98);\r\n  border-radius: 16px;\r\n  box-shadow: 0 6px 18px rgba(240, 224, 180, 0.15);\r\n  overflow: hidden;\r\n  display: flex;\r\n  flex-direction: column; /* 纵向布局 */\r\n}\r\n\r\n/* 自定义标签栏 - 替代ElementUI Tabs */\r\n.custom-tab-header {\r\n  display: flex;\r\n  background-color: #fff8e8;\r\n  border-bottom: 1px solid #f0e8d0;\r\n  padding: 0 10px;\r\n}\r\n.custom-tab-item {\r\n  flex: 1;\r\n  text-align: center;\r\n  padding: 12px 0;\r\n  color: #8a7d5e;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n  position: relative;\r\n  transition: color 0.2s ease;\r\n}\r\n.custom-tab-item:hover {\r\n  color: #f0c880;\r\n}\r\n.custom-tab-item.active {\r\n  color: #f0c880;\r\n  font-weight: 500;\r\n}\r\n/* 激活标签下划线 */\r\n.custom-tab-item.active::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  bottom: -1px;\r\n  left: 15%;\r\n  width: 70%;\r\n  height: 2px;\r\n  background-color: #f0c880;\r\n  border-radius: 1px;\r\n}\r\n\r\n/* 自定义标签内容区 */\r\n.custom-tab-content {\r\n  flex: 1;\r\n  overflow: hidden;\r\n}\r\n/* 工具组件容器 - 撑满内容区，无白色背景 */\r\n.tool-component {\r\n  padding: 15px;\r\n  background-color: transparent;\r\n  height: 100%;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* 中间对话区 - 微调样式，与左右侧统一 */\r\n.interaction-area {\r\n  background-color: rgba(255, 255, 250, 0.98);\r\n  border-radius: 16px;\r\n  box-shadow: 0 6px 18px rgba(240, 224, 180, 0.15);\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n}\r\n.interaction-title {\r\n  padding: 12px 18px;\r\n  font-weight: 500;\r\n  color: #8a7d5e;\r\n  border-bottom: 1px solid #f0e8d0;\r\n  background-color: #fff8e8;\r\n}\r\n\r\n.chat-content {\r\n  flex-grow: 1;\r\n  overflow-y: auto;\r\n  padding: 18px;\r\n  background-color: #fffdf8;\r\n  background-image: linear-gradient(90deg, transparent 0%, transparent 98%, rgba(245, 220, 168, 0.2) 98%, rgba(245, 220, 168, 0.2) 100%);\r\n  background-size: 25px 100%;\r\n}\r\n.chat-content::-webkit-scrollbar {\r\n  width: 8px;\r\n}\r\n.chat-content::-webkit-scrollbar-track {\r\n  background-color: #fff8e8;\r\n  border-radius: 4px;\r\n}\r\n.chat-content::-webkit-scrollbar-thumb {\r\n  background-color: #f5dca8;\r\n  border-radius: 4px;\r\n  border: 1px solid #fff8e8;\r\n}\r\n\r\n.system-message {\r\n  text-align: center;\r\n  color: #a09880;\r\n  font-size: 12px;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.chat-bubble {\r\n  display: flex;\r\n  margin-bottom: 15px;\r\n  max-width: 90%;\r\n}\r\n.bubble-avatar {\r\n  width: 36px;\r\n  height: 36px;\r\n  border-radius: 50%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-weight: bold;\r\n  margin-right: 10px;\r\n  flex-shrink: 0;\r\n  border: 2px solid;\r\n}\r\n.user-avatar {\r\n  background-color: #f8fff0;\r\n  color: #7d8a5e;\r\n  border-color: #e0f0d8;\r\n}\r\n.ai-avatar {\r\n  background-color: #fff8e8;\r\n  color: #8a7d5e;\r\n  border-color: #f5dca8;\r\n}\r\n.bubble-content {\r\n  padding: 12px 16px;\r\n  border-radius: 20px;\r\n  word-break: break-word;\r\n  border: 1px solid;\r\n  box-shadow: 0 3px 8px rgba(0,0,0,0.05);\r\n  position: relative;\r\n}\r\n.user-content {\r\n  background-color: #f8fff0;\r\n  border-color: #e0f0d8;\r\n  margin-left: auto;\r\n}\r\n.ai-content {\r\n  background-color: #fff8e8;\r\n  border-color: #f0e8d0;\r\n}\r\n.ai-content::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  left: -8px;\r\n  top: 15px;\r\n  width: 12px;\r\n  height: 12px;\r\n  background-color: #fff8e8;\r\n  border: 1px solid #f0e8d0;\r\n  border-right: none;\r\n  border-bottom: none;\r\n  transform: rotate(45deg);\r\n  box-shadow: -2px -2px 2px rgba(240, 224, 180, 0.08);\r\n}\r\n.user-content::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  right: -8px;\r\n  top: 15px;\r\n  width: 12px;\r\n  height: 12px;\r\n  background-color: #f8fff0;\r\n  border: 1px solid #e0f0d8;\r\n  border-left: none;\r\n  border-top: none;\r\n  transform: rotate(45deg);\r\n  box-shadow: 2px 2px 2px rgba(224, 240, 216, 0.08);\r\n}\r\n\r\n.selected-fabric-tag, .selected-colors {\r\n  background-color: #fff8e8;\r\n  border: 1px solid #f0e8d0;\r\n  border-radius: 4px;\r\n  padding: 5px 8px;\r\n  margin-bottom: 5px;\r\n  font-size: 13px;\r\n  color: #8a7d5e;\r\n}\r\n.color-swatch-container {\r\n  display: flex;\r\n  gap: 5px;\r\n  margin-top: 5px;\r\n}\r\n.color-swatch {\r\n  width: 20px;\r\n  height: 20px;\r\n  border-radius: 4px;\r\n  border: 1px solid #f0e8d0;\r\n}\r\n\r\n.user-image, .ai-image {\r\n  margin-top: 8px;\r\n}\r\n.user-image img, .ai-image img {\r\n  max-width: 200px;\r\n  max-height: 200px;\r\n  border-radius: 8px;\r\n  border: 1px solid #f0e8d0;\r\n  box-shadow: 0 3px 8px rgba(240, 224, 180, 0.15);\r\n  cursor: pointer;\r\n}\r\n.image-action {\r\n  font-size: 12px;\r\n  color: #a09880;\r\n  margin-top: 4px;\r\n  text-align: center;\r\n}\r\n\r\n.loading {\r\n  text-align: center;\r\n  color: #8a7d5e;\r\n  padding: 10px 0;\r\n}\r\n.custom-spinner {\r\n  margin: 0 auto 8px;\r\n  width: 30px;\r\n  height: 30px;\r\n  border: 3px solid #f3f3f3;\r\n  border-top: 3px solid #f0c880;\r\n  border-radius: 50%;\r\n  animation: spin 1s linear infinite;\r\n}\r\n@keyframes spin {\r\n  0% { transform: rotate(0deg); }\r\n  100% { transform: rotate(360deg); }\r\n}\r\n\r\n.input-area {\r\n  padding: 12px;\r\n  border-top: 1px solid #f0e8d0;\r\n  background-color: #fffdf8;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n.input-controls {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n}\r\n.url-input {\r\n  flex-grow: 1;\r\n  --el-input-border-color: #f0e8d0;\r\n  --el-input-hover-border-color: #f0c880;\r\n  border-radius: 22px;\r\n}\r\n/* 统一按钮样式 - 无蓝色 */\r\n.upload-btn, .send-btn {\r\n  --el-button-bg-color: #f5dca8 !important;\r\n  --el-button-border-color: #f0c880 !important;\r\n  --el-button-text-color: #8a7d5e !important;\r\n  --el-button-hover-bg-color: #f0c880 !important;\r\n  --el-button-hover-text-color: #7a6d4e !important;\r\n  --el-button-disabled-bg-color: #f9eeda !important;\r\n  --el-button-disabled-border-color: #f5dca8 !important;\r\n  --el-button-disabled-text-color: #a09880 !important;\r\n  border-radius: 22px !important;\r\n}\r\n.main-input-row {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n.text-input {\r\n  flex-grow: 1;\r\n  --el-input-border-color: #f0e8d0;\r\n  --el-input-hover-border-color: #f0c880;\r\n  border-radius: 22px;\r\n}\r\n\r\n/* 右侧：预览+成果库 - 与左侧视觉完全统一 */\r\n.gallery-area {\r\n  background-color: rgba(255, 255, 250, 0.98);\r\n  border-radius: 16px;\r\n  box-shadow: 0 6px 18px rgba(240, 224, 180, 0.15);\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  height: 100%; /* 强制继承父容器高度 */\r\n}\r\n.gallery-title {\r\n  padding: 12px 18px;\r\n  font-weight: 500;\r\n  color: #8a7d5e;\r\n  border-bottom: 1px solid #f0e8d0;\r\n  background-color: #fff8e8;\r\n  flex-shrink: 0; /* 禁止标题被压缩 */\r\n}\r\n\r\n/* 上半部分：预览区 - 限制最大高度，不再占满 */\r\n.preview-section {\r\n  padding: 15px;\r\n  border-bottom: 1px solid #f0e8d0;\r\n  flex-shrink: 0; /* 禁止预览区被压缩 */\r\n}\r\n.img-placeholder-container {\r\n  width: 100%;\r\n  max-height: 220px; /* 核心：限制预览区最大高度 */\r\n  aspect-ratio: 1/1; /* 保持正方形，但不超过max-height */\r\n  margin: 0 auto 10px;\r\n  position: relative;\r\n}\r\n.img-placeholder {\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: #fff8e8;\r\n  border: 1px dashed #f0e8d0;\r\n  border-radius: 8px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-direction: column;\r\n  color: #8a7d5e;\r\n}\r\n.placeholder-content i {\r\n  font-size: 48px;\r\n  margin-bottom: 10px;\r\n  color: #f0c880;\r\n}\r\n.placeholder-content p {\r\n  font-size: 14px;\r\n  margin: 0;\r\n}\r\n.preview-img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain;\r\n  background-color: #fffdf8;\r\n  border: 1px solid #f0e8d0;\r\n  border-radius: 8px;\r\n}\r\n/* 预览区保存按钮 */\r\n.save-img-btn {\r\n  width: 100%;\r\n  padding: 8px 0;\r\n  background-color: #f5dca8;\r\n  color: #8a7d5e;\r\n  border: 1px solid #f0c880;\r\n  border-radius: 20px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n  transition: all 0.2s ease;\r\n}\r\n.save-img-btn:hover {\r\n  background-color: #f0c880;\r\n  color: #7a6d4e;\r\n  box-shadow: 0 2px 6px rgba(240, 200, 128, 0.15);\r\n}\r\n\r\n/* 下半部分：成果库列表 - 强制预留最小高度 */\r\n.list-section {\r\n  flex-grow: 1; /* 占满剩余所有高度 */\r\n  overflow-y: auto;\r\n  padding: 12px;\r\n  min-height: 180px; /* 核心：给列表设置最小高度，确保可见 */\r\n}\r\n.save-list {\r\n  width: 100%;\r\n}\r\n/* 成果库列表样式优化 */\r\n:deep(.save-list .history-item) {\r\n  border: 1px solid #f0e8d0;\r\n  border-radius: 10px;\r\n  box-shadow: 0 3px 8px rgba(240, 224, 180, 0.12);\r\n  overflow: hidden;\r\n  transition: all 0.2s ease;\r\n  margin-bottom: 10px;\r\n  cursor: pointer;\r\n}\r\n:deep(.save-list .history-item:hover) {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 5px 12px rgba(240, 224, 180, 0.18);\r\n  border-color: #f0c880;\r\n}\r\n\r\n/* 滚动条全局统一 - 左右侧保持一致 */\r\n::-webkit-scrollbar {\r\n  width: 8px;\r\n  height: 8px;\r\n}\r\n::-webkit-scrollbar-track {\r\n  background-color: #fff8e8;\r\n  border-radius: 4px;\r\n}\r\n::-webkit-scrollbar-thumb {\r\n  background-color: #f5dca8;\r\n  border-radius: 4px;\r\n  border: 1px solid #fff8e8;\r\n}\r\n</style>"]}]}