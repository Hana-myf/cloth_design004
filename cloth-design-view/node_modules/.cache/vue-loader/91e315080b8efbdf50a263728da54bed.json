{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\components\\FabricLibrary.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\components\\FabricLibrary.vue","mtime":1767451377465},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":1759332253502},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":1759332273371}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["FabricLibrary.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAoGA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA","file":"FabricLibrary.vue","sourceRoot":"src/components","sourcesContent":["<template>\r\n  <div class=\"fabric-library\">\r\n    <!-- 标题：与主页面标题风格对齐 -->\r\n    <h4 class=\"library-title\">\r\n      <span class=\"title-dot\"></span>面料库\r\n    </h4>\r\n    \r\n    <!-- 搜索区域：与主页面输入组件样式统一 -->\r\n    <div class=\"search-container\">\r\n      <el-input\r\n        v-model=\"searchQuery.name\"\r\n        placeholder=\"搜索面料名称\"\r\n        clearable\r\n        class=\"search-input\"\r\n        @clear=\"handleSearch\"\r\n        @input=\"handleSearchDebounced\"\r\n      ></el-input>\r\n      \r\n      <el-select\r\n        v-model=\"searchQuery.type\"\r\n        placeholder=\"选择面料类型\"\r\n        clearable\r\n        class=\"type-select\"\r\n        @change=\"handleSearch\"\r\n      >\r\n        <el-option\r\n          v-for=\"type in allTypes\"\r\n          :key=\"type\"\r\n          :label=\"type\"\r\n          :value=\"type\"\r\n        ></el-option>\r\n      </el-select>\r\n    </div>\r\n    \r\n    <!-- 面料展示区：撑满剩余高度 + 滚动适配 -->\r\n    <div class=\"fabric-grid\">\r\n      <div v-for=\"(fabric, index) in fabrics\" :key=\"fabric.id\" class=\"fabric-item\">\r\n        <div \r\n          class=\"fabric-wrapper\"\r\n          @click=\"handleFabricClick(fabric)\"\r\n        >\r\n          <img \r\n            :src=\"fabric.imageUrl\" \r\n            alt=\"面料图片\" \r\n            class=\"fabric-image\"\r\n            @error=\"handleImageError(index)\" \r\n          >\r\n          <div class=\"fabric-info\">\r\n            <div class=\"fabric-name\">{{ fabric.name }}</div>\r\n            <div class=\"fabric-type\">{{ fabric.type }}</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- 无数据提示 -->\r\n      <div v-if=\"fabrics.length === 0 && !loading\" class=\"no-data\">\r\n        <p>暂无面料数据</p>\r\n      </div>\r\n      \r\n      <!-- 加载中提示：与主页面加载样式统一 -->\r\n      <div v-if=\"loading\" class=\"loading\">\r\n        <div class=\"custom-spinner\"></div>\r\n        <p>加载中...</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 面料详情弹窗：与主页面弹窗风格统一 -->\r\n    <el-dialog\r\n      :visible.sync=\"previewVisible\"\r\n      append-to-body\r\n      close-on-click-modal\r\n      show-close\r\n      class=\"fabric-preview-dialog\"\r\n      width=\"60%\"\r\n    >\r\n      <div class=\"preview-content\">\r\n        <img \r\n          :src=\"currentFabric.imageUrl\" \r\n          alt=\"面料预览\" \r\n          class=\"preview-image\"\r\n          @error=\"handlePreviewImageError\"\r\n        >\r\n        <div class=\"preview-details\">\r\n          <h3>{{ currentFabric.name }}</h3>\r\n          <p><strong>类型：</strong>{{ currentFabric.type }}</p>\r\n          <p><strong>描述：</strong>{{ currentFabric.description || '暂无描述' }}</p>\r\n          <el-button \r\n            type=\"primary\" \r\n            @click=\"handleSelectFabric\"\r\n            style=\"margin-top: 16px;\"\r\n          >\r\n            选择该面料\r\n          </el-button>\r\n        </div>\r\n      </div>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { debounce } from 'lodash';\r\n\r\nexport default {\r\n  name: 'FabricLibrary',\r\n  data() {\r\n    return {\r\n      fabrics: [],\r\n      searchQuery: {\r\n        name: '',\r\n        type: ''\r\n      },\r\n      allTypes: [],\r\n      previewVisible: false,\r\n      currentFabric: {},\r\n      loading: false\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchAllTypes();\r\n    this.fetchFabrics();\r\n  },\r\n  methods: {\r\n    handleSearchDebounced: debounce(function() {\r\n      this.handleSearch();\r\n    }, 300),\r\n    \r\n    async fetchFabrics() {\r\n      this.loading = true;\r\n      try {\r\n        const params = {\r\n          ...this.searchQuery,\r\n          current: 1,\r\n          size: 20 // 增加每页加载数量，让内容更饱满\r\n        };\r\n        const response = await this.$axios.post('/fabric/query', params);\r\n        if (response.data.code === 200) {\r\n          this.fabrics = response.data.data.fabricList || [];\r\n        } else {\r\n          this.$message.error('获取面料失败：' + (response.data.msg || '未知错误'));\r\n          this.fabrics = [];\r\n        }\r\n      } catch (error) {\r\n        this.$message.error('获取面料列表失败，请重试');\r\n        console.error(error);\r\n        this.fabrics = [];\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n    \r\n    async fetchAllTypes() {\r\n      try {\r\n        const response = await this.$axios.get('/fabric/types');\r\n        if (response.data.code === 200) {\r\n          this.allTypes = response.data.data || [];\r\n        } else {\r\n          this.$message.error('获取面料类型失败：' + (response.data.msg || '未知错误'));\r\n        }\r\n      } catch (error) {\r\n        this.$message.error('获取面料类型失败，请重试');\r\n        console.error(error);\r\n      }\r\n    },\r\n    \r\n    handleSearch() {\r\n      this.fetchFabrics();\r\n    },\r\n    \r\n    handleFabricClick(fabric) {\r\n      this.currentFabric = { ...fabric };\r\n      this.previewVisible = true;\r\n    },\r\n    \r\n    handleSelectFabric() {\r\n      this.$emit('select', this.currentFabric);\r\n      this.previewVisible = false;\r\n      this.$message.success(`已选择面料：${this.currentFabric.name}`);\r\n    },\r\n    \r\n    handleImageError(index) {\r\n      this.$set(this.fabrics[index], 'imageUrl', require('@/assets/fabric-placeholder.png'));\r\n    },\r\n    \r\n    handlePreviewImageError() {\r\n      this.currentFabric.imageUrl = require('@/assets/fabric-placeholder.png');\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 面料库容器：撑满左侧工具区高度 + 主页面风格统一 */\r\n.fabric-library {\r\n  padding: 15px;\r\n  background-color: rgba(252, 252, 237, 0.98);\r\n  height: 100%; /* 强制占满父容器（左侧工具区）高度 */\r\n  box-sizing: border-box;\r\n  display: flex;\r\n  flex-direction: column; /* 纵向布局，让内容撑满 */\r\n  overflow: hidden;\r\n}\r\n\r\n/* 标题：与主页面标题样式完全对齐 */\r\n.library-title {\r\n  margin: 0 0 16px;\r\n  font-size: 16px;\r\n  color: #8a7d5e;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.title-dot {\r\n  display: inline-block;\r\n  width: 8px;\r\n  height: 16px;\r\n  background-color: #f0c880;\r\n  border-radius: 4px;\r\n}\r\n\r\n/* 搜索区域：与主页面输入组件样式统一 */\r\n.search-container {\r\n  display: flex;\r\n  gap: 12px;\r\n  margin-bottom: 16px;\r\n}\r\n.search-input {\r\n  flex: 1;\r\n  --el-input-border-color: #f0e8d0 !important;\r\n  --el-input-hover-border-color: #f0c880 !important;\r\n  --el-input-text-color: #8a7d5e !important;\r\n  --el-input-placeholder-color: #a09880 !important;\r\n  border-radius: 22px !important; /* 与主页面输入框圆角一致 */\r\n}\r\n.type-select {\r\n  width: 160px;\r\n  --el-select-border-color: #f0e8d0 !important;\r\n  --el-select-hover-border-color: #f0c880 !important;\r\n  --el-select-text-color: #8a7d5e !important;\r\n  --el-select-placeholder-color: #a09880 !important;\r\n  border-radius: 22px !important; /* 与主页面下拉框圆角一致 */\r\n}\r\n\r\n/* 面料展示区：撑满剩余高度 + 滚动适配 */\r\n.fabric-grid {\r\n  flex: 1; /* 撑满容器剩余高度 */\r\n  display: grid;\r\n  grid-template-columns: repeat(2, 1fr); /* 2列布局适配工具区宽度 */\r\n  gap: 12px;\r\n  overflow-y: auto; /* 内容超出时滚动 */\r\n  /* 滚动条样式：与主页面.chat-content滚动条完全一致 */\r\n  &::-webkit-scrollbar {\r\n    width: 8px;\r\n  }\r\n  &::-webkit-scrollbar-track {\r\n    background-color: #fff8e8;\r\n    border-radius: 4px;\r\n  }\r\n  &::-webkit-scrollbar-thumb {\r\n    background-color: #f5dca8;\r\n    border-radius: 4px;\r\n    border: 1px solid #fff8e8;\r\n  }\r\n}\r\n\r\n/* 面料卡片：与主页面成果库卡片样式统一 */\r\n.fabric-item {\r\n  background-color: #fff8e8;\r\n  border: 1px solid #f0e8d0;\r\n  border-radius: 10px;\r\n  overflow: hidden;\r\n  box-shadow: 0 3px 8px rgba(240, 224, 180, 0.12);\r\n  transition: all 0.2s ease;\r\n}\r\n.fabric-item:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 5px 12px rgba(240, 224, 180, 0.18);\r\n  border-color: #f0c880;\r\n}\r\n.fabric-wrapper {\r\n  cursor: pointer;\r\n}\r\n.fabric-image {\r\n  width: 100%;\r\n  height: 120px;\r\n  object-fit: cover;\r\n}\r\n.fabric-info {\r\n  padding: 8px 10px;\r\n  color: #8a7d5e;\r\n}\r\n.fabric-name {\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  margin-bottom: 4px;\r\n}\r\n.fabric-type {\r\n  font-size: 12px;\r\n  opacity: 0.9;\r\n}\r\n\r\n/* 无数据/加载提示：与主页面风格统一 */\r\n.no-data, .loading {\r\n  grid-column: span 2;\r\n  height: 100%; /* 占满展示区高度 */\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #8a7d5e;\r\n  background-color: #fff8e8;\r\n  border: 1px dashed #f0e8d0;\r\n  border-radius: 10px;\r\n}\r\n.custom-spinner {\r\n  margin: 0 auto 8px;\r\n  width: 30px;\r\n  height: 30px;\r\n  border: 3px solid #f3f3f3;\r\n  border-top: 3px solid #f0c880;\r\n  border-radius: 50%;\r\n  animation: spin 1s linear infinite;\r\n}\r\n@keyframes spin {\r\n  0% { transform: rotate(0deg); }\r\n  100% { transform: rotate(360deg); }\r\n}\r\n\r\n/* 弹窗：与主页面弹窗样式统一 */\r\n.fabric-preview-dialog {\r\n  --el-dialog-bg-color: rgba(255, 255, 250, 0.98) !important;\r\n  --el-dialog-border-color: #f0e8d0 !important;\r\n}\r\n.fabric-preview-dialog .el-dialog__header {\r\n  border-bottom: 1px solid #f0e8d0;\r\n  color: #8a7d5e;\r\n}\r\n.preview-content {\r\n  display: flex;\r\n  gap: 20px;\r\n  padding: 10px 0;\r\n}\r\n.preview-image {\r\n  width: 240px;\r\n  height: 240px;\r\n  object-fit: cover;\r\n  border: 1px solid #f0e8d0;\r\n  border-radius: 8px;\r\n}\r\n.preview-details {\r\n  flex: 1;\r\n  color: #8a7d5e;\r\n}\r\n.preview-details h3 {\r\n  font-size: 18px;\r\n  margin-bottom: 16px;\r\n  color: #8a7d5e;\r\n}\r\n.preview-details p {\r\n  line-height: 1.6;\r\n  margin-bottom: 8px;\r\n}\r\n.preview-details .el-button--primary {\r\n  --el-button-bg-color: #f5dca8 !important;\r\n  --el-button-border-color: #f0c880 !important;\r\n  --el-button-text-color: #8a7d5e !important;\r\n  --el-button-hover-bg-color: #f0c880 !important;\r\n  --el-button-hover-text-color: #7a6d4e !important;\r\n  border-radius: 22px !important; /* 与主页面按钮圆角一致 */\r\n}\r\n</style>"]}]}