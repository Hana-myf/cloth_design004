\" : \"取消收藏\" }}\r\n            </el-button>\r\n          </div>\r\n          <div class=\"article\" v-html=\"newsInfo.content\"></div>\r\n        </div>\r\n        <div style=\"margin-top: 16px;\">\r\n          <Evaluations :contentId=\"newsInfo.id\" contentType=\"NEWS\" />\r\n        </div>\r\n      </div>\r\n    </el-col>\r\n    <el-col :span=\"6\">\r\n      <div class=\"card-bg\" style=\"padding: 10px 0 18px; margin-bottom: 14px;\">\r\n        <h3 class=\"aside-title\" style=\"padding: 10px 20px;\">{{ scoreList.length === 0 ? '立即评分' : '我的评分' }}</h3>\r\n        <div style=\"padding: 0 20px;\">\r\n          <el-rate v-model=\"scoreProxy\" :disabled=\"scoreList.length!==0\" @change=\"scoreChange\"></el-rate>\r\n        </div>\r\n      </div>\r\n      <div class=\"card-bg\" style=\"padding: 10px 0 6px;\">\r\n        <h3 class=\"aside-title\" style=\"padding: 10px 20px;\">资讯推荐</h3>\r\n        <el-col @click.native=\"newsItemClick(news)\" :span=\"24\" :key=\"index\" v-for=\"(news, index) in newsTopList\">\r\n          <div style=\"padding: 8px 20px;box-sizing: border-box;\">\r\n            <img :src=\"news.cover\" :alt=\"news.name\" style=\"width: 100%;height: 148px;border-radius: 8px;\" />\r\n            <div class=\"news-title\">{{ news.name }}</div>\r\n            <div class=\"aside-meta\"><span class=\"news-tags\">{{ news.tagName }}</span><span style=\"margin-left: 10px;\">{{ parseTime(news.createTime) }}</span></div>\r\n          </div>\r\n        </el-col>\r\n      </div>\r\n    </el-col>\r\n  </el-row>\r\n</template>\r\n<script>\r\nimport { timeAgo } from \"@/utils/data\";\r\nimport Evaluations from \"@/components/Evaluations.vue\";\r\nexport default {\r\n  components: { Evaluations },\r\n  name: \"NewsDetail\",\r\n  data() {\r\n    return {\r\n      newsInfo: {},\r\n      newsTopList: [],\r\n      saveFlag: false,\r\n      newsSaveList: [],\r\n      scoreList: [],\r\n      score: 0\r\n    };\r\n  },\r\n  created() {\r\n    this.getStorageInfo();\r\n    this.loadAllTopNews();\r\n    this.loadScore();\r\n  },\r\n  methods: {\r\n    // 便于模板里禁用/启用同一个rate组件\r\n    get scoreProxy() { return this.scoreList.length===0 ? this.score : this.scoreList[0]?.total; },\r\n    set scoreProxy(v) { this.score = v; },\r\n    scoreChange() {\r\n      const dto = {\r\n        total: this.score,\r\n        articleId: this.newsInfo.id\r\n      };\r\n      this.$axios.post(\"/score/save\", dto).then(response => {\r\n        const { data } = response;\r\n        if (data.code === 200) {\r\n          this.$notify({\r\n            duration: 1000,\r\n            title: \"评分\",\r\n            message: \"评分成功\",\r\n            type: \"success\"\r\n          });\r\n          this.loadScore();\r\n        }\r\n      });\r\n    },\r\n    loadScore() {\r\n      const dto = { articleId: this.newsInfo.id };\r\n      this.$axios.post(\"/score/query\", dto).then(response => {\r\n        const { data } = response;\r\n        if (data.code === 200) {\r\n          this.scoreList = data.data;\r\n        }\r\n      });\r\n    },\r\n    loadSaveStatus() {\r\n      const newsSaveQueryDto = {\r\n        newsId: this.newsInfo.id\r\n      };\r\n      console.log(\"查询的参数：\" + JSON.stringify(newsSaveQueryDto));\r\n      this.$axios\r\n        .post(\"/news-save/queryUser\", newsSaveQueryDto)\r\n        .then(response => {\r\n          const { data } = response;\r\n          if (data.code === 200) {\r\n            this.saveFlag = data.data.length !== 0;\r\n          }\r\n        });\r\n    },\r\n    // 收藏或取消收藏操作\r\n    saveNewsOperation() {\r\n      this.$axios\r\n        .post(\"/news-save/operation\", { newsId: this.newsInfo.id })\r\n        .then(response => {\r\n          const { data } = response;\r\n          if (data.code === 200) {\r\n            this.$message.success(!this.saveFlag ? \"收藏成功\" : \"取消收藏成功\");\r\n            this.saveFlag = !this.saveFlag;\r\n          }\r\n        });\r\n    },\r\n    newsItemClick(news) {\r\n      this.newsInfo = news;\r\n      this.loadSaveStatus();\r\n    },\r\n    // 转换时间\r\n    parseTime(time) {\r\n      return timeAgo(time);\r\n    },\r\n    getStorageInfo() {\r\n      const newInfo = sessionStorage.getItem(\"newsInfo\");\r\n      this.newsInfo = JSON.parse(newInfo);\r\n      this.loadSaveStatus();\r\n    },\r\n    // 查询推荐资讯\r\n    loadAllTopNews() {\r\n      this.$axios.get(`/news/queryRecommend/${3}`).then(response => {\r\n        const { data } = response;\r\n        if (data.code === 200) {\r\n          this.newsTopList = data.data;\r\n        }\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n.page-wrap { padding: 10px 0; }\r\n.title { margin: 0 0 6px; }\r\n.news-tags { display:inline-block; padding: 2px 8px; background: rgba(212,175,55,.18); color:#f6e7b7; border-radius: 4px; }\r\n.news-title { margin-block: 10px; font-weight: 600; color: var(--text); }\r\n.aside-title { margin: 0; color: var(--text); }\r\n.aside-meta { font-size: 12px; color: var(--muted); }\r\n.article { color: var(--text); line-height: 1.75; }\r\n</style>\r\n"]}]}