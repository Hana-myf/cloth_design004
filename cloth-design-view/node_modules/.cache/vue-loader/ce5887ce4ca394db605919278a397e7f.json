{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\components\\CozeChat.vue?vue&type=style&index=0&id=17985582&scoped=true&lang=scss&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\components\\CozeChat.vue","mtime":1759334886652},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\css-loader\\dist\\cjs.js","mtime":1759332259160},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1759332273372},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\postcss-loader\\src\\index.js","mtime":1759332269050},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\sass-loader\\dist\\cjs.js","mtime":1759332272097},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":1759332273371}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["CozeChat.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAubA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"CozeChat.vue","sourceRoot":"src/components","sourcesContent":["<template>\r\n  <div class=\"coze-chat-container\">\r\n    <!-- 页面标题，统一风格，这里作为子组件可能不需要大标题，可以调整为更小的组件标题 -->\r\n    <div class=\"section-header chat-page-header\">\r\n      <h2 class=\"page-title\">\r\n        <i class=\"el-icon-chat-dot-round\"></i>\r\n        AI智能设计助手\r\n      </h2>\r\n      <p class=\"page-subtitle\">智能设计，灵感触达</p>\r\n      <div class=\"divider\"></div>\r\n    </div>\r\n\r\n    <!-- 主要内容区域 -->\r\n    <div class=\"main-content\">\r\n      <!-- 左侧：智能体对话框 -->\r\n      <div class=\"chat-container section-card\">\r\n        <div class=\"card-title chat-header\">\r\n          <h3>AI 助手</h3>\r\n          <div class=\"header-buttons\">\r\n            <el-button type=\"text\" size=\"small\" @click=\"toggleMinimized\">\r\n              {{ isMinimized ? '展开' : '收起' }}\r\n            </el-button>\r\n          </div>\r\n        </div>\r\n\r\n        <div v-if=\"!isMinimized\" class=\"chat-messages\" ref=\"chatMessages\">\r\n          <div v-for=\"(msg, index) in messages\" :key=\"index\" class=\"message-item\">\r\n            <div :class=\"['message-bubble', msg.isUser ? 'user' : 'ai']\">\r\n              <img :src=\"msg.avatar\" class=\"avatar\" :alt=\"msg.isUser ? '用户头像' : 'AI头像'\">\r\n              <div class=\"content\">\r\n                <p v-if=\"msg.senderName\" class=\"sender\">{{ msg.senderName }}</p>\r\n                <div class=\"text\" v-html=\"parseContent(msg.content)\"></div>\r\n                <!-- 显示AI生成的图片 -->\r\n                <div v-if=\"msg.isAiGeneratedImage\" class=\"ai-generated-image-wrapper\">\r\n                  <img :src=\"msg.imageUrl\" alt=\"AI生成图片\" class=\"ai-generated-image\" @click=\"viewFullImage(msg.imageUrl)\">\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div v-if=\"isLoading\" class=\"loading-indicator\">\r\n            <i class=\"el-icon-loading\"></i> AI 正在思考...\r\n          </div>\r\n        </div>\r\n\r\n        <div v-if=\"!isMinimized\" class=\"chat-input-area\">\r\n          <label class=\"file-upload-btn\" for=\"file-upload\">\r\n            <i class=\"el-icon-picture\"></i>\r\n          </label>\r\n          <input\r\n            type=\"file\"\r\n            id=\"file-upload\"\r\n            class=\"file-upload-input\"\r\n            accept=\"image/*\"\r\n            @change=\"handleFileUpload\"\r\n            :disabled=\"isLoading\"\r\n          >\r\n          <el-input\r\n            v-model=\"userInput\"\r\n            @keyup.enter.native=\"sendMessage\"\r\n            placeholder=\"输入消息...按回车发送\"\r\n            :disabled=\"isLoading\"\r\n            class=\"message-input\"\r\n            type=\"textarea\"\r\n            :autosize=\"{ minRows: 1, maxRows: 4 }\"\r\n          ></el-input>\r\n          <el-button type=\"primary\" @click=\"sendMessage\" :disabled=\"isLoading\" class=\"send-button\">发送</el-button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 右侧：图片预览框 -->\r\n      <div class=\"right-content\">\r\n        <!-- 图片预览卡片 -->\r\n        <div class=\"image-preview-card section-card\">\r\n          <div class=\"card-title\">\r\n            <i class=\"el-icon-picture-outline\"></i>\r\n            <span>图片预览</span>\r\n          </div>\r\n          <ImageViewer\r\n            :aiReplyImageUrl=\"currentAiGeneratedImageUrl\"\r\n            :currentUserId=\"currentUserId.toString()\"\r\n            class=\"image-viewer-component\"\r\n            @save-success=\"handleImageSaveSuccess\"\r\n          />\r\n        </div>\r\n\r\n        <!-- 我的创作卡片 -->\r\n        <div class=\"my-creations-card section-card\">\r\n          <div class=\"card-title\">\r\n            <i class=\"el-icon-folder\"></i>\r\n            <span>我的创作</span>\r\n          </div>\r\n          <ImageSaveList\r\n            :savedImages=\"savedImages\"\r\n            class=\"image-save-list-component\"\r\n            @refresh-images=\"loadUserImages\"\r\n          />\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport ImageViewer from './ImageViewer.vue';\r\nimport ImageSaveList from './ImageSaveList.vue';\r\nimport { mapGetters } from 'vuex';\r\nimport request from '@/utils/request';\r\nimport { Message, MessageBox } from 'element-ui';\r\n\r\nexport default {\r\n  name: 'CozeChat',\r\n  components: {\r\n    ImageViewer,\r\n    ImageSaveList\r\n  },\r\n  data() {\r\n    return {\r\n      messages: [],\r\n      userInput: '',\r\n      isLoading: false,\r\n      isMinimized: false,\r\n      apiKey: 'pat_mY0OSWqTlyfxYW4cV8fu7vGY6jXupqFhQJ2FvyZfasve8SgKMGmFoFoS5Rshonq5',\r\n      robotId: '7475343940674371584',\r\n      userId: localStorage.getItem('cozeChatUserId') || 'user_' + Math.random().toString(36).substr(2, 9),\r\n      apiUrl: 'https://api.coze.cn/v3/chat',\r\n      currentAiGeneratedImageUrl: '',\r\n      savedImages: [],\r\n      currentUserId: '', // 初始化为空字符串，等待 Vuex 获取\r\n      uploadUrl: '/file/upload',\r\n      aiAvatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/chatsdk-logo.png',\r\n      userAvatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/coze-logo.png',\r\n    };\r\n  },\r\n  computed: {\r\n    ...mapGetters('user', ['userInfo'])\r\n  },\r\n  watch: {\r\n    // 监听 userInfo 的变化来设置 currentUserId 和加载用户图片\r\n    userInfo: {\r\n      handler(newVal) {\r\n        if (newVal && newVal.id) {\r\n          this.currentUserId = newVal.id;\r\n          this.loadUserImages(); // 用户登录后加载图片\r\n        } else {\r\n          this.currentUserId = ''; // 用户未登录或登出，清空ID\r\n          this.savedImages = []; // 清空保存的图片列表\r\n        }\r\n      },\r\n      immediate: true // 立即执行一次\r\n    }\r\n  },\r\n  created() {\r\n    if (!localStorage.getItem('cozeChatUserId')) {\r\n      localStorage.setItem('cozeChatUserId', this.userId);\r\n    }\r\n  },\r\n  mounted() {\r\n    this.messages.push({\r\n      content: '你好！我是AI助手，有什么可以帮你的吗？',\r\n      isUser: false,\r\n      avatar: this.aiAvatar,\r\n      senderName: 'AI 助手'\r\n    });\r\n    this.scrollToBottom();\r\n  },\r\n  methods: {\r\n    toggleMinimized() {\r\n      this.isMinimized = !this.isMinimized;\r\n      if (!this.isMinimized) {\r\n        this.$nextTick(() => {\r\n          this.scrollToBottom();\r\n        });\r\n      }\r\n    },\r\n    // 处理 ImageViewer 保存成功事件\r\n    handleImageSaveSuccess() {\r\n      this.loadUserImages(); // 刷新我的创作列表\r\n      Message.success('图片保存成功！');\r\n    },\r\n    async loadUserImages() {\r\n      // 只有当用户已登录时才加载图片\r\n      if (!this.currentUserId) {\r\n        // Message.warning('请先登录以查看您的创作。'); // 移除强制提示，由组件内部逻辑决定是否显示空状态\r\n        return;\r\n      }\r\n      try {\r\n        const queryDto = {\r\n          userId: this.currentUserId,\r\n          pageNum: 1,\r\n          pageSize: 4\r\n        };\r\n        const response = await request.post('/generatedImage/query', queryDto);\r\n\r\n        if (response.data && response.data.code === 200) {\r\n          const sortedImages = response.data.data.sort(\r\n            (a, b) => new Date(b.generateTime) - new Date(a.generateTime)\r\n          );\r\n          this.savedImages = sortedImages.slice(0, 4);\r\n        } else {\r\n          console.warn('后端返回非成功状态：', response.data);\r\n        }\r\n      } catch (error) {\r\n        console.error('加载用户图片失败：', error);\r\n        // Message.error('加载我的创作失败'); // 移除强制提示，避免未登录时频繁报错\r\n      }\r\n    },\r\n    async handleFileUpload(e) {\r\n      // 检查登录状态\r\n      if (!this.currentUserId) {\r\n        Message.warning('请先登录才能上传图片。');\r\n        // 可以选择跳转到登录页，或者禁用上传功能\r\n        this.$router.push('/login');\r\n        return;\r\n      }\r\n\r\n      const file = e.target.files[0];\r\n      if (!file) return;\r\n\r\n      e.target.value = '';\r\n\r\n      if (!file.type.startsWith('image/')) {\r\n        Message.error('请上传图片文件（jpg、png等）');\r\n        return;\r\n      }\r\n      if (file.size > 10 * 1024 * 1024) {\r\n        Message.error('文件大小不能超过10MB');\r\n        return;\r\n      }\r\n\r\n      this.isLoading = true;\r\n      try {\r\n        const formData = new FormData();\r\n        formData.append('file', file);\r\n\r\n        const response = await request.post(this.uploadUrl, formData, {\r\n          headers: { 'Content-Type': 'multipart/form-data' }\r\n        });\r\n\r\n        if (response.data.code === 200) {\r\n          const imageUrl = response.data.data;\r\n          this.messages.push({\r\n            content: ``,\r\n            imageUrl: imageUrl,\r\n            isUser: true,\r\n            avatar: this.userAvatar,\r\n            senderName: '我',\r\n            isUploadedImage: true\r\n          });\r\n          this.scrollToBottom();\r\n\r\n          this.sendMessageWithImage(imageUrl);\r\n        } else {\r\n          Message.error(response.data.msg || '上传失败');\r\n        }\r\n      } catch (error) {\r\n        console.error('文件上传失败:', error);\r\n        Message.error('上传失败，请重试');\r\n      } finally {\r\n        this.isLoading = false;\r\n      }\r\n    },\r\n    sendMessageWithImage(imageUrl) {\r\n      const userMessage = `请分析这张图片: ${imageUrl}`;\r\n      this.userInput = userMessage;\r\n      this.sendMessage();\r\n    },\r\n    parseContent(content) {\r\n      return content;\r\n    },\r\n    async sendMessage() {\r\n      // 检查登录状态\r\n      if (!this.currentUserId) {\r\n        Message.warning('请先登录才能与AI助手对话。');\r\n        this.$router.push('/login');\r\n        return;\r\n      }\r\n\r\n      if (!this.userInput.trim() && !this.messages.some(m => m.isUploadedImage && m.isUser && m.content === '')) {\r\n        Message.warning('请输入消息内容或上传图片');\r\n        return;\r\n      }\r\n      if (this.isLoading) return;\r\n\r\n      const userMessageText = this.userInput;\r\n      this.userInput = '';\r\n\r\n      let finalUserMessage = userMessageText;\r\n      const lastUserMsg = this.messages[this.messages.length - 1];\r\n      if (lastUserMsg && lastUserMsg.isUser && lastUserMsg.isUploadedImage && lastUserMsg.content === '') {\r\n          finalUserMessage = `已上传图片：${lastUserMsg.imageUrl}，请问有什么可以帮助的？\\n${userMessageText}`;\r\n          lastUserMsg.content = `已上传图片`;\r\n      } else {\r\n          this.messages.push({\r\n              content: userMessageText,\r\n              isUser: true,\r\n              avatar: this.userAvatar,\r\n              senderName: '我',\r\n          });\r\n      }\r\n\r\n      this.isLoading = true;\r\n      this.scrollToBottom();\r\n\r\n      const aiMsgIndex = this.messages.length;\r\n      this.messages.push({\r\n          content: '',\r\n          isUser: false,\r\n          avatar: this.aiAvatar,\r\n          senderName: 'AI 助手',\r\n          isAiGenerating: true\r\n      });\r\n\r\n      let fullReply = '';\r\n      let aiGeneratedImageUrls = [];\r\n\r\n      try {\r\n        const response = await fetch(this.apiUrl, {\r\n          method: 'POST',\r\n          headers: {\r\n            'Content-Type': 'application/json',\r\n            'Authorization': `Bearer ${this.apiKey}`\r\n          },\r\n          body: JSON.stringify({\r\n            bot_id: this.robotId,\r\n            user_id: this.userId,\r\n            stream: true,\r\n            auto_save_history: true,\r\n            additional_messages: [\r\n              {\r\n                role: \"user\",\r\n                content: finalUserMessage,\r\n                content_type: \"text\"\r\n              }\r\n            ]\r\n          })\r\n        });\r\n\r\n        if (!response.ok) {\r\n          throw new Error(`请求失败: ${response.status}`);\r\n        }\r\n\r\n        const reader = response.body.getReader();\r\n        const decoder = new TextDecoder();\r\n        let buffer = '';\r\n\r\n        while (true) {\r\n          const { done, value } = await reader.read();\r\n          if (done) break;\r\n\r\n          buffer += decoder.decode(value, { stream: true });\r\n          let boundary = buffer.indexOf('\\n\\n');\r\n          while (boundary !== -1) {\r\n            const eventBlock = buffer.substring(0, boundary).trim();\r\n            buffer = buffer.substring(boundary + 2);\r\n\r\n            const eventMatch = eventBlock.match(/^event:\\s*(\\S+)/m);\r\n            const dataMatch = eventBlock.match(/^data:\\s*(.*)/m);\r\n\r\n            if (eventMatch && dataMatch) {\r\n                const eventName = eventMatch[1];\r\n                const dataStr = dataMatch[1];\r\n\r\n                if (eventName === 'conversation.message.delta') {\r\n                    if (dataStr) {\r\n                        try {\r\n                            const data = JSON.parse(dataStr);\r\n                            if (data.content) {\r\n                                fullReply += data.content;\r\n                                this.messages[aiMsgIndex].content = fullReply;\r\n                                this.scrollToBottom();\r\n                            }\r\n                        } catch (e) {\r\n                            console.warn('解析消息片段失败:', e);\r\n                        }\r\n                    }\r\n                } else if (eventName === 'message.file') {\r\n                    if (dataStr) {\r\n                        try {\r\n                            const data = JSON.parse(dataStr);\r\n                            if (data.url) {\r\n                                aiGeneratedImageUrls.push(data.url);\r\n                                this.currentAiGeneratedImageUrl = data.url; // 更新预览\r\n                                // 如果AI回复中还没有图片，就添加进去\r\n                                if (!this.messages[aiMsgIndex].isAiGeneratedImage) {\r\n                                     this.messages[aiMsgIndex].isAiGeneratedImage = true;\r\n                                     this.messages[aiMsgIndex].imageUrl = data.url;\r\n                                } else {\r\n                                     this.messages[aiMsgIndex].imageUrl = data.url; // 确保显示最新图片\r\n                                }\r\n                                this.scrollToBottom();\r\n                            }\r\n                        } catch (e) {\r\n                            console.warn('解析文件片段失败:', e);\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n            boundary = buffer.indexOf('\\n\\n');\r\n          }\r\n        }\r\n\r\n      } catch (error) {\r\n        console.error('API调用错误:', error);\r\n        this.messages[aiMsgIndex].content = `出错了: ${error.message}`;\r\n        Message.error('AI助手服务异常，请稍后再试。');\r\n      } finally {\r\n        this.isLoading = false;\r\n        this.messages[aiMsgIndex].isAiGenerating = false;\r\n        if (aiGeneratedImageUrls.length > 0 && !this.messages[aiMsgIndex].isAiGeneratedImage) {\r\n            this.messages[aiMsgIndex].isAiGeneratedImage = true;\r\n            this.messages[aiMsgIndex].imageUrl = aiGeneratedImageUrls[aiGeneratedImageUrls.length - 1];\r\n        }\r\n        this.scrollToBottom();\r\n      }\r\n    },\r\n    scrollToBottom() {\r\n      this.$nextTick(() => {\r\n        const container = this.$refs.chatMessages;\r\n        if (container) {\r\n          container.scrollTop = container.scrollHeight;\r\n        }\r\n      });\r\n    },\r\n    viewFullImage(imageUrl) {\r\n        MessageBox({\r\n            title: '查看大图',\r\n            message: `<div style=\"text-align: center;\"><img src=\"${imageUrl}\" style=\"max-width: 100%; max-height: 70vh; object-fit: contain; border-radius: 8px;\"></div>`,\r\n            dangerouslyUseHTMLString: true,\r\n            showCancelButton: false,\r\n            confirmButtonText: '关闭',\r\n            center: true,\r\n            customClass: 'full-image-dialog'\r\n        });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n// 定义颜色变量\r\n$primary-color: #d4af37; // 金色\r\n$secondary-color: #8b9dc3; // 蓝色，用于用户头像或辅助色\r\n$bg-color-light: #fcfcfa;\r\n$border-color: #e0e0e0;\r\n$shadow-light: rgba(0,0,0,0.05);\r\n$shadow-medium: rgba(0,0,0,0.1);\r\n\r\n.coze-chat-container {\r\n  padding: 30px;\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n  background-color: $bg-color-light;\r\n  min-height: calc(100vh - 120px); // 假设头部导航高度为60px，底部footler为60px\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 30px;\r\n}\r\n\r\n// 页面级别的 Section Header 样式 (与 DressUp 页面保持一致)\r\n.section-header {\r\n  margin-bottom: 20px;\r\n  position: relative;\r\n\r\n  .page-title {\r\n    font-size: 28px;\r\n    color: #2d2d2a;\r\n    margin: 0 0 8px 0;\r\n    font-weight: 600;\r\n    letter-spacing: 1px;\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n  }\r\n\r\n  .page-subtitle {\r\n    font-size: 16px;\r\n    color: #6a6a66;\r\n    margin: 0 0 15px 0;\r\n  }\r\n\r\n  .divider {\r\n    height: 3px;\r\n    width: 80px;\r\n    background-color: $primary-color;\r\n    border-radius: 2px;\r\n    transition: width 0.3s ease;\r\n\r\n    &:hover {\r\n      width: 120px;\r\n    }\r\n  }\r\n}\r\n\r\n// 统一的卡片样式\r\n.section-card {\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 4px 12px $shadow-light;\r\n  padding: 24px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex: 1; // 允许卡片在父容器中伸展\r\n}\r\n\r\n.card-title {\r\n  font-size: 20px;\r\n  color: #2d2d2a;\r\n  font-weight: 500;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-bottom: 15px;\r\n  padding-bottom: 10px;\r\n  border-bottom: 1px dashed #eee;\r\n}\r\n\r\n.main-content {\r\n  display: flex;\r\n  gap: 30px;\r\n  flex: 1; // 占据剩余空间\r\n  min-height: 0; // 允许子元素滚动\r\n  \r\n  @media (max-width: 992px) {\r\n    flex-direction: column; // 小屏幕下垂直排列\r\n  }\r\n}\r\n\r\n/* 左侧聊天区域容器 */\r\n.chat-container {\r\n  flex: 2; // 聊天区域占据更多空间\r\n  min-width: 350px;\r\n  height: 100%; // 填充父容器高度\r\n  \r\n  .chat-header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    h3 {\r\n      margin: 0;\r\n      font-size: 20px; // 保持与卡片标题一致\r\n      color: #2d2d2a;\r\n      font-weight: 500;\r\n      display: flex;\r\n      align-items: center;\r\n      gap: 8px;\r\n      &::before { // 添加AI助手图标\r\n          content: \"\\e74a\"; // Element UI 聊天图标\r\n          font-family: 'element-icons' !important;\r\n          font-style: normal;\r\n          -webkit-font-smoothing: antialiased;\r\n          -moz-osx-font-smoothing: grayscale;\r\n          margin-right: 8px;\r\n          color: $primary-color;\r\n      }\r\n    }\r\n    .header-buttons .el-button--text {\r\n      color: $primary-color;\r\n      font-weight: 500;\r\n      &:hover {\r\n        color: darken($primary-color, 10%);\r\n      }\r\n    }\r\n  }\r\n\r\n  .chat-messages {\r\n    flex: 1; // 消息列表占据剩余空间\r\n    overflow-y: auto; // 消息列表可滚动\r\n    padding: 10px;\r\n    margin-bottom: 15px;\r\n    background-color: #fcfcfc;\r\n    border-radius: 8px;\r\n    box-shadow: inset 0 1px 3px rgba(0,0,0,0.03); // 内阴影增加层次感\r\n  }\r\n\r\n  .message-item {\r\n    margin-bottom: 15px;\r\n    display: flex; // 使用flex布局来对齐头像和气泡\r\n  }\r\n\r\n  .message-bubble {\r\n    display: flex;\r\n    align-items: flex-start;\r\n    max-width: 85%; // 限制气泡最大宽度\r\n  }\r\n\r\n  .message-bubble.user {\r\n    margin-left: auto; // 用户消息靠右\r\n    flex-direction: row-reverse; // 反转顺序，让头像在右边\r\n  }\r\n\r\n  .avatar {\r\n    width: 36px;\r\n    height: 36px;\r\n    border-radius: 50%;\r\n    margin-right: 10px; // AI头像右侧留白\r\n    background-color: #e0e0e0; // 默认头像背景\r\n    flex-shrink: 0; // 防止头像被压缩\r\n    object-fit: cover;\r\n    \r\n    .message-bubble.user & {\r\n      margin-right: 0;\r\n      margin-left: 10px; // 用户头像左侧留白\r\n    }\r\n  }\r\n\r\n  .content {\r\n    padding: 10px 15px;\r\n    border-radius: 18px;\r\n    word-break: break-word; // 单词内断行\r\n    font-size: 15px;\r\n    line-height: 1.6;\r\n    box-shadow: 0 1px 3px $shadow-light; // 气泡阴影\r\n  }\r\n\r\n  .sender {\r\n    font-size: 12px;\r\n    margin: 0 0 5px 0;\r\n    color: #888;\r\n  }\r\n\r\n  .message-bubble.ai .content {\r\n    background-color: #f0f0ed; // AI消息气泡背景\r\n    color: #333;\r\n    border-bottom-left-radius: 4px; // 气泡尾部\r\n  }\r\n\r\n  .message-bubble.user .content {\r\n    background-color: $primary-color; // 用户消息气泡背景\r\n    color: #fff;\r\n    border-bottom-right-radius: 4px; // 气泡尾部\r\n  }\r\n\r\n  .chat-image {\r\n    max-width: 100%; // 确保图片在气泡内部\r\n    max-height: 250px;\r\n    object-fit: contain;\r\n    border-radius: 8px;\r\n    margin-top: 5px;\r\n    display: block; // 确保图片独占一行\r\n  }\r\n\r\n  .ai-generated-image-wrapper {\r\n    margin-top: 10px;\r\n    display: inline-block; // 让图片包裹内容\r\n    .ai-generated-image {\r\n      max-width: 100%;\r\n      height: auto;\r\n      border-radius: 8px;\r\n      cursor: zoom-in;\r\n      transition: transform 0.2s ease;\r\n      &:hover {\r\n        transform: scale(1.02);\r\n      }\r\n    }\r\n  }\r\n\r\n  .loading-indicator {\r\n    text-align: center;\r\n    padding: 10px;\r\n    color: #666;\r\n    font-size: 14px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    gap: 8px;\r\n    i {\r\n      animation: rotating 1.5s linear infinite;\r\n    }\r\n  }\r\n\r\n  .chat-input-area {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    padding-top: 15px;\r\n    border-top: 1px solid #eee;\r\n\r\n    .file-upload-input {\r\n      display: none;\r\n    }\r\n\r\n    .file-upload-btn {\r\n      padding: 8px;\r\n      color: $primary-color;\r\n      cursor: pointer;\r\n      font-size: 24px;\r\n      transition: color 0.2s ease;\r\n      &:hover {\r\n        color: darken($primary-color, 10%);\r\n      }\r\n    }\r\n\r\n    .message-input {\r\n      flex: 1;\r\n      ::v-deep .el-textarea__inner {\r\n        border-radius: 20px;\r\n        padding: 10px 15px;\r\n        border-color: $border-color;\r\n        &:focus {\r\n          border-color: $primary-color;\r\n          box-shadow: 0 0 0 2px rgba($primary-color, 0.2);\r\n        }\r\n      }\r\n    }\r\n    \r\n    .send-button {\r\n      padding: 10px 20px;\r\n      border-radius: 20px;\r\n      background-color: $primary-color;\r\n      border-color: $primary-color;\r\n      &:hover {\r\n        background-color: darken($primary-color, 8%);\r\n        border-color: darken($primary-color, 8%);\r\n      }\r\n      &:disabled {\r\n        background-color: #e0e0e0;\r\n        border-color: #e0e0e0;\r\n        cursor: not-allowed;\r\n      }\r\n    }\r\n  }\r\n}\r\n\r\n/* 右侧内容区域 */\r\n.right-content {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 30px;\r\n  min-width: 280px;\r\n\r\n  .image-preview-card, .my-creations-card {\r\n    flex: 1; // 两个卡片平分高度\r\n    min-height: 200px; // 确保有最小高度\r\n    \r\n    .card-title {\r\n        &::before { // 添加图标\r\n            content: \"\\e60e\"; // Element UI 图片图标\r\n            font-family: 'element-icons' !important;\r\n            font-style: normal;\r\n            -webkit-font-smoothing: antialiased;\r\n            -moz-osx-font-smoothing: grayscale;\r\n            margin-right: 8px;\r\n            color: $primary-color;\r\n        }\r\n    }\r\n  }\r\n\r\n  .my-creations-card .card-title {\r\n      &::before {\r\n            content: \"\\e656\"; // Element UI 文件夹图标\r\n        }\r\n  }\r\n}\r\n\r\n// 动画\r\n@keyframes rotating {\r\n  from {\r\n    transform: rotate(0deg);\r\n  }\r\n  to {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n\r\n// 媒体查询：小屏幕适配\r\n@media (max-width: 992px) {\r\n  .coze-chat-container {\r\n    padding: 15px;\r\n    gap: 20px;\r\n  }\r\n  .section-header {\r\n    .page-title {\r\n      font-size: 24px;\r\n    }\r\n    .page-subtitle {\r\n      font-size: 14px;\r\n    }\r\n  }\r\n  .main-content {\r\n    flex-direction: column;\r\n    gap: 20px;\r\n  }\r\n  .chat-container, .right-content {\r\n    min-width: unset;\r\n    flex: none; // 不再使用flex缩放，保持内容自然高度\r\n  }\r\n  .chat-container {\r\n    .chat-messages {\r\n      max-height: 400px; // 小屏幕下限制聊天列表高度\r\n    }\r\n  }\r\n}\r\n\r\n</style>"]}]}