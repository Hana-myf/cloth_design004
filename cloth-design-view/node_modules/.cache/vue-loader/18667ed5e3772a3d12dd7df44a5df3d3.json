{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\DressUp.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\DressUp.vue","mtime":1759325219418},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":456789000000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["DressUp.vue"],"names":[],"mappings":";AAqKA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"DressUp.vue","sourceRoot":"src/views/user","sourcesContent":["<template>\r\n    <div class=\"dress-up-container\">\r\n      <!-- 页面标题 -->\r\n      <div class=\"page-header\">\r\n        <h2 class=\"page-title\">\r\n          <i class=\"el-icon-magic-stick\"></i>\r\n          智能换装系统\r\n        </h2>\r\n        <p class=\"page-subtitle\">上传您的照片和服装，体验AI智能换装效果</p>\r\n      </div>\r\n  \r\n      <!-- 主要内容区域 -->\r\n      <div class=\"main-content\">\r\n        <!-- 左侧：上传区域 -->\r\n        <div class=\"upload-section\">\r\n          <!-- 人物上传 -->\r\n          <div class=\"upload-card\">\r\n            <div class=\"card-header\">\r\n              <i class=\"el-icon-user\"></i>\r\n              <span>上传人物照片</span>\r\n            </div>\r\n            <div class=\"upload-area\" @click=\"triggerPersonUpload\">\r\n              <div v-if=\"!personImage\" class=\"upload-placeholder\">\r\n                <i class=\"el-icon-plus\"></i>\r\n                <p>点击上传人物照片</p>\r\n                <span class=\"upload-tip\">支持 JPG、PNG 格式，建议尺寸 512x512</span>\r\n              </div>\r\n              <div v-else class=\"image-preview\">\r\n                <img :src=\"personImage\" alt=\"人物照片\" />\r\n                <div class=\"image-overlay\">\r\n                  <el-button type=\"text\" @click.stop=\"removePersonImage\">\r\n                    <i class=\"el-icon-delete\"></i>\r\n                  </el-button>\r\n                </div>\r\n              </div>\r\n              <input\r\n                ref=\"personUpload\"\r\n                type=\"file\"\r\n                accept=\"image/*\"\r\n                style=\"display: none\"\r\n                @change=\"handlePersonUpload\"\r\n              />\r\n            </div>\r\n          </div>\r\n  \r\n          <!-- 服装上传 -->\r\n          <div class=\"upload-card\">\r\n            <div class=\"card-header\">\r\n              <i class=\"el-icon-shopping-bag-2\"></i>\r\n              <span>上传服装图片</span>\r\n            </div>\r\n            <div class=\"upload-area\" @click=\"triggerClothingUpload\">\r\n              <div v-if=\"!clothingImage\" class=\"upload-placeholder\">\r\n                <i class=\"el-icon-plus\"></i>\r\n                <p>点击上传服装图片</p>\r\n                <span class=\"upload-tip\">支持 JPG、PNG 格式，建议透明背景</span>\r\n              </div>\r\n              <div v-else class=\"image-preview\">\r\n                <img :src=\"clothingImage\" alt=\"服装图片\" />\r\n                <div class=\"image-overlay\">\r\n                  <el-button type=\"text\" @click.stop=\"removeClothingImage\">\r\n                    <i class=\"el-icon-delete\"></i>\r\n                  </el-button>\r\n                </div>\r\n              </div>\r\n              <input\r\n                ref=\"clothingUpload\"\r\n                type=\"file\"\r\n                accept=\"image/*\"\r\n                style=\"display: none\"\r\n                @change=\"handleClothingUpload\"\r\n              />\r\n            </div>\r\n          </div>\r\n  \r\n          <!-- 换装按钮 -->\r\n          <div class=\"action-section\">\r\n            <el-button\r\n              type=\"primary\"\r\n              size=\"large\"\r\n              :disabled=\"!canDressUp\"\r\n              @click=\"startDressUp\"\r\n              :loading=\"isProcessing\"\r\n              class=\"dress-up-btn\"\r\n            >\r\n              <i class=\"el-icon-magic-stick\"></i>\r\n              {{ isProcessing ? 'AI换装中...' : '开始换装' }}\r\n            </el-button>\r\n          </div>\r\n        </div>\r\n  \r\n        <!-- 右侧：预览区域 -->\r\n        <div class=\"preview-section\">\r\n          <div class=\"preview-card\">\r\n            <div class=\"card-header\">\r\n              <i class=\"el-icon-picture\"></i>\r\n              <span>换装效果预览</span>\r\n            </div>\r\n            <div class=\"preview-area\">\r\n              <div v-if=\"!resultImage\" class=\"preview-placeholder\">\r\n                <i class=\"el-icon-picture-outline\"></i>\r\n                <p>换装效果将在这里显示</p>\r\n                <span class=\"preview-tip\">上传人物和服装后点击\"开始换装\"</span>\r\n              </div>\r\n              <div v-else class=\"result-preview\">\r\n                <img :src=\"resultImage\" alt=\"换装效果\" />\r\n                <div class=\"result-actions\">\r\n                  <el-button type=\"success\" @click=\"downloadResult\">\r\n                    <i class=\"el-icon-download\"></i>\r\n                    下载图片\r\n                  </el-button>\r\n                  <el-button type=\"info\" @click=\"saveToGallery\">\r\n                    <i class=\"el-icon-star-on\"></i>\r\n                    保存到相册\r\n                  </el-button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n  \r\n          <!-- 历史记录 -->\r\n          <div class=\"history-card\">\r\n            <div class=\"card-header\">\r\n              <i class=\"el-icon-time\"></i>\r\n              <span>换装历史</span>\r\n            </div>\r\n            <div class=\"history-list\">\r\n              <div v-if=\"historyList.length === 0\" class=\"empty-history\">\r\n                <i class=\"el-icon-picture-outline\"></i>\r\n                <p>暂无换装记录</p>\r\n              </div>\r\n              <div v-else class=\"history-items\">\r\n                <div\r\n                  v-for=\"(item, index) in historyList\"\r\n                  :key=\"index\"\r\n                  class=\"history-item\"\r\n                  @click=\"loadHistoryItem(item)\"\r\n                >\r\n                  <!-- 注意: item.resultImage 等属性要与后端 DressupHistoryItem Pojo 匹配 -->\r\n                  <img :src=\"item.resultImage\" alt=\"历史记录\" />\r\n                  <div class=\"history-info\">\r\n                    <!-- item.createTime 可能是 ISO 格式字符串，需要前端格式化 -->\r\n                    <span class=\"history-time\">{{ formatTime(item.createTime) }}</span>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n  \r\n      <!-- 加载遮罩 -->\r\n      <div v-if=\"isProcessing\" class=\"loading-overlay\">\r\n        <div class=\"loading-content\">\r\n          <i class=\"el-icon-loading\"></i>\r\n          <p>AI正在为您进行智能换装...</p>\r\n          <div class=\"loading-progress\">\r\n            <el-progress :percentage=\"progressPercentage\" :show-text=\"false\"></el-progress>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n</template>\r\n  \r\n<script>\r\n// 引入 request 实例，它已经配置了 baseURL\r\nimport request from '@/utils/request' \r\n// 引入 Element UI 的 Message 组件，如果你项目有配置的话\r\n// import { Message } from 'element-ui' \r\n\r\nexport default {\r\n    name: 'DressUp',\r\n    data() {\r\n      return {\r\n        personImage: '', // 人物图片URL\r\n        clothingImage: '', // 服装图片URL\r\n        resultImage: '', // 换装结果图片URL\r\n        isProcessing: false, // 是否正在处理中\r\n        progressPercentage: 0, // 处理进度（目前是模拟，真实进度需要后端支持）\r\n        historyList: [], // 历史记录列表\r\n        uploadProgress: 0 // 上传进度\r\n      }\r\n    },\r\n    computed: {\r\n      canDressUp() {\r\n        return this.personImage && this.clothingImage && !this.isProcessing\r\n      }\r\n    },\r\n    created() {\r\n      // 组件创建时加载历史记录\r\n      this.loadHistory()\r\n    },\r\n    methods: {\r\n      // 触发人物图片文件选择框\r\n      triggerPersonUpload() {\r\n        this.$refs.personUpload.click()\r\n      },\r\n  \r\n      // 触发服装图片文件选择框\r\n      triggerClothingUpload() {\r\n        this.$refs.clothingUpload.click()\r\n      },\r\n  \r\n      // 处理人物图片文件选择后的操作\r\n      handlePersonUpload(event) {\r\n        const file = event.target.files[0]\r\n        if (file) {\r\n          this.uploadImage(file, 'person')\r\n        }\r\n      },\r\n  \r\n      // 处理服装图片文件选择后的操作\r\n      handleClothingUpload(event) {\r\n        const file = event.target.files[0]\r\n        if (file) {\r\n          this.uploadImage(file, 'clothing')\r\n        }\r\n      },\r\n  \r\n      // 通用图片上传方法\r\n      async uploadImage(file, type) {\r\n        const formData = new FormData()\r\n        formData.append('file', file) // 参数名 'file' 与后端 @RequestParam(\"file\") 匹配\r\n        \r\n        try {\r\n          // 使用已存在的文件上传接口\r\n          const response = await request.post('/file/upload', formData, {\r\n            headers: {\r\n              'Content-Type': 'multipart/form-data' // 必须设置，Axios会自动处理 boundary\r\n            },\r\n            // 如果后端支持，可以追踪上传进度\r\n            onUploadProgress: (progressEvent) => {\r\n              this.uploadProgress = Math.round((progressEvent.loaded * 100) / progressEvent.total)\r\n              // console.log(`上传进度: ${this.uploadProgress}%`)\r\n            }\r\n          })\r\n \r\n          // 根据后端返回的 code 和 data 更新图片URL\r\n          const { data } = response\r\n          if (data && data.code === 200) {\r\n            if (type === 'person') {\r\n              this.personImage = data.data // 图片URL\r\n            } else {\r\n              this.clothingImage = data.data // 图片URL\r\n            }\r\n            this.$message.success('图片上传成功')\r\n          } else {\r\n            this.$message.error((data && (data.msg || data.message)) || '上传失败')\r\n          }\r\n        } catch (error) {\r\n          console.error('上传失败:', error)\r\n          this.$message.error('图片上传失败，请重试')\r\n        }\r\n      },\r\n  \r\n      // 移除人物图片\r\n      removePersonImage() {\r\n        this.personImage = ''\r\n        this.$refs.personUpload.value = '' // 清空文件输入框\r\n      },\r\n  \r\n      // 移除服装图片\r\n      removeClothingImage() {\r\n        this.clothingImage = ''\r\n        this.$refs.clothingUpload.value = '' // 清空文件输入框\r\n      },\r\n  \r\n      // 开始换装\r\n      async startDressUp() {\r\n        if (!this.canDressUp) return\r\n \r\n        this.isProcessing = true\r\n        this.progressPercentage = 0 // 重置进度\r\n \r\n        // 模拟进度条增加\r\n        const interval = setInterval(() => {\r\n          if (this.progressPercentage < 95) {\r\n            this.progressPercentage += 5\r\n          }\r\n        }, 300)\r\n \r\n        try {\r\n          // 调用后端 /api/dressup/process 接口\r\n          // 后端需要接收 personImage 和 clothingImage 的 URL\r\n          const response = await request.post('/dressup/process', {\r\n            personImage: this.personImage, // 传递人物图片URL\r\n            clothingImage: this.clothingImage // 传递服装图片URL\r\n          })\r\n \r\n          clearInterval(interval) // 停止进度模拟\r\n          this.progressPercentage = 100 // 完成进度\r\n \r\n          const { data } = response\r\n          if (data && data.code === 200) {\r\n            this.resultImage = data.data // 结果图片URL\r\n            this.$message.success('换装完成！')\r\n            this.loadHistory() // 换装成功后刷新历史记录\r\n          } else {\r\n            this.$message.error((data && (data.msg || data.message)) || '换装失败')\r\n          }\r\n        } catch (error) {\r\n          clearInterval(interval) // 停止进度模拟\r\n          this.progressPercentage = 0 // 重置进度\r\n          console.error('换装失败:', error)\r\n          // 后端未就绪时的降级：直接使用人物图作为占位结果\r\n          this.resultImage = this.personImage\r\n          this.$message.warning('后端未就绪，已生成占位结果')\r\n        } finally {\r\n          this.isProcessing = false\r\n        }\r\n      },\r\n  \r\n      // 下载结果图片\r\n      downloadResult() {\r\n        if (!this.resultImage) return\r\n        \r\n        const link = document.createElement('a')\r\n        link.href = this.resultImage\r\n        link.download = `dressup-result-${Date.now()}.png` // 下载文件名\r\n        document.body.appendChild(link)\r\n        link.click()\r\n        document.body.removeChild(link)\r\n      },\r\n  \r\n      // 保存到相册\r\n      async saveToGallery() {\r\n        if (!this.resultImage) return\r\n \r\n        try {\r\n          // 调用后端 /api/dressup/save-to-gallery 接口\r\n          // 传递所有相关图片URL\r\n          const response = await request.post('/dressup/save-to-gallery', {\r\n            resultImage: this.resultImage,\r\n            personImage: this.personImage,\r\n            clothingImage: this.clothingImage\r\n          })\r\n \r\n          const { data } = response\r\n          if (data && data.code === 200) {\r\n            this.$message.success('已保存到相册')\r\n          } else {\r\n            this.$message.error((data && (data.msg || data.message)) || '保存失败')\r\n          }\r\n        } catch (error) {\r\n          console.error('保存失败:', error)\r\n          this.$message.error('保存到相册失败')\r\n        }\r\n      },\r\n  \r\n      // 加载历史记录\r\n      async loadHistory() {\r\n        try {\r\n          // 调用后端 /api/dressup/history 接口\r\n          const response = await request.get('/dressup/history')\r\n          const { data } = response\r\n          if (data && data.code === 200) {\r\n            this.historyList = data.data || []\r\n          } else {\r\n            this.historyList = []\r\n          }\r\n        } catch (error) {\r\n          console.error('加载历史记录失败:', error)\r\n          // 历史接口未就绪时不打扰用户\r\n          this.historyList = []\r\n        }\r\n      },\r\n  \r\n      // 点击历史记录项，加载其图片到当前界面\r\n      loadHistoryItem(item) {\r\n        this.resultImage = item.resultImage\r\n        this.personImage = item.personImage\r\n        this.clothingImage = item.clothingImage\r\n        // 可以在这里添加一些动画或滚动效果\r\n        this.$message.info('已加载历史记录项')\r\n      },\r\n  \r\n      // 格式化时间，以适应后端返回的 createTime (例如 ISO 格式字符串)\r\n      formatTime(time) {\r\n        if (!time) return ''\r\n        // 假设后端返回的是类似 \"2023-01-01T10:30:00\" 这样的字符串\r\n        return new Date(time).toLocaleString('zh-CN', {\r\n            year: 'numeric',\r\n            month: '2-digit',\r\n            day: '2-digit',\r\n            hour: '2-digit',\r\n            minute: '2-digit',\r\n            second: '2-digit'\r\n        })\r\n      }\r\n    }\r\n}\r\n</script>\r\n  \r\n<style scoped lang=\"scss\">\r\n// 你的样式代码保持不变，它只影响页面布局和外观\r\n.dress-up-container {\r\n    padding: 20px;\r\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n    min-height: 100vh;\r\n}\r\n  \r\n.page-header {\r\n    text-align: center;\r\n    margin-bottom: 30px;\r\n    color: white;\r\n  \r\n    .page-title {\r\n      font-size: 32px;\r\n      font-weight: 600;\r\n      margin-bottom: 10px;\r\n      \r\n      i {\r\n        margin-right: 10px;\r\n        color: #ffd700;\r\n      }\r\n    }\r\n  \r\n    .page-subtitle {\r\n      font-size: 16px;\r\n      opacity: 0.9;\r\n      margin: 0;\r\n    }\r\n}\r\n  \r\n.main-content {\r\n    display: flex;\r\n    gap: 30px;\r\n    max-width: 1400px;\r\n    margin: 0 auto;\r\n}\r\n  \r\n.upload-section {\r\n    flex: 1;\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 20px;\r\n}\r\n  \r\n.preview-section {\r\n    flex: 1;\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 20px;\r\n}\r\n  \r\n.upload-card,\r\n.preview-card,\r\n.history-card {\r\n    background: white;\r\n    border-radius: 16px;\r\n    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\r\n    overflow: hidden;\r\n    backdrop-filter: blur(10px);\r\n}\r\n  \r\n.card-header {\r\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n    color: white;\r\n    padding: 20px;\r\n    font-size: 18px;\r\n    font-weight: 600;\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n  \r\n    i {\r\n      font-size: 20px;\r\n    }\r\n}\r\n  \r\n.upload-area {\r\n    padding: 30px;\r\n    cursor: pointer;\r\n    transition: all 0.3s ease;\r\n    border: 2px dashed #e0e0e0;\r\n    margin: 20px;\r\n    border-radius: 12px;\r\n  \r\n    &:hover {\r\n      border-color: #667eea;\r\n      background-color: #f8f9ff;\r\n    }\r\n}\r\n  \r\n.upload-placeholder {\r\n    text-align: center;\r\n    color: #666;\r\n  \r\n    i {\r\n      font-size: 48px;\r\n      color: #ddd;\r\n      margin-bottom: 15px;\r\n      display: block;\r\n    }\r\n  \r\n    p {\r\n      font-size: 16px;\r\n      margin: 10px 0;\r\n      font-weight: 500;\r\n    }\r\n  \r\n    .upload-tip {\r\n      font-size: 12px;\r\n      color: #999;\r\n    }\r\n}\r\n  \r\n.image-preview {\r\n    position: relative;\r\n    text-align: center;\r\n  \r\n    img {\r\n      max-width: 100%;\r\n      max-height: 200px;\r\n      border-radius: 8px;\r\n      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);\r\n    }\r\n  \r\n    .image-overlay {\r\n      position: absolute;\r\n      top: 10px;\r\n      right: 10px;\r\n      opacity: 0;\r\n      transition: opacity 0.3s ease;\r\n    }\r\n  \r\n    &:hover .image-overlay {\r\n      opacity: 1;\r\n    }\r\n}\r\n  \r\n.action-section {\r\n    padding: 20px;\r\n    text-align: center;\r\n}\r\n  \r\n.dress-up-btn {\r\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n    border: none;\r\n    padding: 15px 40px;\r\n    font-size: 16px;\r\n    font-weight: 600;\r\n    border-radius: 25px;\r\n    box-shadow: 0 8px 24px rgba(102, 126, 234, 0.3);\r\n    transition: all 0.3s ease;\r\n  \r\n    &:hover {\r\n      transform: translateY(-2px);\r\n      box-shadow: 0 12px 32px rgba(102, 126, 234, 0.4);\r\n    }\r\n  \r\n    &:disabled {\r\n      background: #ccc;\r\n      transform: none;\r\n      box-shadow: none;\r\n    }\r\n}\r\n  \r\n.preview-area {\r\n    padding: 30px;\r\n    min-height: 300px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n}\r\n  \r\n.preview-placeholder {\r\n    text-align: center;\r\n    color: #666;\r\n  \r\n    i {\r\n      font-size: 64px;\r\n      color: #ddd;\r\n      margin-bottom: 20px;\r\n      display: block;\r\n    }\r\n  \r\n    p {\r\n      font-size: 18px;\r\n      margin: 10px 0;\r\n      font-weight: 500;\r\n    }\r\n  \r\n    .preview-tip {\r\n      font-size: 14px;\r\n      color: #999;\r\n    }\r\n}\r\n  \r\n.result-preview {\r\n    text-align: center;\r\n  \r\n    img {\r\n      max-width: 100%;\r\n      max-height: 400px;\r\n      border-radius: 12px;\r\n      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);\r\n      margin-bottom: 20px;\r\n    }\r\n  \r\n    .result-actions {\r\n      display: flex;\r\n      gap: 15px;\r\n      justify-content: center;\r\n    }\r\n}\r\n  \r\n.history-list {\r\n    padding: 20px;\r\n    max-height: 300px;\r\n    overflow-y: auto;\r\n}\r\n  \r\n.empty-history {\r\n    text-align: center;\r\n    color: #666;\r\n    padding: 40px 20px;\r\n  \r\n    i {\r\n      font-size: 48px;\r\n      color: #ddd;\r\n      margin-bottom: 15px;\r\n      display: block;\r\n    }\r\n  \r\n    p {\r\n      font-size: 16px;\r\n      margin: 0;\r\n    }\r\n}\r\n  \r\n.history-items {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));\r\n    gap: 15px;\r\n}\r\n  \r\n.history-item {\r\n    cursor: pointer;\r\n    border-radius: 8px;\r\n    overflow: hidden;\r\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\r\n    transition: all 0.3s ease;\r\n  \r\n    &:hover {\r\n      transform: translateY(-2px);\r\n      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);\r\n    }\r\n  \r\n    img {\r\n      width: 100%;\r\n      height: 120px;\r\n      object-fit: cover;\r\n    }\r\n  \r\n    .history-info {\r\n      padding: 8px;\r\n      background: #f8f9fa;\r\n  \r\n      .history-time {\r\n        font-size: 12px;\r\n        color: #666;\r\n      }\r\n    }\r\n}\r\n  \r\n.loading-overlay {\r\n    position: fixed;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: 0;\r\n    background: rgba(0, 0, 0, 0.7);\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    z-index: 9999;\r\n}\r\n  \r\n.loading-content {\r\n    background: white;\r\n    padding: 40px;\r\n    border-radius: 16px;\r\n    text-align: center;\r\n    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2);\r\n  \r\n    i {\r\n      font-size: 48px;\r\n      color: #667eea;\r\n      margin-bottom: 20px;\r\n      display: block;\r\n    }\r\n  \r\n    p {\r\n      font-size: 18px;\r\n      margin-bottom: 20px;\r\n      color: #333;\r\n    }\r\n  \r\n    .loading-progress {\r\n      width: 300px;\r\n    }\r\