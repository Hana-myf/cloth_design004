{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ImageViewer.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ImageViewer.vue","mtime":1753770921840},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":315532800000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["ImageViewer.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAmCA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"ImageViewer.vue","sourceRoot":"src/components","sourcesContent":["<template>\r\n  <div class=\"image-viewer\">\r\n    <!-- 图片查看区域 -->\r\n    <div v-if=\"imageUrl\" class=\"image-container\">\r\n      <h3>图片预览</h3>\r\n      <div class=\"image-wrapper\">\r\n        <img \r\n          :src=\"imageUrl\" \r\n          alt=\"提取的图片\" \r\n          class=\"preview-image\"\r\n          @load=\"isLoading = false\"\r\n          @error=\"handleImageError\"\r\n        >\r\n        <div v-if=\"isLoading\" class=\"image-loading\">加载中...</div>\r\n        <div v-if=\"loadError\" class=\"image-error\">图片加载失败，请检查链接</div>\r\n      </div>\r\n      \r\n      <!-- 修改按钮文本，反映保存到数据库的操作 -->\r\n    <button \r\n      class=\"save-btn\" \r\n      @click=\"saveImage\" \r\n      :disabled=\"isLoading || loadError || saving\"\r\n    >\r\n      {{ saving ? '保存中...' : '保存图片到我的创作' }}\r\n    </button>\r\n    </div>\r\n\r\n    <!-- 无图片时的提示 -->\r\n    <div v-else class=\"no-image\">\r\n      {{ hasChecked? '未从回复中提取到图片链接' : '等待AI生成图片...' }}\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'ImageViewer',\r\n  props: {\r\n    // 接收AI的回复内容，用于提取图片链接\r\n    aiReply: {\r\n      type: String,\r\n      default: ''\r\n    },\r\n    // 新增：接收当前用户ID（从父组件传递）\r\n    currentUserId: {\r\n      type: String,\r\n      required: false, // 改为非必填\r\n      default: '' // 默认空字符串\r\n    },\r\n  },\r\n  data() {\r\n    return {\r\n      imageUrl: '', // 提取到的图片链接\r\n      isLoading: false, // 图片加载状态\r\n      loadError: false, // 加载错误状态\r\n      hasChecked: false, // 是否已检查过回复内容\r\n      saving: false, // 新增：保存到数据库的状态\r\n      saveSuccess: false, // 新增：保存成功状态\r\n    };\r\n  },\r\n  watch: {\r\n    // 当AI回复变化时，自动提取图片链接\r\n    aiReply(newReply) {\r\n      this.extractImageUrl(newReply);\r\n    }\r\n  },\r\n  methods: {\r\n    // 从AI回复中提取图片链接（支持Coze图片链接格式）\r\n    extractImageUrl(content) {\r\n      if (!content) {\r\n        this.resetState();\r\n        return;\r\n      }\r\n\r\n      // 正则匹配Coze图片链接（https://s.coze.cn/t/xxx/格式）\r\n      const imgRegex = /https?:\\/\\/s\\.coze\\.cn\\/t\\/[a-zA-Z0-9]+\\/?/g;\r\n      const matches = content.match(imgRegex);\r\n\r\n      if (matches && matches.length > 0) {\r\n        // 提取第一个有效链接\r\n        this.imageUrl = matches[0];\r\n        this.isLoading = true;\r\n        this.loadError = false;\r\n        this.hasChecked = true;\r\n      } else {\r\n        this.resetState();\r\n        this.hasChecked = true;\r\n      }\r\n    },\r\n\r\n    // 处理图片加载错误\r\n    handleImageError() {\r\n      this.isLoading = false;\r\n      this.loadError = true;\r\n    },\r\n\r\n    // 保存图片到本地\r\n    async saveImage() {\r\n      if (!this.imageUrl || this.saving) return;\r\n      \r\n      this.saving = true;\r\n      this.saveSuccess = false;\r\n      \r\n      try {\r\n        // 从图片URL中提取文件名（如果有）\r\n        const fileName = this.imageUrl.split('/').pop() || 'generated-image';\r\n        \r\n        // 调用后端API保存图片信息\r\n        const response = await fetch('/generatedImage/save', {\r\n          method: 'POST',\r\n          headers: {\r\n            'Content-Type': 'application/json',\r\n          },\r\n          body: JSON.stringify({\r\n            userId: this.currentUserId, // 从父组件获取的用户ID\r\n            imageName: fileName,        // 图片名称\r\n            imageUrl: this.imageUrl,    // 图片URL\r\n            generateTime: new Date().toISOString() // 当前时间\r\n          }),\r\n        });\r\n        \r\n        if (!response.ok) {\r\n          throw new Error(`保存失败: ${response.status}`);\r\n        }\r\n        \r\n        const result = await response.json();\r\n        if (result.success) {\r\n          // 保存成功，通知父组件刷新列表\r\n          this.$emit('save-success');\r\n          this.saveSuccess = true;\r\n          \r\n          // 显示成功提示（可添加UI反馈）\r\n          setTimeout(() => {\r\n            this.saveSuccess = false;\r\n          }, 2000);\r\n        } else {\r\n          throw new Error(result.message || '保存失败');\r\n        }\r\n      } catch (error) {\r\n        console.error('保存图片失败:', error);\r\n        // 显示错误提示（可添加UI反馈）\r\n      } finally {\r\n        this.saving = false;\r\n      }\r\n    },\r\n\r\n    // 重置状态\r\n    resetState() {\r\n      this.imageUrl = '';\r\n      this.isLoading = false;\r\n      this.loadError = false;\r\n    }\r\n  },\r\n  created() {\r\n    // 初始化时检查已有回复\r\n    if (this.aiReply) {\r\n      this.extractImageUrl(this.aiReply);\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.image-viewer {\r\n  width: 350px;\r\n  border: 1px solid #e0e0e0;\r\n  border-radius: 8px;\r\n  padding: 15px;\r\n  margin: 10px 0;\r\n  background-color: white;\r\n}\r\n\r\n.image-container h3 {\r\n  margin: 0 0 15px 0;\r\n  color: #333;\r\n  font-size: 16px;\r\n}\r\n\r\n.image-wrapper {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 250px;\r\n  border: 1px dashed #ccc;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.preview-image {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain; /* 保持图片比例，不拉伸 */\r\n}\r\n\r\n.image-loading {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(255,255,255,0.8);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #666;\r\n}\r\n\r\n.image-error {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: #fff5f5;\r\n  color: #f56c6c;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 14px;\r\n}\r\n\r\n.save-btn {\r\n  background-color: #165DFF;\r\n  color: white;\r\n  border: none;\r\n  padding: 8px 16px;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n}\r\n\r\n.save-btn:disabled {\r\n  background-color: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.save-btn:hover:not(:disabled) {\r\n  background-color: #0e47d7;\r\n}\r\n\r\n.no-image {\r\n  height: 250px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #666;\r\n  border: 1px dashed #ccc;\r\n  border-radius: 4px;\r\n}\r\n</style>"]}]}