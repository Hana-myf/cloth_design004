{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\Message.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\Message.vue","mtime":1759647554210},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":1759332253502},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":1759332273371}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Message.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAkFA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Message.vue","sourceRoot":"src/views/user","sourcesContent":["<template>\r\n    <div class=\"dress-up-container user-message-page-wrapper\">\r\n\r\n        <!-- 主内容区域 -->\r\n        <div class=\"main-content-message\">\r\n            <!-- 左侧消息类型导航 -->\r\n            <div class=\"message-type-card section-card\">\r\n                <div class=\"card-title\">\r\n                    <i class=\"el-icon-menu\"></i>\r\n                    消息分类\r\n                </div>\r\n                <div class=\"message-type-bar\">\r\n                    <span\r\n                        :class=\"['message-type-item', { 'message-type-item--active': messageTypeItem === messageType.type }]\"\r\n                        @click=\"messageTypeSelected(messageType.type)\"\r\n                        v-for=\"(messageType, index) in filteredMessageTypes\"\r\n                        :key=\"index\"\r\n                    >\r\n                        {{ messageType.detail }}\r\n                    </span>\r\n                </div>\r\n                <div class=\"clear-all-messages\">\r\n                    <el-button type=\"info\" size=\"small\" @click=\"clearMessage\">\r\n                        <i class=\"el-icon-delete\"></i>\r\n                        全部设为已读\r\n                    </el-button>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- 右侧消息列表 -->\r\n            <div class=\"message-list-section section-card\">\r\n                <div class=\"card-title\">\r\n                    <i class=\"el-icon-document\"></i>\r\n                    我的消息\r\n                </div>\r\n\r\n                <div v-if=\"filteredMessageList.length === 0\" class=\"empty-message-list\">\r\n                    <el-empty description=\"暂无消息\"></el-empty>\r\n                </div>\r\n                <div v-else class=\"message-items-list\">\r\n                    <div\r\n                        class=\"message-item-card\"\r\n                        :class=\"{ 'message-item-unread': !message.isRead }\"\r\n                        v-for=\"(message, index) in filteredMessageList\"\r\n                        :key=\"index\"\r\n                    >\r\n                        <div class=\"message-item-header\">\r\n                            <span class=\"message-icon-wrapper\">\r\n                                <span v-if=\"message.messageType === 1 || message.messageType === 2\">\r\n                                    <img class=\"sender-avatar\" :src=\"message.senderAvatar\" alt=\"用户头像\">\r\n                                </span>\r\n                                <i v-else-if=\"message.messageType === 3\" class=\"el-icon-data-analysis\"></i>\r\n                                <i v-else-if=\"message.messageType === 4\" class=\"el-icon-warning-outline\"></i>\r\n                                <i v-else class=\"el-icon-info\"></i> <!-- 默认图标 -->\r\n                            </span>\r\n                            <div class=\"message-content-wrapper\">\r\n                                <div class=\"message-main-info\">\r\n                                    <div class=\"message-sender-name\" v-if=\"message.messageType === 1 || message.messageType === 2\">\r\n                                        {{ message.senderName }}\r\n                                    </div>\r\n                                    <div class=\"message-title-text\">\r\n                                        <span v-if=\"message.messageType === 1\">评论了你的文章：{{ commentDeal(message.content)[2] }}</span>\r\n                                        <span v-else-if=\"message.messageType === 2\">点赞了你的评论：{{ message.content }}</span>\r\n                                        <span v-else-if=\"message.messageType === 3\">指标提醒：{{ message.content }}</span>\r\n                                        <span v-else-if=\"message.messageType === 4\">系统通知：{{ message.content }}</span>\r\n                                        <span v-else>{{ message.content }}</span>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"message-actions-time\">\r\n                                    <span class=\"message-time\">{{ formatTime(message.createTime) }}</span>\r\n                                    <el-button type=\"text\" size=\"mini\" @click=\"replyUser(message)\" v-if=\"message.messageType === 1\" class=\"reply-btn\">回复</el-button>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\n// import Logo from \"@/components/Logo\";\r\nimport Swal from \"sweetalert2\";\r\nimport request from '@/utils/request'; // 引入 request 实例\r\n\r\nexport default {\r\n    // components: { Logo },\r\n    data() {\r\n        return {\r\n            userInfo: {},\r\n            messageQueryDto: {},\r\n            messageList: [],\r\n            messageTypes: [],\r\n            messageTypeItem: null, // 初始化为 null，与“全部消息”的 type 保持一致\r\n            dialogEvaluationsOperation: false,\r\n            message: {}\r\n        };\r\n    },\r\n    computed: {\r\n        filteredMessageTypes() {\r\n            // 确保 \"全部消息\" 始终是第一个，并且只显示特定类型\r\n            const allTypes = [\r\n                { type: null, detail: \"全部消息\" },\r\n                { type: 3, detail: \"指标提醒\" },\r\n                { type: 4, detail: \"系统通知\" },\r\n                // 可以根据需要添加其他消息类型\r\n            ];\r\n            // 过滤掉不在预设列表中的类型，并合并\r\n            const uniqueTypes = new Map(allTypes.map(item => [item.type, item]));\r\n            this.messageTypes.forEach(type => {\r\n                if (!uniqueTypes.has(type.type) && type.type !== null && type.detail !== \"全部消息\") { // 避免重复添加全部消息\r\n                    uniqueTypes.set(type.type, type);\r\n                }\r\n            });\r\n            return Array.from(uniqueTypes.values());\r\n        },\r\n        filteredMessageList() {\r\n            // 根据 selectedMessageType 过滤\r\n            if (this.messageTypeItem === null) {\r\n                return this.messageList; // 显示全部消息\r\n            }\r\n            return this.messageList.filter(m => m.messageType === this.messageTypeItem);\r\n        }\r\n    },\r\n    created() {\r\n        this.getUserInfo();\r\n        this.loadAllMessageType(); // 先加载消息类型，再根据类型加载消息\r\n    },\r\n    methods: {\r\n        commentDeal(content) {\r\n            // 假设 content 格式为 \"parentId;contentId;评论内容\"\r\n            if (content && typeof content === 'string') {\r\n                const parts = content.split(\";\");\r\n                // 确保至少有三个部分，否则返回原始 content 或一个默认值\r\n                return parts.length >= 3 ? parts : [null, null, content];\r\n            }\r\n            return [null, null, content]; // 返回一个默认结构\r\n        },\r\n        replyUser(message) {\r\n            Swal.fire({\r\n                title: `回复【${message.senderName}】`,\r\n                input: \"text\",\r\n                inputPlaceholder: \"请输入回复内容...\",\r\n                showCancelButton: true,\r\n                confirmButtonText: \"发送\",\r\n                cancelButtonText: \"取消\",\r\n                customClass: {\r\n                    container: 'my-swal-container', // 自定义类，方便样式覆盖\r\n                    popup: 'my-swal-popup',\r\n                    title: 'my-swal-title',\r\n                    input: 'my-swal-input',\r\n                    confirmButton: 'my-swal-confirm-button',\r\n                    cancelButton: 'my-swal-cancel-button'\r\n                },\r\n                preConfirm: (value) => { // 使用 preConfirm 进行验证和处理\r\n                    if (!value || value.trim() === '') {\r\n                        Swal.showValidationMessage('内容不能为空哦');\r\n                        return false;\r\n                    }\r\n                    return value; // 返回有效值\r\n                }\r\n            }).then(result => {\r\n                if (result.isConfirmed) {\r\n                    const content = result.value;\r\n                    const commentParts = this.commentDeal(message.content);\r\n                    this.saveCommentData(\r\n                        message.senderId,\r\n                        content,\r\n                        commentParts\r\n                    );\r\n                }\r\n            });\r\n        },\r\n        async saveCommentData(senderId, content, commentParts) {\r\n            try {\r\n                const comment = {\r\n                    content,\r\n                    parentId: commentParts[0], // 评论回复父ID\r\n                    contentType: \"NEWS\", // 假设都是针对新闻的评论\r\n                    contentId: commentParts[1], // 新闻ID\r\n                    replierId: senderId // 被回复的用户ID\r\n                };\r\n                const response = await request.post(\"/evaluations/insert\", comment);\r\n                const { data } = response;\r\n                if (data.code === 200) {\r\n                    this.$notify({\r\n                        title: \"评论回复\",\r\n                        message: \"回复成功\",\r\n                        type: \"success\"\r\n                    });\r\n                    // 可以考虑刷新消息列表或更新相关状态\r\n                } else {\r\n                    this.$notify.error({\r\n                        title: \"评论回复\",\r\n                        message: data.msg || \"回复失败\"\r\n                    });\r\n                }\r\n            } catch (error) {\r\n                console.error(\"回复异常：\", error);\r\n                this.$notify.error({\r\n                    title: \"评论回复\",\r\n                    message: \"回复失败，请稍后再试\"\r\n                });\r\n            }\r\n        },\r\n        async clearMessage() {\r\n            const confirmed = await Swal.fire({\r\n                title: \"清空消息\",\r\n                text: \"您确定要将所有消息设为已读吗？此操作不可撤销。\",\r\n                icon: \"warning\",\r\n                showCancelButton: true,\r\n                confirmButtonText: \"确认\",\r\n                cancelButtonText: \"取消\",\r\n                confirmButtonColor: '#d4af37', // 替换为主题色\r\n                cancelButtonColor: '#909399', // 替换为 Info 色\r\n                customClass: {\r\n                    container: 'my-swal-container',\r\n                    popup: 'my-swal-popup',\r\n                    title: 'my-swal-title',\r\n                    content: 'my-swal-text',\r\n                    confirmButton: 'my-swal-confirm-button',\r\n                    cancelButton: 'my-swal-cancel-button'\r\n                }\r\n            });\r\n            if (confirmed.isConfirmed) {\r\n                try {\r\n                    const response = await request.put(\"/message/clearMessage\");\r\n                    const { data } = response;\r\n                    if (data.code === 200) {\r\n                        this.$notify.success({\r\n                            title: \"消息清除\",\r\n                            message: \"所有消息已设为已读\"\r\n                        });\r\n                        this.loadAllUsersMessage(); // 刷新消息列表\r\n                    } else {\r\n                        this.$notify.error({\r\n                            title: \"消息清除\",\r\n                            message: data.msg || \"操作失败\"\r\n                        });\r\n                    }\r\n                } catch (error) {\r\n                    console.error(\"清空消息异常：\", error);\r\n                    this.$notify.error({\r\n                        title: \"消息清除\",\r\n                        message: \"操作失败，请稍后再试\"\r\n                    });\r\n                }\r\n            }\r\n        },\r\n        messageTypeSelected(messageType) {\r\n            this.messageTypeItem = messageType;\r\n            // 理论上这里应该重新调用后端接口，根据 messageTypeItem 来过滤\r\n            // 但如果后端接口不支持按类型查询，就只能前端过滤\r\n            // 假设 loadAllUsersMessage 会根据 this.messageQueryDto 自动带上 messageType\r\n            this.messageQueryDto.messageType = messageType;\r\n            this.loadAllUsersMessage();\r\n        },\r\n        getUserInfo() {\r\n            const userInfo = sessionStorage.getItem(\"userInfo\");\r\n            if (userInfo) {\r\n                this.userInfo = JSON.parse(userInfo);\r\n            } else {\r\n                // 处理用户未登录的情况，例如跳转到登录页\r\n                // this.$router.push('/login');\r\n            }\r\n        },\r\n        async loadAllMessageType() {\r\n            try {\r\n                const response = await request.get(\"/message/types\");\r\n                const { data } = response;\r\n                if (data.code === 200) {\r\n                    this.messageTypes = data.data || [];\r\n                    // 将“全部消息”作为默认选中项\r\n                    this.messageTypeItem = null; // null 对应“全部消息”\r\n                    this.loadAllUsersMessage(); // 类型加载完后加载所有消息\r\n                }\r\n            } catch (error) {\r\n                console.error(\"加载消息类型失败：\", error);\r\n                this.messageTypes = [];\r\n            }\r\n        },\r\n        async loadAllUsersMessage() {\r\n            if (!this.userInfo || !this.userInfo.id) {\r\n                // console.warn(\"用户信息未加载，无法获取消息。\");\r\n                return;\r\n            }\r\n            try {\r\n                this.messageQueryDto.userId = this.userInfo.id;\r\n                // 如果 messageTypeItem 为 null，则不传 messageType 参数，表示查询全部\r\n                if (this.messageTypeItem !== null) {\r\n                    this.messageQueryDto.messageType = this.messageTypeItem;\r\n                } else {\r\n                    delete this.messageQueryDto.messageType; // 删除该属性\r\n                }\r\n                \r\n                const response = await request.post(\"/message/query\", this.messageQueryDto);\r\n                const { data } = response;\r\n                if (data.code === 200) {\r\n                    this.messageList = data.data || [];\r\n                } else {\r\n                    this.messageList = [];\r\n                }\r\n            } catch (error) {\r\n                console.error(\"加载用户消息失败：\", error);\r\n                this.messageList = [];\r\n            }\r\n        },\r\n        formatTime(time) {\r\n            if (!time) return '';\r\n            return new Date(time).toLocaleString('zh-CN', {\r\n                year: 'numeric',\r\n                month: '2-digit',\r\n                day: '2-digit',\r\n                hour: '2-digit',\r\n                minute: '2-digit',\r\n            });\r\n        }\r\n    }\r\n};\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n// 统一的颜色和阴影变量 (可以放在一个公共 SCSS 文件中，这里为了演示直接包含)\r\n$primary-color: #d4af37; // 金色\r\n$secondary-color: #8b9dc3; // 蓝色\r\n$bg-color-light: #fcfcfa; // 页面背景\r\n$border-color: #e0e0e0; // 边框颜色\r\n$shadow-light: rgba(0,0,0,0.05); // 轻度阴影\r\n$shadow-medium: rgba(0,0,0,0.1); // 中度阴影\r\n$text-color-dark: #2d2d2a;\r\n$text-color-medium: #6a6a66;\r\n$success-color: #67c23a; // Element UI 成功色\r\n$info-color: #909399; // Element UI 信息色\r\n\r\n// 从 dress-up-container 复制过来的顶层容器样式\r\n.dress-up-container {\r\n    padding: 30px;\r\n    max-width: 1400px;\r\n    margin: 0 auto;\r\n    background-color: $bg-color-light;\r\n    min-height: calc(100vh - 120px);\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 30px;\r\n}\r\n\r\n// 页面级别的 Section Header 样式 (与 DressUp 页面保持一致)\r\n.section-header {\r\n    margin-bottom: 20px;\r\n    position: relative;\r\n\r\n    .page-title {\r\n        font-size: 28px;\r\n        color: $text-color-dark;\r\n        margin: 0 0 8px 0;\r\n        font-weight: 600;\r\n        letter-spacing: 1px;\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 10px;\r\n    }\r\n\r\n    .page-subtitle {\r\n        font-size: 16px;\r\n        color: $text-color-medium;\r\n        margin: 0 0 15px 0;\r\n    }\r\n\r\n    .divider {\r\n        height: 3px;\r\n        width: 80px;\r\n        background-color: $primary-color;\r\n        border-radius: 2px;\r\n        transition: width 0.3s ease;\r\n\r\n        &:hover {\r\n            width: 120px;\r\n        }\r\n    }\r\n}\r\n\r\n// 统一的卡片样式\r\n.section-card {\r\n    background: #fff;\r\n    border-radius: 12px;\r\n    box-shadow: 0 4px 12px $shadow-light;\r\n    padding: 24px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    flex: 1;\r\n}\r\n\r\n.card-title {\r\n    font-size: 20px;\r\n    color: $text-color-dark;\r\n    font-weight: 500;\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    margin-bottom: 15px;\r\n    padding-bottom: 10px;\r\n    border-bottom: 1px dashed #eee;\r\n\r\n    i {\r\n        color: $primary-color;\r\n    }\r\n}\r\n\r\n// 消息中心页面的特定布局\r\n.user-message-page-wrapper {\r\n    // 覆盖原页面的背景色，使用统一的 bg-color-light\r\n    background: $bg-color-light;\r\n    padding: 30px; // 保持与 dress-up-container 一致的 padding\r\n}\r\n\r\n.main-content-message {\r\n    display: flex;\r\n    gap: 30px;\r\n    align-items: stretch; // 让两侧高度一致\r\n    flex: 1; // 占据可用空间\r\n\r\n    @media (max-width: 992px) {\r\n        flex-direction: column; // 小屏幕下垂直排列\r\n    }\r\n}\r\n\r\n/* 消息类型卡片 */\r\n.message-type-card {\r\n    flex: 0 0 250px; // 固定宽度\r\n    gap: 15px; // 内部元素间距\r\n\r\n    @media (max-width: 992px) {\r\n        flex: none; // 小屏幕下取消固定宽度\r\n        width: 100%;\r\n    }\r\n\r\n    .message-type-bar {\r\n        display: flex;\r\n        flex-direction: column; // 垂直排列\r\n        gap: 10px; // 类型项间距\r\n        padding-left: 0; // 移除原先的 padding\r\n        margin-top: 5px;\r\n\r\n        .message-type-item {\r\n            display: block; // 让 span 占据整行\r\n            padding: 10px 15px;\r\n            border-radius: 8px;\r\n            font-size: 16px;\r\n            color: $text-color-dark;\r\n            cursor: pointer;\r\n            transition: all 0.2s ease;\r\n            font-weight: 400; // 默认不加粗\r\n\r\n            &:hover {\r\n                background-color: #f5f5f5;\r\n                color: $primary-color;\r\n            }\r\n        }\r\n\r\n        .message-type-item--active {\r\n            background-color: #fffaf0; // 选中状态的背景色\r\n            color: $primary-color;\r\n            font-weight: 600; // 选中状态加粗\r\n            position: relative;\r\n            // 可以在这里添加一个左侧指示条\r\n            &::before {\r\n                content: '';\r\n                position: absolute;\r\n                left: 0;\r\n                top: 50%;\r\n                transform: translateY(-50%);\r\n                width: 4px;\r\n                height: 70%;\r\n                background-color: $primary-color;\r\n                border-radius: 2px;\r\n            }\r\n        }\r\n    }\r\n\r\n    .clear-all-messages {\r\n        margin-top: auto; // 将按钮推到卡片底部\r\n        padding-top: 15px; // 增加与上方内容的间距\r\n        border-top: 1px dashed #eee;\r\n\r\n        .el-button {\r\n            width: 100%;\r\n            // Element UI 按钮样式覆盖\r\n            background-color: $info-color;\r\n            border-color: $info-color;\r\n            color: #fff;\r\n            &:hover {\r\n                background-color: darken($info-color, 8%);\r\n                border-color: darken($info-color, 8%);\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n/* 消息列表区域 */\r\n.message-list-section {\r\n    flex: 3; // 占据大部分空间\r\n    gap: 15px; // 消息项之间的间距\r\n\r\n    .empty-message-list {\r\n        padding: 50px 0;\r\n        .el-empty {\r\n            padding: 0;\r\n        }\r\n    }\r\n\r\n    .message-items-list {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 15px;\r\n    }\r\n\r\n    .message-item-card {\r\n        padding: 18px 24px;\r\n        border-radius: 10px;\r\n        border: 1px solid $border-color;\r\n        background: #fff; // 默认白色背景\r\n        transition: all 0.3s ease;\r\n        cursor: pointer; // 消息项可点击\r\n        box-shadow: 0 2px 8px $shadow-light;\r\n\r\n        &:hover {\r\n            transform: translateY(-3px);\r\n            box-shadow: 0 4px 12px $shadow-medium;\r\n        }\r\n    }\r\n\r\n    .message-item-unread {\r\n        background: #fffaf0; // 未读消息背景色\r\n        border-color: lighten($primary-color, 20%); // 未读消息边框色\r\n        .message-item-header .message-content-wrapper .message-title-text {\r\n             font-weight: 600; // 未读消息标题加粗\r\n             color: $text-color-dark;\r\n        }\r\n    }\r\n\r\n    .message-item-header {\r\n        display: flex;\r\n        align-items: flex-start; // 顶部对齐\r\n        gap: 15px;\r\n    }\r\n\r\n    .message-icon-wrapper {\r\n        flex-shrink: 0; // 不压缩图标\r\n        width: 48px;\r\n        height: 48px;\r\n        border-radius: 50%;\r\n        display: flex;\r\n        justify-content: center;\r\n        align-items: center;\r\n        background-color: lighten($primary-color, 45%); // 浅金色背景\r\n        border: 2px solid lighten($primary-color, 35%); // 浅金色边框\r\n\r\n        .sender-avatar {\r\n            width: 44px; // 比 wrapper 小一些\r\n            height: 44px;\r\n            border-radius: 50%;\r\n            object-fit: cover;\r\n        }\r\n\r\n        i {\r\n            font-size: 24px;\r\n            color: $primary-color; // 图标颜色\r\n        }\r\n    }\r\n\r\n    .message-content-wrapper {\r\n        flex: 1;\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 5px;\r\n    }\r\n\r\n    .message-main-info {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 4px;\r\n    }\r\n\r\n    .message-sender-name {\r\n        font-size: 16px;\r\n        font-weight: 600;\r\n        color: $text-color-dark;\r\n    }\r\n\r\n    .message-title-text {\r\n        font-size: 14px;\r\n        color: $text-color-medium;\r\n        line-height: 1.5;\r\n    }\r\n\r\n    .message-actions-time {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 15px;\r\n        margin-top: 8px; // 与内容区的间距\r\n    }\r\n\r\n    .message-time {\r\n        font-size: 12px;\r\n        color: $text-color-medium;\r\n    }\r\n\r\n    .reply-btn {\r\n        color: $primary-color; // 回复按钮使用主题色\r\n        font-size: 12px;\r\n        padding: 0; // 移除默认 Element Text 按钮的 padding\r\n        height: auto;\r\n        &:hover {\r\n            text-decoration: underline;\r\n        }\r\n    }\r\n}\r\n\r\n\r\n/* Element UI 组件的微调，使其与整体风格更协调 */\r\n::v-deep {\r\n    // 覆盖 Swal 样式\r\n    .my-swal-popup {\r\n        border-radius: 12px !important;\r\n        box-shadow: 0 8px 24px rgba(0,0,0,0.1) !important;\r\n    }\r\n    .my-swal-title {\r\n        color: $text-color-dark !important;\r\n        font-size: 20px !important;\r\n        font-weight: 600 !important;\r\n    }\r\n    .my-swal-text {\r\n        color: $text-color-medium !important;\r\n        font-size: 16px !important;\r\n    }\r\n    .my-swal-input {\r\n        border-color: $border-color !important;\r\n        &:focus {\r\n            border-color: $primary-color !important;\r\n            box-shadow: 0 0 0 2px rgba($primary-color, 0.2) !important;\r\n        }\r\n    }\r\n    .my-swal-confirm-button {\r\n        background-color: $primary-color !important;\r\n        border-color: $primary-color !important;\r\n        &:hover {\r\n            background-color: darken($primary-color, 8%) !important;\r\n            border-color: darken($primary-color, 8%) !important;\r\n        }\r\n    }\r\n    .my-swal-cancel-button {\r\n        background-color: $info-color !important;\r\n        border-color: $info-color !important;\r\n        &:hover {\r\n            background-color: darken($info-color, 8%) !important;\r\n            border-color: darken($info-color, 8%) !important;\r\n        }\r\n    }\r\n}\r\n\r\n\r\n/* 响应式调整 */\r\n@media (max-width: 992px) {\r\n    .dress-up-container {\r\n        padding: 20px;\r\n        gap: 20px;\r\n    }\r\n    .main-content-message {\r\n        flex-direction: column;\r\n        gap: 20px;\r\n    }\r\n    .message-type-card {\r\n        flex: none;\r\n        width: 100%;\r\n        .message-type-bar {\r\n            flex-direction: row; // 小屏幕下横向排列\r\n            flex-wrap: wrap; // 允许换行\r\n            justify-content: center;\r\n            .message-type-item {\r\n                flex: 1 1 auto; // 自适应宽度\r\n                max-width: 30%; // 限制最大宽度，每行3个左右\r\n                text-align: center;\r\n                &:before { // 小屏幕下移除左侧指示条\r\n                    display: none;\r\n                }\r\n            }\r\n        }\r\n        .clear-all-messages {\r\n            margin-top: 20px;\r\n        }\r\n    }\r\n    .message-list-section {\r\n        flex: none;\r\n        width: 100%;\r\n    }\r\n    .message-item-card {\r\n        padding: 15px 20px;\r\n    }\r\n    .message-icon-wrapper {\r\n        width: 40px;\r\n        height: 40px;\r\n        .sender-avatar {\r\n            width: 36px;\r\n            height: 36px;\r\n        }\r\n        i {\r\n            font-size: 20px;\r\n        }\r\n    }\r\n    .message-sender-name {\r\n        font-size: 15px;\r\n    }\r\n    .message-title-text {\r\n        font-size: 13px;\r\n    }\r\n    .message-time {\r\n        font-size: 11px;\r\n    }\r\n}\r\n\r\n@media (max-width: 600px) {\r\n    .dress-up-container {\r\n        padding: 15px;\r\n    }\r\n    .section-header {\r\n        .page-title {\r\n            font-size: 24px;\r\n        }\r\n        .page-subtitle {\r\n            font-size: 14px;\r\n        }\r\n    }\r\n    .card-title {\r\n        font-size: 18px;\r\n    }\r\n    .message-type-card .message-type-bar .message-type-item {\r\n        max-width: 45%; // 每行2个\r\n    }\r\n    .message-item-card {\r\n        padding: 12px 15px;\r\n    }\r\n    .message-item-header {\r\n        gap: 10px;\r\n    }\r\n    .message-icon-wrapper {\r\n        width: 36px;\r\n        height: 36px;\r\n        .sender-avatar {\r\n            width: 32px;\r\n            height: 32px;\r\n        }\r\n        i {\r\n            font-size: 18px;\r\n        }\r\n    }\r\n    .message-sender-name {\r\n        font-size: 14px;\r\n    }\r\n    .message-title-text {\r\n        font-size: 12px;\r\n    }\r\n    .message-actions-time {\r\n        gap: 10px;\r\n    }\r\n}\r\n</style>"]}]}