{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\Message.vue?vue&type=style&index=0&id=5d22e93d&scoped=true&lang=scss","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\Message.vue","mtime":1753376948392},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\css-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\postcss-loader\\src\\index.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\sass-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Message.vue"],"names":[],"mappings":";AAiPA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Message.vue","sourceRoot":"src/views/user","sourcesContent":["<template>\r\n    <div class=\"user-message-page\">\r\n        <div style=\"padding: 4px 50px;\">\r\n            <el-card class=\"banner-card message-banner-card\">\r\n                <div class=\"message-header-row\">\r\n                    <span class=\"main-title\">消息中心</span>\r\n                    <el-button class=\"plain-black-btn clear-message-btn\" @click=\"clearMessage\">\r\n                        <i class=\"el-icon-s-open\"></i> 清空\r\n                    </el-button>\r\n                </div>\r\n            </el-card>\r\n            <div>\r\n                <div class=\"message-type-bar\">\r\n                    <span\r\n                        :class=\"['message-type', { 'message-type--active': messageTypeItem === messageType.type }]\"\r\n                        @click=\"messageTypeSelected(messageType.type)\"\r\n                        v-for=\"(messageType, index) in filteredMessageTypes\"\r\n                        :key=\"index\"\r\n                    >\r\n                        {{ messageType.detail }}\r\n                    </span>\r\n                </div>\r\n            </div>\r\n            <div style=\"padding: 30px 0;\">\r\n                <el-card class=\"message-list-card\">\r\n                    <div v-if=\"filteredMessageList.length === 0\">\r\n                        <el-empty description=\"暂无消息\"></el-empty>\r\n                    </div>\r\n                    <div v-else>\r\n                        <div\r\n                            class=\"message-item-card\"\r\n                            :class=\"{ 'message-item-unread': !message.isRead }\"\r\n                            v-for=\"(message, index) in filteredMessageList\"\r\n                            :key=\"index\"\r\n                        >\r\n                            <el-row class=\"message-item-row\">\r\n                             <div>\r\n                                <span class=\"bell-icon\">\r\n                                    <span v-if=\"message.messageType === 1 || message.messageType === 2\">\r\n                                        <img style=\"width: 40px;height: 40px;border-radius: 20px;\"\r\n                                            :src=\"message.senderAvatar\" alt=\"\" srcset=\"\">\r\n                                    </span>\r\n                                    <i v-if=\"message.messageType === 3\" class=\"el-icon-data-analysis\"></i>\r\n                                </span>\r\n                              </div>\r\n                              <div>\r\n                                <div>\r\n                                    <div v-if=\"message.messageType === 1 || message.messageType === 2\">\r\n                                        <div style=\"font-size: 18px;\">\r\n                                            {{ message.senderName }}\r\n                                        </div>\r\n                                    </div>\r\n                                    <div style=\"font-size: 18px;\">\r\n                                        <span class=\"message-content\" v-if=\"message.messageType === 1\"\r\n                                            style=\"font-size: 14px;\">{{ commentDeal(message.content)[2] }}</span>\r\n                                        <span class=\"message-content\" v-else-if=\"message.messageType === 3\" style=\"font-size: 14px;\">{{ message.content\r\n                                            }}</span>\r\n                                        <span class=\"message-content\" v-else style=\"font-size: 14px;\">点赞了你的评论【{{ message.content\r\n                                            }}】</span>\r\n                                    </div>\r\n                                </div>\r\n                                <div>\r\n                                    <span class=\"message-time\">{{ message.createTime }}</span>\r\n                                    <span @click=\"replyUser(message)\" v-if=\"message.messageType === 1\"\r\n                                        style=\"font-size: 10px;margin-left: 10px;cursor: pointer;\">回复</span>\r\n                                </div>\r\n                              </div>\r\n                            </el-row>\r\n                        </div>\r\n                    </div>\r\n                </el-card>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\n// import Logo from \"@/components/Logo\";\r\nimport Swal from \"sweetalert2\";\r\n\r\nexport default {\r\n    // components: { Logo },\r\n    data() {\r\n        return {\r\n            userInfo: {},\r\n            messageQueryDto: {},\r\n            messageList: [],\r\n            messageTypes: [],\r\n            messageTypeItem: {},\r\n            dialogEvaluationsOperation: false,\r\n            message: {}\r\n        };\r\n    },\r\n    computed: {\r\n        filteredMessageTypes() {\r\n            return this.messageTypes.filter(\r\n                (type) =>\r\n                    type.detail === \"全部消息\" ||\r\n                    type.detail === \"指标提醒\" ||\r\n                    type.detail === \"系统通知\"\r\n            );\r\n        },\r\n        filteredMessageList() {\r\n            return this.messageList.filter(\r\n                (m) => m.messageType === 3 || m.messageType === 4\r\n            );\r\n        }\r\n    },\r\n    created() {\r\n        // 1. 拿到当前用户的信息\r\n        this.getUserInfo();\r\n        // 2. 加载用户全部消息\r\n        this.loadAllUsersMessage();\r\n        // 3. 加载全部的消息类型\r\n        this.loadAllMessageType();\r\n    },\r\n    methods: {\r\n        commentDeal(content) {\r\n            return content.split(\";\");\r\n        },\r\n        // 回复用户\r\n        replyUser(message) {\r\n            Swal.fire({\r\n                title: `回复【${message.senderName}】`,\r\n                input: \"text\",\r\n                inputPlaceholder: \"回复内容\",\r\n                showCancelButton: true,\r\n                confirmButtonText: \"提交\",\r\n                cancelButtonText: \"取消\",\r\n                inputValidator: value => {\r\n                    if (!value) {\r\n                        return \"内容不能为空哦\";\r\n                    } else {\r\n                        this.saveCommentData(\r\n                            message.senderId,\r\n                            value,\r\n                            this.commentDeal(message.content)\r\n                        );\r\n                    }\r\n                }\r\n            }).then(result => {\r\n                console.log(\"操作结果：\", result);\r\n            });\r\n        },\r\n        // 保存回复数据\r\n        saveCommentData(senderId, content, ary) {\r\n            const comment = {\r\n                id: 1,\r\n                content,\r\n                parentId: ary[0],\r\n                contentType: \"NEWS\",\r\n                contentId: ary[1],\r\n                replierId: senderId\r\n            };\r\n            this.$axios\r\n                .post(\"/evaluations/insert\", comment)\r\n                .then(response => {\r\n                    const { data } = response;\r\n                    if (data.code === 200) {\r\n                        this.$notify({\r\n                            title: \"评论回复\",\r\n                            message: \"回复成功\",\r\n                            type: \"success\"\r\n                        });\r\n                    }\r\n                })\r\n                .catch(error => {\r\n                    console.log(\"回复异常：\", error);\r\n                });\r\n        },\r\n        // 将全部的消息设置未已读\r\n        async clearMessage() {\r\n            const confirmed = await this.$swalConfirm({\r\n                title: \"消息清除\",\r\n                text: `是否将全部的消息设置为已读？`,\r\n                icon: \"warning\"\r\n            });\r\n            if (confirmed) {\r\n                this.$axios.put(\"/message/clearMessage\").then(response => {\r\n                    const { data } = response;\r\n                    if (data.code === 200) {\r\n                        this.loadAllUsersMessage();\r\n                    }\r\n                });\r\n            }\r\n        },\r\n        evaluationsPut() {\r\n            this.$axios.put(\"/message/clearMessage\").then(response => {\r\n                const { data } = response;\r\n                if (data.code === 200) {\r\n                    this.loadAllUsersMessage();\r\n                }\r\n            });\r\n        },\r\n        // 做回复的\r\n        replyEvalustions(message) {\r\n            this.message = message;\r\n            this.dialogEvaluationsOperation = true;\r\n        },\r\n        // 消息类型选中\r\n        messageTypeSelected(messageType) {\r\n            this.messageTypeItem = messageType;\r\n            this.messageQueryDto.messageType = messageType;\r\n            // 如果是评论数据，需要额外处理\r\n            this.loadAllUsersMessage();\r\n        },\r\n        getUserInfo() {\r\n            const userInfo = sessionStorage.getItem(\"userInfo\");\r\n            this.userInfo = JSON.parse(userInfo);\r\n        },\r\n        // 加载全部的消息类型\r\n        loadAllMessageType() {\r\n            this.$axios.get(\"/message/types\").then(response => {\r\n                const { data } = response;\r\n                if (data.code === 200) {\r\n                    this.messageTypes = data.data;\r\n                    const messageType = { type: null, detail: \"全部消息\" };\r\n                    this.messageTypes.unshift(messageType);\r\n                    this.messageTypes.map(entity => (entity.isCheck = false));\r\n                    this.messageTypeSelected(this.messageTypes[0].type);\r\n                }\r\n            });\r\n        },\r\n        loadAllUsersMessage() {\r\n            const userInfo = sessionStorage.getItem(\"userInfo\");\r\n            const entity = JSON.parse(userInfo);\r\n            this.messageQueryDto.userId = entity.id;\r\n            this.$axios\r\n                .post(\"/message/query\", this.messageQueryDto)\r\n                .then(response => {\r\n                    const { data } = response;\r\n                    if (data.code === 200) {\r\n                        this.messageList = data.data;\r\n                    }\r\n                });\r\n        }\r\n    }\r\n};\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n.user-message-page {\r\n    background: linear-gradient(120deg, #e6f9ec 0%, #fafdff 100%);\r\n    min-height: 100vh;\r\n    padding: 32px 0 40px 0;\r\n}\r\n.header-divider {\r\n    height: 4px;\r\n    background: #e6f9ec;\r\n    margin: 0 0 32px 0;\r\n    width: 100%;\r\n}\r\n.banner-card.message-banner-card {\r\n    background: linear-gradient(120deg, #e6f9ec 0%, #fafdff 100%);\r\n    border: none;\r\n    box-shadow: 0 2px 8px rgba(43, 121, 203, 0.08);\r\n    margin-bottom: 18px;\r\n    border-radius: 12px;\r\n    padding: 18px 32px 12px 32px;\r\n}\r\n.main-title {\r\n    font-size: 1.5rem;\r\n    font-weight: 700;\r\n    color: #2bcba8;\r\n}\r\n.user-info-bar {\r\n    float: right;\r\n    display: flex;\r\n    align-items: center;\r\n    flex-wrap: wrap;\r\n}\r\n.user-avatar {\r\n    width: 30px;\r\n    height: 30px;\r\n    border-radius: 15px;\r\n}\r\n.user-name {\r\n    margin-left: 8px;\r\n    font-size: 1.1rem;\r\n    color: #333;\r\n}\r\n.message-header-row {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n}\r\n.plain-black-btn.clear-message-btn {\r\n    background: #fff !important;\r\n    color: #222 !important;\r\n    border-radius: 18px !important;\r\n    border: 1px solid #e0e0e0 !important;\r\n    font-weight: 500;\r\n    transition: background 0.2s;\r\n    font-size: 1rem;\r\n    padding: 6px 18px;\r\n}\r\n.plain-black-btn.clear-message-btn:hover {\r\n    background: #f5f5f5 !important;\r\n    color: #111 !important;\r\n}\r\n.message-type-bar {\r\n    display: flex;\r\n    gap: 24px;\r\n    margin: 18px 0 0 0;\r\n    padding-left: 8px;\r\n}\r\n.message-type {\r\n    display: inline-block;\r\n    border-bottom: 4px solid transparent;\r\n    padding-bottom: 6px;\r\n    font-size: 1.1rem;\r\n    color: #333;\r\n    cursor: pointer;\r\n    font-weight: 500;\r\n    transition: border 0.2s, color 0.2s;\r\n}\r\n.message-type--active {\r\n    border-bottom: 4px solid #2bcba8;\r\n    color: #2bcba8;\r\n}\r\n.message-list-card {\r\n    border-radius: 12px;\r\n    box-shadow: 0 2px 8px rgba(43, 121, 203, 0.06);\r\n    background: #fff;\r\n    border: none;\r\n    padding: 24px 32px 18px 32px;\r\n}\r\n.message-item-card {\r\n    margin-bottom: 12px;\r\n    padding: 18px 24px;\r\n    border-radius: 10px;\r\n    border: 1px solid #e0e0e0;\r\n    background: #fafafa;\r\n    transition: background 0.2s;\r\n}\r\n.message-item-unread {\r\n    background: #e6f9ec;\r\n}\r\n.message-item-row {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 18px;\r\n}\r\n.message-item-content {\r\n    flex: 1;\r\n}\r\n.message-item-title {\r\n    font-size: 1.1rem;\r\n    font-weight: 600;\r\n    color: #222;\r\n    margin-bottom: 6px;\r\n}\r\n.bell-icon {\r\n    display: inline-block;\r\n    height: 50px;\r\n    width: 50px;\r\n    border-radius: 25px;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    background-color: rgb(106, 190, 238);\r\n    border: 3px solid rgb(92, 172, 219);\r\n\r\n    i {\r\n        line-height: 30px;\r\n        width: 30px;\r\n        text-align: center;\r\n        font-size: 25px;\r\n        color: #f1f1f1;\r\n    }\r\n}\r\n\r\n.message-time {\r\n    font-size: 12px;\r\n    color: rgb(131, 104, 102);\r\n}\r\n\r\n.clear-message {\r\n    display: inline-block;\r\n    margin-left: 10px;\r\n    padding: 6px 12px;\r\n    border-radius: 5px;\r\n}\r\n\r\n.clear-message:hover {\r\n    background-color: #f1f1f1;\r\n}\r\n\r\n.news-tags {\r\n    display: inline-block;\r\n    padding: 2px 5px;\r\n    background-color: rgb(222, 243, 251);\r\n    color: #1d3cc4;\r\n    font-size: 14px;\r\n    border-radius: 3px;\r\n}\r\n</style>"]}]}