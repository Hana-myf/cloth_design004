r\n                </el-button>\r\n            </div>\r\n        </div>\r\n        <div class=\"chart-row pie-charts\">\r\n            <div class=\"chart-card\">\r\n                <PieChart \r\n                    tag=\"作品统计\" \r\n                    chartType=\"dept\" \r\n                    bag=\"#f5f7fa\" \r\n                    fontColor=\"#333\"\r\n                    height=\"320px\"\r\n                />\r\n            </div>\r\n            <div class=\"chart-card\">\r\n                <PieChart \r\n                    tag=\"用户统计\" \r\n                    chartType=\"user\" \r\n                    bag=\"#f5f7fa\" \r\n                    fontColor=\"#333\"\r\n                    height=\"320px\"\r\n                />\r\n            </div>\r\n        </div>\r\n        <div class=\"chart-row line-charts\">\r\n            <div class=\"chart-card\">\r\n                <LineChart \r\n                    tag=\"数量趋势\" \r\n                    chartType=\"conference\" \r\n                    height=\"320px\"\r\n                />\r\n            </div>\r\n            <div class=\"chart-card\">\r\n                <LineChart \r\n                    tag=\"新闻趋势\" \r\n                    chartType=\"news\" \r\n                    height=\"320px\"\r\n                />\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\n// 引入图表组件\r\nimport PieChart from '@/components/PieChart.vue';\r\nimport LineChart from '@/components/LineChart.vue';\r\n\r\nexport default {\r\n    name: \"Main\",\r\n    components: {\r\n        PieChart,\r\n        LineChart\r\n    },\r\n    data() {\r\n        return {\r\n            // 页面状态\r\n            loading: false\r\n        }\r\n    },\r\n    created() {\r\n        // 页面初始化逻辑\r\n    },\r\n    methods: {\r\n        // 刷新数据方法\r\n        refreshData() {\r\n            this.loading = true;\r\n            // 模拟数据刷新延迟\r\n            setTimeout(() => {\r\n                this.loading = false;\r\n                this.$message.success('数据刷新成功');\r\n            }, 800);\r\n        }\r\n    }\r\n};\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n.dashboard-container {\r\n    padding: 20px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 20px;\r\n}\r\n\r\n.dashboard-header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    margin-bottom: 20px;\r\n    \r\n    .dashboard-title {\r\n        font-size: 20px;\r\n        font-weight: bold;\r\n        color: #333;\r\n    }\r\n    \r\n    .dashboard-actions {\r\n        display: flex;\r\n        gap: 10px;\r\n    }\r\n}\r\n\r\n.chart-row {\r\n    display: flex;\r\n    gap: 20px;\r\n    margin-bottom: 20px;\r\n    \r\n    /* 响应式布局 - 小屏幕下堆叠显示 */\r\n    @media (max-width: 1024px) {\r\n        flex-direction: column;\r\n    }\r\n    \r\n    /* 饼图行 - 调整列宽 */\r\n    &.pie-charts {\r\n        .chart-card {\r\n            flex: 1;\r\n        }\r\n    }\r\n    \r\n    /* 折线图行 - 调整列宽 */\r\n    &.line-charts {\r\n        .chart-card {\r\n            flex: 1;\r\n        }\r\n    }\r\n}\r\n\r\n.chart-card {\r\n    border-radius: 8px;\r\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\r\n    overflow: hidden;\r\n    background-color: #fff;\r\n    transition: transform 0.3s ease;\r\n    \r\n    &:hover {\r\n        transform: translateY(-5px);\r\n    }\r\n}\r\n\r\n/* 优化图表容器样式 */\r\n.pie-main {\r\n    padding: 10px;\r\n}\r\n\r\n.line-main {\r\n    padding: 10px;\r\n}\r\n</style>"]}]}