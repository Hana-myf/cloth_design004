{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\DetailOptimization.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\views\\user\\DetailOptimization.vue","mtime":1757506932648},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\babel-loader\\lib\\index.js","mtime":315532800000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["DetailOptimization.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAmIA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA","file":"DetailOptimization.vue","sourceRoot":"src/views/user","sourcesContent":["<template>\r\n  <div class=\"detail-optimization\">\r\n    <!-- 页面标题 -->\r\n    <div class=\"page-header\">\r\n      <h1>细节优化工具</h1>\r\n      <p>上传图片 → 选择素材 → 生成方案</p>\r\n    </div>\r\n\r\n    <!-- 主布局：左（工具）- 中（交互）- 右（成果） -->\r\n    <div class=\"main-layout\">\r\n      <!-- 左侧工具区：包含面料库和色彩提取器 -->\r\n      <div class=\"tools-area\">\r\n        <div class=\"tools-title\">设计工具</div>\r\n        \r\n        <!-- 面料库组件 -->\r\n        <fabric-library \r\n          @select=\"onFabricSelect\" \r\n           class=\"tool-component fabric-component\"\r\n        ></fabric-library>\r\n\r\n        <color-extractor \r\n          @apply-colors=\"onColorsApplied\"\r\n          class=\"tool-component color-component\"\r\n        ></color-extractor>\r\n        \r\n        <!-- 搭配助手仍为占位 -->\r\n          <CollocationAssistant\r\n           class=\"tool-component assistant-component\"\r\n          ></CollocationAssistant>\r\n      </div>\r\n\r\n      <!-- 中间交互区：与AI对话 -->\r\n      <div class=\"interaction-area\">\r\n        <div class=\"interaction-title\">AI设计对话</div>\r\n        \r\n        <!-- 对话内容区 -->\r\n        <div class=\"chat-content\">\r\n          <!-- 系统提示 -->\r\n          <div class=\"system-message\">\r\n            请上传参考图片、选择面料或输入描述，我会生成设计方案\r\n          </div>\r\n          \r\n          <!-- 对话记录 -->\r\n          <div v-for=\"(msg, index) in chatRecords\" :key=\"index\" class=\"chat-bubble\">\r\n            <div class=\"bubble-avatar\">{{ msg.role === 'user' ? '我' : 'AI' }}</div>\r\n            <div class=\"bubble-content\">\r\n              <!-- 用户消息：可能包含选择的面料或色彩 -->\r\n              <template v-if=\"msg.role === 'user'\">\r\n                <div v-if=\"msg.fabric\" class=\"selected-fabric-tag\">\r\n                  已选择面料：{{ msg.fabric.name }}（{{ msg.fabric.type }}）\r\n                </div>\r\n                <div v-if=\"msg.colors\" class=\"selected-colors\">\r\n                  <span class=\"tag\">已选择色彩：</span>\r\n                  <div class=\"color-swatch-container\">\r\n                    <div \r\n                      v-for=\"(color, cIndex) in msg.colors\" \r\n                      :key=\"cIndex\"\r\n                      class=\"color-swatch\"\r\n                      :style=\"{ backgroundColor: color.hex }\"\r\n                      :title=\"color.hex\"\r\n                    ></div>\r\n                  </div>\r\n                </div>\r\n                <p v-if=\"msg.text\">{{ msg.text }}</p>\r\n                <div v-if=\"msg.imageUrl\" class=\"user-image\">\r\n                  <img :src=\"msg.imageUrl\" alt=\"用户上传图片\">\r\n                </div>\r\n              </template>\r\n              \r\n              <!-- AI消息：生成的方案 -->\r\n              <template v-if=\"msg.role === 'ai'\">\r\n                <p v-if=\"msg.text\">{{ msg.text }}</p>\r\n                <div v-if=\"msg.imageUrl\" class=\"ai-image\">\r\n                  <img :src=\"msg.imageUrl\" alt=\"AI生成方案\" @click=\"saveToGallery(msg.imageUrl, msg.title)\">\r\n                  <div class=\"image-action\">点击保存到右侧成果库</div>\r\n                </div>\r\n              </template>\r\n            </div>\r\n          </div>\r\n          \r\n          <!-- 加载中提示 -->\r\n          <div v-if=\"isLoading\" class=\"loading\">\r\n            <div class=\"custom-spinner\"></div>\r\n            <p>加载中...</p>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 输入区 -->\r\n        <div class=\"input-area\">\r\n          <!-- 新增：上传图片按钮 -->\r\n          <div class=\"upload-container\">\r\n            <el-upload\r\n              class=\"image-uploader\"\r\n              action=\"\"\r\n              :auto-upload=\"false\"\r\n              :on-change=\"handleImageUpload\"\r\n              :show-file-list=\"false\"\r\n              accept=\"image/*\"\r\n            >\r\n              <el-button type=\"primary\" icon=\"el-icon-upload\">上传图片</el-button>\r\n            </el-upload>\r\n          </div>\r\n          \r\n          <el-input \r\n            v-model=\"userInput\" \r\n            placeholder=\"输入设计需求...\" \r\n            class=\"text-input\"\r\n          ></el-input>\r\n          <el-button \r\n            type=\"primary\" \r\n            @click=\"sendMessage\"\r\n            class=\"send-btn\"\r\n            :disabled=\"!canSendMessage\"\r\n          >\r\n            发送\r\n          </el-button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 右侧成果区：保存生成的图片 -->\r\n      <div class=\"gallery-area\">\r\n        <div class=\"gallery-title\">我的成果库</div>\r\n        <image-save-list \r\n          :saved-images=\"savedImages\"\r\n        ></image-save-list>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n// 1. 新增：引入 OpenAI SDK\r\nimport OpenAI from 'openai';\r\nimport axios from 'axios';\r\n\r\n// 引入组件（保持不变）\r\nimport FabricLibrary from '@/components/FabricLibrary.vue';\r\nimport ImageSaveList from '@/components/ImageSaveList.vue';\r\nimport ColorExtractor from '@/components/ColorExtractor.vue';\r\nimport CollocationAssistant from '@/components/CollocationAssistant.vue';\r\nimport DirectModelCall from '@/components/DirectModelCall.vue';\r\n\r\nexport default {\r\n  components: {\r\n    FabricLibrary,\r\n    ImageSaveList,\r\n    ColorExtractor,\r\n    CollocationAssistant,\r\n    DirectModelCall\r\n  },\r\n  data() {\r\n    return {\r\n      // 对话记录（保持不变）\r\n      chatRecords: [],\r\n      // 用户输入文本（保持不变）\r\n      userInput: '',\r\n      // 保存的成果图片（保持不变）\r\n      savedImages: [],\r\n      // 加载状态（保持不变）\r\n      isLoading: false,\r\n      // 当前选中的面料（未发送状态）（保持不变）\r\n      currentFabric: null,\r\n      // 当前选中的颜色（未发送状态）（保持不变）\r\n      currentColors: null,\r\n      // 当前上传的图片（未发送状态）（保持不变）\r\n      currentImageUrl: null,\r\n      // 模型配置（保留原结构，新增 OpenAI 客户端初始化）\r\n      apiConfig: {\r\n        url: 'https://ark.cn-beijing.volces.com/api/v3/images/generations',\r\n        apiKey: 'f2390958-8c5a-424a-9021-651e920c2bc4',\r\n        model: 'doubao-seededit-3-0-i2i-250628'\r\n      },\r\n      // 2. 新增：OpenAI 客户端实例（用于调用模型）\r\n      openai: new OpenAI({\r\n        apiKey: 'f2390958-8c5a-424a-9021-651e920c2bc4', // 你的 API Key\r\n        baseURL: 'https://ark.cn-beijing.volces.com/api/v3', // 火山方舟接口地址（兼容 OpenAI 协议）\r\n        timeout: 30000 // 超时时间（生成图片耗时较长，设为30秒）\r\n      }),\r\n      useDirectCall: true, // 开关：true=前端直连，false=后端代理（保持不变）\r\n      directModelInstance: null // 组件实例引用（保持不变）\r\n    };\r\n  },\r\n  computed: {\r\n    // 判断是否可以发送消息（保持不变）\r\n    canSendMessage() {\r\n      return this.userInput.trim() !== '' || \r\n             this.currentFabric !== null || \r\n             this.currentColors !== null ||\r\n             this.currentImageUrl !== null;\r\n    }\r\n  },\r\n  methods: {\r\n    initDirectModelCall() {\r\n      this.directModelInstance = this.$refs.directModel;\r\n    },\r\n\r\n    // 接收面料库选择的面料（保持不变）\r\n    onFabricSelect(fabric) {\r\n      this.currentFabric = fabric;\r\n      if (this.userInput.trim()) {\r\n        this.userInput += `，使用【${fabric.name}】面料`;\r\n      } else {\r\n        this.userInput = `使用【${fabric.name}】面料`;\r\n      }\r\n      this.$message.success(`已选择面料：${fabric.name}`);\r\n    },\r\n\r\n    // 接收色彩提取器应用的色彩（保持不变）\r\n    onColorsApplied(colors) {\r\n      const displayColors = colors.slice(0, 4);\r\n      this.currentColors = displayColors;\r\n      const colorHexList = displayColors.map(c => c.hex).join('、');\r\n      if (this.userInput.trim()) {\r\n        this.userInput += `，使用颜色：${colorHexList}`;\r\n      } else {\r\n        this.userInput = `使用颜色：${colorHexList}`;\r\n      }\r\n      this.$message.success('已选择色彩方案');\r\n    },\r\n\r\n    // 处理图片上传（保持不变）\r\n    async handleImageUpload(file) {\r\n      this.isLoading = true;\r\n      try {\r\n        const formData = new FormData();\r\n        formData.append('file', file.raw);\r\n        const response = await this.$axios.post('/file/upload', formData, {\r\n          headers: {\r\n            'Content-Type': 'multipart/form-data'\r\n          }\r\n        });\r\n        if (response.data.code === 200) {\r\n          this.currentImageUrl = response.data.data;\r\n          this.$message.success('图片上传成功，可用于生成设计方案');\r\n        } else {\r\n          this.$message.error(response.data.msg || '图片上传失败');\r\n        }\r\n      } catch (error) {\r\n        console.error('上传接口调用失败：', error);\r\n        this.$message.error('网络错误，上传失败');\r\n      } finally {\r\n        this.isLoading = false;\r\n      }\r\n    },\r\n\r\n    // 发送用户消息（保持不变，仅调用的模型方法名修改）\r\n    sendMessage() {\r\n      if (!this.canSendMessage) return;\r\n      \r\n      const userMessage = {\r\n        role: 'user',\r\n        text: this.userInput,\r\n        fabric: this.currentFabric,\r\n        colors: this.currentColors,\r\n        imageUrl: this.currentImageUrl\r\n      };\r\n      \r\n      this.chatRecords.push(userMessage);\r\n      \r\n      // 3. 修改：调用 SDK 版本的模型方法（替代原后端代理调用）\r\n      this.generateAIResponseWithSDK({\r\n        fabric: this.currentFabric,\r\n        colors: this.currentColors,\r\n        image: this.currentImageUrl,\r\n        prompt: this.userInput\r\n      });\r\n      \r\n      this.userInput = '';\r\n      this.currentFabric = null;\r\n      this.currentColors = null;\r\n      this.currentImageUrl = null;\r\n    },\r\n\r\n    /**\r\n     * 4. 新增：使用 OpenAI SDK 调用模型（核心修改点）\r\n     * 逻辑与原 generateAIResponse 一致，仅将“后端接口请求”替换为“SDK 调用”\r\n     */\r\n    async generateAIResponseWithSDK({ fabric, colors, image, prompt }) {\r\n      this.isLoading = true;\r\n      try {\r\n        // 构建完整 prompt（逻辑完全不变）\r\n        let fullPrompt = prompt || '';\r\n        if (fabric) fullPrompt += ` 使用【${fabric.name}】面料（${fabric.type}）`;\r\n        if (colors) {\r\n          const colorHexList = colors.map(c => c.hex).join('、');\r\n          fullPrompt += ` 搭配颜色：${colorHexList}`;\r\n        }\r\n        if (!fullPrompt.trim()) fullPrompt = \"根据提供的素材生成设计方案\";\r\n\r\n        // 处理图片 URL（逻辑完全不变）\r\n        let imageUrl = image;\r\n        if (imageUrl && imageUrl.startsWith('data:image/')) {\r\n          imageUrl = 'https://ark-project.tos-cn-beijing.volces.com/doc_image/seededit_i2i.jpeg';\r\n          this.$message.warning('本地图片暂不支持，已使用示例图片替代');\r\n        }\r\n        const finalImageUrl = imageUrl || 'https://ark-project.tos-cn-beijing.volces.com/doc_image/seededit_i2i.jpeg';\r\n\r\n        // 5. 核心替换：用 SDK 调用替代 axios 后端请求\r\n        const response = await this.openai.images.generate({\r\n          model: this.apiConfig.model, // 从原配置中读取模型名（保持统一）\r\n          prompt: fullPrompt, // 构建好的完整提示词\r\n          image: finalImageUrl, // 参考图片 URL（i2i 模型必需）\r\n          size: '1024x1024', // 生成图片尺寸\r\n          response_format: 'url', // 返回图片 URL（而非 base64）\r\n          guidance_scale: 5.5, // 引导强度（与原参数一致）\r\n          seed: Math.floor(Math.random() * 1000), // 随机种子（与原逻辑一致）\r\n          watermark: true // 添加水印\r\n        });\r\n\r\n        // 解析响应（逻辑与原方法一致）\r\n        if (!response.data || response.data.length === 0) {\r\n          throw new Error('模型返回为空，未生成图片');\r\n        }\r\n        const generatedImageUrl = response.data[0].url;\r\n        if (!generatedImageUrl) {\r\n          throw new Error('生成的图片 URL 为空');\r\n        }\r\n\r\n        // 构建 AI 响应（逻辑完全不变）\r\n        let responseText = '';\r\n        if (fabric) responseText = `已用【${fabric.name}】面料生成方案：`;\r\n        else if (colors) responseText = `已用指定色彩生成方案：`;\r\n        else if (image) responseText = `已根据图片生成方案：`;\r\n        else responseText = `已根据需求生成方案：`;\r\n\r\n        this.chatRecords.push({\r\n          role: 'ai',\r\n          text: responseText,\r\n          imageUrl: generatedImageUrl,\r\n          title: fabric ? `${fabric.name}设计方案` : \r\n                 colors ? '色彩搭配方案' : 'AI生成方案'\r\n        });\r\n\r\n      } catch (error) {\r\n        // 错误处理（适配 SDK 可能的错误类型，保留原提示风格）\r\n        console.error('SDK 调用失败：', error);\r\n        let errorMsg = '生成失败，请重试';\r\n        \r\n        if (error.message.includes('401')) {\r\n          errorMsg = 'API Key 无效或过期，请检查密钥';\r\n        } else if (error.message.includes('403')) {\r\n          errorMsg = '无权限调用该模型，请确认模型权限';\r\n        } else if (error.message.includes('timeout')) {\r\n          errorMsg = '请求超时，请稍后重试';\r\n        } else if (error.message.includes('404')) {\r\n          errorMsg = '模型不存在，请检查模型ID';\r\n        } else {\r\n          errorMsg = `错误：${error.message || '未知错误'}`;\r\n        }\r\n\r\n        this.chatRecords.push({\r\n          role: 'ai',\r\n          text: errorMsg,\r\n          imageUrl: null\r\n        });\r\n      } finally {\r\n        this.isLoading = false;\r\n      }\r\n    },\r\n\r\n    // 保存图片到成果库（保持不变）\r\n    saveToGallery(imageUrl, title) {\r\n      if (this.savedImages.length >= 4) {\r\n        this.savedImages.shift();\r\n      }\r\n      \r\n      this.savedImages.push({\r\n        imageUrl: imageUrl,\r\n        imageName: title || `方案_${new Date().getTime()}`\r\n      });\r\n      \r\n      this.$message.success('已保存到成果库');\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 原有样式保持不变 */\r\n.detail-optimization {\r\n  padding: 20px;\r\n  background-color: #f9f9f9;\r\n  /* 关键修改：移除min-height: 100vh的强制限制，让内容自然撑开高度 */\r\n  min-height: auto;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.page-header {\r\n  text-align: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.page-header h1 {\r\n  font-size: 24px;\r\n  color: #333;\r\n  margin: 0 0 8px;\r\n}\r\n\r\n.page-header p {\r\n  font-size: 14px;\r\n  color: #666;\r\n  margin: 0;\r\n}\r\n\r\n.main-layout {\r\n  display: grid;\r\n  grid-template-columns: 300px 1fr 300px;\r\n  gap: 20px;\r\n  /* 关键修改：将固定高度改为最小高度，允许内容超出时自然扩展 */\r\n  min-height: calc(100vh - 100px);\r\n  /* 新增：当内容超出视口时，允许页面整体滚动 */\r\n}\r\n\r\n.tools-area {\r\n  background: white;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.05);\r\n  overflow: hidden;\r\n  display: flex;\r\n  flex-direction: column;\r\n  /* 关键修改：工具区使用最小高度而非固定高度，允许内容扩展 */\r\n  min-height: 500px;\r\n}\r\n\r\n.tools-title {\r\n  padding: 16px;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #333;\r\n  border-bottom: 1px solid #eee;\r\n}\r\n\r\n/* 工具组件样式调整 - 增加高度上限，允许更多内容展示 */\r\n.tool-component {\r\n  padding: 16px;\r\n  border-bottom: 1px solid #eee;\r\n  /* 提高最大高度限制 */\r\n  max-height: 500px;\r\n  overflow-y: auto;\r\n}\r\n\r\n/* 面料库组件：增加高度占比 */\r\n.fabric-component {\r\n  max-height: 50%; /* 从40%提高到50% */\r\n  min-height: 300px; /* 提高最小高度 */\r\n}\r\n\r\n/* 色彩提取器组件：增加高度占比 */\r\n.color-component {\r\n  max-height: 50%; /* 从40%提高到50% */\r\n  min-height: 200px; /* 提高最小高度 */\r\n}\r\n\r\n/* 新增色彩选择相关样式 */\r\n.selected-colors {\r\n  margin-bottom: 8px;\r\n  padding: 8px;\r\n  background-color: #fff8e6;\r\n  border-radius: 4px;\r\n}\r\n\r\n.tag {\r\n  font-size: 12px;\r\n  color: #fa8c16;\r\n  font-weight: 500;\r\n}\r\n\r\n.color-swatch-container {\r\n  display: inline-flex;\r\n  margin-left: 8px;\r\n  gap: 4px;\r\n}\r\n\r\n.color-swatch {\r\n  width: 20px;\r\n  height: 20px;\r\n  border-radius: 3px;\r\n  border: 1px solid #eee;\r\n  cursor: pointer;\r\n}\r\n\r\n/* 其他原有样式保持不变 */\r\n.tool-placeholder {\r\n  padding: 20px 16px;\r\n  text-align: center;\r\n  border-bottom: 1px solid #eee;\r\n  background-color: #fafafa;\r\n}\r\n\r\n.placeholder-icon {\r\n  font-size: 24px;\r\n  margin-bottom: 8px;\r\n  color: #999;\r\n}\r\n\r\n.placeholder-text {\r\n  font-size: 14px;\r\n  color: #666;\r\n  margin: 0 0 4px;\r\n}\r\n\r\n.placeholder-desc {\r\n  font-size: 12px;\r\n  color: #ccc;\r\n  margin: 0;\r\n}\r\n\r\n.interaction-area {\r\n  background: white;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.05);\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  /* 关键修改：交互区使用最小高度，允许内容无限扩展 */\r\n 