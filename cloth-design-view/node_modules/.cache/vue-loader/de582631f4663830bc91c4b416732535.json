{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ImageViewer.vue?vue&type=style&index=0&id=5567e6cd&scoped=true&lang=css&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ImageViewer.vue","mtime":1767440098487},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\css-loader\\dist\\cjs.js","mtime":1759332259160},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1759332273372},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\postcss-loader\\src\\index.js","mtime":1759332269050},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":1759332273371}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["ImageViewer.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAqEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA","file":"ImageViewer.vue","sourceRoot":"src/components","sourcesContent":["<template>\r\n  <div class=\"image-viewer\">\r\n    <!-- 图片容器：统一正方形占位 + 图片自适应 -->\r\n    <div class=\"img-placeholder-container\">\r\n      <!-- 已生成图片 -->\r\n      <img \r\n        :src=\"proxyImageUrl\" \r\n        alt=\"AI生成图\"\r\n        class=\"preview-img\"\r\n        v-if=\"proxyImageUrl\"\r\n      >\r\n      <!-- 未生成时的正方形占位符 -->\r\n      <div class=\"img-placeholder\" v-else>\r\n        <div class=\"placeholder-content\">\r\n          <i class=\"el-icon-picture-outline\"></i>\r\n          <p>等待AI生成图片...</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <!-- 保存按钮：匹配chatvue暖色调风格 -->\r\n    <button \r\n      @click=\"saveImage\" \r\n      class=\"save-img-btn\"\r\n      v-if=\"proxyImageUrl\"\r\n    >\r\n      保存图片\r\n    </button>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'ImageViewer',\r\n  props: {\r\n    aiReply: {\r\n      type: String,\r\n      default: ''\r\n    }\r\n  },\r\n  computed: {\r\n    // 直接从AI回复中提取Coze链接 + 拼接代理URL\r\n    proxyImageUrl() {\r\n      if (!this.aiReply) return '';\r\n      // 提取s.coze.cn的链接\r\n      const match = this.aiReply.match(/https?:\\/\\/s\\.coze\\.cn\\/t\\/[a-zA-Z0-9_\\-]+\\/?/);\r\n      if (!match) return '';\r\n      // 拼接后端代理URL\r\n      return `http://localhost:21090/api/personal-heath/v1.0/imageProxy?url=${encodeURIComponent(match[0])}`;\r\n    }\r\n  },\r\n  methods: {\r\n    saveImage() {\r\n      // 保存逻辑保留原有代码\r\n      fetch('http://localhost:21090/api/personal-heath/v1.0/generatedImage/save', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({\r\n          imageUrl: this.proxyImageUrl,\r\n          userId: 23,\r\n          generateTime: new Date().toISOString()\r\n        })\r\n      }).then(res => alert('保存成功'))\r\n        .catch(err => alert('保存失败'));\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 整体容器：匹配chatvue的image-viewer样式 */\r\n.image-viewer {\r\n  padding: 15px;\r\n  font-family: Arial, sans-serif;\r\n}\r\n\r\n.image-viewer h3 {\r\n  margin: 0 0 15px 0;\r\n  font-size: 16px;\r\n  color: #8a7d5e; /* 匹配chatvue暖色调文字 */\r\n}\r\n\r\n/* 图片容器：保证占位符和图片都是正方形 */\r\n.img-placeholder-container {\r\n  width: 100%;\r\n  aspect-ratio: 1/1; /* 强制正方形 */\r\n  margin: 10px 0;\r\n  position: relative;\r\n}\r\n\r\n/* 未生成图片时的正方形占位符 */\r\n.img-placeholder {\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: #fff8e8; /* 匹配chatvue暖色调背景 */\r\n  border: 1px dashed #f0e8d0; /* 暖色调虚线边框 */\r\n  border-radius: 8px; /* 匹配chatvue圆角 */\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-direction: column;\r\n  color: #8a7d5e; /* 暖色调文字 */\r\n}\r\n\r\n.placeholder-content i {\r\n  font-size: 48px;\r\n  margin-bottom: 10px;\r\n  color: #f0c880; /* 暖色调图标 */\r\n}\r\n\r\n.placeholder-content p {\r\n  font-size: 14px;\r\n  margin: 0;\r\n}\r\n\r\n/* 预览图片：适配正方形容器，保持风格统一 */\r\n.preview-img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain; /* 保持图片比例，不拉伸 */\r\n  background-color: #fffdf8; /* 图片背景色匹配chatvue */\r\n  border: 1px solid #f0e8d0; /* 暖色调边框 */\r\n  border-radius: 8px; /* 匹配chatvue圆角 */\r\n}\r\n\r\n/* 保存按钮：完全匹配chatvue的按钮风格 */\r\n.save-img-btn {\r\n  padding: 8px 20px;\r\n  background-color: #f5dca8; /* 匹配chatvue按钮底色 */\r\n  color: #8a7d5e; /* 暖色调文字 */\r\n  border: 1px solid #f0c880; /* 暖色调边框 */\r\n  border-radius: 20px; /* 匹配chatvue圆角按钮 */\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.save-img-btn:hover {\r\n  background-color: #f0c880; /* hover暖色调加深 */\r\n  color: #7a6d4e; /* 文字加深 */\r\n  box-shadow: 0 2px 6px rgba(240, 200, 128, 0.15); /* 匹配chatvue阴影 */\r\n}\r\n\r\n.save-img-btn:active {\r\n  transform: translateY(1px);\r\n}\r\n</style>"]}]}