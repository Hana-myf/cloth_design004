{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ImageViewer.vue?vue&type=style&index=0&id=5567e6cd&scoped=true&lang=css&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\components\\ImageViewer.vue","mtime":1753784873228},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\css-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\postcss-loader\\src\\index.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["ImageViewer.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAgKA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"ImageViewer.vue","sourceRoot":"src/components","sourcesContent":["<template>\r\n  <div class=\"image-viewer\">\r\n    <!-- 图片查看区域 -->\r\n    <div v-if=\"imageUrl\" class=\"image-container\">\r\n      <h3>图片预览</h3>\r\n      <div class=\"image-wrapper\">\r\n        <img \r\n          :src=\"imageUrl\" \r\n          alt=\"提取的图片\" \r\n          class=\"preview-image\"\r\n          @load=\"isLoading = false\"\r\n          @error=\"handleImageError\"\r\n        >\r\n        <div v-if=\"isLoading\" class=\"image-loading\">加载中...</div>\r\n        <div v-if=\"loadError\" class=\"image-error\">图片加载失败，请检查链接</div>\r\n      </div>\r\n      \r\n      <button \r\n        class=\"save-btn\" \r\n        @click=\"saveImage\" \r\n        :disabled=\"isLoading || loadError || saving\"\r\n      >\r\n        {{ saving ? '保存中...' : '保存图片到我的创作' }}\r\n      </button>\r\n    </div>\r\n\r\n    <!-- 无图片时的提示 -->\r\n    <div v-else class=\"no-image\">\r\n      {{ hasChecked? '未从回复中提取到图片链接' : '等待AI生成图片...' }}\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n// 引入项目配置的request实例（确保带token）\r\nimport request from '@/utils/request';\r\n\r\nexport default {\r\n  name: 'ImageViewer',\r\n  props: {\r\n    aiReply: {\r\n      type: String,\r\n      default: ''\r\n    },\r\n    currentUserId: {\r\n      type: [String, Number],\r\n      required: false,\r\n      default: ''\r\n    },\r\n  },\r\n  data() {\r\n    return {\r\n      imageUrl: '',\r\n      isLoading: false,\r\n      loadError: false,\r\n      hasChecked: false,\r\n      saving: false,\r\n      saveSuccess: false,\r\n    };\r\n  },\r\n  watch: {\r\n    aiReply(newReply) {\r\n      this.extractImageUrl(newReply);\r\n    }\r\n  },\r\n  methods: {\r\n    extractImageUrl(content) {\r\n      if (!content) {\r\n        this.resetState();\r\n        return;\r\n      }\r\n\r\n      // 匹配Coze图片链接\r\n      const imgRegex = /https?:\\/\\/s\\.coze\\.cn\\/t\\/[a-zA-Z0-9]+\\/?/g;\r\n      const matches = content.match(imgRegex);\r\n\r\n      if (matches && matches.length > 0) {\r\n        this.imageUrl = matches[0];\r\n        this.isLoading = true;\r\n        this.loadError = false;\r\n        this.hasChecked = true;\r\n      } else {\r\n        this.resetState();\r\n        this.hasChecked = true;\r\n      }\r\n    },\r\n\r\n    handleImageError() {\r\n      this.isLoading = false;\r\n      this.loadError = true;\r\n    },\r\n\r\n    async saveImage() {\r\n      // 验证用户登录状态\r\n      if (!this.currentUserId) {\r\n        alert('请先登录再保存图片');\r\n        return;\r\n      }\r\n      // 验证图片链接\r\n      if (!this.imageUrl || this.saving) return;\r\n\r\n      this.saving = true;\r\n      this.saveSuccess = false;\r\n\r\n      try {\r\n        const fileName = this.imageUrl.split('/').pop() || 'generated-image';\r\n        \r\n        // 生成符合后端要求的时间格式（不含毫秒）\r\n        const date = new Date();\r\n        // 转换为 ISO 格式并去除毫秒部分（例如 \"2025-07-29T10:22:21Z\"）\r\n        const generateTime = date.toISOString().split('.')[0] + 'Z';\r\n        // 打印请求信息（用于调试）\r\n        console.log('保存请求参数:', {\r\n          userId: this.currentUserId,\r\n          imageName: fileName,\r\n          imageUrl: this.imageUrl,\r\n          generateTime: new Date().toISOString()\r\n        });\r\n\r\n        // 使用项目配置的request实例发送请求（自动带token）\r\n        const response = await request.post('/generatedImage/save', {\r\n          userId: this.currentUserId,\r\n          imageName: fileName,\r\n          imageUrl: this.imageUrl,\r\n          generateTime: generateTime\r\n        });\r\n\r\n        // 处理后端响应（根据实际响应格式调整）\r\n        if (response.data && (response.data.code === 200 || response.data.success)) {\r\n          this.$emit('save-success');\r\n          this.saveSuccess = true;\r\n          alert('图片保存成功');\r\n          setTimeout(() => this.saveSuccess = false, 2000);\r\n        } else {\r\n          throw new Error(response.data.msg || '保存失败（无详细信息）');\r\n        }\r\n      } catch (error) {\r\n        console.error('保存失败详情:', error);\r\n        console.error('响应数据:', error.response?.data || '无响应');\r\n        alert('保存失败: ' + (error.message || '未知错误'));\r\n      } finally {\r\n        this.saving = false;\r\n      }\r\n    },\r\n\r\n    resetState() {\r\n      this.imageUrl = '';\r\n      this.isLoading = false;\r\n      this.loadError = false;\r\n    }\r\n  },\r\n  created() {\r\n    if (this.aiReply) {\r\n      this.extractImageUrl(this.aiReply);\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.image-viewer {\r\n  width: 350px;\r\n  border: 1px solid #e0e0e0;\r\n  border-radius: 8px;\r\n  padding: 15px;\r\n  margin: 10px 0;\r\n  background-color: white;\r\n}\r\n\r\n.image-container h3 {\r\n  margin: 0 0 15px 0;\r\n  color: #333;\r\n  font-size: 16px;\r\n}\r\n\r\n.image-wrapper {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 250px;\r\n  border: 1px dashed #ccc;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.preview-image {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain; /* 保持图片比例，不拉伸 */\r\n}\r\n\r\n.image-loading {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(255,255,255,0.8);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #666;\r\n}\r\n\r\n.image-error {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: #fff5f5;\r\n  color: #f56c6c;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 14px;\r\n}\r\n\r\n.save-btn {\r\n  background-color: #165DFF;\r\n  color: white;\r\n  border: none;\r\n  padding: 8px 16px;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n}\r\n\r\n.save-btn:disabled {\r\n  background-color: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.save-btn:hover:not(:disabled) {\r\n  background-color: #0e47d7;\r\n}\r\n\r\n.no-image {\r\n  height: 250px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #666;\r\n  border: 1px dashed #ccc;\r\n  border-radius: 4px;\r\n}\r\n</style>"]}]}