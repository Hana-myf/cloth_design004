{"remainingRequest":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\web\\cloth_design\\cloth-design-view\\src\\components\\CollocationAssistant.vue?vue&type=style&index=0&id=da9d864e&scoped=true&lang=css&","dependencies":[{"path":"D:\\web\\cloth_design\\cloth-design-view\\src\\components\\CollocationAssistant.vue","mtime":1767449014602},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\css-loader\\dist\\cjs.js","mtime":1759332259160},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1759332273372},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\postcss-loader\\src\\index.js","mtime":1759332269050},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1759332254437},{"path":"D:\\web\\cloth_design\\cloth-design-view\\node_modules\\vue-loader\\lib\\index.js","mtime":1759332273371}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["CollocationAssistant.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA+KA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"CollocationAssistant.vue","sourceRoot":"src/components","sourcesContent":["<template>\r\n  <div class=\"collocation-assistant\">\r\n    <div class=\"chat-header\">\r\n      <h3>搭配助手</h3>\r\n      <div class=\"header-buttons\">\r\n        <button @click=\"clearChatHistory\" class=\"clear-btn\">清空记录</button>\r\n        <button @click=\"isMinimized = !isMinimized\" class=\"minimize-btn\">\r\n          {{ isMinimized ? '展开' : '收起' }}\r\n        </button>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-if=\"!isMinimized\" class=\"chat-messages\">\r\n      <div v-for=\"(msg, index) in messages\" :key=\"index\" class=\"message-item\">\r\n        <div :class=\"['message-bubble', msg.isUser ? 'user' : 'ai']\">\r\n          <img :src=\"msg.avatar\" class=\"avatar\" alt=\"头像\">\r\n          <div class=\"content\">\r\n            <p class=\"sender\">{{ msg.isUser ? '我' : '搭配助手' }}</p>\r\n            <div class=\"text\">{{ msg.content }}</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div v-if=\"isLoading\" class=\"loading\">\r\n        <div class=\"custom-spinner\"></div>\r\n        <span>正在思考搭配方案...</span>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-if=\"!isMinimized\" class=\"chat-input\">\r\n      <input \r\n        type=\"text\" \r\n        v-model=\"userInput\" \r\n        @keyup.enter=\"sendMessage\" \r\n        placeholder=\"输入搭配需求...按回车发送\"\r\n        :disabled=\"isLoading\"\r\n      >\r\n      <button @click=\"sendMessage\" :disabled=\"isLoading || !userInput.trim()\">发送</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'CollocationAssistant',\r\n  data() {\r\n    return {\r\n      messages: [],\r\n      userInput: '',\r\n      isLoading: false,\r\n      isMinimized: false,\r\n      apiKey: 'pat_l71GjeLrzmzEzh0d8R5saRWgJFrlhAL79YJbt1KJPLDSmHt2OuXaxom7A92dKjqG',\r\n      robotId: '7533187838620631066',\r\n      userId: 'user_' + Math.random().toString(36).substr(2, 9),\r\n      apiUrl: 'https://api.coze.cn/v3/chat',\r\n      recommendList: [\r\n        { style: '通勤风', desc: '羊毛面料 + 深灰/藏青 + 简约剪裁 + 单排扣设计' },\r\n        { style: '休闲风', desc: '牛仔面料 + 水洗蓝 + 破洞元素 + 宽松版型' },\r\n        { style: '轻奢风', desc: '真丝面料 + 香槟金/米白 + 蕾丝拼接 + 收腰设计' },\r\n        { style: '运动风', desc: '速干面料 + 荧光色撞色 + 反光条 + 连帽设计' }\r\n      ]\r\n    };\r\n  },\r\n  mounted() {\r\n    this.messages.push({\r\n      content: '你好！我可以帮你搭配服装配饰，有什么需求吗？',\r\n      isUser: false,\r\n      avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/chatsdk-logo.png'\r\n    });\r\n  },\r\n  methods: {\r\n    async sendMessage() {\r\n      if (!this.userInput.trim() || this.isLoading) return;\r\n\r\n      this.messages.push({\r\n        content: this.userInput,\r\n        isUser: true,\r\n        avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/coze-logo.png'\r\n      });\r\n\r\n      const userMessage = this.userInput;\r\n      this.userInput = '';\r\n      this.isLoading = true;\r\n\r\n      const aiMsgIndex = this.messages.push({\r\n        content: '',\r\n        isUser: false,\r\n        avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/chatsdk-logo.png'\r\n      }) - 1;\r\n\r\n      try {\r\n        const response = await fetch(this.apiUrl, {\r\n          method: 'POST',\r\n          headers: {\r\n            'Content-Type': 'application/json',\r\n            'Authorization': `Bearer ${this.apiKey}`\r\n          },\r\n          body: JSON.stringify({\r\n            bot_id: this.robotId,\r\n            user_id: this.userId,\r\n            stream: true,\r\n            auto_save_history: true,\r\n            additional_messages: [\r\n              { role: \"user\", content: userMessage, content_type: \"text\" }\r\n            ]\r\n          })\r\n        });\r\n\r\n        if (!response.ok) throw new Error(`请求失败: ${response.status}`);\r\n\r\n        const reader = response.body.getReader();\r\n        const decoder = new TextDecoder();\r\n        let fullReply = '';\r\n        let currentEvent = null;\r\n\r\n        while (true) {\r\n          const { done, value } = await reader.read();\r\n          if (done) break;\r\n\r\n          const chunk = decoder.decode(value, { stream: true });\r\n          const lines = chunk.split('\\n').filter(line => line.trim());\r\n\r\n          for (const line of lines) {\r\n            if (line.startsWith('event:')) {\r\n              currentEvent = line.replace('event:', '').trim();\r\n              continue;\r\n            }\r\n\r\n            if (line.startsWith('data:') && currentEvent === 'conversation.message.delta') {\r\n              const dataStr = line.replace('data:', '').trim();\r\n              if (dataStr) {\r\n                try {\r\n                  const data = JSON.parse(dataStr);\r\n                  if (data.content) {\r\n                    fullReply += data.content;\r\n                    this.messages[aiMsgIndex].content = fullReply;\r\n                    this.scrollToBottom();\r\n                  }\r\n                } catch (e) {\r\n                  console.warn('解析片段失败:', e);\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n\r\n        this.isLoading = false;\r\n\r\n      } catch (error) {\r\n        console.error('搭配助手API错误:', error);\r\n        this.messages[aiMsgIndex].content = `获取搭配建议失败: ${error.message}`;\r\n        this.isLoading = false;\r\n      }\r\n    },\r\n    handleRecommendSelect(item) {\r\n      this.$emit('select-recommend', item);\r\n    },\r\n    scrollToBottom() {\r\n      const container = this.$el.querySelector('.chat-messages');\r\n      if (container) container.scrollTop = container.scrollHeight;\r\n    },\r\n    clearChatHistory() {\r\n      if (confirm('确定要清空聊天记录吗？')) {\r\n        this.messages = [];\r\n        this.messages.push({\r\n          content: '你好！我可以帮你搭配服装配饰，有什么需求吗？',\r\n          isUser: false,\r\n          avatar: 'https://lf-coze-web-cdn.coze.cn/obj/eden-cn/lm-lgvj/ljhwZthlaukjlkulzlp/coze/chatsdk-logo.png'\r\n        });\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.collocation-assistant {\r\n  height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n  background-color: rgba(255, 255, 250, 0.98);\r\n  border: 1px solid #f0e8d0;\r\n}\r\n\r\n/* 聊天头部 */\r\n.chat-header {\r\n  padding: 10px 16px;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  background: #fff8e8;\r\n  border-bottom: 1px solid #f0e8d0;\r\n}\r\n.chat-header h3 {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  color: #8a7d5e;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.chat-header h3::before {\r\n  content: \"\";\r\n  width: 6px;\r\n  height: 14px;\r\n  background-color: #f0c880;\r\n  border-radius: 3px;\r\n}\r\n.header-buttons {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n.clear-btn, .minimize-btn {\r\n  padding: 4px 8px;\r\n  font-size: 12px;\r\n  border: 1px solid #f0e8d0;\r\n  border-radius: 20px;\r\n  background: #fffdf8;\r\n  color: #8a7d5e;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n}\r\n.clear-btn:hover, .minimize-btn:hover {\r\n  background: #f5dca8;\r\n  color: #7a6d4e;\r\n  border-color: #f0c880;\r\n}\r\n\r\n/* 聊天消息区 */\r\n.chat-messages {\r\n  flex: 1;\r\n  padding: 12px;\r\n  overflow-y: auto;\r\n  background: #fffdf8;\r\n}\r\n.message-item {\r\n  margin-bottom: 12px;\r\n}\r\n.message-bubble {\r\n  display: flex;\r\n  max-width: 80%;\r\n}\r\n.message-bubble.user {\r\n  margin-left: auto;\r\n  flex-direction: row-reverse;\r\n}\r\n.avatar {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 50%;\r\n  margin-right: 8px;\r\n  border: 1px solid #f0e8d0;\r\n}\r\n.message-bubble.user .avatar {\r\n  margin-right: 0;\r\n  margin-left: 8px;\r\n}\r\n.content {\r\n  padding: 8px 12px;\r\n  border-radius: 16px;\r\n  background: #fff8e8;\r\n  border: 1px solid #f0e8d0;\r\n  box-shadow: 0 1px 3px rgba(240, 200, 128, 0.1);\r\n}\r\n.message-bubble.user .content {\r\n  background: #f5dca8;\r\n  color: #8a7d5e;\r\n  border-color: #f0c880;\r\n}\r\n.sender {\r\n  margin: 0 0 4px;\r\n  font-size: 12px;\r\n  opacity: 0.8;\r\n  color: #8a7d5e;\r\n}\r\n.message-bubble.user .sender {\r\n  color: #7a6d4e;\r\n}\r\n.text {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  color: #8a7d5e;\r\n}\r\n\r\n/* 加载状态 */\r\n.loading {\r\n  text-align: center;\r\n  padding: 10px;\r\n  color: #8a7d5e;\r\n  font-size: 12px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n}\r\n.custom-spinner {\r\n  width: 16px;\r\n  height: 16px;\r\n  border: 2px solid #f0e8d0;\r\n  border-top-color: #f0c880;\r\n  border-radius: 50%;\r\n  animation: spin 1s linear infinite;\r\n}\r\n@keyframes spin {\r\n  from { transform: rotate(0deg); }\r\n  to { transform: rotate(360deg); }\r\n}\r\n\r\n/* 输入区 */\r\n.chat-input {\r\n  display: flex;\r\n  gap: 8px;\r\n  padding: 12px;\r\n  border-top: 1px solid #f0e8d0;\r\n  background: #fff8e8;\r\n}\r\n.chat-input input {\r\n  flex: 1;\r\n  padding: 8px 12px;\r\n  border: 1px solid #f0e8d0;\r\n  border-radius: 20px;\r\n  outline: none;\r\n  background: #fffdf8;\r\n  color: #8a7d5e;\r\n}\r\n.chat-input input:focus {\r\n  border-color: #f0c880;\r\n  box-shadow: 0 0 0 2px rgba(240, 200, 128, 0.1);\r\n}\r\n.chat-input input:disabled {\r\n  background: #f5f5f5;\r\n  color: #999;\r\n}\r\n.chat-input button {\r\n  padding: 8px 16px;\r\n  background: #f5dca8;\r\n  color: #8a7d5e;\r\n  border: 1px solid #f0c880;\r\n  border-radius: 20px;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n}\r\n.chat-input button:hover:not(:disabled) {\r\n  background: #f0c880;\r\n  color: #7a6d4e;\r\n  box-shadow: 0 2px 6px rgba(240, 200, 128, 0.2);\r\n}\r\n.chat-input button:disabled {\r\n  background: #eee;\r\n  color: #999;\r\n  border-color: #ddd;\r\n  cursor: not-allowed;\r\n}\r\n</style>"]}]}